el":500,"baseCoefficient":0,"levelCoefficient":0.1,"maxLabel":"满进化 · 满觉醒"}]}],"options":[{"id":10810,"level":250,"name":"队伍近程伤害提升"},{"id":320563,"level":null,"name":"高洁意志"}]}],"illustrations":[{"name":"原版立绘","asset":{"key":"illust:illust_guardian_angel","skin":null},"stage":null}],"costumes":[{"id":10449,"code":"guardian_angel_worker","name":"便利店员工安吉","type":"时装","sprite":{"sheet":"characters","name":"guardian_angel_worker"},"asset":{"key":"character:guardian_angel_worker","skin":null}}],"weapons":[{"code":"cwp_guardianangel","name":"荣耀颂歌","type":"单手剑","variants":[{"id":9010624,"code":"cwp_guardianangel_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_guardianangel"},"stats":[{"name":"每秒伤害","values":[600,659],"baseValues":[600.2699998908599,659.1199998801601],"grows":true},{"name":"水属性攻击","values":[187,205],"baseValues":[186.999999966,205.333333296],"grows":true},{"name":"暴击率","values":[7,7],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"技能伤害值","min":4.0,"max":16.0,"unit":"%"},{"name":"生命","min":4.0,"max":12.0,"unit":"%"},{"name":"防御","min":4.0,"max":12.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":3.0,"max":10.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"在天界回音状态下，天界剑刃命中目标时，为被命中的目标刻上天界纹章，使其防御减免5%并持续6秒。该效果最多叠加4次。"}],"skill":{"name":"天界之光","description":"降下神圣光芒，对敌人造成近程伤害并附带击倒效果。","levels":[1,5],"damage":[180.0,220.0],"cooldown":[10.0,9.0],"ailment":"击倒"}}],"number":1}],"profile":{"Age":null,"Height":[170],"Weight":[55]},"tribes":["天使"],"story":"天界现任财务部部长安吉，她曾担任天界骑士团“守护者”的骑士团长，是一名正义凛然的天使。\n\n在担任骑士团长期间，安吉是一名令敌人闻风丧胆的战士，也是一位深受天界军士们尊敬的出色将领。身经百战的安吉取得了无数次战役的胜利，为守护天界立下了赫赫战功。对安吉来说，守护天界即为正义，在战场中为了保护盟友，每次她都会冲锋在最前线。安吉的英勇赢得了诸神的赞赏，被誉为“天界之剑”。\n\n当凯登一行人为了遏制毁灭火花蔓延而前往天界时，充满正义感的安吉也毅然加入了他们，一同踏上征程。在旅途中，安吉遇到了失忆的普利特维采，自那以后，安吉便陪伴在普利特维采身边全心全意辅佐她，直到她恢复记忆。尽管普利特维采已经恢复了记忆，但忠诚的安吉仍然继续追随着她，就这样安吉成为了普利特维采唯一信赖的天使。\n\n由于世界树失去力量，间接导致了天界的财政体系崩溃，在这种混乱的局面下，安吉糊里糊涂地当上了天界财务部部长。虽然安吉并不具备财政方面的专业知识，但她凭借骑士团长时期培养出的责任感，全身心地投入到重建天界财政秩序的工作中。然而现实是残酷的，仅凭满腔的热情根本无法解决天界的财政危机，无奈之下，安吉不得不亲自外出打工。在辗转多个工作岗位后，安吉被一家便利店录用了，但她却没想到，自己竟会一直无法摆脱这家店。\n\n无论工作环境多么恶劣，安吉总是能够认真负责地完成各种艰难的任务。然而在加百列的便利店工作不是一般的辛苦，无穷无尽的加班和令人窒息的工作量不止一次地点燃了安吉离职的决心。但是，每当安吉想要离开便利店的时候，加百列就会刻意提及普利特维采，如此一来，安吉也只好打消离职的念头。\n\n幸运的是，安吉在骑士团的那段经历对便利店的工作有很大帮助，在货架上整齐排列的面包和牛奶，总能让顾客们赞叹不已。另一方面，军人钢铁般的精神造就了安吉坚强的意志和耐心，使得她即使面对顾客的无理取闹和恶意刁难，也能从容应对。辛苦工作一天后，安吉回到自己的出租屋，怀着成功解除普利特维采封印的美好幻想进入梦乡。","storyKey":"profile_guardian_angel_story","sources":{"hero":"heroes.json / OriginId=563","profile":"heroprofile.json / OriginId=563","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"guardian_angel","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["务必在明天之前，提交战争费用报告。"],"enUS":["Please report the battle costs by tomorrow."],"jaJP":["戦費の清算報告は明日までにお願いします"]},"keys":["cv_guardian_angel_NormalBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/563/5630001@5301182357818294060"],"enUS":["cdn/Android/ondemand/voices_en/563/5630001"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/563/5630001@365222548553257146"]},"audioName":"5630001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["这就是你剑指天界的代价。"],"enUS":["That's the price for pointing your sword at Heaven."],"jaJP":["天界に刃を向けた代償です"]},"keys":["cv_guardian_angel_BossBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/563/5630002@5236366967405289705"],"enUS":["cdn/Android/ondemand/voices_en/563/5630002"],"jaJP":["offline/AssetBundles/Android/ondema