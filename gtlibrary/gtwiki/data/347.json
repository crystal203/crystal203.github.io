1,616],"baseValues":[561.0,616.0000000000001],"grows":true},{"name":"虚属性攻击","values":[140,154],"baseValues":[140.25,154.00000000000003],"grows":true},{"name":"恢复能力","values":[210,210],"baseValues":[210,210],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"开始战斗时，加成额外生命","min":2.0,"max":5.0,"unit":"%"},{"name":"防御","min":8.0,"max":22.0,"unit":"%"},{"name":"生命","min":6.0,"max":18.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":5.0,"max":12.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"普通攻击时，以40%概率抛出强化狐仙宝玉。"}],"skill":{"name":"狐火炸弹","description":"召唤周围狐火，逐一抛向敌人造成远程伤害并附带击倒效果。","levels":[3,6],"damage":[140.0,215.0],"cooldown":[8.5,8.5],"ailment":"击倒"}}],"number":1}],"profile":{"Age":null,"Height":[146],"Weight":[40]},"tribes":["狐狸"],"story":"奈莉，长有8条尾巴的狐仙。\n\n八尾狐奈莉，天生少一条尾巴，凭借狐仙宝玉之力施展道法。从小与九尾狐佳岚一起成长，一起修炼，因少一条尾巴，道法不及佳岚，修炼偶尔需要佳岚的协助。急需帮助的村民们用恳切祈祷与隆重祭典唤醒了长眠石像奈莉。\n\n总想利用幼儿般可爱的外表戏弄对方，却不能被人视为小孩。故意装出一副可爱至极的模样瞒过对方，若受骗的人信以为真，把她当成小孩，即刻变脸，恼羞成怒。‘竟敢把我当成不懂人情世故的孩童？！’缺乏耐心，脾气暴躁，却正直耿介，直言不讳。\n\n外表稚嫩，却已经历漫长的岁月，从不用敬语，时常大声斥责别人，酷似不懂礼节的孩子。其实，奈莉颇为明智，能够妥善帮助遇到困难的人们，诚实履行身为神仙的义务。与外表相反，兴趣爱好偏向老人，喜欢“又香又甜”锅巴糖果，比起透心凉的冰水，更爱喝“热水”。","storyKey":"profile_eight_tail_story","sources":{"hero":"heroes.json / OriginId=347","profile":"heroprofile.json / OriginId=347","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}