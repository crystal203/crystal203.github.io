.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"凝聚魔力","description":"神奇激光束连续3次命中目标，按照每秒伤害的35%，造成额外伤害，并附带僵化效果。"}],"skill":{"name":"威猛激光链","description":"发射威猛激光凝聚能，同时对诸多敌人造成伤害，并附带击倒效果。","levels":[2,5],"damage":[210.0,240.0],"cooldown":[9.3,9.0],"ailment":"击倒"}}],"number":1}],"profile":{"Age":[19],"Height":[162],"Weight":[50]},"tribes":["人类"],"story":"索菲，魔法学院高材生。\n\n虽没有任何魔法天赋，却擅长融合魔法与技术进行创新发明，施展名曰‘魔科学’的超凡魔法。\n\n聪明伶俐，但缺乏社交能力，不会分场合，经常口无遮拦地说出‘比我笨的你们’侮辱对方。不认识索菲的人还以为她品性恶劣，其实，索菲只是不懂得交际，分不清哪些话该说，哪些话不该讲，也不明白怎样才是为对方着想。喜欢指出别人的缺点，为他人讲解是想炫耀自己胜过旁人的能力，因此，越发难以与人相处。\n\n曾经向学院申请过组建《给魔法时报寄抗议信》社团，被学院领导拒绝。","storyKey":"profile_ghost_buster_story","sources":{"hero":"heroes.json / OriginId=41","profile":"heroprofile.json / OriginId=41","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"ghost_buster","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["这些不能用作实验数据。"],"enUS":["This data isn't good enough."],"jaJP":["こんなの、実験データにすらならない"]},"keys":["cv_ghost_buster_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["按计划行事。"],"enUS":["Just as calculated."],"jaJP":["計画通り"]},"keys":["cv_ghost_buster_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["失败乃成功之母…"],"enUS":["We fail… To learn…"],"jaJP":["失敗は…成功の…データ…"]},"keys":["cv_ghost_buster_Die"]},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["还是老样子。"],"enUS":["As usual."],"jaJP":["いつもので"]},"keys":["cv_ghost_buster_GetExp"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["你会记得你吃过多少片面包吗？我吃了4797片。"],"enUS":["Do you remember the number of breads you've eaten? Mine is 4797."],"jaJP":["これまで食べたパンの数覚えてる？私は4797個よ"]},"keys":["cv_ghost_buster_LevelUp"]},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["不可思议…不过这个装备有做过安全检验吗？"],"enUS":["Incredible! But did you run safety checks?"],"jaJP":["良いね、ところでこの装備、当然安全点検はしたよね？"]},"keys":["cv_ghost_buster_EquipWeapon"]},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["嗯…你觉得这很帅？"],"enUS":["Huh? You like this?"],"jaJP":["これが「イカしてる」？根拠に乏しいね"]},"keys":["cv_ghost_buster_EquipCostume"]},{"type":"Evolve","label":"进化","texts":{"zhCN":["你相信创世论吗？"],"enUS":["You still believe in creationism?"],"jaJP":["これでも創造説を信じるのかな"]},"keys":["cv_ghost_buster_Evolve"]},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["哼哼！"],"enUS":["Hehe!"],"jaJP":["ふふん！"]},"keys":["cv_ghost_buster_Attack1"]},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["哈呀！"],"enUS":["Oh, laser!"],"jaJP":["はあっ！"]},"keys":["cv_ghost_buster_Attack2"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["科学！"],"enUS":["Science!"],"jaJP":["サイエンス！"]},"keys":["cv_ghost_buster_Attack3"]},{"type":"Skill1","label":"技能1","texts":{"zhCN":["通电！"],"enUS":["Energize!"],"jaJP":["エナジャイズ！"]},"keys":["cv_ghost_buster_Skill1"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["逗你呢！"],"enUS":["Bazinga!"],"jaJP":["バジンガ！"]},"keys":["cv_ghost_buster_Skill2"]},{"type":"Damaged1","label":"受到攻击1","texts":{"zhCN":["呃"],"enUS":["Ugh!"],"jaJP":["くっ…"]},"keys":["cv_ghost_buster_Damaged1"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["还不是时候！"],"enUS":["Not yet!"],"jaJP":["まだよ！"]},"keys":["cv_ghost_buster_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["这也算是一种约定俗成的选择吗？"],"enUS":["Is this a non optional social convention?"],"jaJP":["これも個人は選択する権利のない、社会的約束というものか？"]},"keys":["cv_ghost_buster_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["你刚才的行为违反了社会道德准则，你是不是没有社交生活？"],"enUS":["You just broke a code of ethics. Are you perhaps socially inept?"],"jaJP":["今のお前の行動は明らかに倫理規定違反よ、社会性が不足してるんじゃないの？"]},"keys":["cv_ghost_buster_PlayerChooseDark"]},{"type":"WeakEnemyBattleStart","label":"与弱小敌人战斗","texts":{"zhCN":["浪费时间。"],"enUS":["This is a waste of time."],"jaJP":["リソースの無駄遣いね"]},"keys":["cv_