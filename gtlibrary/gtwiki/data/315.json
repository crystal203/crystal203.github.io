e":"cwp_idolcaptain_myth"},"stats":[{"name":"每秒伤害","values":[724,795],"baseValues":[723.619008,794.5620480000001],"grows":true},{"name":"虚属性攻击","values":[236,260],"baseValues":[236.4768,259.66080000000005],"grows":true},{"name":"暴击率","values":[2,2],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"开始战斗时，加成额外生命","min":4.0,"max":10.0,"unit":"%"},{"name":"生命","min":8.0,"max":20.0,"unit":"%"},{"name":"武器技能恢复速度","min":5.0,"max":15.0,"unit":"%"}],"subOptions":[{"name":"防御","min":5.0,"max":15.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"使用声波击时，承受伤害减免20%。\n使用声波击时，我方全部人员的攻击和暴击率提升20%，持续6秒；队长的攻击和暴击率提升为30%。每6秒内只能触发一次。"}],"skill":{"name":"倾泻彩虹","description":"利用绚丽多彩的光线，对敌人造成远程伤害并附带击飞效果。","levels":[3,7],"damage":[200.0,240.0],"cooldown":[8.0,8.0],"ailment":"击飞"}}],"number":1}],"profile":{"Age":[29],"Height":[171],"Weight":[54]},"tribes":["人类"],"story":"偶像骑士团长伊娃是身穿偶像演出服唱歌的“守护者”第19任骑士团长。\n\n为了利用聚集魔力的声音演唱，启动攻击魔法而变身现在模样。与平时果断严厉的声音不同，伊娃的歌声如银铃般清脆动听。利用清雅美妙的歌声攻击，让伊娃害羞不已，不得不穿上偶像演出服施展魔法，令人啼笑皆非。自以为“骑士团长伊娃”与“偶像伊娃”截然不同，伪装也是完美无缺。可是，别人都知道唱歌的是身穿偶像演出服的“骑士团长伊娃”。只因明白伊娃为何害羞，大家就睁一只眼闭一只眼，假装没认出骑士团长。\n\n伊娃的歌声，对敌人来说是恐怖的攻击，对世界各地的歌迷来说是触动心弦的旋律。应歌迷们无休止的盛情邀请，偶像伊娃偶尔也会举办演唱会。以为没人会认出自己是骑士团长，在舞台上开怀大笑，尽情欢歌，向歌迷大喊“我的朋友”，放下身份，享受如释重负的感觉。","storyKey":"profile_idol_captain_story","sources":{"hero":"heroes.json / OriginId=315","profile":"heroprofile.json / OriginId=315","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"idol_captain","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["为了演唱会居然要练到这种程度吗…？偶像世界的竞争很残酷。"],"enUS":["All this just for concert practice...? The idol world sure is something else."],"jaJP":["ライブの練習のためにこんなことまで…？アイドルの世界は奥深いな"]},"keys":["cv_idol_captain_NormalBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/315/3150001@4868030233095620069"],"enUS":["cdn/Android/ondemand/voices_en/315/3150001"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/315/3150001@-3365670512331544008"]},"audioName":"3150001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["将这份荣誉献给制作人！"],"enUS":["Glory to the producer!"],"jaJP":["この勝利の栄光を、プロデューサーに！"]},"keys":["cv_idol_captain_BossBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/315/3150002@2232419168424400814"],"enUS":["cdn/Android/ondemand/voices_en/315/3150002"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/315/3150002@-4013320258872064001"]},"audioName":"3150002"},{"type":"Die","label":"阵亡","texts":{"zhCN":["应该不会再有安可了…"],"enUS":["There will be no… encore…"],"jaJP":["アンコールは… ないか…"]},"keys":["cv_idol_captain_Die"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/315/3150003@8179602968482155946"],"enUS":["cdn/Android/ondemand/voices_en/315/3150003"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/315/3150003@5509395775708947841"]},"audioName":"3150003"},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["感谢大家给予的关怀～！"],"enUS":["I shall repay all your love and support."],"jaJP":["みんなの声援に答えよう"]},"keys":["cv_idol_captain_GetExp"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/315/3150004@4580767306170239230"],"enUS":["cdn/Android/ondemand/voices_en/315/3150004"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/315/3150004@4380103912611515705"]},"audioName":"3150004"},{"type":"LevelUp","label":"升级","texts":{"zhCN":["骑士…不，不是，偶像训练无止境！"],"enUS":["Never stop training, I mean singing!"],"jaJP":["騎士の… あ、いや、アイドルの鍛錬に終わりはない！"]},"keys":["cv_id