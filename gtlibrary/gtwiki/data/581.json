190],"baseValues":[190,190],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"技能伤害值","min":8.0,"max":22.0,"unit":"%"},{"name":"生命","min":7.0,"max":18.0,"unit":"%"},{"name":"防御","min":6.0,"max":16.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":5.0,"max":15.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"森林之箭的第一次攻击得到强化，命中目标时，英雄自身的攻击提升30%并持续5秒；\n敏锐感知的效果适用于我方全部人员。"}],"skill":{"name":"森林共鸣","description":"发射森林净化能量，造成远程伤害并附带重伤效果。","levels":[1,5],"damage":[160.0,220.0],"cooldown":[9.1,7.1],"ailment":"重伤"}}],"number":1}],"profile":{"Age":[70],"Height":[175],"Weight":[46]},"tribes":["森精灵"],"story":"森精灵艾丝黛尔是一名森林卫士，守护森林与元素精灵神树是她的职责。\n\n森精灵是与元素精灵一起生活在森林中，和大自然和谐共存的种族。森精灵们以守护给森林带来无尽生机的元素精灵神树为使命，为了防止外敌对森林和神树进行破坏，他们还组建了护卫队时刻穿梭在广阔的森林中进行巡逻。不料，这种与世隔绝，戒备森严的封闭森林，反而激起了人类强烈的好奇心，有人甚至还编造了“精灵森林藏有珍贵宝藏”的谣言。\n\n艾丝黛尔是森林护卫队中最年轻、战斗力最强的卫士。凭借敏锐的感知力，艾丝黛尔能一瞬间准确地掌握远处敌人的动向，还能通过感知对方的呼吸与心跳，读取其内心的真实想法。通常来说，精灵们平时都会注意提高警惕，但或许是因为艾丝黛尔对自身能力充满自信，她的戒心并不强，这也造就了艾丝黛尔乐观开朗的性格。\n\n由森精灵负责守护的元素精灵神树是森林的根源。神树蕴含着元素精华，这种精华会甄选具有成为元素精灵王资质的精灵，并赋予其力量。然而有一天，对元素精华窥伺已久的神秘组织袭击了森林，神树也因此遭受严重破坏，元素精华散落到了世界各地。在元素精灵神树被摧毁后不久，森林便开始逐渐失去活力，元素精灵们也随之陷入了混乱。\n\n想要救活神树，就必须找回元素精华，为此，森精灵们召开了一场紧急会议。因为艾丝黛尔不仅是最优秀的森林卫士，而且还能准确锁定精华所在的位置，所以大家一致认为她是回收元素精华的最佳人选。就这样，艾丝黛尔被委以重任，在森精灵们的鼓励和祈祷中离开了森林，开始了一段前往陌生世界找回元素精华的旅程。\n\n看似完美至极的艾丝黛尔却有一个鲜为人知的缺点，那就是，艾丝黛尔是一个无药可救的音痴。用歌声与大自然沟通的精灵们，通常都拥有天籁般的嗓音，但唯独艾丝黛尔是个例外。一旦她唱起歌，就一定会跑调，不仅找不准音律和节拍，甚至连音阶都能唱歪。因此，艾丝黛尔绝不会在其他精灵面前唱歌。精灵伙伴们一直以为是艾丝黛尔太过害羞，以至于不敢与大自然进行沟通。","storyKey":"profile_forest_elf_story","sources":{"hero":"heroes.json / OriginId=581","profile":"heroprofile.json / OriginId=581","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"forest_elf","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["箭无虚发。"],"enUS":["One shot, one kill."],"jaJP":["一矢一殺…"]},"keys":["cv_forest_elf_NormalBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/581/5810001@-6962357337952816161"],"enUS":["cdn/Android/ondemand/voices_en/581/5810001"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/581/5810001@848288252752610525"]},"audioName":"5810001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["风，不是用来抗拒的，而是用来驾驭的。"],"enUS":["The wind is to be utilized, not to be overcome."],"jaJP":["風は克服するものではなく、計算するもの"]},"keys":["cv_forest_elf_BossBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/581/5810002@-4653569205495966233"],"enUS":["cdn/Android/ondemand/voices_en/581/5810002"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/581/5810002@-7573521711905489556"]},"audioName":"5810002"},{"type":"Die","label":"阵亡","texts":{"zhCN":["我必须…找回精华…"],"enUS":["I… need to retrieve… the essence…."],"jaJP":["精霊のエッセンスを…回収しないと…"]},"keys":["cv_forest_elf_Die"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/581/5810003@-807048096785448816"],"enUS":["cdn/Android/ondemand/voices_en/581/5810003"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/581/5810003@-1514713168255823574"]},"audioName":"5810003"},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["这将为我的成长提供充足的养分。"],"enUS":["It'll be good fertilizer for growth."],"jaJP":["成長のための、いい肥料ね"]},"keys":["cv_forest_elf_GetExp"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/581/5810004@353199700550616285"],"enUS":["cdn/Android/ondemand/voices_en/581/5810004"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/581/5810004@-8915296180935702360"]},"audioName":"5810004"},{"type":"LevelUp","labe