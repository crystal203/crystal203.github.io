unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"使用涟漪舞步后，水箭的伤害值增加25%，移动速度提升20%，持续5秒。\n音波冲击命中敌人时，目标敌人武器技能恢复速度降低30%，持续2秒。"}],"skill":{"name":"音波冲击","description":"发射超声波箭矢，对敌人造成远程伤害并附带击倒效果。","levels":[1,5],"damage":[190.0,250.0],"cooldown":[10.7,8.7],"ailment":"击倒"}},{"id":9040385,"code":"cwp_mermaidspy_myth","label":"开花","stars":6,"sprite":{"sheet":"items","name":"cwp_mermaidspy_myth"},"stats":[{"name":"每秒伤害","values":[759,834],"baseValues":[759.4705800000002,833.92848],"grows":true},{"name":"水属性攻击","values":[345,379],"baseValues":[345.2139,379.0584],"grows":true},{"name":"暴击率","values":[10,10],"unit":"%"},{"name":"恢复能力","values":[228,228],"baseValues":[228,228],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"技能伤害值","min":8.0,"max":22.0,"unit":"%"},{"name":"防御","min":7.0,"max":18.0,"unit":"%"},{"name":"生命","min":6.0,"max":16.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":6.0,"max":16.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"使用涟漪舞步后，水箭的伤害值增加25%，移动速度提升20%，持续7秒。\n音波冲击命中敌人时，目标敌人武器技能恢复速度降低30%，持续2秒。"}],"skill":{"name":"音波冲击","description":"发射超声波箭矢，对敌人造成远程伤害并附带击倒效果。","levels":[1,5],"damage":[270.0,270.0],"cooldown":[10.7,8.7],"ailment":"击倒"}}],"number":1}],"profile":{"Age":[32],"Height":[172],"Weight":[60]},"tribes":["海豚人"],"story":"J是亚特兰蒂斯情报部的特工。\n\n在广阔的忒提斯海洋，众多种族自由自在地生活在这里。由于水之精灵王特里顿的存在，大海始终保持着和平。作为辅佐精灵王的直属机构，情报部的特工们负责清除威胁亚特兰蒂斯的大规模恐怖袭击和跨国危机，默默地守护着海底世界的和平。\n\n和其他团队行动的特工不同，J经常被独自派往任务区域执行任务。对外则宣称，因为她具有独自完成团队规模作战的能力，高层特别批准她可以单独行动。\n\n但实际上，她在组织内处于被孤立状态。出于对国家的忠诚，她在工作中摒弃了个人情感，为了任务完全放弃了个人生活。但随着情报部的权力更替，J的工作方式被评价为效率低下，迂腐陈旧，因而遭到了忽视。\n\n于是，J成为了情报部中唯一一个没有团队的特工。每天独自执行大量任务后，盯着抽屉角落里的那封辞职信，已成了她的日常。一方面，她想守护特里顿大人缔造的和平，继续遵守当初立下的誓言；另一方面则是非常现实的原因，如果现在辞职她就会失去国家公务员的特别养老金。\n\n一切的转变，出现在J与一名代号为“鱼鹰”的特工协同作战时。两人都只专注于任务目标，在此过程中，完全没有产生任何情感上的纠葛。干净利落地完成这次任务之后，J更加确信：在一个只看重利益的组织里，自己很难找到合适的队友。\n\n从那天起，每次执行任务时，J都会组建自己的团队。挑选队友的标准有三条：\n1.任务目标绝对一致。\n2.情报完全公开。\n3.决策权平等。\n\n通过这种方式，她逐渐有了一支能够完全专注于任务的团队。这种纯粹到极致的协作模式创造了惊人战绩，最终高层破例授予她“自主行动特权”，这使得J成为情报局两百年来唯一可不受上级指令约束，完全自主开展行动的特工。\n\n不过对J而言，团队协作只是达成目的的工具。没有什么比完成任务更重要。","storyKey":"profile_mermaid_spy_story","sources":{"hero":"heroes.json / OriginId=650","profile":"heroprofile.json / OriginId=650","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"mermaid_spy","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["做个好梦吧，朋友。"],"enUS":["Sweet dreams, friend."],"jaJP":["よい夢を"]},"keys":["cv_mermaid_spy_NormalBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/650/6500001@141591606868869350"],"enUS":["cdn/Android/ondemand/voices_en/650/6500001"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/650/6500001@-621761608356235643"]},"audioName":"6500001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["目标清除。干净利落对吧？"],"enUS":["All clear. That was a smooth operation."],"jaJP":["任務完了！"]},"keys":["cv_mermaid_spy_BossBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/650/6500002@6542533799129223589"],"enUS":["cdn/Android/ondemand/voices_en/650/6500002"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/650/6500002@-7474278028038480484"]},"audioName":"6500002"},{"type":"Die","label":"阵亡","texts":{"zhCN":["这情报…我不会交给你…！"],"enUS":["I'm taking that... to the grave...!"],"jaJP":["情報を、渡すつもりはない…！"]},"keys":["cv_mermaid_spy_Die"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/650/6500003@-3919358685774173464"],"enUS":["cdn/Android/ondemand/voices_en/650/6500003"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/650/6500003@31130725126194101"]},"audioName":"6500003"},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["这点投资…想必是在期待合理的回报吧？"],"enUS":["An investment like this... surely calls for a proper return."],"jaJP":["賄賂のつもりなら、どんな見返りを求めているのかしら？"]},"keys":["cv_mermaid_spy_GetExp"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/650/6500004@-8561446347241303039"],"enUS":["cdn/Android/ondemand/voices_en/650/6500004"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/650/6500004@8275284999518293432"]},"audioName":"6500004"},{"type":"LevelUp","label":"升级","texts":{"zhCN":["晋升总是让人心情复杂。毕竟责任也随之加重了。"],"enUS":["Promotions always feel a little strange. They just come with more responsibility."],"jaJP":["昇進って素直に喜べないのよね、それに伴う責任が増えるから"]},"keys":["cv_mermaid_spy_LevelUp"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/650/6500005@-516317265407885745"],"enUS":["cdn/Android/ondemand/voices_en/650/6500005"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/650/6500005@-2239434836377608439"]},"audioName":"6500005"},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["很好。这是作战必需品。"],"enUS":["Good. We’ll need this for the mission."],"jaJP":["いいわね、任務遂行に不可欠よ"]},"keys":["cv_mermaid_spy_EquipWeapon"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/650/6500006@8723882120210244385"],"enUS":["cdn/Android/ondemand/voices_en/650/6500006"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/650/6500006@-6832952315536884703"]},"audioName":"6500006"},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["伪装…是间谍的必备技能。"],"enUS":["Disguises, huh? A key virtue for any intel agent."],"jaJP":["変装は、諜報員には必須の技能よ"]},"keys":["cv_mermaid_spy_EquipCostume"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/650/6500007@4197327717512623538"],"enUS":["cdn/An