CN":["目标竟是首领…该给额外津贴吧…？"],"enUS":["The objective is the boss, huh?… Think I’ll get paid extra for this..?"],"jaJP":["ボスがターゲットね…追加手当を期待したいけど…"]},"keys":["cv_mermaid_spy_BossBattleStart"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/650/6500021@3438883637584842702"],"enUS":["cdn/Android/ondemand/voices_en/650/6500021"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/650/6500021@8410866160448371737"]},"audioName":"6500021"},{"type":"JoinParty","label":"首次加入队伍","texts":{"zhCN":["请叫我J……当然，这只是个代号。"],"enUS":["Call me J… It's my alias, obviously."],"jaJP":["Jと呼んで…もちろん、仮名よ"]},"keys":["cv_mermaid_spy_JoinParty"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/650/6500022@-3348439186058586176"],"enUS":["cdn/Android/ondemand/voices_en/650/6500022"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/650/6500022@3855257834971561824"]},"audioName":"6500022"},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["集中火力攻击！"],"enUS":["Everyone, focus your attacks!"],"jaJP":["全員で、攻撃を集中させて！"]},"keys":["cv_mermaid_spy_CoopAttack"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/650/6500023@5135516448976704148"],"enUS":["cdn/Android/ondemand/voices_en/650/6500023"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/650/6500023@-1190145479026266602"]},"audioName":"6500023"},{"type":"CoopHeal","label":"战斗-请求治疗","texts":{"zhCN":["急需治疗。快！"],"enUS":["I need healing. Quickly!"],"jaJP":["治療を！速やかに！"]},"keys":["cv_mermaid_spy_CoopHeal"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/650/6500024@3345984897402130793"],"enUS":["cdn/Android/ondemand/voices_en/650/6500024"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/650/6500024@1972651676569900538"]},"audioName":"6500024"},{"type":"CoopRun","label":"战斗-注意","texts":{"zhCN":["全体撤离当前位置！"],"enUS":["Everyone, fall back from your positions!"],"jaJP":["みんな、ここから離れて！"]},"keys":["cv_mermaid_spy_CoopRun"],"audio":{"zhCN":["offline/AssetBundles/Android/ond