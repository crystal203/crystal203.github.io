友"}]}],"illustrations":[{"name":"原版立绘","asset":{"key":"illust:illust_tanker","skin":null},"stage":null},{"name":"日服立绘","asset":{"key":"illust:illust_tanker_kong","skin":null},"stage":null},{"name":"晋升立绘","asset":{"key":"illust:illust_tanker_ascent","skin":null},"stage":10092}],"costumes":[{"id":10159,"code":"golem_tanker","name":"森林魔像克雷格","type":"时装","sprite":{"sheet":"characters","name":"golem_tanker"},"asset":{"key":"character:golem_tanker","skin":null}},{"id":10211,"code":"tanker_hw_tin","name":"锡匠克雷格","type":"时装","sprite":{"sheet":"characters","name":"tanker_hw_tin"},"asset":{"key":"character:tanker_hw_tin","skin":null}}],"weapons":[{"code":"cwp_tanker","name":"沉默","type":"单手剑","variants":[{"id":9010324,"code":"cwp_tanker_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_tanker"},"stats":[{"name":"每秒伤害","values":[599,658],"baseValues":[599.3519998939199,658.1119998835201],"grows":true},{"name":"土属性攻击","values":[192,211],"baseValues":[192.09999996599998,210.933333296],"grows":true},{"name":"暴击率","values":[4,4],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"防御","min":5.0,"max":10.0,"unit":"%"},{"name":"生命","min":5.0,"max":10.0,"unit":"%"},{"name":"伤害减免","min":15,"max":30,"unit":""}],"subOptions":[{"name":"技能伤害值","min":3.0,"max":10.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"坚强意志","description":"受到近程攻击时，按照每秒伤害的20%造成近程伤害，恢复1%自己生命。伤害值按照技能施放者防御一定比例提升。该技能每2秒启动1次。"}],"skill":{"name":"冲锋攻击","description":"快速向敌人突进造成近程范围伤害。伤害值按照技能施展英雄的防御一定比例提升。攻击造成敌人击倒。","levels":[2,5],"damage":[85.0,100.0],"cooldown":[7.0,7.0],"ailment":"击倒"}}],"number":1}],"profile":{"Age":[35],"Height":[189],"Weight":[98]},"tribes":["人类"],"story":"克雷格，地牢王国勇士挑战者。\n\n20年来，克雷格一直想成为勇士。他不懈锻炼，每5年都来参加地牢勇士大赛并挑战击杀大恶魔的任务，但结果总是不尽如人意。克雷格屡战屡败，最后只能在一家酒吧当保镖维持生计。对克雷格而言，失败并不陌生，但他害怕20年的努力与付出会成为泡影，这种恐惧让他痛苦难耐。即便如此，克雷格面对挫折，也能永不言败，那一股奋力向前的韧劲与勇气绝不亚于其他勇士挑战者。\n\n克雷格体格健壮，是一名拥有超强抵抗能力的坦克。他可以只身抵挡刀剑、火焰、冰冻等各种攻击，堪称人形盾牌。若穿戴一身性能优良的盔甲，克雷格的战斗力将会大大提升。","storyKey":"profile_tanker_story","sources":{"hero":"heroes.json / OriginId=92","profile":"heroprofile.json / OriginId=92","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"tanker","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["我也…能做到。"],"enUS":["I… Can still go on."],"jaJP":["俺だって… まだやれる"]},"keys":["cv_tanker_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["我做到了…成功了！艾尔丽！"],"enUS":["I did it… I did it! Ailee!"],"jaJP":["やった… やったぞエイリー！"]},"keys":["cv_tanker_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["我…只能在这种地方…"],"enUS":["To die at a place like this…"],"jaJP":["俺は… まだ何もできてない…"]},"keys":["cv_tanker_Die"]},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["谢谢。"],"enUS":["Thank you."],"jaJP":["感謝するよ"]},"keys":["cv_tanker_GetExp"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["变得更强大了！"],"enUS":["I'm stronger!"],"jaJP":["強く…なれただろうか…"]},"keys":["cv_tanker_LevelUp"]},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["有点吃不消。"],"enUS":["This is too much for me."],"jaJP":["俺に？勿体なく無いか？"]},"keys":["cv_tanker_EquipWeapon"]},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["我觉得我穿起来好像一只鸡。"],"enUS":["I feel like a chicken."],"jaJP":["まるでチキンだな"]},"keys":["cv_tanker_EquipCostume"]},{"type":"Evolve","label":"进化","texts":{"zhCN":["人生，即使跌宕起伏，也要百折不挠。"],"enUS":["Life is all about taking a hit and still moving forward."],"jaJP":["人生、七転び八起きっていうからな"]},"keys":["cv_tanker_Evolve"]},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["哈！"],"enUS":["Haat!"],"jaJP":["はっ！"]},"keys":["cv_tanker_Attack1"]},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["呼！"],"enUS":["Raah!"],"jaJP":["ふっ！"]},"keys":["cv_tanker_Attack2"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["过来！"],"enUS":["Come!"],"jaJP":["来い！"]},"keys":["cv_tanker_Attack3"]},{"type":"Skill1","label":"技能1","texts":{"zhCN":["这边！"],"enUS":["There!"],"jaJP":["ここだ！"]},"keys":["cv_tanker_Skill1"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["来个大的！"],"enUS":["Here comes the big one!"],"jaJP":["どーんと行くぞ！"]},"keys":["cv_tanker_Skill2"]},{"type":"Damaged1","label":"受到攻击1","texts":{"zhCN":["呃啊！"],"enUS":["Ugh!"],"jaJP":["くっ！"]},"keys":["cv_tanker_Damaged1"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["过来啊！"],"enUS":["Come on!"],"jaJP":["カモーン！"]},"keys":["cv_tanker_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["善恶终有报，天道有轮回。多简单的道理啊！"],"enUS":["Do good and good will come to you. It's simple math."],"jaJP":["良い行いをすれば良いことが起きる、自然なことさ"]},"keys":["cv_tanker_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["苍天饶过谁，你会有报应的。"],"enUS":["This is going to come back at you."],"jaJP":["今の行い、いつか君に返ってくるぞ"]},"keys":["cv_tanker_PlayerChooseDark"]},{"type":"WeakEnemyBattleStart","label":"与弱小敌人战斗","texts":{"zhCN":["别太勉强。"],"enUS":["Don't push yourself."],"jaJP":["こんなところで無理をするな"]},"keys":["cv_tanker_WeakEnemyBattleStart"]},{"type":"NormalEnemyBattleStart","label":"与普通敌人战斗","texts":{"zhCN":["快点收拾。"],"enUS":["Let's clean this up."],"jaJP":["手早く片付けよう"]},"keys":["cv_tanker_NormalEnemyBattleStart"]},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["恐惧就像烈火一样…炙热。"],"enUS":["Fear is like fire… It consumes."],"jaJP":["恐怖は炎のようなものさ、ああ…熱いな…"]},"keys":["cv_tanker_StrongEnemyBattleStart"]},{"type":"BossBattleStart","label":"与首领战斗","texts":{"zhCN":["我…我也能做到…！"],"enUS":["I… I can still achieve something!"],"jaJP":["俺にも… 俺にも何かができるはずだ…！"]},"keys":["cv_tanker_BossBattleStart"]},{"type":"JoinParty","label":"首次加入队伍","texts":{"zhCN":["谢谢你等着我，谢谢你愿意相信我。"],"enUS":["Thank you for waiting for me. For believing in me."],"jaJP":["ありがとうな、信じて待っていてくれて"]},"keys":["cv_tanker_JoinParty"]},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["趁现在！"],"enUS":["Now!"],"jaJP":["今だ！"]},"keys":["cv_tanker_CoopAttack"]},{"type":"CoopHeal","label":"战斗-请求治疗","texts":{"zhCN":["辅助！"],"enUS":["Healer!"],"jaJP":["ヒーラー！"]},"keys":["cv_tanker_CoopHeal"]},{"type":"CoopRun","label":"战斗-注意","texts":{"zhCN":["都躲到我身后！"],"enUS":["Everyone get behind me!"],"jaJP":["皆、俺の後ろに！"]},"keys":["cv_tanker_CoopRun"]},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["是大家的功劳。"],"enUS":["It's all thanks to you."],"jaJP":["皆のおかげだ"]},"keys":["cv_tanker_CoopWin"]},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["即使身衰梦碎，但此刻…"],"enUS":["Moments like this keeps me going…!"],"jaJP":["身も心も色あせてしまったが…この瞬間だけは…"]},"keys":["cv_tanker_CoopMVP"]},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["知道自己该做什么，就要做，不是吗？"],"enUS":["You know what to do, all you gotta do is act on it."],"jaJP":["成すべきことが分かったなら、あとは挑むしかないだろう？"]},"keys":["cv_tanker_CoopHi"]},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["快点，朋友。"],"enUS":["Hurry, my friend."],"jaJP":["急げよ、相棒"]},"keys":["cv_tanker_CoopHurryUp"]},{"type":"CoopBelieve","label":"战斗-信任","texts":{"zhCN":["我不擅长唱歌跳舞，但举盾牌还是比较拿手的。"],"enUS":["I can't dance or sing. But I can shield."],"jaJP":["歌も踊りもできないが、盾役なら任せておけ"]},"keys":["cv_tanker_CoopBelieve"]},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["是什么？"],"enUS":["What is it?"],"jaJP":["なんだ？"]},"keys":["Voice_tanker_1_TouchReactionGood1","cv_tanker_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["我听着呢。"],"enUS":["I'm listening."],"jaJP":["聞いてるさ"]},"keys":["Voice_tanker_1_TouchReactionGood2","cv_tanker_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["不要打扰我。"],"enUS":["Don't bother me."],"jaJP":["邪魔しないでくれよ"]},"keys":["Voice_tanker_1_TouchReactionBad1","cv_tanker_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["(叹气)唉。"],"enUS":["(sigh)"],"jaJP":["はぁ…"]},"keys":["Voice_tanker_1_TouchReactionBad2","cv_tanker_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["新邮件，快点确认。"],"enUS":["You've got mail. Read it promptly."],"jaJP":["メールだぞ、早く見てやれよ"]},"keys":["Voice_tanker_1_NoticeMail","cv_tanker_NoticeMail"]},{"type":"NoticeEvent","label":"活动提示","texts":{"zhCN":["有活动。坚持到底。"],"enUS":["It's an event. Let's give it our best."],"jaJP":["イベントだ、行けるところまで行ってみようじゃないか"]},"keys":["cv_tanker_NoticeEvent"]}]}]}
