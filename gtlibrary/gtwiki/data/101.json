1288],"grows":true},{"name":"火属性攻击","values":[175,192],"baseValues":[175.100000034,192.26666670400002],"grows":true},{"name":"暴击率","values":[15,15],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"技能伤害值","min":4.0,"max":15.0,"unit":"%"},{"name":"武器技能恢复速度","min":4.0,"max":10.0,"unit":"%"},{"name":"生命","min":4.0,"max":12.0,"unit":"%"}],"subOptions":[{"name":"防御","min":3.0,"max":6.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"千柄剑","description":"东方剑术最后一击伤害提升50%，附带无限剑击，造成范围伤害。"}],"skill":{"name":"赤鬼","description":"释放封印的鬼怪威力，对敌人造成伤害，并附带重伤效果。","levels":[2,5],"damage":[205.0,250.0],"cooldown":[8.0,6.5],"ailment":"重伤"}}],"number":1}],"profile":{"Age":null,"Height":[163],"Weight":[48]},"tribes":["人类"],"story":"赤雪，游历世界的剑士。\n\n化身石像500年之久，苏醒之后，对变化万千的世界感到陌生。相反，对其他人完全不知的过往世界倒是了如指掌。面对与以往不同的新武器与战斗方式，不加深思，用过去传统方式与习惯投入战斗，豪放不羁的过去世界剑士。\n\n无论过去，还是现在，赤雪浪迹天涯的目的只有一个，就是与强者对决。只要有机会，便不顾一切挑战强者，每次交战都会全力以赴。性格豪爽，败在实力派强者手上，毫无怨言。淳朴善良的赤雪的爱好仅仅是与强者较量。","storyKey":"profile_akayuki_story","sources":{"hero":"heroes.json / OriginId=101","profile":"heroprofile.json / OriginId=101","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}