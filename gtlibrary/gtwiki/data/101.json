1288],"grows":true},{"name":"火属性攻击","values":[175,192],"baseValues":[175.100000034,192.26666670400002],"grows":true},{"name":"暴击率","values":[15,15],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"技能伤害值","min":4.0,"max":15.0,"unit":"%"},{"name":"武器技能恢复速度","min":4.0,"max":10.0,"unit":"%"},{"name":"生命","min":4.0,"max":12.0,"unit":"%"}],"subOptions":[{"name":"防御","min":3.0,"max":6.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"千柄剑","description":"东方剑术最后一击伤害提升50%，附带无限剑击，造成范围伤害。"}],"skill":{"name":"赤鬼","description":"释放封印的鬼怪威力，对敌人造成伤害，并附带重伤效果。","levels":[2,5],"damage":[205.0,250.0],"cooldown":[8.0,6.5],"ailment":"重伤"}}],"number":1}],"profile":{"Age":null,"Height":[163],"Weight":[48]},"tribes":["人类"],"story":"赤雪，游历世界的剑士。\n\n化身石像500年之久，苏醒之后，对变化万千的世界感到陌生。相反，对其他人完全不知的过往世界倒是了如指掌。面对与以往不同的新武器与战斗方式，不加深思，用过去传统方式与习惯投入战斗，豪放不羁的过去世界剑士。\n\n无论过去，还是现在，赤雪浪迹天涯的目的只有一个，就是与强者对决。只要有机会，便不顾一切挑战强者，每次交战都会全力以赴。性格豪爽，败在实力派强者手上，毫无怨言。淳朴善良的赤雪的爱好仅仅是与强者较量。","storyKey":"profile_akayuki_story","sources":{"hero":"heroes.json / OriginId=101","profile":"heroprofile.json / OriginId=101","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"akayuki","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["下一个！哦…这么快就结束了？"],"enUS":["Next! What, that was it?"],"jaJP":["次！あれ… もう終わり？"]},"keys":["cv_akayuki_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["好久没有尽情战斗了！"],"enUS":["This was the best fight I've had in a while!"],"jaJP":["久しぶりに思いっきり戦えたよ！"]},"keys":["cv_akayuki_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["青…雪…"],"enUS":["Ao…yuki…"],"jaJP":["アオ… ユキ…"]},"keys":["cv_akayuki_Die"]},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["我知道！这是经验结晶！"],"enUS":["I know this! It's Exp… Rright?"],"jaJP":["私、これ知ってる！経験値ってやつでしょ？"]},"keys":["cv_akayuki_GetExp"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["嗯…如果我变得太强，找到值得一战的对手可能会变得很难…"],"enUS":["Hmph. If I get too strong, it might get harder to find worthy opponents."],"jaJP":["んー、あまり強くなりすぎると、強い敵と戦えなくなっちゃうんだよね…"]},"keys":["cv_akayuki_LevelUp"]},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["哇，这么好？谢谢！"],"enUS":["Pretty nice. Thank you!"],"jaJP":["わあ、いいね！ありがとう！"]},"keys":["cv_akayuki_EquipWeapon"]},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["嗯…时装还不都是一样的？"],"enUS":["Hmm. I never understood fashion."],"jaJP":["んー、服ってどれも一緒じゃないの？"]},"keys":["cv_akayuki_EquipCostume"]},{"type":"Evolve","label":"进化","texts":{"zhCN":["长见识了！"],"enUS":["I just had elightenment!"],"jaJP":["新しく目が覚めたような気分…！"]},"keys":["cv_akayuki_Evolve"]},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["哈啊！"],"enUS":["Haat!"],"jaJP":["はあっ！"]},"keys":["cv_akayuki_Attack1"]},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["喝啊！"],"enUS":["Hut!"],"jaJP":["ふっ！"]},"keys":["cv_akayuki_Attack2"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["嘿！"],"enUS":["There!"],"jaJP":["そこっ！"]},"keys":["cv_akayuki_Attack3"]},{"type":"Skill1","label":"技能1","texts":{"zhCN":["战斗！"],"enUS":["Batto!"],"jaJP":["抜刀！"]},"keys":["cv_akayuki_Skill1"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["我来了，村雨！"],"enUS":["Here we go, Murasame!"],"jaJP":["いくよ、ムラサメ！"]},"keys":["cv_akayuki_Skill2"]},{"type":"Damaged1","label":"受到攻击1","texts":{"zhCN":["切…！"],"enUS":["Heh…!"],"jaJP":["ちっ…！"]},"keys":["cv_akayuki_Damaged1"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["就凭这些…！"],"enUS":["This is nothing!"],"jaJP":["この程度で…！"]},"keys":["cv_akayuki_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["这是你的选择。我希望能和更多强者战斗！"],"enUS":["Well, it's your choice. I hope this gets us a lot of good fights!"],"jaJP":["なんとかなるよ\nああ、強い人にいーっぱい会えるといいな！"]},"keys":["cv_akayuki_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["嗯…我觉得你在走险路。"],"enUS":["Hmm… I feel you are walking on a thin line there…"],"jaJP":["ん…？そういうのって良く無い気がするんだけど…"]},"keys":["cv_akayuki_PlayerChooseDark"]},{"type":"WeakEnemyBattleStart","label":"与弱小敌人战斗","texts":{"zhCN":["发现敌人！哎…好弱。"],"enUS":["Enemies spotted ahead! Aww, they look so weak!"],"jaJP":["敵発見！うーん… 弱くて相手にならないね"]},"keys":["cv_akayuki_WeakEnemyBattleStart"]},{"type":"NormalEnemyBattleStart","label":"与普通敌人战斗","texts":{"zhCN":["好！旗鼓相当！"],"enUS":["Ok, not too bad."],"jaJP":["よし、相手にとって不足なし！"]},"keys":["cv_akayuki_NormalEnemyBattleStart"]},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["强大的敌人！让开，他是我的。"],"enUS":["Strong enemies! Everybody move! They are mine!"],"jaJP":["強敵発見！\nみんなどいて、あいつは私が相手をするから！"]},"keys":["cv_akayuki_StrongEnemyBattleStart"]},{"type":"BossBattleStart","label":"与首领战斗","texts":{"zhCN":["和首领战斗？跟你同行果然是正确的选择。"],"enUS":["A boss to fight? I made the right choice to follow you!"],"jaJP":["ボスだね、やっぱり君についてきて正解だったよ！"]},"keys":["cv_akayuki_BossBattleStart"]},{"type":"JoinParty","label":"首次加入队伍","texts":{"zhCN":["和你在一起，应该能遇到更多强敌！"],"enUS":["I feel like you'll lead me into lots of good fights!"],"jaJP":["君と一緒なら強い相手とたくさん会えそうだね！"]},"keys":["cv_akayuki_JoinParty"]},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["不要犹豫，攻击！"],"enUS":["Don't hesitate, attack!"],"jaJP":["迷わず突撃ー！"]},"keys":["cv_akayuki_CoopAttack"]},{"type":"CoopHeal","label":"战斗-请求治疗","texts":{"zhCN":["等，等一下，先帮我治疗！"],"enUS":["I need a healer!"],"jaJP":["ま、待って！回復をお願い！"]},"keys":["cv_akayuki_CoopHeal"]},{"type":"CoopRun","label":"战斗-注意","texts":{"zhCN":["杀气…！后退！"],"enUS":["I sense danger… Step back!"],"jaJP":["殺気が…！みんな下がって！"]},"keys":["cv_akayuki_CoopRun"]},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["这么多高手…是不是很刺激？"],"enUS":["Isn't it thrilling that there are so many strong foes out there to fight?"],"jaJP":["世の中、強い相手がいっぱいいるなー、ワクワクするよね！"]},"keys":["cv_akayuki_CoopWin"]},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["这代表我是最强的战士对吗？噢，谢谢！"],"enUS":["Does this mean I was the best fighter? Thanks!"],"jaJP":["この戦、一番手柄を上げたのは私だー！ありがとー！"]},"keys":["cv_akayuki_CoopMVP"]},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["请多关照，记得最强的要留给我处理。"],"enUS":["Let's do this everyone! And make sure you leave the strongest for me!"],"jaJP":["みんなよろしくね！一番強い敵は私がやるから！"]},"keys":["cv_akayuki_CoopHi"]},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["再磨蹭，就丢下你先走了？！"],"enUS":["Move! Or I'm leaving you behind!"],"jaJP":["おいて行っちゃうよ？"]},"keys":["cv_akayuki_CoopHurryUp"]},{"type":"CoopBelieve","label":"战斗-信任","texts":{"zhCN":["都让开！我来对付他！"],"enUS":["Everybody move! He's mine!"],"jaJP":["退いて退いて！アイツは私のものだから！"]},"keys":["cv_akayuki_CoopBelieve"]},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["嗯…好无聊…好想找个对手尽情战斗！"],"enUS":["I'm bored… I want a good fight!"],"jaJP":["暇だなあ…歯ごたえのある相手と戦いたいよお"]},"keys":["Voice_akayuki_1_TouchReactionGood1","cv_akayuki_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["咦？我是不喜欢太复杂的东西，但应该也不傻。应该吧…？"],"enUS":["Well… I do like to keep things simple. But I'm not stupid. Probably."],"jaJP":["たしかに私、難しいことは分からないけど、バカではないから！多分"]},"keys":["Voice_akayuki_1_TouchReactionGood2","cv_akayuki_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["再烦我，我要打你了！"],"enUS":["Stop fooling around!"],"jaJP":["あんまり調子に乗ってると怒るよ？"]},"keys":["Voice_akayuki_1_TouchReactionBad1","cv_akayuki_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["500年了…青雪还活着吗？"],"enUS":["It has been 500 years… Is Aoyuki still alive?"],"jaJP":["500年か… アオユキはどこかで生きてるのかな？"]},"keys":["Voice_akayuki_1_TouchReactionBad2","cv_akayuki_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["邮件！我能一起看看吗？"],"enUS":["You got new mail! Can I read it with you?"],"jaJP":["わっ！手紙だって、私も一緒に読んでいい？","わっ！手紙だって私も一緒に読んでいい？"]},"keys":["Voice_akayuki_1_NoticeMail","cv_akayuki_NoticeMail"]},{"type":"NoticeEvent","label":"活动提示","texts":{"zhCN":["有活动！会有很多强大的敌人！对吧？"],"enUS":["An event! There will be a lot of strong fighters there, right?"],"jaJP":["イベントがはじまってるよ！\nきっと強い相手がたくさんいるよね？"]},"keys":["cv_akayuki_NoticeEvent"]}]}]}
