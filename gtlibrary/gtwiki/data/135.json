.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"报复","description":"命中目标时，攻击与暴击率以40%概率提升4%并持续5秒，但防御以相同概率减免4%并持续相同时间。该效果最多重叠5次。"}],"skill":{"name":"善变的淑女","description":"凝聚周围能量，对敌人造成伤害，并附带击倒效果。","levels":[2,5],"damage":[195.0,255.0],"cooldown":[9.9,9.0],"ailment":"击倒"}}],"number":1}],"profile":{"Age":[23],"Height":[162],"Weight":[48]},"tribes":["人类"],"story":"艾米，身穿仆人服的雇佣兵。\n\n艾米身上的这套仆人服并不是自愿穿上的，是谎称宫廷魔法师的搭档道尔夫为了演戏不露马脚而要求的。\n\n长期穿着不喜欢的服装，还要配合虚有其表的懒鬼道尔夫演戏，导致精神压力过大。总是一副冷漠阴沉的表情，时常低声嘟囔。与对手交战时，之前积累的压力得到释放，露出可怕面孔，变成另外一个人。毫无疑问，战斗中的艾米是名副其实的狂暴战士。挥舞巨剑如使用木棍般轻松自如，拥有非凡的腕力。吼声震慑四方，拥有超强战斗力，乐于交战，都令人毛骨悚然。","storyKey":"profile_maid_story","sources":{"hero":"heroes.json / OriginId=135","profile":"heroprofile.json / OriginId=135","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"maid","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["本想再猖狂一些…"],"enUS":["I wanted to fight more…"],"jaJP":["もっと暴れたかったな…"]},"keys":["cv_maid_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["你以为你是谁…"],"enUS":["I'm warning you… Don't mess with me!"],"jaJP":["ふざけんな！まだ…もっと…！"]},"keys":["cv_maid_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["道尔夫…快跑…"],"enUS":["Dolf… Run…"],"jaJP":["ドルフ… 逃げて…"]},"keys":["cv_maid_Die"]},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["我真的可以收下吗？"],"enUS":["Can I really take this?"],"jaJP":["こ、こんなにもらって…いいの…？"]},"keys":["cv_maid_GetExp"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["精力充沛…"],"enUS":["I feel so powerful…"],"jaJP":["力が…溢れてくる…"]},"keys":["cv_maid_LevelUp"]},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["这触感…好喜欢…"],"enUS":["I like the way it feels…"],"jaJP":["こういうの…好き、かも…"]},"keys":["cv_maid_EquipWeapon"]},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["这次要穿上这个…？别闹了…！"],"enUS":["You want me to wear this? Cut it out!"],"jaJP":["こ、こんどはこれを着ろって…？いいかげんにしろよっ！"]},"keys":["cv_maid_EquipCostume"]},{"type":"Evolve","label":"进化","texts":{"zhCN":["想马上战斗…！"],"enUS":["I want to battle, now!"],"jaJP":["あああああ、今すぐ戦いに行きたいっ……！"]},"keys":["cv_maid_Evolve"]},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["我会把你们全部摧毁！"],"enUS":["I will destroy you all!"],"jaJP":["ぶっ壊してやる！"]},"keys":["cv_maid_Attack1"]},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["呃啊啊！"],"enUS":["Haaa!"],"jaJP":["くあああ！"]},"keys":["cv_maid_Attack2"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["哈啊啊呀！"],"enUS":["Naaaah!"],"jaJP":["はあああっ！"]},"keys":["cv_maid_Attack3"]},{"type":"Skill1","label":"技能1","texts":{"zhCN":["这就是你最好的状态了吗？"],"enUS":["Ahaha! Is this your best?!"],"jaJP":["ははっ、その程度か！"]},"keys":["cv_maid_Skill1"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["我要用我的存在来否定你！"],"enUS":["I will deny you with all my being!"],"jaJP":["私の存在をかけて、お前を否定してやる！"]},"keys":["cv_maid_Skill2"]},{"type":"Damaged1","label":"受到攻击1","texts":{"zhCN":["呃啊…！"],"enUS":["Ugh…!"],"jaJP":["くうぅ…！"]},"keys":["cv_maid_Damaged1"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["呃…还不…！"],"enUS":["Ugh, not yet!"],"jaJP":["まだだ…！"]},"keys":["cv_maid_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["啊…真的…？"],"enUS":["Really…?"],"jaJP":["本当に…？"]},"keys":["cv_maid_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["果然，没错。"],"enUS":["I knew you'd do that."],"jaJP":["…そうだと思った"]},"keys":["cv_maid_PlayerChooseDark"]},{"type":"WeakEnemyBattleStart","label":"与弱小敌人战斗","texts":{"zhCN":["这些你就自己处理吧？"],"enUS":["Haha, handle these weakings yourself!"],"jaJP":["この程度の雑魚、お前が片付けろよ…っ！"]},"keys":["cv_maid_WeakEnemyBattleStart"]},{"type":"NormalEnemyBattleStart","label":"与普通敌人战斗","texts":{"zhCN":["还不错！"],"enUS":["Let's go wild!"],"jaJP":["いいな、邪魔するなよ！"]},"keys":["cv_maid_NormalEnemyBattleStart"]},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["有点强…开始战斗吧！"],"enUS":["They're strong… Let's rumble!!"],"jaJP":["楽な相手じゃない…関係ないけどな！"]},"keys":["cv_maid_StrongEnemyBattleStart"]},{"type":"BossBattleStart","label":"与首领战斗","texts":{"zhCN":["还不错…但比起我，你不算什么。"],"enUS":["A boss…? But you're nothing compared to me! Ahahahaha!"],"jaJP":["こいつが、ボス…けど、私の敵じゃねえなあ！"]},"keys":["cv_maid_BossBattleStart"]},{"type":"JoinParty","label":"首次加入队伍","texts":{"zhCN":["道尔夫，这是…新工作？"],"enUS":["Dolf, is this… Our new employer?"],"jaJP":["ドルフ、これから… ここで働くの？"]},"keys":["cv_maid_JoinParty"]},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["除掉他们！"],"enUS":["Kill them all!"],"jaJP":["まとめてぶっ潰せ！"]},"keys":["cv_maid_CoopAttack"]},{"type":"CoopHeal","label":"战斗-请求治疗","texts":{"zhCN":["快！帮我治疗！"],"enUS":["Heal me! Hurry!"],"jaJP":["回復しろ！早く！"]},"keys":["cv_maid_CoopHeal"]},{"type":"CoopRun","label":"战斗-注意","texts":{"zhCN":["你！让开！"],"enUS":["There! Move!"],"jaJP":["そこを退けぇぇぇ！"]},"keys":["cv_maid_CoopRun"]},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["呼呜…没意思。"],"enUS":["Phew! That was easy."],"jaJP":["はぁー…こんなものか…"]},"keys":["cv_maid_CoopWin"]},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["还，还要再来一场…！"],"enUS":["More… I want more…!"],"jaJP":["まだまだ暴れたりないんだよっ！"]},"keys":["cv_maid_CoopMVP"]},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["拜托了…我不想后悔！"],"enUS":["Let's make this work… If you don't want to regret it!"],"jaJP":["よろしく、お願いします…ちゃんとヤレよ…！？"]},"keys":["cv_maid_CoopHi"]},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["再快一点…"],"enUS":["Hurry up…"],"jaJP":["まだ、ですかね…"]},"keys":["cv_maid_CoopHurryUp"]},{"type":"CoopBelieve","label":"战斗-信任","texts":{"zhCN":["我来解决…"],"enUS":["I'll take care of it… Everyone move!"],"jaJP":["私に任せて…巻き込まれてもしらねえぞ！！"]},"keys":["cv_maid_CoopBelieve"]},{"type":"TouchReactionGood1","label":"