.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"报复","description":"命中目标时，攻击与暴击率以40%概率提升4%并持续5秒，但防御以相同概率减免4%并持续相同时间。该效果最多重叠5次。"}],"skill":{"name":"善变的淑女","description":"凝聚周围能量，对敌人造成伤害，并附带击倒效果。","levels":[2,5],"damage":[195.0,255.0],"cooldown":[9.9,9.0],"ailment":"击倒"}}],"number":1}],"profile":{"Age":[23],"Height":[162],"Weight":[48]},"tribes":["人类"],"story":"艾米，身穿仆人服的雇佣兵。\n\n艾米身上的这套仆人服并不是自愿穿上的，是谎称宫廷魔法师的搭档道尔夫为了演戏不露马脚而要求的。\n\n长期穿着不喜欢的服装，还要配合虚有其表的懒鬼道尔夫演戏，导致精神压力过大。总是一副冷漠阴沉的表情，时常低声嘟囔。与对手交战时，之前积累的压力得到释放，露出可怕面孔，变成另外一个人。毫无疑问，战斗中的艾米是名副其实的狂暴战士。挥舞巨剑如使用木棍般轻松自如，拥有非凡的腕力。吼声震慑四方，拥有超强战斗力，乐于交战，都令人毛骨悚然。","storyKey":"profile_maid_story","sources":{"hero":"heroes.json / OriginId=135","profile":"heroprofile.json / OriginId=135","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}