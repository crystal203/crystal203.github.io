x":18.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":8.0,"max":20.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"命中目标时，在被命中的敌人身上刻下目标标记，使其攻击减免10%并持续6秒。\n对生命低于50%的敌人造成的伤害值提升30%。\n脉冲炮塔的生命为0时立即爆炸，按照每秒伤害的100%造成额外远程伤害，脉冲炮塔技能恢复时间减少3秒。"}],"skill":{"name":"超能核心光束","description":"发射激光，对敌人造成远程伤害并附带重伤效果。","levels":[1,5],"damage":[170.0,250.0],"cooldown":[10.0,8.4],"ailment":"重伤"}},{"id":9030555,"code":"cwp_twinsandroid_myth","label":"开花","stars":6,"sprite":{"sheet":"items","name":"cwp_twinsandroid_myth"},"stats":[{"name":"每秒伤害","values":[727,798],"baseValues":[726.5664000000003,797.7984000000004],"grows":true},{"name":"暗属性攻击","values":[272,299],"baseValues":[272.4624,299.17440000000005],"grows":true},{"name":"暴击率","values":[12,12],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"防御","min":8.0,"max":20.0,"unit":"%"},{"name":"生命","min":8.0,"max":18.0,"unit":"%"},{"name":"技能伤害值","min":6.0,"max":18.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":8.0,"max":20.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"命中目标时，在被命中的敌人身上刻下目标标记，使其攻击减免10%并持续6秒。\n对生命低于50%的敌人造成的伤害值提升30%。\n脉冲炮塔的生命为0时立即爆炸，按照每秒伤害的120%造成额外远程伤害，脉冲炮塔技能恢复时间减少4秒。"}],"skill":{"name":"超能核心光束","description":"发射激光，对敌人造成远程伤害并附带重伤效果。","levels":[1,5],"damage":[280.0,280.0],"cooldown":[10.0,8.4],"ailment":"重伤"}}],"number":1}],"profile":{"Age":null,"Height":[168],"Weight":[50]},"tribes":["机器人"],"story":"双胞胎机器人妮芙缇，是赛博机器人科技专项研发的双胞胎模型机器人之一，作为秘书助理辅佐赛博机器人科技CEO的日常工作。\n\n妮芙缇和她的双胞胎姐妹斯芙缇，共同执行秘书的工作，同时，她们也会代替忙碌的CEO处理公司的整体运营业务。因为是双胞胎机器人，妮芙缇与斯芙缇被设计成了相似的结构，但她们搭载的人工智能却完全不同。妮芙缇注重找出问题解决过程中存在的多种可能性，而斯芙缇则注重于问题解决的效率。CEO认为，如果这两个人工智能一起处理业务，就能通过互补达成完美。因此，CEO给妮芙缇与斯芙缇下达了“永远合作”的指令。\n\n不过，妮芙缇与斯芙缇有时也会像普通的姐妹一样吵架，每当她们争吵不休，工作效率就会急速下降。而最容易引发争执的话题就是“谁才是姐姐”，两名机器人都各执己见，声称自己才是姐姐。妮芙缇主张她的机器人身体是比斯芙缇更早制造出来的，而斯芙缇则强调她的人工智能要比妮芙缇更早研发完成。这场争执严重影响了她们的整体工作，CEO见状表示“今后会根据工作效率来决定谁是姐姐”。自那以后，两名机器人的工作效率竟然飙升到了原来的三倍以上。\n\n现在的妮芙缇与斯芙缇因为发色不同，所以很容易区分，但起初她们的发色是完全相同的。当时，为了激发两名机器人的竞争意识，CEO故意叫反了她们的名字，受到打击的两名机器人第二天就把头发染成了不同的颜色。","storyKey":"profile_twins_android_story","sources":{"hero":"heroes.json / OriginId=632","profile":"heroprofile.json / OriginId=632","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"twins_android","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["索赔，请联系斯芙缇。"],"enUS":["Please contact Shifty to file for damages."],"jaJP":["損害賠償については、シフティを通して請求してください"]},"keys":["cv_twins_android_NormalBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/632/6320001@-4259159745154043279"],"enUS":["cdn/Android/ondemand/voices_en/632/6320001"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/632/6320001@795804418244311933"]},"audioName":"6320001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["你不适合在新世界中存活。"],"enUS":["You do not fit in the new world."],"jaJP":["あなたは新世界に相応しくありません"]},"keys":["cv_twins_android_BossBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/632/6320002@-7685869053747944753"],"enUS":["cdn/Android/ondemand/voices_en/632/6320002"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/632/6320002@7872465243471958906"]},"audioName":"6320002"},{"type":"Die","label":"阵亡","texts":{"zhCN":["父亲的计划…还…没有…"],"enUS":["Fathe