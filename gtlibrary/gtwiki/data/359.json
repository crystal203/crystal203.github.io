hRate":1.02,"mainOptions":[{"name":"恢复能力","min":8.0,"max":20.0,"unit":"%"},{"name":"技能伤害值","min":8.0,"max":20.0,"unit":"%"},{"name":"生命","min":6.0,"max":16.0,"unit":"%"}],"subOptions":[{"name":"防御","min":6.0,"max":16.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"恢复能力","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"热情之风技能命中目标时，按照每秒伤害的20%，造成额外伤害，若命中队员，则按照恢复能力的10%恢复生命。"}],"skill":{"name":"火趁风威","description":"掷出三向火扇再收回，造成伤害，并附带击飞效果。","levels":[3,6],"damage":[220.0,280.0],"cooldown":[8.4,7.5],"ailment":"击飞"}}],"number":1}],"profile":{"Age":[22],"Height":[166],"Weight":[50]},"tribes":["人类"],"story":"美娅是操纵式神击退恶灵的驱魔师。\n\n美娅作为与生俱来拥有超强灵力的驱魔世家后裔，肩负着净化世间万恶并成就人间乐土的使命。美娅经常能碰上凡人看不到的鬼怪妖精。她会规劝尚未修炼成精的妖怪鬼神，或对具有威胁性的强悍恶鬼进行驱魔仪式，使其从善成佛。虽然在人生中面对来自阴暗世界生物的机会很多，但美娅是一个乐观开朗、亲切友善的实力派驱魔师。\n\n人无完人，沉迷于娱乐是美娅唯一的缺点。每次成功完成大型驱魔仪式之后，美娅的家人都会依照传统举办庆典，以抚慰得到净化的灵魂，使其安息，并让世人感受幸福快乐。长辈们秉持“世间万物皆该善始善终”这一原则而坚持家族习俗，却未曾想到，美娅会深陷其中，不能自已。小美娅被灯火明亮、歌声缭绕、烟花四放、娱乐无穷的庆典深深吸引，魂不守舍。\n\n美娅背着妈妈，偷偷跑去参加邻村庆典，在那里她经历了人生第一次博彩。多亏隔壁家阿姨发现了她并把她带离现场，要不然只赢两局输掉六局的美娅可能连回家的路费也要押上了。美娅无法忘却当时紧张刺激的感觉，终于按奈不住，瞒着长辈将祖传家宝拿去当筹码，不慎将家人操纵的式神散落到世界各地。奶奶命美娅找回所有式神，在完成任务之前，不得踏进家门一步。但是，离家远行的美娅执迷不悟，异想天开地认为“只要在大局中赢得头筹”定能一举寻回所有式神，对博彩流连忘返。利用驱魔仪式赚钱，转身又在博彩中输得精光，落得两手空空的美娅总会埋怨在一旁支招的鬼怪们。","storyKey":"profile_festival_girl_story","sources":{"hero":"heroes.json / OriginId=359","profile":"heroprofile.json / OriginId=359","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}