":"3590027"},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["若我们并肩作战，你要照顾好自己哦？"],"enUS":["Try not to die!"],"jaJP":["一緒に戦うというなら、お願いですから死なないでくださいね？"]},"keys":["cv_festival_girl_CoopHi"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/359/3590028@-8689957533582037227"],"enUS":["cdn/Android/ondemand/voices_en/359/3590028"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/359/3590028@7162123977606212966"]},"audioName":"3590028"},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["趁恶灵们还没有完全抓狂之前，快点！"],"enUS":["Come on, before the enemies go wild!"],"jaJP":["急いでください、悪霊たちが暴れだす前に！"]},"keys":["cv_festival_girl_CoopHurryUp"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/359/3590029@7009997779426673674"],"enUS":["cdn/Android/ondemand/voices_en/359/3590029"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/359/3590029@3666174031121339154"]},"audioName":"3590029"},{"type":"CoopBelieve","label":"战斗-信任","texts":{"zhCN":["与恶灵的战斗，就包在我美娅身上！"],"enUS":["I'll take care of the fights with the dead!"],"jaJP":["亡者たちとの闘いなら、私、ミヤがいきます！"]},"keys":["cv_festival_girl_CoopBelieve"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/359/3590030@-4128250698680699528"],"enUS":["cdn/Android/ondemand/voices_en/359/3590030"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/359/3590030@-2978956758335166495"]},"audioName":"3590030"},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["难以放弃博彩！这世界充满机遇，怎么能装作不知道！"],"enUS":["What…?! Quit gambling? How can I simply ignore the endless possibilities in this world?!"],"jaJP":["賭け事を辞めろ…？世界にはこんなにも可能性が満ちあふれているのに、それを閉ざしてしまうだなんて！"]},"keys":["Voice_festival_girl_1_TouchReactionGood1","cv_festival_girl_TouchReactionGood1"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/359/3590031@-8095858949385077006"],"enUS":["cdn/Android/ondemand/voices_en/359/3590031"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/359/3590031@6744013908539449060"]},"audioName":"3590031"},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["庆典处处可见生活的滋味和朝气，还少不了博彩！"],"enUS":["There's so much energy and life in festivals. And also gambling!"],"jaJP":["お祭りには命の匂いと活気、そしてスリル満点のギャンブルがあります！"]},"keys":["Voice_festival_girl_1_TouchReactionGood2","cv_festival_girl_TouchReactionGood2"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/359/3590032@-3062159978380957833"],"enUS":["cdn/Android/ondemand/voices_en/359/3590032"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/359/3590032@6292937290977346299"]},"audioName":"3590032"},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["好生气，我又输了！但是…无所谓，这就是博彩的魅力所在！"],"enUS":["I lost money again! It's so… It's so frustrating, but… This is what gambling is!"],"jaJP":["また溶かしてしまいました、悔しい！でも… 賭け事はこうでなくちゃですね！"]},"keys":["Voice_festival_girl_1_TouchReactionBad1","cv_festival_girl_TouchReactionBad1"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/359/3590033@-4348480872387507466"],"enUS":["cdn/Android/ondemand/voices_en/359/3590033"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/359/3590033@661724779890815740"]},"audioName":"3590033"},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["虽然我能遇佛杀佛，遇魔杀魔，但却总是赌输！古人有云，厨子多了煮坏汤，木匠多了盖歪房。人多嘴杂，都怪旁边支招的人太多！"],"enUS":["How can I lose money in gambling, when I see ghosts? Too many cooks spoil the broth, you know!"],"jaJP":["霊が見えるのにどうして賭け事に負けるのか、ですか？「船頭多くして船、山に登る」と申しまして…"]},"keys":["Voice_festival_girl_1_TouchReactionBad2","cv_festival_girl_TouchReactionBad2"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/359/3590034@1918767075236604114"],"enUS":["cdn/Android/ondemand/voices_en/359/3590034"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/359/3590034@-4321241861083346547"]},"audioName":"3590034"},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["收到邮件！会有什么好消息呢～？"],"enUS":["There's mail! What news can it be?"],"jaJP":["メールが届いてますよ！内容は…っと"]},"keys":["Voice_festival_