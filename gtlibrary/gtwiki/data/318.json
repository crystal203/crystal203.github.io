[{"id":9050484,"code":"cwp_flowergirl2_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_flowergirl2"},"stats":[{"name":"每秒伤害","values":[557,612],"baseValues":[556.9200000000001,611.52],"grows":true},{"name":"土属性攻击","values":[134,147],"baseValues":[133.875,147.0],"grows":true},{"name":"暴击率","values":[4,4],"unit":"%"},{"name":"恢复能力","values":[206,206],"baseValues":[206,206],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"技能伤害值","min":8.0,"max":20.0,"unit":"%"},{"name":"武器技能恢复速度","min":6.0,"max":18.0,"unit":"%"},{"name":"生命","min":6.0,"max":16.0,"unit":"%"}],"subOptions":[{"name":"防御","min":6.0,"max":18.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"佩戴武器时，英雄的职业技能随着武器而变。\n- 队伍能力切换为[c][F8E8CB]暴击率提升[-][/c]；\n- 普通攻击切换为[c][F8E8CB]狂风怒号[-][/c]；\n- 连锁技能切换为[c][F8E8CB]飞翎雨[-][/c]；\n- 特殊能力切换为[c][F8E8CB]微风呼啸[-][/c]。"}],"skill":{"name":"狂暴旋风","description":"皮诺发射旋风能量，对敌人造成近程伤害并附带击飞效果。","levels":[3,6],"damage":[205.0,250.0],"cooldown":[9.0,8.7],"ailment":"击飞"}}],"number":2}],"profile":{"Age":null,"Height":[170],"Weight":[50]},"tribes":["？"],"story":"鲜花店少女芭莉是丰收之神的侍奉使者。游遍世界，收集人们幸福的回忆，正在执行拯救被烧毁的世界树的任务。\n\n借助神秘鲜花之力，帮人们实现愿望，取走他们的幸福回忆作为代价。暗暗下决心，绝不干涉错综复杂的人间烦事。但，看到为了一己之私不惜丢弃宝贵的美好过往的人们，便会心寒，碰上遭遇不幸而诚心祈祷的人们，便会不忍忽视，伸出援手。尤其，对那些被遗弃的人们特别心软。有时，人们想实现的愿望规模超出所付出的代价，芭莉就要用自己的幸福回忆填补缺失。芭莉事先并不知在哪儿能遇上需要帮助的人。于是，她会在世界各地留住更多美好回忆，以备不时之需。\n\n芭莉在执行任务时会坚持两个原则。第一、聚集丰收之神和大自然的威力惩罚基于过分贪念想利用芭莉的人们，绝不心慈手软。第二、签订公平合约，对方许下的愿望，都尽力帮他实现，唯独想让逝者重生的愿望例外。因为，有些人曾经许下现已成为禁忌的愿望，他们的下场都惨不忍睹。","storyKey":"profile_flower_girl_story","sources":{"hero":"heroes.json / OriginId=318","profile":"heroprofile.json / OriginId=318","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}