m":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"命中目标时，激发增幅能量，黑暗魔力的射程及伤害范围扩大20%，伤害提升90%，并持续2秒。该技能每6秒启动1次。"}],"skill":{"name":"湮灭","description":"从指尖迸射魔力引发连环爆破伤害，并附带击飞效果。","levels":[3,7],"damage":[185.0,245.0],"cooldown":[10.0,8.0],"ailment":"击飞"}}],"number":1}],"profile":{"Age":null,"Height":null,"Weight":null},"tribes":["魔族"],"story":"杰洛士，自称是神秘教官；实际他是高阶魔族，负责侍奉五心腹之一的兽王。\n\n正如自我介绍中提到的一样，杰洛士是一个神秘的人物。很多人曾试图了解他的真实身份与意图，但都会被一句“这是一个秘密”打发。\n\n杰洛士与其他魔族一样，以人类的恐惧、憎恨、悲伤等负面情绪作为养分。相反，他极其讨厌那些歌颂友谊、爱情等正面含义的生命赞歌。\n\n除了五心腹之外，杰洛士便是最强的魔族。他曾在降魔战争中，以一己之力消灭了数千条龙。这次事件让精灵与龙族对杰洛士心生恐惧，杰洛士也成为了他们避而远之的对象。","storyKey":"profile_xellos_story","sources":{"hero":"heroes.json / OriginId=455","profile":"heroprofile.json / OriginId=455","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"xellos","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["哎哟，我说你们这些不起眼的家伙，能搞清楚状况吗？"],"enUS":["My, my small fries. Could you read the room please?"],"jaJP":["やれやれ。雑魚の皆さんはもう少し空気を読んでいただけませんと…"]},"keys":["cv_xellos_NormalBattleWin"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550001"]},"audioName":"4550001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["哎呀～差点出大事了！"],"enUS":["Whew, that was close!"],"jaJP":["いやぁ、危ないところでしたね。"]},"keys":["cv_xellos_BossBattleWin"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550002"]},"audioName":"4550002"},{"type":"Die","label":"阵亡","texts":{"zhCN":["是我…疏忽了…"],"enUS":["My negligence… is to blame…"],"jaJP":["ぼ、僕としたことが…しくじっちゃいましたね。"]},"keys":["cv_xellos_Die"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550003"]},"audioName":"4550003"},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["比起这些，我更喜欢负面情绪。"],"enUS":["Negative emotions are more to my tastes than something like this."],"jaJP":["ふぅむ…あぁいえ、せっかくですからね、いただきます。"]},"keys":["cv_xellos_GetExp"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550004"]},"audioName":"4550004"},{"type":"LevelUp","label":"升级","texts":{"zhCN":["这有什么意义？"],"enUS":["Does this even matter?"],"jaJP":["おかげさまで強くなりました。そういうことにしておきません？"]},"keys":["cv_xellos_LevelUp"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550005"]},"audioName":"4550005"},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["比起这些，我更想拿回被莉娜夺走的魔血玉。"],"enUS":["I’d rather get my snatched talisman back from Lina instead."],"jaJP":["リナさん、そろそろタリスマン返してくれませんかねえ。"]},"keys":["cv_xellos_EquipWeapon"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550006"]},"audioName":"4550006"},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["真羡慕高里的头发。我的怎么弄也编不出麻花辫。"],"enUS":["I’m envious of Gourry’s hair. I can’t pull off braids no matter how hard I try."],"jaJP":["羨ましいですね、ガウリイさんの髪。僕の長さじゃ三つ編みはできないですから"]},"keys":["cv_xellos_EquipCostume"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550007"]},"audioName":"4550007"},{"type":"Evolve","label":"进化","texts":{"zhCN":["强大的秘诀？这是一个秘密。"],"enUS":["The key to being powerful? That is a secret."],"jaJP":["強さの秘訣、ですか？それは秘密です。"]},"keys":["cv_xellos_Evolve"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550008"]},"audioName":"4550008"},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["哈！"],"enUS":["Ha-at!"],"jaJP":["はっ！"]},"keys":["cv_xellos_Attack1"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550009"]},"audioName":"4550009"},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["抓到了。"],"enUS":["I got them. "],"jaJP":["ほーら捕まえた"]},"keys":["cv_xellos_Attack2"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550010"]},"audioName":"4550010"},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["这个怎么样？"],"enUS":["How's This?"],"jaJP":["これはどうでしょうか？"]},"keys":["cv_xellos_Attack3"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550011"]},"audioName":"4550011"},{"type":"Skill1","label":"技能1","texts":{"zhCN":["好，游戏该结束了？"],"enUS":["Now, why don’t we stop the child’s play hmm?"],"jaJP":["さあ。そろそろお遊びはおしまいにしましょう。"]},"keys":["cv_xellos_Skill1"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550012"]},"audioName":"4550012"},{"type":"Skill2","label":"技能2","texts":{"zhCN":["你觉得你能从我的手中逃脱吗？"],"enUS":["Did you think you could run from me?"],"jaJP":["もらいました！"]},"keys":["cv_xellos_Skill2"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550013"]},"audioName":"4550013"},{"type":"Damaged1","label":"受到攻击1","texts":{"zhCN":["呃…"],"enUS":["Ahh…"],"jaJP":["くっ…"]},"keys":["cv_xellos_Damaged1"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550014"]},"audioName":"4550014"},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["哎呀…"],"enUS":["Ugh…"],"jaJP":["おやおや…"]},"keys":["cv_xellos_Damaged2"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550015"]},"audioName":"4550015"},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["这种精神攻击…未免有点…"],"enUS":["This kind of attack on the psyche’s… a bit…"],"jaJP":["この精神攻撃は…ちょっと…"]},"keys":["cv_xellos_PlayerChooseBright"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550016"]},"audioName":"4550016"},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["咿呀～非常出色，真令人惊叹。"],"enUS":["Wow, that was excellent. I was in admiration."],"jaJP":["いやあ〜なかなか素晴らしい。僕は感服いたしました。"]},"keys":["cv_xellos_PlayerChooseDark"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550017"]},"audioName":"4550017"},{"type":"WeakEnemyBattleStart","label":"与弱小敌人战斗","texts":{"zhCN":["这种战斗简直就是小菜一碟。"],"enUS":["A battle like this is a piece of cake."],"jaJP":["こんなくだらない勝負で次へ進めるなら楽なもんですよ。"]},"keys":["cv_xellos_WeakEnemyBattleStart"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550018"]},"audioName":"4550018"},{"type":"NormalEnemyBattleStart","label":"与普通敌人战斗","texts":{"zhCN":["哎呀，这我就没办法了。"],"enUS":["Dear, dear, I guess it can’t be helped."],"jaJP":["やれやれ。仕方ないですね。"]},"keys":["cv_xellos_NormalEnemyBattleStart"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550019"]},"audioName":"4550019"},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["太小看我，会让你吃亏的。"],"enUS":["Underestimating me will get you in trouble."],"jaJP":["僕の力を甘く見てもらっては困りますね。"]},"keys":["cv_xellos_StrongEnemyBattleStart"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550020"]},"audioName":"4550020"},{"type":"BossBattleStart","label":"与首领战斗","texts":{"zhCN":["表情不要那么吓人嘛。"],"enUS":["Don’t make a scary face like that."],"jaJP":["そんな怖い顔しないでくださいよ。僕だって仕事なんです。"]},"keys":["cv_xellos_BossBattleStart"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550021"]},"audioName":"4550021"},{"type":"JoinParty","label":"首次加入队伍","texts":{"zhCN":["如你所见，我是神秘教官——杰洛士。"],"enUS":["As you can see, I’m the mysterious priest Xellos."],"jaJP":["ご覧の通り謎のプリースト、ゼロスと言います。"]},"keys":["cv_xellos_JoinParty"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550022"]},"audioName":"4550022"},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["好了，大家开始工作吧？"],"enUS":["Now, could everyone please start working?"],"jaJP":["さあ、皆さん、頑張って下さい。"]},"keys":["cv_xellos_CoopAttack"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550023"]},"audioName":"4550023"},{"type":"CoopHeal","label":"战斗-请求治疗","texts":{"zhCN":["轮到辅助上场了。"],"enUS":["It’s the healer’s turn."],"jaJP":["回復が出来る方はいらっしゃいますか？"]},"keys":["cv_xellos_CoopHeal"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550024"]},"audioName":"4550024"},{"type":"CoopRun","label":"战斗-注意","texts":{"zhCN":["此地不宜久留，还是趁早逃走吧。"],"enUS":["Our best option is running away from here."],"jaJP":["おやおや、まずいですねこれは。"]},"keys":["cv_xellos_CoopRun"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550025"]},"audioName":"4550025"},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["哎呀～各位真的辛苦了。"],"enUS":["Wow, thank you for all of the hard work everyone."],"jaJP":["いやー、皆さん、お疲れ様でした。"]},"keys":["cv_xellos_CoopWin"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550026"]},"audioName":"4550026"},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["没什么，我只是在听从上级的命令罢了。"],"enUS":["Well, all I did was follow orders from up top."],"jaJP":["すみません、僕なんかが貰っちゃって。そんなつもり無かったんですけどね。"]},"keys":["cv_xellos_CoopMVP"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550027"]},"audioName":"4550027"},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["好吧，我就帮你这一次，只有一次哦。"],"enUS":["I have no choice. I’ll help you just this once."],"jaJP":["お手伝いは一度きりですからね。"]},"keys":["cv_xellos_CoopHi"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550028"]},"audioName":"4550028"},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["我说…你别磨叽了，快走吧。"],"enUS":["Hey… the dawdling, could you stop?"],"jaJP":["あまりぐずぐずしないで下さいね。"]},"keys":["cv_xellos_CoopHurryUp"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550029"]},"audioName":"4550029"},{"type":"CoopBelieve","label":"战斗-信任","texts":{"zhCN":["相信我就好，一切都在计划之中。"],"enUS":["Trust me. Everything’s going according to my plan."],"jaJP":["一応、僕の計画通りに進んでますから。"]},"keys":["cv_xellos_CoopBelieve"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550030"]},"audioName":"4550030"},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["这家旅馆的老板娘是好人！不仅厨艺一流，而且还有很多地方值得我们学习。"],"enUS":["The Innkeeper is a great person. I have lots to learn from her, including her cooking."],"jaJP":["ここの女将さんは素晴らしい人ですね、料理の腕前もそうですし、学ぶところが実に多い","ここの女将さんは素晴らしい人ですね。料理の腕前もそうですし、学ぶところが実に多い。"]},"keys":["Voice_xellos_1_TouchReactionGood1","cv_xellos_TouchReactionGood1"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550031"]},"audioName":"4550031"},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["感觉你像莉娜一样，很容易被人利用…这点我喜欢。啊！不过这句话要对莉娜保密哦。"],"enUS":["You’re easily manipulated like Lina. I like you for that. Oh, this stays between us."],"jaJP":["あなたのことは気に入ってますよ、リナさんのように色々と使いどころがありそうで…あ、今の話はリナさんには秘密でお願いしますね","あなたのことは気に入ってますよ。リナさんのように色々と使いどころがありそうで。あ、今の話はリナさんには秘密でお願いしますね。"]},"keys":["Voice_xellos_1_TouchReactionGood2","cv_xellos_TouchReactionGood2"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550032"]},"audioName":"4550032"},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["唉…你们人类总是搞不清状况，不知道什么时候该插手，什么时候该放手。"],"enUS":["Whew… You humans always can’t tell when to intervene or not."],"jaJP":["ふぅ…あなたたち人間は、いつも空気というものが読めませんね","ふぅ…あなたたち人間は、いつも空気というものが読めませんね。"]},"keys":["Voice_xellos_1_TouchReactionBad1","cv_xellos_TouchReactionBad1"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550033"]},"audioName":"4550033"},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["不管你怎么说…我本来就是魔族啊。"],"enUS":["Well, even if you put it that way… I was a demon from the start."],"jaJP":["そういわれましても… 僕はもともと魔族なんですけど","そういわれましても… 僕はもともと魔族なんですけど。"]},"keys":["Voice_xellos_1_TouchReactionBad2","cv_xellos_TouchReactionBad2"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/455/4550034"]},"audioName":"4550034"},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["邮件…？上级又下达了什么烦人的命令…"],"enUS":["Mail…? …Must be annoying orders from up top again…"],"jaJP":["メール…？また上からの厄介な命令でなければいいんですが、はぁ","メール…？また上からの厄介な命令でなければいいんですが、はぁ。"]},"keys":["Voice_xellos_1_NoticeMail","cv_xellos_NoticeMail"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voic