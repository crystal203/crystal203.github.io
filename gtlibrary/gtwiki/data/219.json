cient":0.1,"maxLabel":"满进化 · 满觉醒"}]}],"options":[{"id":10400,"level":100,"name":"队伍火属性攻击提升"}]}],"illustrations":[{"name":"原版立绘","asset":{"key":"illust:illust_ms_student_bad_female","skin":null},"stage":null}],"costumes":[],"weapons":[],"profile":{"Age":[18],"Height":[161],"Weight":[47]},"tribes":["人类"],"story":"美娜，魔法学院的不良学生。\n\n认为自己是犯了学生罪，身穿名曰校服的囚衣被关押在学校监狱里，天天盼望着毕业被释放的那一天到来。总是对父母发脾气，尽管家境贫寒，父母含辛茹苦还是把她送到了名校，美娜却不领情，反而顶撞父母，‘你们什么都没为我做’。其实内心深处非常敬爱父母，并强烈希望得到伙伴们的认可。","storyKey":"profile_ms_student_bad_female_story","sources":{"hero":"heroes.json / OriginId=219","profile":"heroprofile.json / OriginId=219","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"ms_student_bad_female","label":"普通","lines":[{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["“粉红头发是模特”—丢掉这种偏见，即使，这是事实。"],"enUS":["Ignore the stereotype that a person with pink hair is a model. Although, I guess it's not wrong."],"jaJP":["ピンク髪がモデルという偏見は捨てろ！まあ、間違ってはいないけど"]},"keys":["Voice_ms_student_bad_female_1_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["需要签名吗？"],"enUS":["Do you want an autograph?"],"jaJP":["サインが欲しいの？"]},"keys":["Voice_ms_student_bad_female_1_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["哈啊？你精神失常了吗？"],"enUS":["Huh? Are you out of your mind?"],"jaJP":["はぁ？お前、正気か？"]},"keys":["Voice_ms_student_bad_female_1_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["无法相信。"],"enUS":["I can't believe this."],"jaJP":["信っじられない"]},"keys":["Voice_ms_student_bad_female_1_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["有新邮件，你知道吗？"],"enUS":["Do you know that you've got mail?"],"jaJP":["メールが来たって、分かってる？"]},"keys":["Voice_ms_student_bad_female_1_NoticeMail"]}]}]}
