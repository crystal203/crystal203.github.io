icient":0.1,"maxLabel":"满进化 · 满觉醒"}]}],"options":[{"id":10820,"level":250,"name":"队伍远程伤害提升"},{"id":320530,"level":null,"name":"仙山神功"}]}],"illustrations":[{"name":"原版立绘","asset":{"key":"illust:illust_cyborg_monk","skin":null},"stage":null}],"costumes":[{"id":10409,"code":"cyborg_monk_darkness","name":"黑化千虑","type":"时装","sprite":{"sheet":"characters","name":"cyborg_monk_darkness"},"asset":{"key":"character:cyborg_monk_darkness","skin":null}},{"id":10510,"code":"cyborg_monk_swan","name":"天鹅嬉戏千虑","type":"时装","sprite":{"sheet":"characters","name":"cyborg_monk_swan"},"asset":{"key":"character:cyborg_monk_swan","skin":null}}],"weapons":[{"code":"cwp_cyborgmonk","name":"仙山拳秘籍","type":"篮子","variants":[{"id":9050434,"code":"cwp_cyborgmonk_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_cyborgmonk"},"stats":[{"name":"每秒伤害","values":[562,617],"baseValues":[562.071,617.176],"grows":true},{"name":"光属性攻击","values":[136,150],"baseValues":[136.425,149.8],"grows":true},{"name":"暴击率","values":[3,3],"unit":"%"},{"name":"恢复能力","values":[206,206],"baseValues":[206,206],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"技能伤害值","min":8.0,"max":20.0,"unit":"%"},{"name":"防御","min":6.0,"max":18.0,"unit":"%"},{"name":"生命","min":6.0,"max":18.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":8.0,"max":20.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"禅定气功持续时间增加2秒。\n仙山强拳最后一次攻击增强，使敌人远程防御减免20%并持续4秒。"}],"skill":{"name":"金刚掌","description":"巨掌自空中拍下，对目标敌人造成远程范围伤害并附带击倒效果。","levels":[3,6],"damage":[215.0,260.0],"cooldown":[9.2,8.3],"ailment":"击倒"}}],"number":1}],"profile":{"Age":null,"Height":[198],"Weight":[130]},"tribes":["机械人"],"story":"机械行者千虑，是一位在漫长修行中彻悟人生真谛的拳法大师。\n\n千虑，本名不详，曾经是武林正派义天门的弟子，在武林大会后遭受同门大师兄所设的奸计陷害，身败名裂，被永久逐出了师门。为了确保千虑无法再修炼师门武功，大师兄不顾同门之情命人挑断了他的四肢筋脉，震碎了丹田，最后将千虑扔至荒山，任其自生自灭。当遍体鳞伤的千虑被一位路过的高僧发现时，他已经命在旦夕，除了经脉与丹田的不可逆损伤，还留下包括全身大面积骨折在内的致命性外伤，利用普通的医疗技术已经无法挽救他的性命。\n\n天无绝人之路，在高僧的帮助下，千虑有幸接受了以机器替换人体大部分器官的“机械化手术”。从理论上讲，接受“机械化手术”就能半永久性地活在世上，所以对此垂涎三尺的人不乏其数，卡马逊公司出于多种原因，只为极少数人提供手术机会。卡马逊公司的路易兹理事曾经受到过高僧的帮助，为表达谢意，特意答应为他提供一次手术机会。高僧不忍看到年轻有为的武林新秀就此丧命，将原本属于自己的宝贵机会让给了生命垂危的千虑，让卡马逊公司破例给千虑进行“机械化手术”，以挽救他的性命。最终，手术非常成功，千虑不仅保住了性命，还恢复了内力，甚至在高僧的指导下可以用这机械之躯继续修行武功。高僧赐予重获新生的他法号“千虑”，希望他能忘记仇恨，皈依佛门。但此时的千虑心中，仍然充满了迷惘与隐隐的仇恨……\n\n千虑对高僧感恩戴德，内心更是对他充满了深深的敬意。高僧的慷慨让千虑拥有了新的身体，他的宽仁更是让复仇结束后失去人生目标的千虑找到了继续活下去的理由。对于自幼失去双亲，孤僻习武的千虑来说，无论何时都能为其指引明路的师傅，自然而然地成为了千虑心目中的榜样。后来，千虑自创的一套拳法，也借由高僧的法号“仙山”命名。由此可见，千虑对师傅深怀着崇敬之情与感恩之心。\n\n仙山拳之所以被世人称为绝世神功，是因为这套拳法不仅练成后力量强大，还具有很高的通用性。千虑以义天门的武功修炼了极阴之气，以高僧的教诲修炼了极阳之气，加上历经千帆后的顿悟，最终促成了阴阳和合。由此诞生的仙山拳可谓刚柔并济，盖世无双，无论面对什么样的敌人，无论遇到什么样的情况，都能应对自如，化险为夷。除此以外，因为千虑是由人类之躯变成了机械之形，他所创造的拳法对修炼者并无局限性，据说不仅人类可以修炼，连机器人也可以。\n\n跟随师傅修行期间，千虑总是热衷于救世济民，危难之处经常能见到他无私奉献的身影。但自从仙山大师圆寂后，千虑就像在这个世界上消失了一样，从此渺无音讯。有人说“他因失去师傅悲痛欲绝，已经远离尘世了”，也有人说“他为了参透新的真理而闭关修行了”，甚至还有人说“他和一位蓝色长发女子，在半夜私奔了”。人们对千虑的行踪众说纷纭，其下落至今仍是个迷。","storyKey":"profile_cyborg_monk_story","sources":{"hero":"heroes.json / OriginId=530","profile":"heroprofile.json / OriginId=530","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"cyborg_monk","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["愿施主安息。"],"enUS":["May you rest in peace."],"jaJP":["成仏するがよい"]},"keys":["cv_cyborg_monk_NormalBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/530/5300001@-3585373094067512024"],"enUS":["cdn/Android/ondemand/voices_en/530/5300001"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/530/5300001@-7918030633769956576"]},"audioName":"5300001"},{"typ