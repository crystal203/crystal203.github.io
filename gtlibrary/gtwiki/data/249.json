e":[22],"Height":[154],"Weight":[41]},"tribes":["人类"],"story":"阿加莎，游走各地的杂货商人。\n\n背在身上的大菜刀是她的最爱，并非武器，是生前能做一手好菜的奶奶留给阿加莎的遗物。看到大菜刀的人，都畏惧阿加莎，这反而对阿加莎有利，没人敢和她讨价还价，利润不菲。\n\n个性阴沉，但阻挡视线的长刘海与性格无关，只因忙于工作，没空理发。","storyKey":"profile_shop_girl_story","sources":{"hero":"heroes.json / OriginId=249","profile":"heroprofile.json / OriginId=249","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"shop_girl","label":"普通","lines":[{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["公私要分明，因私见面，也不会打折。"],"enUS":["Business is business and personal is personal. Even if we meet outside the Shop, there's no discount."],"jaJP":["仕事は仕事、身内でも割引はありません"]},"keys":["Voice_shop_girl_1_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["再等下去，我也不会唱歌。"],"enUS":["Even if you wait like that, I won't sing."],"jaJP":["そこでじっと待っても、私は歌いませんよ"]},"keys":["Voice_shop_girl_1_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["曾经经常出现想偷商店里商品的人，现在已经不在了。"],"enUS":["There were people who tried to steal stuff from the Shop. Not anymore."],"jaJP":["昔、商店の品物を盗もうとする輩がいたんですよ…もういませんけど"]},"keys":["Voice_shop_girl_1_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["向人投掷炸弹是没礼貌的行为。"],"enUS":["It's rude to throw a bomb at a person."],"jaJP":["人に爆弾を投げるのは無礼な行為だと思いませんか？"]},"keys":["Voice_shop_girl_1_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["邮递员来过。"],"enUS":["Mailman came by."],"jaJP":["郵便配達員が来ましたよ！メールでしょうか"]},"keys":["Voice_shop_girl_1_NoticeMail"]}]}]}
