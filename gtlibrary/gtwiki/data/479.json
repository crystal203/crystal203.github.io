id":330479,"level":null,"name":"ms_chrome_role_option"},{"id":350479,"level":null,"name":"ms_chrome_weapon_atk_final_scale_option"}]}],"illustrations":[{"name":"原版立绘","asset":{"key":"illust:illust_ms_chrome","skin":null},"stage":null},{"name":"日服立绘","asset":{"key":"illust:illust_ms_chrome_kong","skin":null},"stage":null}],"costumes":[{"id":10361,"code":"ms_chrome_swat","name":"机动部队克罗姆小姐","type":"时装","sprite":{"sheet":"characters","name":"ms_chrome_swat"},"asset":{"key":"character:ms_chrome_swat","skin":null}},{"id":10480,"code":"ms_chrome_traveler","name":"探险家克罗姆小姐","type":"时装","sprite":{"sheet":"characters","name":"ms_chrome_traveler"},"asset":{"key":"character:ms_chrome_traveler","skin":null}},{"id":10535,"code":"ms_chrome_outing","name":"新春出游克罗姆小姐","type":"时装","sprite":{"sheet":"characters","name":"ms_chrome_outing"},"asset":{"key":"character:ms_chrome_outing","skin":null}}],"weapons":[{"code":"cwp_mschrome","name":"黑曼巴","type":"步枪","variants":[{"id":9030454,"code":"cwp_mschrome_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_mschrome"},"stats":[{"name":"每秒伤害","values":[600,659],"baseValues":[599.7600000000001,658.5600000000001],"grows":true},{"name":"虚属性攻击","values":[118,129],"baseValues":[117.81,129.36],"grows":true},{"name":"暴击率","values":[12,12],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"生命","min":8.0,"max":20.0,"unit":"%"},{"name":"防御","min":6.0,"max":18.0,"unit":"%"},{"name":"开始战斗时，加成额外生命","min":4.0,"max":10.0,"unit":"%"}],"subOptions":[{"name":"技能伤害值","min":8.0,"max":20.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"命中目标时，按照每秒伤害的200%造成伤害，使目标敌人“沉默”且2秒内无法使用武器技能。该技能每5秒启动1次。\n“子弹派对”附带“隐形毒牙”效果。\n- 隐形毒牙：使用技能时，可启用副武器步枪的武器技能，但仅适用50%输出伤害与30%异常状态数值。使用技能时，武器技能恢复时间增加2秒。"}],"skill":{"name":"毒蛇之吻","description":"发射爆破型导弹，对敌人造成伤害，并附带重伤效果。","levels":[1,5],"damage":[125.0,225.0],"cooldown":[10.0,8.8],"ailment":"重伤"}}],"number":1}],"profile":{"Age":[32],"Height":[167],"Weight":[51]},"tribes":["人类"],"story":"No.9克罗姆小姐，是黑帮团伙“水库蟒蛇”领导人之一。\n\n克罗姆小姐加入“水库蟒蛇”不过是几年前的事。那时“水库蟒蛇”为了在拉赫帝国扩张势力，与其他犯罪集团展开了激烈竞争，克罗姆小姐只是“水库蟒蛇”敌对组织中的一名基层人员。但万万没想到，有一天她竟然与“水库蟒蛇”取得了联系，并向团伙提出了一个交易。“让我坐上团伙领导人的位子，整个拉赫帝国就会成为我们的地盘。”其他团伙成员听到如此狂妄的发言，都对她的来意表示怀疑，他们认为克罗姆小姐是敌人派来的密探，恨不得马上除掉她。然而，“水库蟒蛇”的首领“伟大的奶奶”对略显狂妄却颇有胆量的克罗姆小姐产生了兴趣。于是，“伟大的奶奶”以失败即死亡为条件，答应给克罗姆小姐一次机会，并让她利用一年的时间证明自己的实力。\n\n正式成为“水库蟒蛇”的一员后，克罗姆小姐立即着手拓展了团伙的业务范围。走私武器、煽动群众、扰乱公共秩序、谋划暗杀，只要有人愿意付钱，再肮脏的任务她都会想尽办法“替人消灾”。后来，克罗姆小姐还刻意接近拉赫帝国的富豪、贵族、皇室成员等权力阶层。起初，大家都对克罗姆小姐保持高度警惕，尽量避而远之。但没过多久，人们就被她华丽的言辞所迷惑了，委托“水库蟒蛇”的任务也自然而然变得多了起来。随着团伙在拉赫帝国的影响力日益增大，竞争对手也都被克罗姆小姐一一铲除。虽然有一些不甘心坐以待毙的人形成了一股反抗势力，但“水库蟒蛇”早已与拉赫帝国腐败的权力阶层建立了牢固的裙带关系，想与其抗衡实属不易。一年就这样过去了，不择手段的克罗姆小姐成功让“水库蟒蛇”成为了拉赫帝国规模最大的黑帮组织。\n\n凭借在拉赫帝国的出色表现，克罗姆小姐不仅得到了“伟大的奶奶”的认可，还如愿以偿地成为了团伙第九领导人。克罗姆小姐一登上领导人席位，就迫不及待地开始解决团伙内大大小小的麻烦。有一次，团伙因涉嫌走私军火而被人举报，多亏克罗姆小姐灵机一动才推翻了团伙的罪名。不仅如此，团伙还以维护治安秩序有功而获得了勋章。这算是关于克罗姆小姐的轶事中最有名的了。“伟大的奶奶”听到这个消息后，也忍不住开怀大笑，极为满意。此后，克罗姆小姐因功受赏并被委以重任，开始负责拟定团伙的作战计划。\n\n每当作战按照自己的计划准确无误地进行时，克罗姆小姐就会感到无比的喜悦，相反，她非常讨厌计划出现差池。但凡做出突发行为破坏克罗姆小姐作战计划的人，无论是敌是友，她都会亲自出面除掉他。传闻，因抗命而死的团伙成员比作战伤亡人数还要多。因此，团伙内有人主张应该惩罚克罗姆小姐，但统计结果证实了因抗命而死的团伙成员全部加在一起，也远远少于预计伤亡人数。自那以后，再也没有人追究此事了。\n\n克罗姆小姐并不满足于第九领导人的身份。“水库蟒蛇”对于她而言，只不过是冲向更高处的跳板。在克罗姆小姐的眼里，尽忠于“伟大的奶奶”的阿拉贝尔和其他团伙成员都是可以随意拿来利用的棋子。与此同时，为了日后不时之需，克罗姆小姐还向团伙隐瞒了自己已经掌握埃尔韦拉行踪的事情。克罗姆小姐虽然是“水库蟒蛇”领导人，但只要能实现自己的目的，她可以和任何人进行合作，即使那个人是团伙锁定的目标。","storyKey":"profile_ms_chrome_story","sources":{"hero":"heroes.json / OriginId=479","profile":"heroprofile.json / OriginId=479","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"ms_chrome","label":"