3,"code":"slime_milim_casual","name":"休闲装米莉姆","type":"时装","sprite":{"sheet":"characters","name":"slime_milim_casual"},"asset":{"key":"character:slime_milim_casual","skin":null}},{"id":10464,"code":"slime_milim_destroy","name":"龙装形态米莉姆","type":"时装","sprite":{"sheet":"characters","name":"slime_milim_destroy"},"asset":{"key":"character:slime_milim_destroy","skin":null}}],"weapons":[{"code":"cwp_slimemilim","name":"龙指虎","type":"爪","variants":[{"id":9100404,"code":"cwp_slimemilim_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_slimemilim"},"stats":[{"name":"每秒伤害","values":[734,806],"baseValues":[733.5839998225199,805.50399980512],"grows":true},{"name":"暗属性攻击","values":[181,198],"baseValues":[180.685714242,198.399999952],"grows":true},{"name":"暴击率","values":[16,16],"unit":"%"},{"name":"防御","values":[22,24],"baseValues":[21.6,24.192000000000004],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"生命","min":5.0,"max":18.0,"unit":"%"},{"name":"防御","min":4.0,"max":16.0,"unit":"%"},{"name":"武器技能恢复速度","min":2.0,"max":10.0,"unit":"%"}],"subOptions":[{"name":"技能伤害值","min":8.0,"max":20.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"对生命高于30%的敌人造成的伤害值提升20%。\n使用“我生气了！！”过程中，英雄承受伤害减免60%。"}],"skill":{"name":"我生气了！！","description":"释放能量，对敌人造成近程伤害并附带击倒效果。","levels":[1,5],"damage":[216.0,280.0],"cooldown":[11.2,10.2],"ailment":"击倒"}}],"number":1}],"profile":{"Age":null,"Height":null,"Weight":null},"tribes":["龙魔人"],"story":"米莉姆·纳瓦，与利姆鲁一样位列八星魔王之一，是龙种与人类诞下的龙魔人。\n\n身为最古老的魔王之一，与生俱来的强大战斗力使米莉姆成为所有人敬畏的对象。利姆鲁首次与米莉姆相遇时便说道，“米莉姆具有足以和‘暴风龙维鲁德拉’匹敌的压倒性霸气”。如此强势的米莉姆，不仅在控制力度的情况下，一击就摧毁了连利姆鲁的攻击也无法撼动的“暴风大妖涡”，还在承受魔王卡利翁的攻击后展露出可以一招摧毁兽王国的超强战斗力。由于米莉姆长着一副小孩子般的样貌，人们很难想象她会拥有与相貌完全不符的强大力量，因此经常被人小看。\n\n虽然米莉姆有着压倒性的战斗力，但她不会只凭借蛮力制服敌人。作为魔王，在漫长岁月中积累了丰富经验，因此米莉姆其实非常精于算计。她会采用狡猾的方式打探出敌人的目的，甚至面对自己不愿意做的事情，米莉姆也会为了完成任务而隐忍下来。\n\n米莉姆和利姆鲁二人关系非常要好，当时米莉姆想结束乏味无趣的生活，不断寻找着有趣的事情。在决定留在“鸠拉·特恩佩斯特联邦国”后，米莉姆和利姆鲁便成为了挚友。一开始，利姆鲁只是想和米莉姆成为普通朋友，但对上米莉姆恳切的眼神，利姆鲁不忍拒绝，只好答应成为她的挚友。米莉姆经常拿着利姆鲁送给自己的礼物在其他魔王面前炫耀一番。由于她非常重视自己的挚友，因此，平时为所欲为的米莉姆在利姆鲁面前就会变得格外乖巧听话。","storyKey":"profile_slime_milim_story","sources":{"hero":"heroes.json / OriginId=578","profile":"heroprofile.json / OriginId=578","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"slime_milim","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["胜利是属于我哒！"],"enUS":["Victory is mine!"],"jaJP":["ワタシの勝利なのだ！"]},"keys":["cv_slime_milim_NormalBattleWin"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/578/5780001"]},"audioName":"5780001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["再陪我玩玩嘛！"],"enUS":["Play with me again!"],"jaJP":["また遊んでやるのだ！"]},"keys":["cv_slime_milim_BossBattleWin"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/578/5780002"]},"audioName":"5780002"},{"type":"Die","label":"阵亡","texts":{"zhCN":["唉，真小气…"],"enUS":["Ugh, so unfair…."],"jaJP":["う、せこい…"]},"keys":["cv_slime_milim_Die"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/578/5780003"]},"audioName":"5780003"},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["太好吃了！再来一碗哒！"],"enUS":["Delicious! Give me more!"],"jaJP":["うまいのだ！おかわりなのだ！"]},"keys":["cv_slime_milim_GetExp"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/578/5780004"]},"audioName":"5780004"},{"type":"LevelUp","label":"升级","texts":{"zhCN":["新的力量，尝试一下也不错哒！"],"enUS":["This new power, let's put it to the test!"],"jaJP":["新しい力、試してみるのも悪くないのだ！"]},"keys":["cv_slime_milim_LevelUp"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/578/5780005"]},"audioName":"5780005"},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["就是这个！你看！你看！"],"enUS":["Lookie! Lookie!"],"jaJP":["これなのだ！ほれほれ～エヘヘヘ"]},"keys":["cv_slime_milim_EquipWeapon"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/578/5780006"]},"audioName":"5780006"},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["好可爱耶！"],"enUS":["This looks cute!"],"jaJP":["これ、可愛いのだ！"]},"keys":["cv_slime_milim_EquipCostume"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/578/5780007"]},"audioName":"5780007"},{"type":"Evolve","label":"进化","texts":{"zhCN":["我真的好好努力了一把哒！"],"enUS":["I worked super-duper hard!"],"jaJP":["だから、ワタシはすっご～く頑張ったのだ！"]},"keys":["cv_slime_milim_Evolve"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/578/5780008"]},"audioName":"5780008"},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["咿呀！"],"enUS":["Hiyap"],"jaJP":["やっ！"]},"keys":["cv_slime_milim_Attack1"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/578/5780009"]},"audioName":"5780009"},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["喝呀啊！"],"enUS":["Haaat"],"jaJP":["はあっ！"]},"keys":["cv_slime_milim_Attack2"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/578/5780010"]},"audioName":"5780010"},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["滋味如何呀？"],"enUS":["How's that?"],"jaJP":["どうだ？"]},"keys":["cv_slime_milim_Attack3"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/578/5780011"]},"audioName":"5780011"},{"type":"Skill1","label":"技能1","texts":{"zhCN":["吃我一招！"],"enUS":["Take this!"],"jaJP":["くらえ！"]},"keys":["cv_slime_milim_Skill1"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/578/5780012"]},"audioName":"5780012"},{"type":"Skill2","label":"技能2","texts":{"zhCN":["让你见识一下我的绝招吧！"],"enUS":["Let me show you this little trick I've been saving up!"],"jaJP