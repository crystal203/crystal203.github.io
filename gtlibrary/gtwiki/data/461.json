t:illust_vampire_lord_kong","skin":null},"stage":null}],"costumes":[{"id":10337,"code":"vampire_lord_rockstar","name":"摇滚巨星克劳德","type":"时装","sprite":{"sheet":"characters","name":"vampire_lord_rockstar"},"asset":{"key":"character:vampire_lord_rockstar","skin":"vampire_lord_rockstar"}},{"id":10360,"code":"vampire_lord_blood_lineage","name":"殷红君主克劳德","type":"时装","sprite":{"sheet":"characters","name":"vampire_lord_blood_lineage"},"asset":{"key":"character:vampire_lord_blood_lineage","skin":"vampire_lord_blood_lineage"}},{"id":10384,"code":"vampire_lord_santa","name":"圣诞老人克劳德","type":"时装","sprite":{"sheet":"characters","name":"vampire_lord_santa"},"asset":{"key":"character:vampire_lord_santa","skin":"vampire_lord_santa"}},{"id":10455,"code":"vampire_lord_bloodchef","name":"血液料理主厨克劳德","type":"时装","sprite":{"sheet":"characters","name":"vampire_lord_bloodchef"},"asset":{"key":"character:vampire_lord_bloodchef","skin":"vampire_lord_bloodchef"}}],"weapons":[{"code":"cwp_vampirelord","name":"暮色","type":"拳套","variants":[{"id":9070404,"code":"cwp_vampirelord_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_vampirelord"},"stats":[{"name":"每秒伤害","values":[721,792],"baseValues":[721.344,792.0640000000001],"grows":true},{"name":"暗属性攻击","values":[173,190],"baseValues":[173.4,190.4],"grows":true},{"name":"暴击率","values":[4,4],"unit":"%"},{"name":"防御","values":[24,26],"baseValues":[23.663999999999998,25.984],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"生命","min":10.0,"max":20.0,"unit":"%"},{"name":"武器技能恢复速度","min":10.0,"max":20.0,"unit":"%"},{"name":"技能伤害值","min":8.0,"max":18.0,"unit":"%"}],"subOptions":[{"name":"防御","min":10.0,"max":18.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"技能伤害值","unit":"%","values":[9.0,18.0,27.0,36.0,45.0]}],"effects":[{"name":"专属效果","description":"殷红盛典命中目标时，每2秒按照每秒伤害的50%造成一次额外伤害，并按照输出伤害的50%恢复自身生命；被额外伤害击中的敌人攻击降低10%并持续2秒。"}],"skill":{"name":"腥风血雨","description":"创造旋风对周围敌人造成伤害，并附带击倒效果。","levels":[1,5],"damage":[180.0,260.0],"cooldown":[11.0,8.8],"ailment":"击倒"}}],"number":1}],"profile":{"Age":[1873],"Height":[191],"Weight":[79]},"tribes":["吸血鬼"],"story":"克劳德伯爵，恶魔郡州长。\n\n500年前，在魔界统一战争结束后，突然在一个地方生活的魔族与吸血鬼因难以接纳彼此之间的差异，从而爆发了矛盾。就在矛盾即将演变成更大的混乱吞噬整个恶魔郡时，克劳德站出来化解双方的矛盾，最终实现了两个种族的和谐相处。他承诺，将致力于维护两个种族的和平与繁荣，作为见证，他会迎娶高阶魔族之女艾莉丝。这场盛大的联姻，象征着恶魔郡的团结。与此同时，克劳德在市民中的支持率飙升，后来他被推举成为恶魔郡的领导人。在一些人眼里，克劳德与艾莉丝的婚姻只是一段毫无感情的政治交换，殊不知克劳德对艾莉丝的爱是真心的。虽然克劳德不会把爱挂在嘴边，但他内心深爱着与妻子的小小世界，世上任何事物都无法比拟。因此，克劳德毫不犹豫地踏入轮回，哪怕只有一丝希望，只要能守护艾莉丝留下的宝贝——心爱的女儿普莉希拉，他也愿意尝试。\n\n在普莉希拉的记忆中，父亲一直是严厉而冷漠的样子。但其实克劳德非常疼爱普莉希拉。普莉希拉小时候写给克劳德的信，全都被完好地保存在他触手可得的地方。在无尽的时空轮回中，这些信成为了支撑克劳德活下去的希望。\n\n作为已经活了很久的强者，在克劳德眼里连莉莉丝也只是一个小孩子。身为纯种的吸血鬼天生的魔力，加上经历漫长岁月积累的强大力量，足以让他成为一个种族的巅峰。利用人造太阳的爆发实现时间的逆转，也因为是克劳德才能做到。\n\n与其他吸血鬼一样，克劳德也需要血液。作为纯正血统的吸血鬼，不少人担心或期待他会咬住牺牲者的脖子，然后吸取对方的血。但其实克劳德更喜欢血包那样的精制血液。他认为，比起强行夺来的血液，自愿献上的贡品更有价值。\n\n小时候的普莉希拉虽然有想吸血的冲动，但又不喜欢吸血，于是克劳德便认真研究各种方式，最后还写出了一本名为《享受血液的100种方法》的料理书。伯爵家的精制血液料理都是按照料理书中的配方烹饪而成，味道极佳！但由于烹饪方法非常繁琐，所以据说尽管伯爵家的厨师待遇非常好，但厨师的流动性却很大。","storyKey":"profile_vampire_lord_story","sources":{"hero":"heroes.json / OriginId=461","profile":"heroprofile.json / OriginId=461","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}