"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/338/3380036@2958217980480900206"],"enUS":["cdn/Android/ondemand/voices_en/338/3380036"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/338/3380036@-8561029767884264645"]},"audioName":"3380036"},{"type":"SummonSpeech1","label":"召唤-台词1","texts":{"zhCN":["非常感谢大家，没想到我会获此殊荣…"],"enUS":["Oh, wow. I am so grateful for this honor…"],"jaJP":["こんな大きな賞をもらえるなんて…"]},"keys":["cv_eugene_SummonSpeech1"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/338/3380094@-4041763654676949627"],"enUS":[],"jaJP":[]},"audioName":"3380094"},{"type":"SummonSpeech2","label":"召唤-台词2","texts":{"zhCN":["为我精心准备“一桌好饭菜”的剧组人员劳苦功高，我只不过“动了动筷子”就受到了这么多关注，真是无地自容…"],"enUS":["I'm humbled to get all the spotlight for myself, when so many people have worked together for this…"],"jaJP":["スタッフさんや共演者、皆の力がひとつになったおかげです"]},"keys":["cv_eugene_SummonSpeech2"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/338/3380095@-1458320796183453254"],"enUS":[],"jaJP":[]},"audioName":"3380095"},{"type":"SummonSpeech3","label":"召唤-台词3","texts":{"zhCN":["我会加倍努力，不负大家期望！"],"enUS":["Thank you, and I'll never stop working for the best performance!"],"jaJP":["これからも頑張ります、応援よろしくおねがいします！"]},"keys":["cv_eugene_SummonSpeech3"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/338/3380096@-7840149502085400872"],"enUS":[],"jaJP":[]},"audioName":"3380096"}]},{"id":"eugene_myth","label":"开花","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["比彩排时发挥得还要好呢！？"],"enUS":[],"jaJP":["リハーサルより、うまくいったんじゃない！？"]},"keys":["cv_eugene_myth_NormalBattleWin"],"audio":{"zhCN":[],"enUS":["cdn/Android/ondemand/voices_en/338/3380001_myth"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/338/3380001_myth@6750011744326188095"]},"audioName":"3380001_myth"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["首领击破！直到最后一刻都充满紧张感！"],"enUS":[],"jaJP":["ボス撃破！ラストシーンまで緊張感あふれてたよ！"]},"keys":["cv_eugene_myth_BossBattle