"grows":true},{"name":"暴击率","values":[3,3],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"武器技能恢复速度","min":5.0,"max":10.0,"unit":"%"},{"name":"生命","min":4.0,"max":8.0,"unit":"%"},{"name":"防御","min":3.0,"max":6.0,"unit":"%"}],"subOptions":[{"name":"技能伤害值","min":5.0,"max":10.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"暴击率","min":10,"max":10,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"振作士气","description":"启动暴击伤害，我方全部人员暴击率提升1倍并持续3秒。该技能每8秒启动1次。"}],"skill":{"name":"皇家敕命","description":"召唤皇室秘密武器发射灵光，对目标敌人造成范围伤害，并附带击飞效果。","levels":[2,5],"damage":[290.0,560.0],"cooldown":[11.9,11.0],"ailment":"击飞"}}],"number":1}],"profile":{"Age":[19],"Height":[159],"Weight":[43]},"tribes":["人类"],"story":"阿依莎，坎特伯雷王国对手拉赫帝国的第7位皇女。\n\n在众多兄弟姐妹中脱颖而出，成为备受瞩目的皇位继承人。传闻皇帝偏爱第七女，阿依莎以德才兼备的谋略家面貌展露锋芒，平息了传闻。领导人培训成绩最优异，对国内外局势变动了如指掌，心怀治理帝国的明确方针和目标，年纪尚幼，却足以让所有人认定阿依莎为下一任帝国领导。\n\n体格娇小，但语气果断且铿锵有力，冷漠的外表与冰冷的语气更具有服众的威力。","storyKey":"profile_steam_princess_story","sources":{"hero":"heroes.json / OriginId=119","profile":"heroprofile.json / OriginId=119","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"steam_princess","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["身为拉赫帝国的皇女，理应如此。"],"enUS":["It was an obvious victory, given who I am."],"jaJP":["帝国皇女として、当然の勝利だ"]},"keys":["cv_steam_princess_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["胜利献给拉赫帝国。"],"enUS":["I dedicate this victory to the people of the Empire."],"jaJP":["この勝利、帝国の民たちに捧げよう"]},"keys":["cv_steam_princess_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["父王…我…"],"enUS":["Father… I…"],"jaJP":["父上… 私は…"]},"keys":["cv_steam_princess_Die"]},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["奉献！"],"enUS":["Accepted!"],"jaJP":["私に捧げよ！"]},"keys":["cv_steam_princess_GetExp"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["一如既往，我变得更强了。"],"enUS":["I became stronger, as always."],"jaJP":["私は強くなる必要があるのだ"]},"keys":["cv_steam_princess_LevelUp"]},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["满意。"],"enUS":["I am satisfied."],"jaJP":["ああ、良い装備だ"]},"keys":["cv_steam_princess_EquipWeapon"]},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["想引领大众，外貌也非常重要。"],"enUS":["Looks are just as important for a leader."],"jaJP":["大衆を導くためには、どう見えるかも大事だからな"]},"keys":["cv_steam_princess_EquipCostume"]},{"type":"Evolve","label":"进化","texts":{"zhCN":["无论何时，唯有向前。这是帝国王族的生活方式。"],"enUS":["I always move forward. That's how the royal family of the Empire lives."],"jaJP":["どのような状況でも前に進む、それが帝国を統べる者の生き様だ"]},"keys":["cv_steam_princess_Evolve"]},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["哈！"],"enUS":["Haat!"],"jaJP":["はっ！"]},"keys":["cv_steam_princess_Attack1"]},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["咿呀！"],"enUS":["Hiyaa!"],"jaJP":["たぁっ！"]},"keys":["cv_steam_princess_Attack2"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["啧，卑微！"],"enUS":["Vulgar thing!"],"jaJP":["愚か者っ！"]},"keys":["cv_steam_princess_Attack3"]},{"type":"Skill1","label":"技能1","texts":{"zhCN":["消失吧。"],"enUS":["Be gone!"],"jaJP":["消えろ"]},"keys":["cv_steam_princess_Skill1"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["服从命令！"],"enUS":["Obey!"],"jaJP":["跪けっ！"]},"keys":["cv_steam_princess_Skill2"]},{"type":"Damaged1","label":"受到攻击1","texts":{"zhCN":["呃！"],"enUS":["Ugh!"],"jaJP":["くっ！"]},"keys":["cv_steam_princess_Damaged1"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["好痛…"],"enUS":["It hurts…"],"jaJP":["痛いな…"]},"keys":["cv_steam_princess_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["只有跟随者，才会为情所动。"],"enUS":["Emotions are for ordinary people."],"jaJP":["情に振り回されるなど、凡人の証だな"]},"keys":["cv_steam_princess_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["始终要做出正确的决定，这是君王的使命。"],"enUS":["Always make the right choice. That is the responsibility of the leader."],"jaJP":["常に正しい選択をする、それが上に立つものの務めだ"]},"keys":["cv_steam_princess_PlayerChooseDark"]},{"type":"WeakEnemyBattleStart","label":"与弱小敌人战斗","texts":{"zhCN":["不需要我动手。"],"enUS":["You shouldn't bother me with this."],"jaJP":["私が手を汚すまでもない"]},"keys":["cv_steam_princess_WeakEnemyBattleStart"]},{"type":"NormalEnemyBattleStart","label":"与普通敌人战斗","texts":{"zhCN":["帝国的敌人，我会处理你们。"],"enUS":["Exterminate the enemies."],"jaJP":["帝国の敵は、私の手で消し去ってやろう"]},"keys":["cv_steam_princess_NormalEnemyBattleStart"]},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["有时为了帝国，不得不面对强敌。"],"enUS":["Sometimes you need strong enemies for politics."],"jaJP":["強い敵が必要なのは、政治と変わらないな"]},"keys":["cv_steam_princess_StrongEnemyBattleStart"]},{"type":"BossBattleStart","label":"与首领战斗","texts":{"zhCN":["我已经历过多次考验，你没什么特别的。"],"enUS":["I've overcome trials like this countless times."],"jaJP":["この程度の試練、既に何度も乗り越えてきた"]},"keys":["cv_steam_princess_BossBattleStart"]},{"type":"JoinParty","label":"首次加入队伍","texts":{"zhCN":["我以皇女之名担保，拉赫帝国将与坎特伯雷同盟，全面协助对抗侵略者战争…"],"enUS":["I pledge to my honor that the Empire will fully support Kanterbury in battles against the invaders."],"jaJP":["私の名誉にかけ、帝国は対インヴェーダー戦線に全面協力することを約束しよう"]},"keys":["cv_steam_princess_JoinParty"]},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["开始攻击！"],"enUS":["Attack!"],"jaJP":["攻撃開始！"]},"keys":["cv_steam_princess_CoopAttack"]},{"type":"CoopHeal","label":"战斗-请求治疗","texts":{"zhCN":["辅助！"],"enUS":["Healer!"],"jaJP":["ヒーラー！"]},"keys":["cv_steam_princess_CoopHeal"]},{"type":"CoopRun","label":"战斗-注意","texts":{"zhCN":["让开！"],"enUS":["Fall back!"],"jaJP":["引け！"]},"keys":["cv_steam_princess_CoopRun"]},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["向各位的努力致上敬意。"],"enUS":["My respect for your hard work."],"jaJP":["其方らの戦い、見事であった"]},"keys":["cv_steam_princess_CoopWin"]},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["这是作为皇女应该做的。"],"enUS":["As a leader, I did what I was supposed to do."],"jaJP":["指導者として当然のことをしたまでだ"]},"keys":["cv_steam_princess_CoopMVP"]},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["我保证，你所立下的功劳将会得到丰厚的奖励。"],"enUS":["I promise generous rewards for your services."],"jaJP":["功績をあげた者には十分な報酬を約束しよう"]},"keys":["cv_steam_princess_CoopHi"]},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["快做决定！"],"enUS":["Make it quick."],"jaJP":["決断を！"]},"keys":["cv_steam_princess_CoopHurryUp"]},{"type":"CoopBelieve","label":"战斗-信任","texts":{"zhCN":["相信我的指令是没错的，我保证会取得胜利。"],"enUS":["Trust my orders. I promise you victory."],"jaJP":["私の命令を信じろ、勝利へ導いて見せよう"]},"keys":["cv_steam_princess_CoopBelieve"]},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["什么？"],"enUS":["What."],"jaJP":["なんだ"]},"keys":["Voice_steam_princess_1_TouchReactionGood1","cv_steam_princess_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["我在听你说。"],"enUS":["I'm listening."],"jaJP":["聞こう"]},"keys":["Voice_steam_princess_1_TouchReactionGood2","cv_steam_princess_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["你要做什么？"],"enUS":["State your business."],"jaJP":["用件を言え"]},"keys":["Voice_steam_princess_1_TouchReactionBad1","cv_steam_princess_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["我觉得你很烦。"],"enUS":["You're unpleasant."],"jaJP":["不愉快だ"]},"keys":["Voice_steam_princess_1_TouchReactionBad2","cv_steam_princess_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["收到邮件，我会尽快处理。"],"enUS":["New mail. Deal with it now."],"jaJP":["メールが来ている、迅速に処理せよ"]},"keys":["Voice_steam_princess_1_NoticeMail","cv_steam_princess_NoticeMail"]},{"type":"NoticeEvent","label":"活动提示","texts":{"zhCN":["活动开始了，去赢得胜利吧。"],"enUS":["An event. Let's go and win."],"jaJP":["イベントだ、勝ちに行くぞ"]},"keys":["cv_steam_princess_NoticeEvent"]}]}]}
