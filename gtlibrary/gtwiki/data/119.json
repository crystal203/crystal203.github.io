"grows":true},{"name":"暴击率","values":[3,3],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"武器技能恢复速度","min":5.0,"max":10.0,"unit":"%"},{"name":"生命","min":4.0,"max":8.0,"unit":"%"},{"name":"防御","min":3.0,"max":6.0,"unit":"%"}],"subOptions":[{"name":"技能伤害值","min":5.0,"max":10.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"暴击率","min":10,"max":10,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"振作士气","description":"启动暴击伤害，我方全部人员暴击率提升1倍并持续3秒。该技能每8秒启动1次。"}],"skill":{"name":"皇家敕命","description":"召唤皇室秘密武器发射灵光，对目标敌人造成范围伤害，并附带击飞效果。","levels":[2,5],"damage":[290.0,560.0],"cooldown":[11.9,11.0],"ailment":"击飞"}}],"number":1}],"profile":{"Age":[19],"Height":[159],"Weight":[43]},"tribes":["人类"],"story":"阿依莎，坎特伯雷王国对手拉赫帝国的第7位皇女。\n\n在众多兄弟姐妹中脱颖而出，成为备受瞩目的皇位继承人。传闻皇帝偏爱第七女，阿依莎以德才兼备的谋略家面貌展露锋芒，平息了传闻。领导人培训成绩最优异，对国内外局势变动了如指掌，心怀治理帝国的明确方针和目标，年纪尚幼，却足以让所有人认定阿依莎为下一任帝国领导。\n\n体格娇小，但语气果断且铿锵有力，冷漠的外表与冰冷的语气更具有服众的威力。","storyKey":"profile_steam_princess_story","sources":{"hero":"heroes.json / OriginId=119","profile":"heroprofile.json / OriginId=119","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}