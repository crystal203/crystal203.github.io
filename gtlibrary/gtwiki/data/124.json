d!"],"jaJP":["こ、こ、こういうのは、ま、まだ早いでしょう？！"]},"keys":["Voice_uptown_lancer_girl_1_TouchReactionBad1","cv_uptown_lancer_girl_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["停，停下！不许动！！"],"enUS":["Stop, stop! Don't move!!"],"jaJP":["す、ストップ！動かないで…"]},"keys":["Voice_uptown_lancer_girl_1_TouchReactionBad2","cv_uptown_lancer_girl_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["有新邮件！一起来看看，怎么样？"],"enUS":["New mail! Shall we check it together?"],"jaJP":["新しいメールが届いたわ！一緒に確認してみない？"]},"keys":["Voice_uptown_lancer_girl_1_NoticeMail","cv_uptown_lancer_girl_NoticeMail"]},{"type":"NoticeEvent","label":"活动提示","texts":{"zhCN":["活动…！能和大家一起出发了！"],"enUS":["An event! I can't wait to meet new people!"],"jaJP":["イベントね…！みんなで一緒に行きましょう？"]},"keys":["cv_uptown_lancer_girl_NoticeEvent"]},{"type":"SummonSpeech1","label":"召唤-台词1","texts":{"zhCN":["其实，我是瞒着爸爸到这里的。"],"enUS":["Frankly, my father doesn't know that I'm here."],"jaJP":["実は、お父様には内緒でここに来てるの"]},"keys":["cv_uptown_lancer_girl_SummonSpeech1"]},{"type":"SummonSpeech2","label":"召唤-台词2","texts":{"zhCN":["但想成为厉害的人，就该阅历丰富。"],"enUS":["But to be a good lord, you need diverse experience."],"jaJP":["立派な領主になるなら経験が必要でしょ？"]},"keys":["cv_uptown_lancer_girl_SummonSpeech2"]},{"type":"SummonSpeech3","label":"召唤-台词3","texts":{"zhCN":["爸爸肯定会理解的！没错吧？"],"enUS":["I'm sure father will understand! Right?"],"jaJP":["きっと、お父様もわかってくれるわ！"]},"keys":["cv_uptown_lancer_girl_SummonSpeech3"]}]}]}
