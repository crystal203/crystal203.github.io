lues":[702.7800000000001,771.6800000000002],"grows":true},{"name":"光属性攻击","values":[265,291],"baseValues":[265.2,291.20000000000005],"grows":true},{"name":"暴击率","values":[6,6],"unit":"%"},{"name":"防御","values":[14,16],"baseValues":[14.280000000000001,15.680000000000001],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"生命","min":8.0,"max":22.0,"unit":"%"},{"name":"防御","min":8.0,"max":22.0,"unit":"%"},{"name":"技能伤害值","min":8.0,"max":20.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":5.0,"max":12.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"佩戴武器时，英雄的职业技能随着武器而变。\n- 队伍能力切换为[c][F8E8CB]近程伤害提升[-][/c]；\n- 普通攻击切换为[c][F8E8CB]闪耀光芒[-][/c]；\n- 连锁技能切换为[c][F8E8CB]永恒阳光[-][/c]；\n- 特殊能力切换为[c][F8E8CB]纯净之心[-][/c]。"}],"skill":{"name":"艳阳当空","description":"投出旋转的太阳伞，对敌人造成近程伤害并附带重伤效果。","levels":[1,5],"damage":[150.0,250.0],"cooldown":[10.5,8.5],"ailment":"重伤"}}],"number":2}],"profile":{"Age":[20],"Height":[170],"Weight":[53]},"tribes":["人类"],"story":"拉碧丝，出身名门的贵族骑士。\n\n保守贵族家庭的掌上明珠，对男女不公的社会、经济地位表示质疑。从小固执，哥哥做什么，她就照着做，父母出于无奈，也让她参加了骑士培训。上学时，曾发表激进言论，而陷于困境。\n\n想了解比自己所处社会环境更为丰富多彩的外边世界的渴望尤为热切，一心想外出参与冒险，尽显自己出众的骑士才华。父母却强烈反对最疼爱的女儿离家涉险，因此，每每用华丽的穿着掩饰，假装出门散步，偷偷探险。怕随身佩剑容易被父母发现，故而改造日常用品或饰品作为武器。\n\n利用挺拔的身材和修长的四肢进行范围攻击。","storyKey":"profile_uptown_lancer_girl_story","sources":{"hero":"heroes.json / OriginId=124","profile":"heroprofile.json / OriginId=124","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}