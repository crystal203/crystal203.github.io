lues":[702.7800000000001,771.6800000000002],"grows":true},{"name":"光属性攻击","values":[265,291],"baseValues":[265.2,291.20000000000005],"grows":true},{"name":"暴击率","values":[6,6],"unit":"%"},{"name":"防御","values":[14,16],"baseValues":[14.280000000000001,15.680000000000001],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"生命","min":8.0,"max":22.0,"unit":"%"},{"name":"防御","min":8.0,"max":22.0,"unit":"%"},{"name":"技能伤害值","min":8.0,"max":20.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":5.0,"max":12.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"佩戴武器时，英雄的职业技能随着武器而变。\n- 队伍能力切换为[c][F8E8CB]近程伤害提升[-][/c]；\n- 普通攻击切换为[c][F8E8CB]闪耀光芒[-][/c]；\n- 连锁技能切换为[c][F8E8CB]永恒阳光[-][/c]；\n- 特殊能力切换为[c][F8E8CB]纯净之心[-][/c]。"}],"skill":{"name":"艳阳当空","description":"投出旋转的太阳伞，对敌人造成近程伤害并附带重伤效果。","levels":[1,5],"damage":[150.0,250.0],"cooldown":[10.5,8.5],"ailment":"重伤"}}],"number":2}],"profile":{"Age":[20],"Height":[170],"Weight":[53]},"tribes":["人类"],"story":"拉碧丝，出身名门的贵族骑士。\n\n保守贵族家庭的掌上明珠，对男女不公的社会、经济地位表示质疑。从小固执，哥哥做什么，她就照着做，父母出于无奈，也让她参加了骑士培训。上学时，曾发表激进言论，而陷于困境。\n\n想了解比自己所处社会环境更为丰富多彩的外边世界的渴望尤为热切，一心想外出参与冒险，尽显自己出众的骑士才华。父母却强烈反对最疼爱的女儿离家涉险，因此，每每用华丽的穿着掩饰，假装出门散步，偷偷探险。怕随身佩剑容易被父母发现，故而改造日常用品或饰品作为武器。\n\n利用挺拔的身材和修长的四肢进行范围攻击。","storyKey":"profile_uptown_lancer_girl_story","sources":{"hero":"heroes.json / OriginId=124","profile":"heroprofile.json / OriginId=124","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"uptown_lancer_girl","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["仅此而已，轻松解决，呼呼。"],"enUS":["That was easy. Huhu."],"jaJP":["ふふっ、楽な相手だったわね"]},"keys":["cv_uptown_lancer_girl_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["虽说是敌人，但你们还不赖嘛～"],"enUS":["That wasn't bad at all?"],"jaJP":["敵ながら見事だったわ、褒めてあげる"]},"keys":["cv_uptown_lancer_girl_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["新的世界…即将来临…"],"enUS":["A new world… Is coming…"],"jaJP":["新しい世界が…来る、はず…"]},"keys":["cv_uptown_lancer_girl_Die"]},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["好！乘胜追击！"],"enUS":["Good! Let's keep this up!"],"jaJP":["この勢いに乗って行きましょう！"]},"keys":["cv_uptown_lancer_girl_GetExp"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["为了所有人，我必须变得更强！"],"enUS":["I have to get stronger for everyone."],"jaJP":["皆のためにもっと強くならないと…！"]},"keys":["cv_uptown_lancer_girl_LevelUp"]},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["好久没有碰到这么好的装备了！"],"enUS":["I haven't seen such a nice weapon in a long time!"],"jaJP":["こんなに良い装備を使わせてくれるなんて！"]},"keys":["cv_uptown_lancer_girl_EquipWeapon"]},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["我，我想我应该试试新东西，才能了解大家的想法。"],"enUS":["I, I guess I should try new things to blend in with the masses!"],"jaJP":["み、民衆を理解するためには、こういう経験も必要なんでしょう…！？"]},"keys":["cv_uptown_lancer_girl_EquipCostume"]},{"type":"Evolve","label":"进化","texts":{"zhCN":["为了保护大家…！"],"enUS":["I need to be strong to protect the people!"],"jaJP":["もっと強くなれるわ…みんなを守るためなら！"]},"keys":["cv_uptown_lancer_girl_Evolve"]},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["喝！"],"enUS":["Hup!"],"jaJP":["はっ！"]},"keys":["cv_uptown_lancer_girl_Attack1"]},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["好慢！"],"enUS":["You're slow!"],"jaJP":["遅いっ！"]},"keys":["cv_uptown_lancer_girl_Attack2"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["喝啊！"],"enUS":["Haat!"],"jaJP":["はーっ！"]},"keys":["cv_uptown_lancer_girl_Attack3"]},{"type":"Skill1","label":"技能1","texts":{"zhCN":["锋利的剑，敏锐的心！"],"enUS":["Sharp sword! Sharp mind!"],"jaJP":["素早く、正確に！"]},"keys":["cv_uptown_lancer_girl_Skill1"]},{"t