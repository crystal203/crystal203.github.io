ame":"原版立绘","asset":{"key":"illust:illust_summer_loraine","skin":null},"stage":null},{"name":"日服立绘","asset":{"key":"illust:illust_summer_loraine_kong","skin":null},"stage":null}],"costumes":[{"id":10353,"code":"summer_loraine_doctor","name":"海滩医生罗兰茵","type":"时装","sprite":{"sheet":"characters","name":"summer_loraine_doctor"},"asset":{"key":"character:summer_loraine_doctor","skin":null}},{"id":10436,"code":"summer_loraine_blackpirate","name":"恐怖海盗罗兰茵","type":"时装","sprite":{"sheet":"characters","name":"summer_loraine_blackpirate"},"asset":{"key":"character:summer_loraine_blackpirate","skin":null}},{"id":10530,"code":"summer_loraine_chrismasparty","name":"圣诞庆典罗兰茵","type":"时装","sprite":{"sheet":"characters","name":"summer_loraine_chrismasparty"},"asset":{"key":"character:summer_loraine_chrismasparty","skin":null}}],"weapons":[{"code":"cwp_summerloraine","name":"海之呼唤","type":"篮子","variants":[{"id":9050424,"code":"cwp_summerloraine_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_summerloraine"},"stats":[{"name":"每秒伤害","values":[562,617],"baseValues":[561.7395,616.8120000000001],"grows":true},{"name":"虚属性攻击","values":[134,147],"baseValues":[133.7475,146.86],"grows":true},{"name":"暴击率","values":[5,5],"unit":"%"},{"name":"恢复能力","values":[202,202],"baseValues":[202,202],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"技能伤害值","min":8.0,"max":22.0,"unit":"%"},{"name":"武器技能恢复速度","min":8.0,"max":20.0,"unit":"%"},{"name":"防御","min":6.0,"max":18.0,"unit":"%"}],"subOptions":[{"name":"生命","min":6.0,"max":16.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"“全军出击”命中目标时，暴击率提升15%并持续3秒；该效果最多重叠3次。当叠加次数达到上限时，暴击伤害倍数提升50%并持续3秒。"}],"skill":{"name":"地精突击","description":"召唤一群地精向前冲击，造成远程伤害并附带击倒效果。","levels":[3,6],"damage":[185.0,245.0],"cooldown":[10.1,9.2],"ailment":"击倒"}}],"number":1}],"profile":{"Age":null,"Height":[165],"Weight":[56]},"tribes":["？"],"story":"夏日旅馆老板娘——罗兰茵！今年夏天将为大家献上美好的海滩回忆！\n\n罗兰茵身为旅馆老板娘每天都要夜以继日地工作，她从不面露疲惫之色，总是面带神秘微笑迎接冒险家客人。虽然罗兰茵没有表现出来，但即使是她偶尔也想抛下手中繁忙的工作，好好给自己放个假，只是一直没有时间。\n\n罗兰茵已经好几年没有度假了，今年她决定让自己轻松一下。为此罗兰茵制造出了原本只存在于图纸上的新型机器人，第一个娱乐型机器人。就这样，有别于以往主要负责战斗及家务的MK系列，专为庆典而生的特殊机器人AA72问世了。看到做事积极主动的AA系列，深受感动的罗兰茵在卡马逊订购了特制泳装，为她换上了一件新衣裳。\n\n然而，得知AA72在海滩失踪时，罗兰茵一反常态，显得十分惊慌。因为从来没有机器人会独自离家出走，而且AA72身上还未配备主要零件——冷却装置。罗兰茵立即指派其他机器人在海滩进行搜索，同时还向救生员请求了帮助。但她没想到的是，这位救生员竟然带着AA72逃走了。\n\n罗兰茵度完假回到浮游城后，首先重建了机器人之间的工作交接体系。为预防类似事件再次发生，她采取了“加强交接流程管理、新建业务监控系统、增设业务认证系统”等一系列措施，于是不健全的机器人业务体系在多方面得到了完善。但这也引来了一些机器人的抱怨，他们没想到出去玩一趟回来后工作会变得更加繁琐。没过多久，心存不满的机器人都被罗兰茵叫到了面谈室，此后再也没有人敢说个不字。\n\n今年，罗兰茵被《夏日焦点》杂志评选为“冉冉升起的新时尚女性”第一名。索菲听到这个消息后愤愤不平，她大闹海滩，一直嚷嚷着“为什么第一名不是我”。相反，罗兰茵却显得非常淡定，她表示这种排名无关紧要。但是，据一名女仆机器人所言，她在罗兰茵的房间里发现了一本可疑的相册，而里面珍藏着有关罗兰茵的焦点访谈专题剪报。","storyKey":"profile_summer_loraine_story","sources":{"hero":"heroes.json / OriginId=473","profile":"heroprofile.json / OriginId=473","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}