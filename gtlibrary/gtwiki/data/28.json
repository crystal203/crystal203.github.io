":null}}],"weapons":[{"code":"cwp_leaffairy","name":"奥伯伦","type":"弓","variants":[{"id":9040244,"code":"cwp_leaffairy_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_leaffairy"},"stats":[{"name":"每秒伤害","values":[617,678],"baseValues":[617.1,677.6000000000001],"grows":true},{"name":"土属性攻击","values":[281,308],"baseValues":[280.5,308.00000000000006],"grows":true},{"name":"暴击率","values":[10,10],"unit":"%"},{"name":"恢复能力","values":[206,206],"baseValues":[206,206],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"恢复能力","min":7.0,"max":15.0,"unit":"%"},{"name":"生命","min":8.0,"max":20.0,"unit":"%"},{"name":"技能伤害值","min":8.0,"max":20.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":4.0,"max":18.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"恢复能力","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"治愈之花","description":"花瓣箭命中目标时，以20%概率，按照每秒伤害的20%造成伤害，并按照恢复能力的20%恢复我方全部人员生命。"}],"skill":{"name":"精灵之王箭","description":"发射藤蔓成长箭，对目标敌人造成范围伤害，并附带击飞效果。","levels":[2,5],"damage":[140.0,200.0],"cooldown":[8.0,8.0],"ailment":"击飞"}}],"number":1}],"profile":{"Age":[99],"Height":[155],"Weight":[45]},"tribes":["妖精"],"story":"青叶，守护森林之花的森林妖精。\n\n花园护理是她的专长，做事懒散是她的特长。青叶花半个小时马马虎虎栽培的花朵远比其他妖精花2个小时精心栽培的花朵还要鲜艳。青叶整天想着有没有办法不动一根手指也能照料花朵，终于造出魔法喷水设备自动浇花，用自动化系统完成守护花园的工作。利用剩余时间，沉迷于人界漫画，游手好闲。\n\n据青叶自己的说法，这并不是因为自己懒，或嫌麻烦，而是为了“更有效地工作”。","storyKey":"profile_leaf_fairy_story","sources":{"hero":"heroes.json / OriginId=28","profile":"heroprofile.json / OriginId=28","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}