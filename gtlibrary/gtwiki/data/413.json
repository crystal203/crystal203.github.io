rite":{"sheet":"characters","name":"lifeguard_yuze_prestige_reward_3"},"asset":{"key":"character:lifeguard_yuze_prestige_reward_3","skin":null}}],"weapons":[{"code":"cwp_lifeguardyuze","name":"海洋守护者","type":"双手剑","variants":[{"id":9020434,"code":"cwp_lifeguardyuze_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_lifeguardyuze"},"stats":[{"name":"每秒伤害","values":[777,853],"baseValues":[776.6279999999999,852.7680000000003],"grows":true},{"name":"水属性攻击","values":[288,316],"baseValues":[287.64,315.84000000000003],"grows":true},{"name":"暴击率","values":[8,8],"unit":"%"},{"name":"防御","values":[13,15],"baseValues":[13.463999999999999,14.784],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"防御","min":8.0,"max":20.0,"unit":"%"},{"name":"生命","min":8.0,"max":20.0,"unit":"%"},{"name":"技能伤害值","min":8.0,"max":20.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":5.0,"max":15.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"技能伤害值","unit":"%","values":[9.0,18.0,27.0,36.0,45.0]}],"effects":[{"name":"专属效果","description":"漩涡的有效范围提升30%。\n位于安全地带的我方人员恢复10%生命，同时该地带我方人员攻击提升30%并持续5秒。"}],"skill":{"name":"救援行动","description":"向目标敌人跃进，在其周围形成安全地带，对敌人造成近程伤害并附带击倒效果。","levels":[1,5],"damage":[200.0,260.0],"cooldown":[10.0,8.8],"ailment":"击倒"}}],"number":1}],"profile":{"Age":[20],"Height":[163],"Weight":[45]},"tribes":["魅魔"],"story":"超人气救生员——柚子！今年夏天负责整个海滩的安全！\n\n听说，原本是避暑胜地的海滩最近总是出现人员受伤。于是，身为魅魔冒险家的柚子挺身而出，决定成为救生员。虽然没有危险发生，但只要看到柚子站在救生员瞭望塔上用望远镜巡视，大家都会感觉踏实很多，还认为海里的或者海边的所有危险都不复存在了。如果真有意外发生，不管是哪里，柚子都会第一时间来到现场救人。就算是全身出汗、衣服被海水打湿，柚子也不会停下救援的脚步！多亏柚子的帮助，就算是出现散步途中被某人打中、或是游泳时突然被某人的榴弹命中掉进海里的紧急情况，都会变得安全。\n\n想当年，柚子在冒险的时候曾遇到过不少强大的怪物。凭借对付这些怪物的精湛技巧以及强大的臂力，她可以沉着冷静地应对每一次突发事件，即使面对鲨鱼或是索菲也不例外。柚子的专属救生圈不但可以用魔法治愈伤员，而且可以用魔法攻击，迅速控制危险因素。\n\n作为救生员，柚子尽职尽责，对工作丝毫不怠慢。与以前当冒险家纽管UP主相比，现在的她可以更快地收集更多的元气，但她实在不懂为什么会这样。柚子唯一想到的可能性是——营救惊心动魄的现场，比纽管UP主的直播更受欢迎。自从索菲出现在海滩，海滩救生员总是缺人，好在这种现象在柚子报名参加救生员活动之后得到了改善。越来越多的人跟随柚子申请成为救生员！现在海滩的安全与危险保持着微妙的平衡，海滩又成为人们快乐度假的场所了，这一切都得益于柚子。","storyKey":"profile_lifeguard_yuze_story","sources":{"hero":"heroes.json / OriginId=413","profile":"heroprofile.json / OriginId=413","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}