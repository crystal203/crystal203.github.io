rite":{"sheet":"characters","name":"lifeguard_yuze_prestige_reward_3"},"asset":{"key":"character:lifeguard_yuze_prestige_reward_3","skin":null}}],"weapons":[{"code":"cwp_lifeguardyuze","name":"海洋守护者","type":"双手剑","variants":[{"id":9020434,"code":"cwp_lifeguardyuze_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_lifeguardyuze"},"stats":[{"name":"每秒伤害","values":[777,853],"baseValues":[776.6279999999999,852.7680000000003],"grows":true},{"name":"水属性攻击","values":[288,316],"baseValues":[287.64,315.84000000000003],"grows":true},{"name":"暴击率","values":[8,8],"unit":"%"},{"name":"防御","values":[13,15],"baseValues":[13.463999999999999,14.784],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"防御","min":8.0,"max":20.0,"unit":"%"},{"name":"生命","min":8.0,"max":20.0,"unit":"%"},{"name":"技能伤害值","min":8.0,"max":20.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":5.0,"max":15.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"技能伤害值","unit":"%","values":[9.0,18.0,27.0,36.0,45.0]}],"effects":[{"name":"专属效果","description":"漩涡的有效范围提升30%。\n位于安全地带的我方人员恢复10%生命，同时该地带我方人员攻击提升30%并持续5秒。"}],"skill":{"name":"救援行动","description":"向目标敌人跃进，在其周围形成安全地带，对敌人造成近程伤害并附带击倒效果。","levels":[1,5],"damage":[200.0,260.0],"cooldown":[10.0,8.8],"ailment":"击倒"}}],"number":1}],"profile":{"Age":[20],"Height":[163],"Weight":[45]},"tribes":["魅魔"],"story":"超人气救生员——柚子！今年夏天负责整个海滩的安全！\n\n听说，原本是避暑胜地的海滩最近总是出现人员受伤。于是，身为魅魔冒险家的柚子挺身而出，决定成为救生员。虽然没有危险发生，但只要看到柚子站在救生员瞭望塔上用望远镜巡视，大家都会感觉踏实很多，还认为海里的或者海边的所有危险都不复存在了。如果真有意外发生，不管是哪里，柚子都会第一时间来到现场救人。就算是全身出汗、衣服被海水打湿，柚子也不会停下救援的脚步！多亏柚子的帮助，就算是出现散步途中被某人打中、或是游泳时突然被某人的榴弹命中掉进海里的紧急情况，都会变得安全。\n\n想当年，柚子在冒险的时候曾遇到过不少强大的怪物。凭借对付这些怪物的精湛技巧以及强大的臂力，她可以沉着冷静地应对每一次突发事件，即使面对鲨鱼或是索菲也不例外。柚子的专属救生圈不但可以用魔法治愈伤员，而且可以用魔法攻击，迅速控制危险因素。\n\n作为救生员，柚子尽职尽责，对工作丝毫不怠慢。与以前当冒险家纽管UP主相比，现在的她可以更快地收集更多的元气，但她实在不懂为什么会这样。柚子唯一想到的可能性是——营救惊心动魄的现场，比纽管UP主的直播更受欢迎。自从索菲出现在海滩，海滩救生员总是缺人，好在这种现象在柚子报名参加救生员活动之后得到了改善。越来越多的人跟随柚子申请成为救生员！现在海滩的安全与危险保持着微妙的平衡，海滩又成为人们快乐度假的场所了，这一切都得益于柚子。","storyKey":"profile_lifeguard_yuze_story","sources":{"hero":"heroes.json / OriginId=413","profile":"heroprofile.json / OriginId=413","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"lifeguard_yuze","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["营救完毕！"],"enUS":["Rescue complete!"],"jaJP":["救助完了っと！"]},"keys":["cv_lifeguard_yuze_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["所有避暑的游客都安全了，一切恢复正常！"],"enUS":["All summer vacationers are safe!"],"jaJP":["安全確認！異状な～し！"]},"keys":["cv_lifeguard_yuze_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["又有谁能来救…救生员呢…？"],"enUS":["Who's gonna rescue… The lifeguard…?"],"jaJP":["ライフガードの安全は…誰が守ってくれるのよ…？"]},"keys":["cv_lifeguard_yuze_Die"]},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["好极了！"],"enUS":["All right!"],"jaJP":["うふふっ…やったー！"]},"keys":["cv_lifeguard_yuze_GetExp"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["我准备好了！"],"enUS":["I’m ready to go!"],"jaJP":["準備バッチリ！"]},"keys":["cv_lifeguard_yuze_LevelUp"]},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["用它打败鲨鱼也没问题？！"],"enUS":["I could take down a shark with this!"],"jaJP":["サメだってドンとこい、だよっ！"]},"keys":["cv_lifeguard_yuze_EquipWeapon"]},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["啊，新制服？我好喜欢耶！"],"enUS":["Is it a new uniform? I love it! "],"jaJP":["新しいユニフォーム？うん、気にいったよ！"]},"keys":["cv_lifeguard_yuze_EquipCostume"]},{"type":"Evolve","label":"进化","texts":{"zhCN":["我天生就是救生员！"],"enUS":["I think lifeguarding's the perfect job for me!"],"jaJP":["ライフガードって、わたしの天職かも！"]},"keys":["cv_lifeguard_yuze_Evolve"]},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["咿呀！"],"enUS":["I-yat!"],"jaJP":["やーん！"]},"keys":["cv_lifeguard_yuze_Attack1"]},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["嘿呦！"],"enUS":["Hi-yaat!"],"jaJP":["んっしょ！"]},"keys":["cv_lifeguard_yuze_Attack2"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["是这边！"],"enUS":["Over here!"],"jaJP":["そこっ！"]},"keys":["cv_lifeguard_yuze_Attack3"]},{"type":"Skill1","label":"技能1","texts":{"zhCN":["我来了！"],"enUS":["I’m on my way!"],"jaJP":["いっくよー！"]},"keys":["cv_lifeguard_yuze_Skill1"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["抓紧啦！"],"enUS":["Hold tight!"],"jaJP":["ざっぱ～ん！"]},"keys":["cv_lifeguard_yuze_Skill2"]},{"type":"Damaged1","label":"受到攻击1","texts":{"zhCN":["呃啊…！"],"enUS":["Ugh…!"],"jaJP":["はげしっ…！"]},"keys":["cv_lifeguard_yuze_Damaged1"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["哎呀…！"],"enUS":["Oww…!"],"jaJP":["いったーい…！"]},"keys":["cv_lifeguard_yuze_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["不愧是我的搭档！"],"enUS":["That’s my partner for ya!"],"jaJP":["さっすがわたしの相棒！"]},"keys":["cv_lifeguard_yuze_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["搭档…你游泳时撞到头了吗…？"],"enUS":["Hey, partner… Did you hit your head while swimming…?"],"jaJP":["相棒…もしかして泳いでるとき、頭でも打った？"]},"keys":["cv_lifeguard_yuze_PlayerChooseDark"]},{"type":"WeakEnemyBattleStart","label":"与弱小敌人战斗","texts":{"zhCN":["不像是紧急情况吧…？"],"enUS":["It doesn’t look like an emergency… does it?"],"jaJP":["緊急…！ってワケじゃなさそうね"]},"keys":["cv_lifeguard_yuze_WeakEnemyBattleStart"]},{"type":"NormalEnemyBattleStart","label":"与普通敌人战斗","texts":{"zhCN":["有人遇到麻烦了！我来处理！"],"enUS":["Someone's in trouble! I’m on it!"],"jaJP":["緊急事態発生！わたしが行きます！"]},"keys":["cv_lifeguard_yuze_NormalEnemyBattleStart"]},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["前方出现强大敌人！我来保护受伤人员！"],"enUS":["Giant enemy ahead! I’ll tend to the injured!"],"jaJP":["前方に巨大な影発見！負傷者を確認するね！"]},"keys":["cv_lifeguard_yuze_StrongEnemyBattleStart"]},{"type":"BossBattleStart","label":"与首领战斗","texts":{"zhCN":["前方出现首领…！搭档，请你竭尽全力！"],"enUS":["Boss ahead…! Partner, give all you’ve got!"],"jaJP":["前方にボス確認！相棒、全力でやっちゃえ！"]},"keys":["cv_lifeguard_yuze_BossBattleStart"]},{"type":"JoinParty","label":"首次加入队伍","texts":{"zhCN":["搭档！如果你在海滩需要帮忙，就来找我吧！不管什么事我都可以帮你噢！"],"enUS":["Hey, partner! Call me when you need help on the beach! Whatever it is!"],"jaJP":["相棒！ビーチで何かあったら呼んでね！なんでもしてあげる！"]},"keys":["cv_lifeguard_yuze_JoinParty"]},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["上！开始攻击！"],"enUS":["Attack! Let’s go!"],"jaJP":["行くよっ！突撃ぃー！"]},"keys":["cv_lifeguard_yuze_CoopAttack"]},{"type":"CoopHeal","label":"战斗-请求治疗","texts":{"zhCN":["辅助！我需要支援～！"],"enUS":["Healer! I need backup!"],"jaJP":["ヒーラー！支援お願いっ！"]},"keys":["cv_lifeguard_yuze_CoopHeal"]},{"type":"CoopRun","label":"战斗-注意","texts":{"zhCN":["快跑！"],"enUS":["Run!"],"jaJP":["みんな逃げて！"]},"keys":["cv_lifeguard_yuze_CoopRun"]},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["这次胜利是属于大家的！"],"enUS":["We all did it together!"],"jaJP":["みんなの勝利だよ！"]},"keys":["cv_lifeguard_yuze_CoopWin"]},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["我很高兴没有人受伤！"],"enUS":["I’m just glad none of you got hurt!"],"jaJP":["みんな無事なのが、一番うれしいよ！"]},"keys":["cv_lifeguard_yuze_CoopMVP"]},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["我们一起享受愉快安全的暑假吧！"],"enUS":["Let’s have a safe and fun summer vacation!"],"jaJP":["海で一緒に「楽しいこと」しようね？"]},"keys":["cv_lifeguard_yuze_CoopHi"]},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["快点，快点啦！"],"enUS":["Come on, come on!"],"jaJP":["ねえ、はやく早く！"]},"keys":["cv_lifeguard_yuze_CoopHurryUp"]},{"type":"CoopBelieve","label":"战斗-信任","texts":{"zhCN":["海滩的安全由我全权负责！"],"enUS":["I’ll be in charge of the beach’s safety!"],"jaJP":["ビーチの安全は、わたしに任せてね！"]},"keys":["cv_lifeguard_yuze_CoopBelieve"]},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["搭档，剧烈运动之前不要忘了热身！明白吗？"],"enUS":["Hey partner, don’t forget to stretch before swimming! Okay?"],"jaJP":["相棒、「激しい運動」の前にはちゃーんと準備運動しないとだよ！知ってるよね？"]},"keys":["Voice_lifeguard_yuze_1_TouchReactionGood1"