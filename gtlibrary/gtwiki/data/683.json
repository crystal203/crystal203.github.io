"cwp_nelluru"},"stats":[{"name":"每秒伤害","values":[657,721],"baseValues":[656.625,721.0000000000001],"grows":true},{"name":"火属性攻击","values":[159,175],"baseValues":[159.375,175.00000000000003],"grows":true},{"name":"暴击率","values":[3,3],"unit":"%"},{"name":"防御","values":[31,34],"baseValues":[30.6,33.6],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"防御","min":12.0,"max":24.0,"unit":"%"},{"name":"生命","min":10.0,"max":20.0,"unit":"%"},{"name":"武器技能恢复速度","min":6.0,"max":16.0,"unit":"%"}],"subOptions":[{"name":"技能伤害值","min":6.0,"max":16.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"防御","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"受到攻击时，按照每秒伤害的30%造成近程伤害。1秒内仅发动一次。"}],"skill":{"name":"地震","description":"向前移动并大力踩踏地面造成近程伤害，并使其陷入击飞状态。","levels":[1,5],"damage":[170.0,250.0],"cooldown":[10.0,8.0],"ailment":"击飞"}},{"id":9070545,"code":"cwp_nelluru_myth","label":"开花","stars":6,"sprite":{"sheet":"items","name":"cwp_nelluru"},"stats":[{"name":"每秒伤害","values":[816,895],"baseValues":[815.52825,895.4820000000001],"grows":true},{"name":"火属性攻击","values":[198,217],"baseValues":[197.94375,217.35000000000002],"grows":true},{"name":"暴击率","values":[3,3],"unit":"%"},{"name":"防御","values":[37,40],"baseValues":[36.72,40.32000000000001],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"防御","min":12.0,"max":24.0,"unit":"%"},{"name":"生命","min":10.0,"max":20.0,"unit":"%"},{"name":"武器技能恢复速度","min":6.0,"max":16.0,"unit":"%"}],"subOptions":[{"name":"技能伤害值","min":6.0,"max":16.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"防御","min":15.0,"max":15.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"受到攻击时，按照每秒伤害的30%造成近程伤害。1秒内仅发动一次。\n使用地震时，恢复10%除自身以外的其他存活人员的生命。"}],"skill":{"name":"地震","description":"向前移动并大力踩踏地面造成近程伤害，并使其陷入击飞状态。","levels":[1,5],"damage":[270.0,270.0],"cooldown":[10.0,8.0],"ailment":"击飞"}}],"number":1}],"profile":{"Age":null,"Height":null,"Weight":null},"tribes":["？"],"story":"涅尔自出生起便是奴隶，因为她的母亲本就是山贼团“乌鸦”的奴隶。山贼们轻蔑笨拙迟钝的涅尔，将她当作畜生般对待。对涅尔而言，她唯一的长处，就是照顾婴儿。天生比他人更强烈的母性，让她主动承担起照料被山贼们掳来的婴儿的工作。只有在照看婴儿的那些时刻，她才能感觉自己是有用的存在。\n\n某天，她又被托付照顾一名婴儿。那名婴儿正是被山贼团绑架的王族之子“卢纳”。涅尔像往常一样喂奶、哄睡、照顾卢纳。而卢纳的保护者魔兽王克伦，也被俘在山贼团的据点中，但涅尔并不知晓他的真实身份。即便当克伦亲自出现在涅尔面前，邀请她离开山贼团、作为卢纳的乳母随他同行时，涅尔也无法理解这番提议的真正含义。\n\n虽然涅尔拒绝了邀请，却因此被栽赃诬陷为憧憬外面的世界而背叛了山贼团，被推入处刑的危机。即便在临死前，涅尔仍试图从山贼手中保护卢纳。\n\n克伦从涅尔身上感受到她是一个“有用的存在”，于是以“涅露露”之名将她复活。重生后她拥有了强健的身体。据阿莉西亚所说，看着涅露露照顾卢纳，会让人不由自主的感到幸福。","storyKey":"profile_nelluru_story","sources":{"hero":"heroes.json / OriginId=683","profile":"heroprofile.json / OriginId=683","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"nelluru","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["总算是……连我也成功把它打倒了。"],"enUS":[],"jaJP":[]},"keys":["cv_nelluru_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["竟敢伤害我宝贵的伙伴，绝对不可饶恕。"],"enUS":[],"jaJP":[]},"keys":["cv_nelluru_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["主人…您赐予我的生命，我却…对不起…"],"enUS":[],"jaJP":[]},"keys":["cv_nelluru_Die"]},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["好漂亮，卢纳少爷，但不能放进嘴里哟。"],"enUS":[],"jaJP":[]},"keys":["cv_nelluru_GetExp"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["哇，感觉浑身充满了力量。"],"enUS":[],"jaJP":[]},"keys":["cv_nelluru_LevelUp"]},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["这武器看起来好厉害，真的要给我吗！？"],"enUS":[],"jaJP":[]},"keys":["cv_nelluru_EquipWeapon"]},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["这、这么贵重的东西，我这样的人也可以穿吗？"],"en