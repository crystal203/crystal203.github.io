":8.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"暴击率","min":10,"max":10,"unit":"%"}],"engrave":[],"engraveRandom":[],"effects":[{"name":"爆破子弹","description":"狙击大师命中目标时，引起爆破并按照每秒伤害的40%造成额外远程伤害。\n处于谨慎射击状态时，暴击伤害倍数提升50%。"}],"skill":{"name":"榴弹","description":"发射榴弹对敌人造成范围伤害，并附带效果。","levels":[3,6],"damage":null,"cooldown":[4.5,4.5],"ailment":""}}],"number":1},{"code":"cwp_sniper","name":"协商者","type":"步枪","variants":[{"id":9030484,"code":"cwp_sniper_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_sniper"},"stats":[{"name":"每秒伤害","values":[115,126],"baseValues":[114.95400000408,126.22400000447999],"grows":true},{"name":"土属性攻击","values":[96,105],"baseValues":[95.7950000034,105.1866666704],"grows":true},{"name":"暴击率","values":[20,20],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"技能伤害值","min":8.0,"max":24.0,"unit":"%"},{"name":"武器技能恢复速度","min":6.0,"max":18.0,"unit":"%"},{"name":"生命","min":4.0,"max":10.0,"unit":"%"}],"subOptions":[{"name":"防御","min":2.0,"max":8.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"暴击率","min":10,"max":10,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"爆破子弹","description":"狙击大师命中目标时，引起爆破并按照每秒伤害的40%造成额外远程伤害。\n处于谨慎射击状态时，暴击伤害倍数提升50%。"}],"skill":{"name":"呼叫战术支援","description":"呼叫卫星射线，对敌人造成远程伤害并附带击倒效果。","levels":[2,5],"damage":[280.0,400.0],"cooldown":[11.75,11.0],"ailment":"击倒"}}],"number":1}],"profile":{"Age":[27],"Height":[170],"Weight":[52]},"tribes":["人类"],"story":"赫卡忒，狙击高手。\n\n赫卡忒最为看重的是金钱。赚大钱与潇洒自由消费，是赫卡忒人生一大乐趣。执迷于高价奢侈品，‘难道花我自己赚来的钱，也要看别人脸色吗？’。轻松赚取巨额报酬的狙击手，对赫卡忒来讲，是最理想的职业。认为用狙击枪赚来的钱财比被自己击中而亡的人还重要。\n\n作为狙击手，赫卡忒在饱经风霜之后，变得有点愤世嫉俗，加上她性格豪爽，反而得到了不少人的青睐，成为别人心目中的‘酷大姐’。年轻女性尤为羡慕，将她视为憧憬的对象。","storyKey":"profile_sniper_story","sources":{"hero":"heroes.json / OriginId=36","profile":"heroprofile.json / OriginId=36","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}