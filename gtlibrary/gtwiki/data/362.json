name":"future_princess_chocolate"},"asset":{"key":"character:future_princess_chocolate","skin":null}},{"id":10600,"code":"future_princess_painter","name":"流浪画家未来公主","type":"时装","sprite":{"sheet":"characters","name":"future_princess_painter"},"asset":{"key":"character:future_princess_painter","skin":null}},{"id":18001,"code":"future_princess_prestige_reward_1","name":"小小未来公主","type":"时装","sprite":{"sheet":"characters","name":"future_princess_prestige_reward_1"},"asset":{"key":"character:future_princess_prestige_reward_1","skin":null}},{"id":19005,"code":"future_princess_dress","name":"花嫁礼服未来公主","type":"时装","sprite":{"sheet":"characters","name":"future_princess_dress"},"asset":{"key":"character:future_princess_dress","skin":null}},{"id":19009,"code":"future_princess_pv_costume","name":"宴会礼服未来公主","type":"时装","sprite":{"sheet":"characters","name":"future_princess_pv_costume"},"asset":{"key":"character:future_princess_pv_costume","skin":null}},{"id":170023,"code":"future_princess_maestra","name":"指挥家未来公主","type":"超级时装","sprite":{"sheet":"characters","name":"future_princess_maestra"},"asset":{"key":"character:future_princess_maestra","skin":null}},{"id":179001,"code":"future_princess_seal_pajamas","name":"海豹睡衣未来公主","type":"超级时装","sprite":{"sheet":"characters","name":"future_princess_seal_pajamas"},"asset":{"key":"character:future_princess_seal_pajamas","skin":null}}],"weapons":[{"code":"cwp_futureprincess","name":"解放者","type":"法杖","variants":[{"id":9060494,"code":"cwp_futureprincess_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_futureprincess"},"stats":[{"name":"每秒伤害","values":[584,641],"baseValues":[583.6950001071001,640.9200001176001],"grows":true},{"name":"光属性攻击","values":[185,203],"baseValues":[185.30000003400002,203.46666670400003],"grows":true},{"name":"暴击率","values":[5,5],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"武器技能恢复速度","min":8.0,"max":20.0,"unit":"%"},{"name":"技能伤害值","min":5.0,"max":15.0,"unit":"%"},{"name":"生命","min":8.0,"max":20.0,"unit":"%"}],"subOptions":[{"name":"防御","min":5.0,"max":15.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"命中目标时，以40%概率，按照每秒伤害的30%造成额外近程伤害；此外，英雄自身恢复2%生命，除英雄以外的我方人员恢复6%生命。\n使用时空风暴时，我方人员攻击提升20%并持续8秒。"}],"skill":{"name":"时空风暴","description":"借助时空威力引起巨大风暴，造成近程伤害并附带重伤效果。","levels":[3,7],"damage":[180.0,300.0],"cooldown":[13.5,13.5],"ailment":"重伤"}}],"number":1}],"profile":{"Age":[20],"Height":[161],"Weight":[47]},"tribes":["人类"],"story":"十年后，未来的坎特伯雷公主终于和来到未来浮游城的守护者重逢了。曾经那个无忧无虑跑遍浮游城每个角落的小公主，现在已经长大了。\n\n身为守护者的你离开浮游城之后，踏上拉赫帝国冒险之旅，却再也没有回来。小公主曾听到拉赫帝国人厌恶坎特伯雷人的传闻，这更让她感到不安。记得上一次你用拉赫帝国公用电话与她通话时说一切安好，小公主还在电话里为你加油助威。当时，不知骑士去向的小公主难以抚平忐忑不安的心，笃定拉赫帝国人及其皇帝对你下了毒手。就在此时，阿依莎高喊着“拉赫帝国与坎特伯雷成为友好同盟”出现在小公主面前。阿依莎与夏皮拉告诉小公主，你比她们早一步离开了拉赫帝国，还以为你已经回到了浮游城。\n\n年仅10岁的小公主无法理解这突如其来的离别究竟为何，也没有人告诉过她“坦然接受”反而是应对良策。小公主只能一直等下去。她相信骑士不会忘记自己的使命，总有一天骑士会归来，一如既往地第一个和她打招呼。不过，浮游城里调皮的孩子却欺负她，还说：“你的骑士逃跑了。你姐姐和骑士都讨厌你，他们不要你了。”温顺的小公主听到这些刺耳的话也会变得凶巴巴，拼了命似的将他们赶走，回到旅馆，就会放声大哭。小公主撕心裂肺的哭声让冷漠的罗兰茵都会感到心疼。一时间谣言四起，有人说你死了，有人说你逃走了，也有人说你恪守本分，不管在哪里都会履行自己的义务。小公主不相信任何人说的话，她只相信暂时陷入迷途的守护者终究会回到自己的身边。但是日复一日，年复一年，小公主所坚信的愿望终于支离破碎。因为太过信任，小公主所承受的打击是旁人无法体会的。\n\n一晃又过了几年，整日以泪洗面，等待杳无音讯之人的小公主逐渐心碎泪干，勉强挤出来的泪水也只是因为怨恨和对背信弃义的憎恨。要是你还在这里，这几年发生的一切悲剧或许能避免。浮游城沦为人类的最后一道防线，并肩作战的伙伴们一一逝去，只留下名字和墓碑。而敌人根本不给小公主喘息的机会，一波波不断来袭。长大的公主变成了为拯救人类而孤军奋战的军人，现在，她是志在收复灭亡国家领土的反抗军领袖。在骑士团长伊娃的严格训练下，公主长大后成为坚定的领袖，脸上却经常交替地闪过对沉重负担的压抑、严肃、疲劳，儿时天真烂漫的笑容早已不见踪影。","storyKey":"profile_future_princess_story","sources":{"hero":"heroes.json / OriginId=362","profile":"heroprofile.json / OriginId=362","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}