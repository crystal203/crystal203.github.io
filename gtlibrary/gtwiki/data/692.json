s":true},{"name":"水属性攻击","values":[234,257],"baseValues":[234.36540000000002,257.34240000000005],"grows":true},{"name":"暴击率","values":[7,7],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"防御","min":6.0,"max":18.0,"unit":"%"},{"name":"生命","min":5.0,"max":16.0,"unit":"%"},{"name":"武器技能恢复速度","min":4.0,"max":14.0,"unit":"%"}],"subOptions":[{"name":"技能伤害值","min":8.0,"max":22.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"英雄自身使用武器技能时，所有队伍成员攻击提升30%，持续7秒。\n队伍成员使用武器技能时，所有队伍成员的暴击率提升10%，持续7秒；若使用武器技能的成员为水属性英雄，则额外使所有水属性成员暴击伤害倍数提升25%，持续7秒。\n雷芒的伤害提升至每秒伤害的70%。"}],"skill":{"name":"惊涛雷爆","description":"引动雷电与水流爆发，对敌人造成近程伤害，并使其进入击飞状态。","levels":[3,7],"damage":[260.0,260.0],"cooldown":[10.0,8.4],"ailment":"击飞"}}],"number":1}],"profile":{"Age":null,"Height":null,"Weight":null},"tribes":["鲤鱼"],"story":"金鳞儿虽是弱小的鲤鱼仙人，但也是一位乐于助人、心怀正义的神仙。\n\n很久很久以前，在消逝之都的仙山之巅有一座巨大的瀑布和一道“门”。这道门凝聚着被称为“天地灵气”的磅礴力量，并周期性地将灵气倾泻入瀑布，激起强烈的波动。每当此时，生活在附近的鲤鱼仙人们便会聚集而来逆流而上，借助那凝聚的力量能让他们蜕变为“龙”。然而这场化龙仪式也伴随着巨大的危险，若是在攀登瀑布时被欲望吞噬，便可能在登上瀑布后化为只会肆意破坏的“孽龙”。\n\n金鳞儿也是来攀登瀑布的仙人之一。准确来说，就算是在被称为下位仙人的鲤鱼仙人中，她也算是最为弱小的一个。她天生的体质难以积攒道力，不仅修行速度缓慢，她那孩童般的身躯也不再继续成长。即便如此，金鳞儿也从未放弃，始终坚持修行，每逢“龙门”开启之日，她都会前来攀登瀑布。她坚信，弱小如自己尚且能修成仙人，必是天意使然，因此一心想要化身为龙，造福世间。\n\n就这样漫长岁月过去，龙门开启之日再次到来。金鳞儿再度攀登瀑布并暗下决心，这次一定要登上瀑布顶端……途中，为了救助陷入危难的生灵，她耗尽了辛苦积攒的道力，却也破天荒地抵达了最后的关卡。然而金鳞儿最终还是未能登顶。因为在她之前登顶的另一位仙人化为了孽龙，开始大肆破坏，摧毁了瀑布与龙门。\n\n即便如此，金鳞儿也没有气馁。一如既往地，她先选择救助身处险境的百姓，以仙人之躯挺身挡在孽龙身前，守护身后无辜的平民。如同奇迹一般……凝聚的天地灵气降临到了金鳞儿身上，让她短暂地变成了真正的神龙。凭借这股力量，金鳞儿成功制服并净化了孽龙。在那之后，金鳞儿不再执着于化龙，她领悟到，并非只有成为全能的龙才能帮助他人，即便是弱小的鲤鱼仙人，也同样可以做到。\n\n在被烧毁的村庄恢复安定后，金鳞儿告别了依依不舍的村民们，离开了消逝之都。她决定在更广阔的世界中，一边帮助遇到困难的人们，一边继续修行。然而事与愿违，每次金鳞儿想要帮助人们时都会遇到难题……因为她那孩童般的外表，没有人相信她是神仙。又不能每次都施展道术来证明自己的仙人身份，无奈之下她只好通过滔滔不绝地讲述各种渊博知识和古老传说，以此证明自己“年纪有多大”。每次费尽口舌才终于获得助人的机会时，金鳞儿虽然会怀着喜悦的心情帮助大家……但同时也会陷入一种难以言喻的挫败感。","storyKey":"profile_carp_girl_story","sources":{"hero":"heroes.json / OriginId=692","profile":"heroprofile.json / OriginId=692","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"carp_girl","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["嗯！看来顺顺当当地解决了呐！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["这次就点到为止，可下次我不会这么仁慈咯！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["已经…没劲儿起身了…"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_Die"]},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["哦…原来道力，是能这么积累的啊…"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_GetExp"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["虽说我知道这样有点贪心…可照这样下去，说不定…我真能化龙呢～"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_LevelUp"]},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["呦，这么重的礼儿，我实在受之有愧…来日，我必定报答你！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_EquipWeapon"]},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["这、这身花衣裳也太让人难为情了…我都说了，我不是小孩儿！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_EquipCostume"]},{"type":"Evolve","label":"进化","texts":{"zhCN":["得亏您了…我才有了新的感悟…！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_Evolve"]},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["哈！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_Attack1"]},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["喝！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_Attack2"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["呀！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_Attack3"]},{"type":"Skill1","label":"技能1","texts":{"zhCN":["威势惊人…！天雷，降临呐！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_Skill1"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["不断壮大吧！雷霆一闪！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_Skill2"]},{"type":"Damaged1","label":"受到攻击1","texts":{"zhCN":["哎哟…！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_Damaged1"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["哎呀…！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["呵呵，年纪轻轻便有这般心性，实属不易呀！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["你究竟…做了什么…！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_PlayerChooseDark"]},{"type":"WeakEnemyBattleStart","label":"与弱小敌人战斗","texts":{"zhCN":["真是些可怜又可悲的家伙…！就由我来亲自指引你们吧！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_WeakEnemyBattleStart"]},{"type":"NormalEnemyBattleStart","label":"与普通敌人战斗","texts":{"zhCN":["既然避无可避，便由我来纠正你们的顽劣本性！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_NormalEnemyBattleStart"]},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["竟敢仗势欺人，嘲弄弱小…真是岂有此理！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_StrongEnemyBattleStart"]},{"type":"BossBattleStart","label":"与首领战斗","texts":{"zhCN":["我一定会驱散那首领身上的邪气，一定…！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_BossBattleStart"]},{"type":"JoinParty","label":"首次加入队伍","texts":{"zhCN":["竟能寻得志同道合的伙伴…简直就像在做梦一样～"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_JoinParty"]},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["轮到我们了！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_CoopAttack"]},{"type":"CoopHeal","label":"战斗-请求治疗","texts":{"zhCN":["唔，治疗就拜托你了…！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_CoopHeal"]},{"type":"CoopRun","label":"战斗-注意","texts":{"zhCN":["快逃吧…！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_CoopRun"]},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["我们…我们赢了！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_CoopWin"]},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["唉，甭这么抬举我的…真让人不好意思…！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_CoopMVP"]},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["莫要抱有太大期待，不过…我定会全力以赴！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_CoopHi"]},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["快点行动吧…！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_CoopHurryUp"]},{"type":"CoopBelieve","label":"战斗-信任","texts":{"zhCN":["莫要担心！交由我来解决吧！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_CoopBelieve"]},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["若你真的感念我的恩情，便去帮助那些落难之人吧。这便是世间相扶相助之道啊！"],"enUS":[],"jaJP":[]},"keys":["Voice_carp_girl_1_TouchReactionGood1","cv_carp_girl_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["红鲤鱼，绿鲤鱼，金鳞鲤鱼戏溪里，金鲤嬉戏鲤鲤嘻，鲤跃龙门龙迎鲤。"],"enUS":[],"jaJP":[]},"keys":["Voice_carp_girl_1_TouchReactionGood2","cv_carp_girl_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["有时深感惋惜…若神龙之力尚存，不知能救助多少人啊…"],"enUS":[],"jaJP":[]},"keys":["Voice_carp_girl_1_TouchReactionBad1","cv_carp_girl_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["哎呦喂…！鲤鱼“奶奶”？！我在仙人里头可是顶年轻的，可不准再这样喊了，哼！"],"enUS":[],"jaJP":[]},"keys":["Voice_carp_girl_1_TouchReactionBad2","cv_carp_girl_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["有书信寄来了…如今已不再用信鸽了吗？"],"enUS":[],"jaJP":[]},"keys":["Voice_carp_girl_1_NoticeMail","cv_carp_girl_NoticeMail"]},{"type":"NoticeEvent","label":"活动提示","texts":{"zhCN":["我曾听瓮仙前辈说过，活动可是件大好事儿哩！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_NoticeEvent"]},{"type":"SummonSpeech1","label":"召唤-台词1","texts":{"zhCN":["跨越瀑布与云霄，我还是头一回来到这么高的地方呢…"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_SummonSpeech1"]},{"type":"SummonSpeech2","label":"召唤-台词2","texts":{"zhCN":["我乃在凡尘中修行的鲤鱼仙人，金鳞儿！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_SummonSpeech2"]},{"type":"SummonSpeech3","label":"召唤-台词3","texts":{"zhCN":["能参与这造福世间的事，我甚是欣喜！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_SummonSpeech3"]}]},{"id":"carp_girl_myth","label":"开花","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["唔～嗯～你往后再也甭起坏心思儿了！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_myth_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["越是强大的力量，越得慎重使用，好好反省吧您呐！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_myth_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["既然已经尽力了，那就被什么遗憾的了。"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_myth_Die"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["能为更多人带去福泽，全都是托您的福呐！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_myth_LevelUp"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["我来助你！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_myth_Attack3"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["你可招架不住！看好了！破邪之雷，镇！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_myth_Skill2"]},{"type":"LeaderSkill","label":"队长技能","texts":{"zhCN":["金龙再次苏醒…净化万物！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_myth_LeaderSkill"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["何等恶行…！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_myth_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["每回瞧见你行善，我都倍感欣慰。"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_myth_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["这次便暂且饶过你。若再执迷不悟，休怪我不客气咯！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_myth_PlayerChooseDark"]},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["那股强大的力量，对你而言反是祸害…就让我来助你一臂之力吧！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_myth_StrongEnemyBattleStart"]},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["发起攻势吧！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_myth_CoopAttack"]},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["嗯！正因我们齐心协力，方能克敌制胜！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_myth_CoopWin"]},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["竟然得了头筹…宛若化身成龙，甚为欣喜！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_myth_CoopMVP"]},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["请诸位拭目以待！我会助各位一臂之力！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_myth_CoopHi"]},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["莫要掉队了…！"],"enUS":[],"jaJP":[]},"keys":["cv_carp_girl_myth_CoopHurryUp"]},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["若你真的感念我的恩情，便去帮助那些落难之人吧。这便是世间相扶相助之道啊！"],"enUS":[],"jaJP":[]},"keys":["Voice_carp_girl_myth_1_TouchReactionGood1","cv_carp_girl_myth_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["形容扶摇而上的龙，四个字该怎么叫？准得是“飞龙在天”呀！"],"enUS":[],"jaJP":[]},"keys":["Voice_carp_girl_myth_1_TouchReactionGood2","cv_carp_girl_myth_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["有时深感惋惜…若神龙之力尚存，不知能救助多少人啊…"],"enUS":[],"jaJP":[]},"keys":["Voice_carp_girl_myth_1_TouchReactionBad1","cv_carp_girl_myth_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["嘿…又喊我“奶奶”…你已经喊了2次了！再喊我奶奶会发生很可怕的事哦…"],"enUS":[],"jaJP":[]},"keys":["Voice_carp_girl_myth_1_TouchReactionBad2","cv_carp_girl_myth_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["有书信寄来了…如今已不再用信鸽了吗？"],"enUS":[],"jaJP":[]},"keys":["Voice_carp_girl_myth_1_NoticeMail"]}]}]}
