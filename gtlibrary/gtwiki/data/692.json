{"id":"carp_girl","originId":692,"name":"福运金鲤金鳞儿","englishName":"","title":"","shortName":"金鳞儿","description":"","introduction":"","element":"水","role":"战士","weaponsAllowed":["法杖","饰品"],"portrait":{"sheet":"portraits","name":"carp_girl"},"stages":[{"id":692,"name":"carp_girl_3","label":"3星","stars":3,"asset":{"key":"character:carp_girl","skin":"carp_girl_3"},"sprite":{"sheet":"characters","name":"carp_girl_3"},"stats":{"Hp":1083.392,"Atk":1.201888,"Def":28.7776,"Recovery":0,"StatGrowthRate":1.02},"skills":[{"kind":"普通攻击","name":"鲤鱼道法","description":"落瀑：掀起汹涌的水浪对敌人造成近程伤害。命中时降低目标30%水属性抵抗，持续3秒，并使其进入湿润状态。\n雷芒：凝聚出剑形的雷电，对敌人造成近程伤害。"},{"name":"惊雷破","description":"发射凝聚的雷电，按照每秒伤害的420%造成近程伤害。","kind":"连锁技能","trigger":"击飞","connect":"击倒"}],"party":[{"id":10600,"name":"水属性攻击","base":12.0,"max":25.0,"unit":"%","level":120,"maxLevel":250,"baseCoefficient":0,"levelCoefficient":0.1,"maxLabel":"满进化 · 满觉醒"}],"skillSets":[{"number":1,"skills":[{"kind":"普通攻击","name":"鲤鱼道法","description":"落瀑：掀起汹涌的水浪对敌人造成近程伤害。命中时降低目标30%水属性抵抗，持续3秒，并使其进入湿润状态。\n雷芒：凝聚出剑形的雷电，对敌人造成近程伤害。"},{"name":"惊雷破","description":"发射凝聚的雷电，按照每秒伤害的420%造成近程伤害。","kind":"连锁技能","trigger":"击飞","connect":"击倒"}],"party":[{"id":10600,"name":"水属性攻击","base":12.0,"max":25.0,"unit":"%","level":120,"maxLevel":250,"baseCoefficient":0,"levelCoefficient":0.1,"maxLabel":"满进化 · 满觉醒"}]}],"options":[{"id":10600,"level":120,"name":"队伍水属性攻击提升"}]},{"id":693,"name":"carp_girl_4","label":"4星","stars":4,"asset":{"key":"character:carp_girl","skin":"carp_girl_4"},"sprite":{"sheet":"characters","name":"carp_girl_4"},"stats":{"Hp":1177.6,"Atk":1.3064,"Def":31.28,"Recovery":0,"StatGrowthRate":1.02},"skills":[{"kind":"普通攻击","name":"鲤鱼道法","description":"落瀑：掀起汹涌的水浪对敌人造成近程伤害。命中时降低目标30%水属性抵抗，持续3秒，并使其进入湿润状态。\n雷芒：凝聚出剑形的雷电，对敌人造成近程伤害。"},{"name":"惊雷破","description":"发射凝聚的雷电，按照每秒伤害的420%造成近程伤害。","kind":"连锁技能","trigger":"击飞","connect":"击倒"}],"party":[{"id":10600,"name":"水属性攻击","base":25.0,"max":25.0,"unit":"%","level":250,"maxLevel":250,"baseCoefficient":0,"levelCoeffici