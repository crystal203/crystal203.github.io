ent":""}],"party":[{"id":100002,"name":"防御","base":23.0,"max":45.0,"unit":"%","level":230,"maxLevel":450,"baseCoefficient":0,"levelCoefficient":0.1,"maxLabel":"满进化 · 满觉醒"}]}],"options":[{"id":100002,"level":230,"name":"队伍防御提升"},{"id":320599,"level":null,"name":"舭龙骨"}]}],"illustrations":[{"name":"原版立绘","asset":{"key":"illust:illust_boatracing_girl","skin":null},"stage":null}],"costumes":[{"id":10494,"code":"boatracing_girl_bluerose_assassin","name":"蓝玫瑰刺客瑞秋","type":"时装","sprite":{"sheet":"characters","name":"boatracing_girl_bluerose_assassin"},"asset":{"key":"character:boatracing_girl_bluerose_assassin","skin":null}}],"weapons":[{"code":"cwp_boatracinggirl","name":"星河奖杯","type":"单手剑","variants":[{"id":9010664,"code":"cwp_boatracinggirl_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_boatracinggirl"},"stats":[{"name":"每秒伤害","values":[594,653],"baseValues":[594.4050000000001,652.6800000000001],"grows":true},{"name":"水属性攻击","values":[189,207],"baseValues":[188.70000000000002,207.20000000000002],"grows":true},{"name":"暴击率","values":[5,5],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"防御","min":4.0,"max":12.0,"unit":"%"},{"name":"生命","min":4.0,"max":12.0,"unit":"%"},{"name":"技能伤害值","min":3.0,"max":10.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":3.0,"max":12.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"回击的威力提升至每秒伤害的170%，并适用异常状态数值。\n使用夺旗竞速时，攻击提升30%并持续5秒。"}],"skill":{"name":"夺旗竞速","description":"向旗帜突进，对敌人造成近程伤害并附带击飞效果。","levels":[1,5],"damage":[100.0,160.0],"cooldown":[8.0,6.0],"ailment":"击飞"}}],"number":1}],"profile":{"Age":[28],"Height":[169],"Weight":[52]},"tribes":["半精灵"],"story":"海滩竞速——瑞秋！今年夏天将驾驶赛艇驰骋于浩瀚的海面上，享受海风吹拂带来的爽快！\n\n瑞秋与守护者一同击败了绑架孩子们的灰须，并将孩子们送回了家人的怀抱。瑞秋勇敢救人的行为感动了那些孩子们，他们对瑞秋心生敬佩，没多久便成为了红玫瑰海贼团的一员，跟着瑞秋一起踏上了冒险之旅。然而，就在他们宣布启航，准备正式出海的那一天，瑞秋才意识到她和她的船员们还没有身为海贼最重要的东西：一艘属于自己的船。\n\n于是，赶忙跑到造船厂的瑞秋，立刻订制了一艘威武壮观的海贼船，她还特别强调船体一定要画上魅力十足的红玫瑰。但瑞秋没想到的是，红玫瑰海贼团早已被造船厂的工匠们列入了黑名单。工匠们每次要求瑞秋付款时，她总是拿自己以后可能发现的宝藏来抵账。因此，尽管这次瑞秋订制的船是每一位工匠都梦寐以求的巨型帆船，但没有一个人愿意为她来造。\n\n急需用钱的瑞秋发挥自身优势，成功找到了一份鸭鸭船救生员的工作。有一次，瑞秋在工作时接到了举报，游客的鸭鸭船被一名来历不明的男子抢走。她便立刻驾驶一艘海边剩下的鸭鸭船，快速向被抢走的船追了过去。在颠簸的鸭鸭船上，瑞秋意外地遇见了她的老船长——灰须。因为瑞秋的背叛而瓦解的灰须海贼团，本想借助鸭鸭船东山再起，不曾想，这次瑞秋又成功阻止了灰须的计划。火冒三丈的灰须直接驾驶鸭鸭船撞向了瑞秋，就这样，两艘鸭鸭船都遭受了严重损坏。\n\n见到瑞秋带着两艘破船回来，老板大发雷霆。但是，抓住了灰须的瑞秋却显得非常自豪，游客们也都欢呼起来，纷纷为她英勇的行为鼓掌。最终，老板只好送给瑞秋一艘她渴望已久的船，作为救生员工作以及抓住灰须的酬劳。虽然这艘船又破又旧，但这丝毫不影响红玫瑰海贼团的首次启航。\n\n目标是在群星岛上举行的最佳船长竞赛——星河竞速！红玫瑰海贼团将在汪洋大海上展开史诗冒险！","storyKey":"profile_boatracing_girl_story","sources":{"hero":"heroes.json / OriginId=599","profile":"heroprofile.json / OriginId=599","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"boatracing_girl","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["对最强竞速者来说，这简直是小菜一碟！"],"enUS":["What a breeze for the best racer!"],"jaJP":["最高のレーサーなら、これくらい楽勝よ！"]},"keys":["cv_boatracing_girl_NormalBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/599/5990001@-9126962040643938951"],"enUS":["cdn/Android/ondemand/voices_en/599/5990001"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/599/5990001@3071571782346650573"]},"audioName":"5990001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["没有什么障碍物可以阻挡我前进的步伐！"],"enUS":["No obstacle can stop me!"],"jaJP":["私を止められる障害物なんてないわ！"]},"keys":["cv_boatracing_girl_BossBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/599/5990002@-7284755031091217265"],"enUS":["cdn/Android/ondemand/voices_en/599/5990002"],"jaJP":["o