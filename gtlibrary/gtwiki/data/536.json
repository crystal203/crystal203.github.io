d":10417,"code":"mermaid_seahorse_doll","name":"海马人偶汐雅","type":"时装","sprite":{"sheet":"characters","name":"mermaid_seahorse_doll"},"asset":{"key":"character:mermaid_seahorse_doll","skin":null}},{"id":10418,"code":"mermaid_summer_beach","name":"复古时装汐雅","type":"时装","sprite":{"sheet":"characters","name":"mermaid_summer_beach"},"asset":{"key":"character:mermaid_summer_beach","skin":null}},{"id":10450,"code":"mermaid_snowboard","name":"单板滑雪选手汐雅","type":"时装","sprite":{"sheet":"characters","name":"mermaid_snowboard"},"asset":{"key":"character:mermaid_snowboard","skin":null}},{"id":10509,"code":"mermaid_festival","name":"庆典金鱼汐雅","type":"时装","sprite":{"sheet":"characters","name":"mermaid_festival"},"asset":{"key":"character:mermaid_festival","skin":null}}],"weapons":[{"code":"cwp_mermaid","name":"海洋之泪","type":"篮子","variants":[{"id":9050464,"code":"cwp_mermaid_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_mermaid"},"stats":[{"name":"每秒伤害","values":[536,588],"baseValues":[535.8059999999999,588.3360000000001],"grows":true},{"name":"水属性攻击","values":[131,144],"baseValues":[131.325,144.20000000000002],"grows":true},{"name":"暴击率","values":[2,2],"unit":"%"},{"name":"恢复能力","values":[220,220],"baseValues":[220,220],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"恢复能力","min":8.0,"max":24.0,"unit":"%"},{"name":"生命","min":6.0,"max":18.0,"unit":"%"},{"name":"技能伤害值","min":6.0,"max":16.0,"unit":"%"}],"subOptions":[{"name":"防御","min":6.0,"max":18.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"生命","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"恢复能力","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"泡泡爆破命中目标时，我方全部人员攻击提升30%并持续5秒。该技能每5秒启动1次。\n泡泡浴命中目标时，按照恢复能力的30%恢复被命中队员的生命并持续3秒。"}],"skill":{"name":"惊涛骇浪","description":"制造升腾而起的水柱，对敌人造成远程伤害并附带重伤效果。","levels":[3,6],"damage":[220.0,280.0],"cooldown":[8.4,7.5],"ailment":"重伤"}}],"number":1}],"profile":{"Age":[136],"Height":[172],"Weight":[65]},"tribes":["人鱼"],"story":"海洋杂货商汐雅，她是一名环游世界收集物品，再把这些东西当作商品出售的商人。\n\n汐雅的爱好是收集稀有物品，不管是海洋里还是陆地上，哪里有珍贵的东西，哪里就有汐雅的身影。从小时候起，汐雅就喜欢在海里寻找不易被人们发现的珍珠或形状奇特的珊瑚。慢慢地，汐雅对陆地上的奇珍异宝也产生了好奇心，并且明白了想拥有自己喜欢的东西必须用等价值的金钱来购买。为了赚取金钱，汐雅拿出自己的收藏品开始了她的第一笔生意。对陆地上的人们来说，这些只能在深海找到的海洋商品可谓是无价之宝，汐雅的商品大受欢迎，瞬间就被抢了个精光。看到人们因为买到了心仪的商品而露出开心的笑容，汐雅感觉自己获得了满满的成就感。找到人生价值的她下定决心，将做生意视为天职，从此开启了经商之路。\n\n汐雅将金钱视为身外之物，也不会刻意费心思打扮自己。平时出门做生意，她总是穿一身简约朴素的衣服，在地面上铺开渔网和包袱就开始做起生意。然而有些心怀不轨的人们看到汐雅这副模样，认为她很好欺负，因此会故意上门找茬。但善良的汐雅不愿与他人发生争执，她会顺着对方的意愿，降低商品价格或者同意缴纳摊位费。汐雅宁愿自己受点损失，也不想为难别人，她会尽量避免引发事端。但随着时间的推移，城市交易所的飞速发展让汐雅难以适应，人员增长造成的频繁争吵更是让她精疲力竭。在这种情况下，汐雅根本无法专心做生意，最终她只得离开大城市到偏远地区，寻找可以安静摆摊的地方。后来，在商业圈流传着这样一个传闻——汐雅是一位销售稀世珍宝的商人，但想见她一面却比登天还难。\n\n每年，汐雅都会去某个海滩小村做一次生意，没什么特别的事情，她就会在那里停留一些时日。汐雅离开大城市后来到了一个郊外的小村庄，无论是所在位置还是规模，这个小村庄都不适合做生意。但这里的村民格外淳朴，他们真心喜欢汐雅带来的商品，还拿出了茶水和点心招待汐雅。村民们的热情接待让她感动万分，自那以后，汐雅每年都会来到这个小村庄，她和村民们的关系也变得越来越亲近。在村庄做生意时，汐雅不仅会帮助村民们解决村里的问题，有时她也会跟村民们一起玩乐。为了答谢她为村庄所做出的努力，村民们送了一辆移动摊位车给汐雅。曾经因为搬运沉重货物吃了不少苦的汐雅，收到这样的礼物自然是喜出望外，甚至感动得流下了眼泪。对汐雅而言，这个小村庄是比任何一座大城市都重要的地方。\n\n在小村庄的经历让汐雅身上发生了巨大变化。随着时代的变迁，原本宁静安详的小村庄也迎来了快速发展。每年来海滩小村避暑的游客日益增多，汐雅也因此被卷入了大大小小的事件中。如果是在别的地方碰到这些麻烦，她肯定立刻转身就走。但这个小村庄对汐雅有着特殊的意义，她不能抛弃村庄独自离去。渐渐地，汐雅意识到一味地逃避并不是解决矛盾的有效方法。为了不再让别人小看自己，汐雅开始注重穿衣打扮，并且利用在长期经商中锻炼出的口才和人鱼与生俱来的力量，勇敢地去应对那些威胁村庄和平的冲突。","storyKey":"profile_mermaid_story","sources":{"hero":"heroes.json / OriginId=536","profile":"heroprofile.json / OriginId=536","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"mermaid","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["难道，没有更安全的地方吗…"],"enUS":["Is there a place where we might be safer…"],"jaJP":["あの、もう少し安全な道を探したほうが…"]},"keys":["cv_mermaid_NormalBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/536/5360001@1727965062734557573"],"enUS":["cdn/Android/ondemand/voices_en/536/5360001"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/536/5360001@1915394155279677813"]},"audioName":"5360001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["我、我做到了！以后你要乖乖听我的！"],"enUS":["G, Got em! Promise to behave now!"],"jaJP":["た、倒せました！このまま大人しくしていてくださいね！"]},"keys":["cv_mermaid_BossBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/536/5360002@2099599316586685921"],"enUS":["cdn/Android/ondemand/voices_en/536/5360002"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/536/5360002@-466762338313726236"]},"audioName":"5360002"},{"type":"Die","label":"阵亡","texts":{"zhCN":["打架…是笨蛋们才会做的事…"],"enUS":["Fighting… It’s so foolish…"],"jaJP":["戦いなんて、バカみたい…"]},"keys":["cv_mermaid_Die"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/536/5360003@-4669096132996606322"],"enUS":["cdn/Android/ondemand/voices_en/536/5360003"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/536/5360003@3570966372839159943"]},"audioName":"5360003"},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["嘻嘻～你看中哪件商品了吖？"],"enUS":["Hey, what's behind all this flattery?"],"jaJP":["こんなにしてくれるなんて…でも、値引きなんてしないですからね"]},"keys":["cv_mermaid_GetExp"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/536/5360004@6290920768382763543"],"enUS":["cdn/Android/ondemand/voices_en/536/5360004"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/536/5360004@3374427256751833636"]},"audioName":"5360004"},{"type":"LevelUp","label":"升级","texts":{"zhCN":["有了这样的尾鳍，谁还会羡慕摩托艇啊？"],"enUS":["With a tail like this, I wouldn’t be jealous of a motorboat!"],"jaJP":["また一段と強くなりました！ヒレも立派になって、モーターボートにだって負けません！"]},"keys":["cv_mermaid_LevelUp"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/536/5360005@-2231209728833617882"],"enUS":["cdn/Android/ondemand/voices_en/536/5360005"],"jaJ