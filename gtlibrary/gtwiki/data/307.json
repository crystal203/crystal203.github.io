e},{"name":"暗属性攻击","values":[270,296],"baseValues":[269.583552,296.01331200000004],"grows":true},{"name":"暴击率","values":[10,10],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"生命","min":5.0,"max":15.0,"unit":"%"},{"name":"防御","min":5.0,"max":15.0,"unit":"%"},{"name":"武器技能恢复速度","min":6.0,"max":20.0,"unit":"%"}],"subOptions":[{"name":"技能伤害值","min":6.0,"max":20.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"技能伤害值","unit":"%","values":[9.0,18.0,27.0,36.0,45.0]}],"effects":[{"name":"专属效果","description":"攻击时，每3秒发射一次特殊榴弹，按照每秒伤害的90%，额外造成远程伤害。"}],"skill":{"name":"溅射等离子榴弹","description":"发射最多溅射3次的特殊榴弹，对敌人造成伤害，并附带重伤效果。","levels":[1,5],"damage":[245.0,245.0],"cooldown":[8.0,7.5],"ailment":"重伤"}}],"number":1}],"profile":{"Age":[21],"Height":[166],"Weight":[54]},"tribes":["半精灵"],"story":"红斗篷团伙阿拉贝尔，黑帮团伙“水库蟒蛇”最年轻领导人。\n\n她实力备受认可，是让其他组员闻风丧胆的冷血刺客，内心深处藏有对人类与世界的极大憎恨。想讲述阿拉贝尔短暂而艰难坎坷的人生，通宵达旦也讲不完。小时候，不知为何被父母遗弃，10岁时被嗜赌如命的养父卖到“水库蟒蛇”抵债。“伟大的奶奶”收养了阿拉贝尔，将其身体改造成行凶武器。几天几夜的煎熬，阿拉贝尔眼前漆黑，几度昏厥过去。醒来之后，阿拉贝尔发现自己拥有了无人能比的坚强机械身躯。而现在，拥有“蛋白质肉身”的所有常人都是阿拉贝尔鄙视的对象。\n\n得到收养自己并把自己改造成“有用”强者的“奶奶”肯定，享受亲孙女一般疼爱，是阿拉贝尔最大的愿望。见到“伟大的奶奶”第一天收到的红色连帽披风是阿拉贝尔最珍惜的宝贝。“奶奶”的血亲、红斗篷埃尔韦拉一直是阿拉贝尔妒忌的竞争对手。","storyKey":"profile_villain_redhood_story","sources":{"hero":"heroes.json / OriginId=307","profile":"heroprofile.json / OriginId=307","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}