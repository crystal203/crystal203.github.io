racters","name":"alpaca_girl_cat"},"asset":{"key":"character:alpaca_girl_cat","skin":null}},{"id":10290,"code":"alpaca_girl_honeybee","name":"蜜蜂梅丽尔","type":"时装","sprite":{"sheet":"characters","name":"alpaca_girl_honeybee"},"asset":{"key":"character:alpaca_girl_honeybee","skin":null}},{"id":10298,"code":"alpaca_girl_frogcoat","name":"小青蛙雨衣梅丽尔","type":"时装","sprite":{"sheet":"characters","name":"alpaca_girl_frogcoat"},"asset":{"key":"character:alpaca_girl_frogcoat","skin":null}},{"id":10317,"code":"alpaca_girl_snow_flower","name":"暖冬白雪梅丽尔","type":"时装","sprite":{"sheet":"characters","name":"alpaca_girl_snow_flower"},"asset":{"key":"character:alpaca_girl_snow_flower","skin":null}},{"id":10381,"code":"alpaca_girl_gyaru","name":"辣妹梅丽尔","type":"时装","sprite":{"sheet":"characters","name":"alpaca_girl_gyaru"},"asset":{"key":"character:alpaca_girl_gyaru","skin":null}},{"id":10394,"code":"alpaca_girl_sakura","name":"樱花女神梅丽尔","type":"时装","sprite":{"sheet":"characters","name":"alpaca_girl_sakura"},"asset":{"key":"character:alpaca_girl_sakura","skin":null}},{"id":10447,"code":"alpaca_girl_pino_doll","name":"皮诺人偶梅丽尔","type":"时装","sprite":{"sheet":"characters","name":"alpaca_girl_pino_doll"},"asset":{"key":"character:alpaca_girl_pino_doll","skin":null}},{"id":10556,"code":"alpaca_girl_poncho","name":"斗篷梅丽尔","type":"时装","sprite":{"sheet":"characters","name":"alpaca_girl_poncho"},"asset":{"key":"character:alpaca_girl_poncho","skin":null}},{"id":18004,"code":"alpaca_girl_prestige_reward_4","name":"小小梅丽尔","type":"时装","sprite":{"sheet":"characters","name":"alpaca_girl_prestige_reward_4"},"asset":{"key":"character:alpaca_girl_prestige_reward_4","skin":null}},{"id":170019,"code":"alpaca_girl_cheerleader","name":"鲜花拉拉队队员梅丽尔","type":"超级时装","sprite":{"sheet":"characters","name":"alpaca_girl_cheerleader"},"asset":{"key":"character:alpaca_girl_cheerleader","skin":null}}],"weapons":[{"code":"cwp_alpacagirl","name":"索拉里斯","type":"爪","variants":[{"id":9100324,"code":"cwp_alpacagirl_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_alpacagirl"},"stats":[{"name":"每秒伤害","values":[750,824],"baseValues":[750.0060000581401,823.5360000638402],"grows":true},{"name":"土属性攻击","values":[188,206],"baseValues":[187.971428586,206.400000016],"grows":true},{"name":"暴击率","values":[14,14],"unit":"%"},{"name":"防御","values":[21,23],"baseValues":[20.8,22.880000000000003],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"技能伤害值","min":12.0,"max":30.0,"unit":"%"},{"name":"生命","min":8.0,"max":20.0,"unit":"%"},{"name":"防御","min":4.0,"max":12.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":3.0,"max":15.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"暴击伤害命中目标时，移动速度提升5%，并使目标敌人的土属性抵抗降低5%；该效果持续5秒，最多可叠加4次。"}],"skill":{"name":"落花缤纷","description":"释放武器中凝聚的能量，对敌人造成远程伤害并附带击倒效果。","levels":[1,5],"damage":[165.0,225.0],"cooldown":[9.0,8.0],"ailment":"击倒"}}],"number":1}],"profile":{"Age":null,"Height":[157],"Weight":[46]},"tribes":["神兽"],"story":"梅丽尔，丰收之神卡麦尔的神兽，也是一只拥有花草魔力的羊驼。平时以羊驼的形态伴随芭莉的身边，但她也可以变成人的形态。\n\n除了芭莉，这世上所有东西都是梅丽尔鄙视的对象。梅丽尔总是把牢骚挂在嘴边，她还讨厌人类，甚至连丰收之神卡麦尔也不喜欢。梅丽尔虽然对卡麦尔的精心养育心存感激，但她已经长大了，不想被人管束。不过卡麦尔还是像对待小孩子一样，这也不许那也不许，事事都要过问，真的非常麻烦。卡麦尔希望梅丽尔可以用看芭莉那样的眼神看着他，不用一模一样，只要稍加温柔和体贴就好。但是，梅丽尔只是对着他翻了翻白眼，并且一脸厌烦地吐了口水，希望卡麦尔不要再打扰她。对卡麦尔来说，梅丽尔无止境的叛逆期着实让人太难过了。\n\n梅丽尔不喜欢人类，她无法理解芭莉为什么要帮助那些贪婪的人类，甚至有时候还要消耗自己的幸福记忆作为代价。梅丽尔曾经也喜欢人类，当人们的目光落在她身上时，都会因为她可爱的样子无法自拔。但是很久以前，有一群人假装可怜博得芭莉的同情，还以芭莉的所有记忆作为代价为自己许下了各种心愿。若不是梅丽尔及时出手阻止，保住了芭莉所剩无几的记忆，芭莉很有可能连梅丽尔和卡麦尔都记不得了。从那之后，梅丽尔非常警惕人类，她发誓要保护芭莉，不再受这些自私人类的伤害。\n\n梅丽尔讨厌她的人类形态，她经常抱怨变成人之后诸事不便，还抱怨人类的规矩太繁琐，必须要穿上很多衣服。每回受芭莉之托变成人的模样时，梅丽尔总是满脸不情愿，还故意把衣服穿得歪歪扭扭。芭莉看到了之后，总会替她整理着装，但只要芭莉转过身去，梅丽尔就会上演一场随性穿搭秀。尽管照顾梅丽尔有些麻烦，但在芭莉眼里，梅丽尔永远是一只讨人喜欢的呆萌羊驼。","storyKey":"profile_alpaca_girl_story","sources":{"hero":"heroes.json / OriginId=398","profile":"heroprofile.json / OriginId=398","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"alpaca_girl","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["哼，我又赢啦？"],"enUS":["Hmph. Too easy."],"jaJP":["ふーん、ヨユーヨユー"]},"keys":["cv_alpaca_girl_NormalBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/398/3980001@-8065579269110691532"],"enUS":["cdn/Android/ondemand/voices_en/398/3980001"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/398/3980001@3889002086257050548"]},"audioName":"3980001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["切～没意思，光有一身肌肉…"],"enUS":["Boring, just a huge sandbag…"],"jaJP":["なーんだ、見かけ倒しじゃん"]},"keys":["cv_alpaca_girl_BossBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/398/3980002@-874993771121996695"],"enUS":["cdn/Android/ondemand/voices_en/398/3980002"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/398/3980002@1280949283519760445"]},"audioName":"3980002"},{"type":"Die","label":"阵亡","texts":{"zhCN":["芭莉…卡麦尔…快来帮帮我…！"],"enUS":["Bari… Kamael… help me…"],"jaJP":["バリ…じいじ…助けてよ…"]},"keys":["cv_alpaca_girl_Die"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/398/3980003@4226672455755009837"],"enUS":["cdn/Android/ondemand/voices_en/398/3980003"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/398/3980003@-1882768147082648532"]},"audioName":"3980003"},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["哇这种感觉！和芭莉给我水喝时一样舒服耶！"],"enUS":["Feels like when Bari feeds me water!"],"jaJP":["バリがくれたお水みたい！"]},"keys":["cv_alpaca_girl_GetExp"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/398/3980004@-652341440172628