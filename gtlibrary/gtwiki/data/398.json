racters","name":"alpaca_girl_cat"},"asset":{"key":"character:alpaca_girl_cat","skin":null}},{"id":10290,"code":"alpaca_girl_honeybee","name":"蜜蜂梅丽尔","type":"时装","sprite":{"sheet":"characters","name":"alpaca_girl_honeybee"},"asset":{"key":"character:alpaca_girl_honeybee","skin":null}},{"id":10298,"code":"alpaca_girl_frogcoat","name":"小青蛙雨衣梅丽尔","type":"时装","sprite":{"sheet":"characters","name":"alpaca_girl_frogcoat"},"asset":{"key":"character:alpaca_girl_frogcoat","skin":null}},{"id":10317,"code":"alpaca_girl_snow_flower","name":"暖冬白雪梅丽尔","type":"时装","sprite":{"sheet":"characters","name":"alpaca_girl_snow_flower"},"asset":{"key":"character:alpaca_girl_snow_flower","skin":null}},{"id":10381,"code":"alpaca_girl_gyaru","name":"辣妹梅丽尔","type":"时装","sprite":{"sheet":"characters","name":"alpaca_girl_gyaru"},"asset":{"key":"character:alpaca_girl_gyaru","skin":null}},{"id":10394,"code":"alpaca_girl_sakura","name":"樱花女神梅丽尔","type":"时装","sprite":{"sheet":"characters","name":"alpaca_girl_sakura"},"asset":{"key":"character:alpaca_girl_sakura","skin":null}},{"id":10447,"code":"alpaca_girl_pino_doll","name":"皮诺人偶梅丽尔","type":"时装","sprite":{"sheet":"characters","name":"alpaca_girl_pino_doll"},"asset":{"key":"character:alpaca_girl_pino_doll","skin":null}},{"id":10556,"code":"alpaca_girl_poncho","name":"斗篷梅丽尔","type":"时装","sprite":{"sheet":"characters","name":"alpaca_girl_poncho"},"asset":{"key":"character:alpaca_girl_poncho","skin":null}},{"id":18004,"code":"alpaca_girl_prestige_reward_4","name":"小小梅丽尔","type":"时装","sprite":{"sheet":"characters","name":"alpaca_girl_prestige_reward_4"},"asset":{"key":"character:alpaca_girl_prestige_reward_4","skin":null}},{"id":170019,"code":"alpaca_girl_cheerleader","name":"鲜花拉拉队队员梅丽尔","type":"超级时装","sprite":{"sheet":"characters","name":"alpaca_girl_cheerleader"},"asset":{"key":"character:alpaca_girl_cheerleader","skin":null}}],"weapons":[{"code":"cwp_alpacagirl","name":"索拉里斯","type":"爪","variants":[{"id":9100324,"code":"cwp_alpacagirl_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_alpacagirl"},"stats":[{"name":"每秒伤害","values":[750,824],"baseValues":[750.0060000581401,823.5360000638402],"grows":true},{"name":"土属性攻击","values":[188,206],"baseValues":[187.971428586,206.400000016],"grows":true},{"name":"暴击率","values":[14,14],"unit":"%"},{"name":"防御","values":[21,23],"baseValues":[20.8,22.880000000000003],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"技能伤害值","min":12.0,"max":30.0,"unit":"%"},{"name":"生命","min":8.0,"max":20.0,"unit":"%"},{"name":"防御","min":4.0,"max":12.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":3.0,"max":15.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"暴击伤害命中目标时，移动速度提升5%，并使目标敌人的土属性抵抗降低5%；该效果持续5秒，最多可叠加4次。"}],"skill":{"name":"落花缤纷","description":"释放武器中凝聚的能量，对敌人造成远程伤害并附带击倒效果。","levels":[1,5],"damage":[165.0,225.0],"cooldown":[9.0,8.0],"ailment":"击倒"}}],"number":1}],"profile":{"Age":null,"Height":[157],"Weight":[46]},"tribes":["神兽"],"story":"梅丽尔，丰收之神卡麦尔的神兽，也是一只拥有花草魔力的羊驼。平时以羊驼的形态伴随芭莉的身边，但她也可以变成人的形态。\n\n除了芭莉，这世上所有东西都是梅丽尔鄙视的对象。梅丽尔总是把牢骚挂在嘴边，她还讨厌人类，甚至连丰收之神卡麦尔也不喜欢。梅丽尔虽然对卡麦尔的精心养育心存感激，但她已经长大了，不想被人管束。不过卡麦尔还是像对待小孩子一样，这也不许那也不许，事事都要过问，真的非常麻烦。卡麦尔希望梅丽尔可以用看芭莉那样的眼神看着他，不用一模一样，只要稍加温柔和体贴就好。但是，梅丽尔只是对着他翻了翻白眼，并且一脸厌烦地吐了口水，希望卡麦尔不要再打扰她。对卡麦尔来说，梅丽尔无止境的叛逆期着实让人太难过了。\n\n梅丽尔不喜欢人类，她无法理解芭莉为什么要帮助那些贪婪的人类，甚至有时候还要消耗自己的幸福记忆作为代价。梅丽尔曾经也喜欢人类，当人们的目光落在她身上时，都会因为她可爱的样子无法自拔。但是很久以前，有一群人假装可怜博得芭莉的同情，还以芭莉的所有记忆作为代价为自己许下了各种心愿。若不是梅丽尔及时出手阻止，保住了芭莉所剩无几的记忆，芭莉很有可能连梅丽尔和卡麦尔都记不得了。从那之后，梅丽尔非常警惕人类，她发誓要保护芭莉，不再受这些自私人类的伤害。\n\n梅丽尔讨厌她的人类形态，她经常抱怨变成人之后诸事不便，还抱怨人类的规矩太繁琐，必须要穿上很多衣服。每回受芭莉之托变成人的模样时，梅丽尔总是满脸不情愿，还故意把衣服穿得歪歪扭扭。芭莉看到了之后，总会替她整理着装，但只要芭莉转过身去，梅丽尔就会上演一场随性穿搭秀。尽管照顾梅丽尔有些麻烦，但在芭莉眼里，梅丽尔永远是一只讨人喜欢的呆萌羊驼。","storyKey":"profile_alpaca_girl_story","sources":{"hero":"heroes.json / OriginId=398","profile":"heroprofile.json / OriginId=398","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"alpaca_girl","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["哼，我又赢啦？"],"enUS":["Hmph. Too easy."],"jaJP":["ふーん、ヨユーヨユー"]},"keys":["cv_alpaca_girl_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["切～没意思，光有一身肌肉…"],"enUS":["Boring, just a huge sandbag…"],"jaJP":["なーんだ、見かけ倒しじゃん"]},"keys":["cv_alpaca_girl_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["芭莉…卡麦尔…快来帮帮我…！"],"enUS":["Bari… Kamael… help me…"],"jaJP":["バリ…じいじ…助けてよ…"]},"keys":["cv_alpaca_girl_Die"]},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["哇这种感觉！和芭莉给我水喝时一样舒服耶！"],"enUS":["Feels like when Bari feeds me water!"],"jaJP":["バリがくれたお水みたい！"]},"keys":["cv_alpaca_girl_GetExp"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["咦？我变强大了？"],"enUS":["Huh? I got stronger?"],"jaJP":["あれ？あたし、強くなってる？"]},"keys":["cv_alpaca_girl_LevelUp"]},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["嗯，感觉还不错…"],"enUS":["Well, not bad…"],"jaJP":["ま、悪くはないけどさ…"]},"keys":["cv_alpaca_girl_EquipWeapon"]},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["又是新衣服？人类真麻烦…"],"enUS":["Another costume? Being human is so tedious…"],"jaJP":["新しい服ぅー？人間のカッコって面倒なんだけどなぁー"]},"keys":["cv_alpaca_girl_EquipCostume"]},{"type":"Evolve","label":"进化","texts":{"zhCN":["我什么时候才能变回原形？"],"enUS":["When can I go back to my original form?"],"jaJP":["あたし、そろそろ元の姿に戻りたいんだけどー"]},"keys":["cv_alpaca_girl_Evolve"]},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["切！"],"enUS":["Hmph!"],"jaJP":["ちっ！"]},"keys":["cv_alpaca_girl_Attack1"]},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["咿呀！"],"enUS":["Yiyat!"],"jaJP":["やっ！"]},"keys":["cv_alpaca_girl_Attack2"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["看招！"],"enUS":["Take this!"],"jaJP":["くらえ！"]},"keys":["cv_alpaca_girl_Attack3"]},{"type":"Skill1","label":"技能1","texts":{"zhCN":["我不会让你逃走的！"],"enUS":["I'm not letting you escape!"],"jaJP":["逃がさないんだから！"]},"keys":["cv_alpaca_girl_Skill1"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["呸呸呸！"],"enUS":["Catooh!"],"jaJP":["ぺぇっ！"]},"keys":["cv_alpaca_girl_Skill2"]},{"type":"Damaged1","label":"受到攻击1","texts":{"zhCN":["哎呀…！"],"enUS":["Ugh…!"],"jaJP":["いたいんだけど！"]},"keys":["cv_alpaca_girl_Damaged1"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["什…什么！"],"enUS":["Wha, what!"],"jaJP":["な、なにすんのよ！"]},"keys":["cv_alpaca_girl_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["芭莉告诉我，和你一起冒险，给她带来了幸福的回忆…"],"enUS":["Bari told me your adventure will bring happy memories…"],"jaJP":["バリは、あんたと一緒なら幸せな思い出が増えるって言ってたけどさあ…"]},"keys":["cv_alpaca_girl_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["你…！芭莉最好把你忘得一干二净。"],"enUS":["You…  Bari will be better off not remembering you."],"jaJP":["バリも、こんなヤツのこと忘れちゃえばいいのに…！"]},"keys":["cv_alpaca_girl_PlayerChooseDark"]},{"type":"WeakEnemyBattleStart","label":"与弱小敌人战斗","texts":{"zhCN":["哼！让开！一群小虾米！"],"enUS":["Hmph! Step aside, you wimps!"],"jaJP":["ざこざーこ、はーいどいてどいてー"]},"keys":["cv_alpaca_girl_WeakEnemyBattleStart"]},{"type":"NormalEnemyBattleStart","label":"与普通敌人战斗","texts":{"zhCN":["不知好歹！让你们见识一下神兽的厉害！"],"enUS":["How dare you, fear the almighty divine beast!"],"jaJP":["神獣の力、思い知らせてあげる！"]},"keys":["cv_alpaca_girl_NormalEnemyBattleStart"]},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["别逞强了！我可一点都不怕你！"],"enUS":["Don't act tough! You don't scare me at all!"],"jaJP":["そんなハッタリ、全然怖くないんだからね？"]},"keys":["cv_alpaca_girl_StrongEnemyBattleStart"]},{"type":"BossBattleStart","label":"与首领战斗","texts":{"zhCN":["首领？哼，卡麦尔爷爷说过，绝对不能放过你！"],"enUS":["Boss? No mercy!"],"jaJP":["ボスはとりあえずぶっ飛ばせー、ってじいじが言ってたよー"]},"keys":["cv_alpaca_girl_BossBattleStart"]},{"type":"JoinParty","label":"首次加入队伍","texts":{"zhCN":["切，我可不想跟着你。我是来找芭莉的！"],"enUS":["I'm not here for you, I'm here for Bari!"],"jaJP":["バリと一緒にいたいだけ、あんたなんてどうでもいいの！"]},"keys":["cv_alpaca_girl_JoinParty"]},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["好吧好吧，我来了！"],"enUS":["Okay, here I come!"],"jaJP":["ほら、いくよ！"]},"keys":["cv_alpaca_girl_CoopAttack"]},{"type":"CoopHeal","label":"战斗-请求治疗","texts":{"zhCN":["呃啊！治疗！谁来帮帮我！"],"enUS":["Ahh! Heal! Heal me!"],"jaJP":["わわっ、ヒールしてよ！"]},"keys":["cv_alpaca_girl_CoopHeal"]},{"type":"CoopRun","label":"战斗-注意","texts":{"zhCN":["大家快躲起来，躲开啊！"],"enUS":["Everyone dodge, I said dodge!"],"jaJP":["みんな、避けて！"]},"keys":["cv_alpaca_girl_CoopRun"]},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["赢了吗？我早就知道会这样！"],"enUS":["We won? I knew it!"],"jaJP":["勝って当然ね"]},"keys":["cv_alpaca_girl_CoopWin"]},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["嘻嘻，我要跟芭莉好好炫耀一番！"],"enUS":["Hehe, I'm gonna brag about this to Bari!"],"jaJP":["えへへ、バリに自慢しよっと！"]},"keys":["cv_alpaca_girl_CoopMVP"]},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["芭莉希望我待人亲切一些…所以…请多关照…"],"enUS":["Bari asked me to be nice… so umm… pleased to meet you…"],"jaJP":["バリに言われたから、できるだけ人には優しくしてねって…一応、ヨロシク"]},"keys":["cv_alpaca_girl_CoopHi"]},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["哇～～～太磨叽了！快过来！"],"enUS":["Ah, come one! Hurry up!"],"jaJP":["ああー、トロいなあー、早くしてよ"]},"keys":["cv_alpaca_girl_CoopHurryUp"]},{"type":"CoopBelieve","label":"战斗-信任","texts":{"zhCN":["相信我，我有能力处理。我最讨厌别人对我指手画脚的了。"],"enUS":["I'm a big girl. You don't have to lecture me."],"jaJP":["うるさいなぁー、黙って任せてくれる？"]},"keys":["cv_alpaca_girl_CoopBelieve"]},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["我只想早点跟芭莉回家，恢复原形再睡个好觉…"],"enUS":["I just want to go home with Bari and sleep in my original form."],"jaJP":["ああー、人間の格好めんどくさいー、バリとお家でごろごろふかふかしてたいよ…"]},"keys":["Voice_alpaca_girl_1_TouchReactionGood1","cv_alpaca_girl_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["卡麦尔爷爷？哼，管他呢，他只会问我今天过得怎么样，真烦人！"],"enUS":["Kamael? Urgh, he is soooo annoying always asking me \"how was your day\"!"],"jaJP":["カマエル？あ、じいじのことね、いっつもどうでもいいことをあれこれ聞いてくるから、面倒くさいんだよね！"]},"keys":["Voice_alpaca_girl_1_TouchReactionGood2","cv_alpaca_girl_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["唉，芭莉心太软了，总是去帮助那些愚蠢又自私的人类。"],"enUS":["Bari is just so benevolent. Always helping those selfish and lame humans."],"jaJP":["バリはやさしすぎるんだよ、自分のことしか考えない身勝手な人間どもを助けるなんてさあ"]},"keys":["Voice_alpaca_girl_1_TouchReactionBad1","cv_alpaca_girl_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["拿开你的脏手！除了芭莉，其他人休想碰到我。"],"enUS":["I don't want anyone but Bari to touch me. So back off."],"jaJP":["バリ以外の人には、葉っぱ一枚触らせる気もないからね！"]},"keys":["Voice_alpaca_girl_1_TouchReactionBad2","cv_alpaca_girl_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["邮件？该不会又是卡麦尔爷爷寄来的吧？真烦人…"],"enUS":["Mail? Is it Kamael again? Jeez…"],"jaJP":["メール？はぁ…またじいじからかなあ…"]},"keys":["Voice_alpaca_girl_1_NoticeMail","cv_alpaca_girl_NoticeMail"]},{"type":"NoticeEvent","label":"活动提示","texts":{"zhCN":["活动？这次就让我恢复原形吧！"],"enUS":["Event? Let me go back to my original form!"],"jaJP":["イベント？行くなら元の姿が良いんだけどなあ"]},"keys":["cv_alpaca_girl_NoticeEvent"]},{"type":"SummonSpeech1","label":"召唤-台词1","texts":{"zhCN":["你需要神兽的帮助吗？"],"enUS":["You need this Divine Beast's help?"],"jaJP":["ぺぇっ！神獣であるあたしに助けて欲しいぃー？"]},"keys":["cv_alpaca_girl_SummonSpeech1"]},{"type":"SummonSpeech2","label":"召唤-台词2","texts":{"zhCN":["呜呜…我讨厌帮助人类，但是…"],"enUS":["Urgh… I hate to help humans but…"],"jaJP":["人間の頼みなんて、聞いてあげたくないんだけど"]},"keys":["cv_alpaca_girl_SummonSpeech2"]},{"type":"SummonSpeech3","label":"召唤-台词3","texts":{"zhCN":["看在芭莉的面子上，就这一次例外。"],"enUS":["Just this once, I'll make an exception for Bari's sake."],"jaJP":["でも…バリに免じて、今回だけだからね！"]},"keys":["cv_alpaca_girl_SummonSpeech3"]},{"type":"Special1","label":"特殊剧情1","texts":{"zhCN":["想知道这是什么吗？这是大自然的力量！"],"enUS":["You know what this is? It's the force of nature!"],"jaJP":["自然の力を思い知れ！"]},"keys":["cv_alpaca_girl_Special1"]}]},{"id":"alpaca_girl_myth","label":"开花","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["这就是小看神兽的下场。"],"enUS":[],"jaJP":[]},"keys":["cv_alpaca_girl_myth_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["根本就不是我的对手啦。"],"enUS":[],"jaJP":[]},"keys":["cv_alpaca_girl_myth_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["芭莉…你在哪儿…？"],"enUS":[],"jaJP":[]},"keys":["cv_alpaca_girl_myth_Die"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["就算变强了也只会更麻烦……"],"enUS":[],"jaJP":[]},"keys":["cv_alpaca_girl_myth_LevelUp"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["别动！"],"enUS":[],"jaJP":[]},"keys":["cv_alpaca_girl_myth_Attack3"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["放弃吧，你这个笨~蛋！"],"enUS":[],"jaJP":[]},"keys":["cv_alpaca_girl_myth_Skill2"]},{"type":"LeaderSkill","label":"队长技能","texts":{"zhCN":["1. 想见识真正的神兽之力吗？！\n2. 就算逃跑，也没有乐园！\n3. 唔——……呸！！！"],"enUS":[],"jaJP":[]},"keys":["cv_alpaca_girl_myth_LeaderSkill"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["可恶！你，竟敢？！"],"enUS":[],"jaJP":[]},"keys":["cv_alpaca_girl_myth_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["感觉你有 0.000001% 像芭莉……喂？这可是夸奖！"],"enUS":[],"jaJP":[]},"keys":["cv_alpaca_girl_myth_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["哈！人类果然就是这副德行。反正我也没抱什么期待。"],"enUS":[],"jaJP":[]},"keys":["cv_alpaca_girl_myth_PlayerChooseDark"]},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["就算你再强又怎样，我可是神兽！"],"enUS":[],"jaJP":[]},"keys":["cv_alpaca_girl_myth_StrongEnemyBattleStart"]},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["别发呆了，快攻击！"],"enUS":[],"jaJP":[]},"keys":["cv_alpaca_girl_myth_CoopAttack"]},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["带着我还赢不了的话，那才是真的傻瓜。"],"enUS":[],"jaJP":[]},"keys":["cv_alpaca_girl_myth_CoopWin"]},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["芭莉！快看！我是MVP！快夸夸我~"],"enUS":[],"jaJP":[]},"keys":["cv_alpaca_girl_myth_CoopMVP"]},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["芭莉不在吧？喂，你们别跟我套近乎。"],"enUS":[],"jaJP":[]},"keys":["cv_alpaca_girl_myth_CoopHi"]},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["搞什么啊！快点快点！"],"enUS":[],"jaJP":[]},"keys":["cv_alpaca_girl_myth_CoopHurryUp"]},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["我只想早点跟芭莉回家，恢复原形再睡个好觉…"],"enUS":[],"jaJP":[]},"keys":["Voice_alpaca_girl_myth_1_TouchReactionGood1","cv_alpaca_girl_myth_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["果然还是春天最棒，芭莉喜欢的花开得到处都是……毕竟我也是丰收神兽嘛。","果然还是春天最棒，毕竟芭莉喜欢的花开得那么多……毕竟我也是丰收神兽嘛。"],"enUS":[],"jaJP":[]},"keys":["Voice_alpaca_girl_myth_1_TouchReactionGood2","cv_alpaca_girl_myth_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["唉，芭莉心太软了，总是去帮助那些愚蠢又自私的人类。"],"enUS":[],"jaJP":[]},"keys":["Voice_alpaca_girl_myth_1_TouchReactionBad1","cv_alpaca_girl_myth_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["咦，哪来的老头味。那个烦人的爷爷……该不会就在附近吧？"],"enUS":[],"jaJP":[]},"keys":["Voice_alpaca_girl_myth_1_TouchReactionBad2","cv_alpaca_girl_myth_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["邮件？该不会又是卡麦尔爷爷寄来的吧？真烦人…"],"enUS":[],"jaJP":[]},"keys":["Voice_alpaca_girl_myth_1_NoticeMail"]}]}]}
