":[34,37],"baseValues":[33.864000000000004,37.184000000000005],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"生命","min":12.0,"max":28.0,"unit":"%"},{"name":"防御","min":6.0,"max":16.0,"unit":"%"},{"name":"伤害减免","min":25,"max":75,"unit":""}],"subOptions":[{"name":"技能伤害值","min":5.0,"max":15.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"怒气爆发","description":"受到攻击时，以20%概率被激怒，按照每秒伤害的50%，对周围敌人造成伤害。该技能每1秒启动1次。"}],"skill":{"name":"人肉地震","description":"震撼大地，对敌人造成伤害，并附带击飞效果。","levels":[2,5],"damage":[211.0,235.0],"cooldown":[11.0,11.0],"ailment":"击飞"}}],"number":1}],"profile":{"Age":[41],"Height":[205],"Weight":[142]},"tribes":["人类"],"story":"马修，在沙漠讨生活的雇佣兵。\n\n体格魁梧又健壮，握力极大，不经意间总是损坏一些东西，健硕的身体是他佣兵生涯的最大倚仗。深知自己无法合群、不会有什么归宿，也不奢求人与人之间的友好亲密关系。看上去粗暴易怒，但竭尽所能守护自己珍惜的人与物，不让其受到任何伤害。\n\n在身经百战的马修眼里，其他战士都是乳臭未干的毛小子。具有丰富雇佣兵经验的马修在每次战斗中都显得从容不迫。","storyKey":"profile_desert_slave_story","sources":{"hero":"heroes.json / OriginId=54","profile":"heroprofile.json / OriginId=54","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"desert_slave","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["我不在意胜利，获胜的过程才是真正有意义的。"],"enUS":["I don't enjoy a victory. I enjoy everything that leads up to it."],"jaJP":["勝利に興味はねえが、殴り合いは悪くねえ"]},"keys":["cv_desert_slave_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["人若犯我，我必犯人，仅此而已。"],"enUS":["I don't enjoy conflicts. That's all."],"jaJP":["殴られたら、倍にして殴り返す、シンプルに楽しもうぜ"]},"keys":["cv_desert_slave_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["如同在地狱煎熬的夜晚…"],"enUS":["It's a hell of a night…"],"jaJP":["地獄みたいな夜だ…"]},"keys":["cv_desert_slave_Die"]},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["远远不够！"],"enUS":["This isn't enough!"],"jaJP":["足りねえ！"]},"keys":["cv_desert_slave_GetExp"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["老了才会觉得满足。"],"enUS":["To be satisfied… Is to be old."],"jaJP":["満足？そいつは老いぼれの言うセリフだな"]},"keys":["cv_desert_slave_LevelUp"]},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["算得上有用的玩具。"],"enUS":["This is a pretty good toy."],"jaJP":["おもちゃにしちゃ、まあまあ使えるか"]},"keys":["cv_desert_slave_EquipWeapon"]},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["…开玩笑的吧？"],"enUS":["Are you kidding?"],"jaJP":["おい、冗談だろ？"]},"keys":["cv_desert_slave_EquipCostume"]},{"type":"Evolve","label":"进化","texts":{"zhCN":["事情办完了吗？"],"enUS":["Are we done?"],"jaJP":["用は済んだか？"]},"keys":["cv_desert_slave_Evolve"]},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["特啊！"],"enUS":["Taat!"],"jaJP":["であっ！"]},"keys":["cv_desert_slave_Attack1"]},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["呼啊！"],"enUS":["Haap!"],"jaJP":["ふあっ！"]},"keys":["cv_desert_slave_Attack2"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["呜哦哦哦哦哦哦！"],"enUS":["Wuuoooooooo!"],"jaJP":["うおおおおおおお！"]},"keys":["cv_desert_slave_Attack3"]},{"type":"Skill1","label":"技能1","texts":{"zhCN":["去死吧！"],"enUS":["Die!"],"jaJP":["終わりだ！"]},"keys":["cv_desert_slave_Skill1"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["好像很有意思。"],"enUS":["This is gonna be fun."],"jaJP":["楽しくなってきたな"]},"keys":["cv_desert_slave_Skill2"]},{"type":"Damaged1","label":"受到攻击1","texts":{"zhCN":["呃啊！"],"enUS":["Argh!"],"jaJP":["くはっ！"]},"keys":["cv_desert_slave_Damaged1"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["这家伙…"],"enUS":["You son of a…"],"jaJP":["この野郎！"]},"keys":["cv_desert_slave_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["只有强者才能做出懦弱的选择。"],"enUS":["Only the strong can make weak decisions."],"jaJP":["強いヤツだから、甘っちょろい選択ができるんだ"]},"keys":["cv_desert_slave_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["这样的决定，只会让人觉得你是懦弱的。"],"enUS":["Pretending to be strong will only make you look weak."],"jaJP":["あまり強がるなよ、弱っちく見えるぜ"]},"keys":["cv_desert_slave_PlayerChooseDark"]},{"type":"WeakEnemyBattleStart","label":"与弱小敌人战斗","texts":{"zhCN":["切…小样儿…"],"enUS":["Hmph. Weaklings…"],"jaJP":["ちっ！雑魚が…"]},"keys":["cv_desert_slave_WeakEnemyBattleStart"]},{"type":"NormalEnemyBattleStart","label":"与普通敌人战斗","texts":{"zhCN":["允许你尖叫。"],"enUS":["It's okay if you scream."],"jaJP":["泣いてもいいんだぜ？"]},"keys":["cv_desert_slave_NormalEnemyBattleStart"]},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["我没被困在这里。而是你们被关进这里，和我在一起。"],"enUS":["I'm not locked in here with you, you're locked in here with me!"],"jaJP":["俺が閉じ込められたんじゃねぇ、てめぇらが俺とここに閉じこもったんだよ！"]},"keys":["cv_desert_slave_StrongEnemyBattleStart"]},{"type":"BossBattleStart","label":"与首领战斗","texts":{"zhCN":["我喜欢坏人，这样再怎么折磨，也不会有罪恶感。"],"enUS":["I love bad guys. I don't feel guilty no matter how much I torture them."],"jaJP":["俺は悪党の方が好きだぜ、どんだけ殴っても構わねえからな！"]},"keys":["cv_desert_slave_BossBattleStart"]},{"type":"JoinParty","label":"首次加入队伍","texts":{"zhCN":["生存还是毁灭，这是个问题。"],"enUS":["Live hard or die hard."],"jaJP":["忙しく生きるか、忙しく死ぬか、だ"]},"keys":["cv_desert_slave_JoinParty"]},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["一个活口都不留！"],"enUS":["Kill 'em all!"],"jaJP":["一匹でも逃がすなよ！"]},"keys":["cv_desert_slave_CoopAttack"]},{"type":"CoopHeal","label":"战斗-请求治疗","texts":{"zhCN":["辅助在做什么！"],"enUS":["Where's the healer?!"],"jaJP":["ヒーラーは何をやってる！？"]},"keys":["cv_desert_slave_CoopHeal"]},{"type":"CoopRun","label":"战斗-注意","texts":{"zhCN":["快跑啊，蠢货！"],"enUS":["Run, you fools!"],"jaJP":["逃げろ、バカどもが！"]},"keys":["cv_desert_slave_CoopRun"]},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["我已经习惯了。"],"enUS":["I'm used to hell."],"jaJP":["いつもと変わらん地獄だな"]},"keys":["cv_desert_slave_CoopWin"]},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["真实的敌人和熟悉的战场，如此简单的快乐。"],"enUS":["Enemies and battlefields. Gotta love their simplicity."],"jaJP":["敵と戦場、こんなに分かりやすい楽しみはねえな"]},"keys":["cv_desert_slave_CoopMVP"]},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["遗嘱写好了吗？"],"enUS":["Did you write your will?"],"jaJP":["遺書は書き終わったか？"]},"keys":["cv_desert_slave_CoopHi"]},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["胆小鬼，别磨蹭。"],"enUS":["Don't be long, cowards."],"jaJP":["グズグズしてんじゃねえ、弱虫ども！"]},"keys":["cv_desert_slave_CoopHurryUp"]},{"type":"CoopBelieve","label":"战斗-信任","texts":{"zhCN":["很简单，打败最弱的，杀掉最强的。"],"enUS":["It's simple. We beat the weakest. And we kill the strongest."],"jaJP":["やることは簡単だ、弱い敵は殺して、強い敵はぶっ殺す"]},"keys":["cv_desert_slave_CoopBelieve"]},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["什么。"],"enUS":["What."],"jaJP":["なんだ"]},"keys":["Voice_desert_slave_1_TouchReactionGood1","cv_desert_slave_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["…嗯？"],"enUS":["… Huh?"],"jaJP":["…うん？"]},"keys":["Voice_desert_slave_1_TouchReactionGood2","cv_desert_slave_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["…咦？"],"enUS":["… Hah?"],"jaJP":["…ああん？"]},"keys":["Voice_desert_slave_1_TouchReactionBad1","cv_desert_slave_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["别叽叽喳喳的。"],"enUS":["You better stop it."],"jaJP":["ギャーギャー騒ぐんじゃねえ"]},"keys":["Voice_desert_slave_1_TouchReactionBad2","cv_desert_slave_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["新邮件，做点事吧。"],"enUS":["It's mail. Do something about it."],"jaJP":["メールだ、なんとかしろ"]},"keys":["Voice_desert_slave_1_NoticeMail","cv_desert_slave_NoticeMail"]},{"type":"NoticeEvent","label":"活动提示","texts":{"zhCN":["有活动。"],"enUS":["An event."],"jaJP":["イベントだ"]},"keys":["cv_desert_slave_NoticeEvent"]},{"type":"Special1","label":"特殊剧情1","texts":{"zhCN":["比起接下来我要对你做的事，堕入阿鼻地狱就像是去往了天堂。"],"enUS":["The bottom of hell would be like heaven compared to what I'm about to do to you."],"jaJP":["てめぇが向かう地獄の果ては、今から俺がてめぇにすることに比べりゃ、天国みたいなものさ"]},"keys":["cv_desert_slave_Special1"]}]}]}
