":[34,37],"baseValues":[33.864000000000004,37.184000000000005],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"生命","min":12.0,"max":28.0,"unit":"%"},{"name":"防御","min":6.0,"max":16.0,"unit":"%"},{"name":"伤害减免","min":25,"max":75,"unit":""}],"subOptions":[{"name":"技能伤害值","min":5.0,"max":15.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"怒气爆发","description":"受到攻击时，以20%概率被激怒，按照每秒伤害的50%，对周围敌人造成伤害。该技能每1秒启动1次。"}],"skill":{"name":"人肉地震","description":"震撼大地，对敌人造成伤害，并附带击飞效果。","levels":[2,5],"damage":[211.0,235.0],"cooldown":[11.0,11.0],"ailment":"击飞"}}],"number":1}],"profile":{"Age":[41],"Height":[205],"Weight":[142]},"tribes":["人类"],"story":"马修，在沙漠讨生活的雇佣兵。\n\n体格魁梧又健壮，握力极大，不经意间总是损坏一些东西，健硕的身体是他佣兵生涯的最大倚仗。深知自己无法合群、不会有什么归宿，也不奢求人与人之间的友好亲密关系。看上去粗暴易怒，但竭尽所能守护自己珍惜的人与物，不让其受到任何伤害。\n\n在身经百战的马修眼里，其他战士都是乳臭未干的毛小子。具有丰富雇佣兵经验的马修在每次战斗中都显得从容不迫。","storyKey":"profile_desert_slave_story","sources":{"hero":"heroes.json / OriginId=54","profile":"heroprofile.json / OriginId=54","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}