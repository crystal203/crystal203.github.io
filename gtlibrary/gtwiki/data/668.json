er:eternal_flame_mizuasobi","skin":null}}],"weapons":[{"code":"cwp_eternalflame","name":"魔力护符","type":"篮子","variants":[{"id":9050544,"code":"cwp_eternalflame_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_eternalflame"},"stats":[{"name":"每秒伤害","values":[572,628],"baseValues":[572.22,628.3200000000002],"grows":true},{"name":"光属性攻击","values":[140,154],"baseValues":[140.25,154.00000000000003],"grows":true},{"name":"暴击率","values":[2,2],"unit":"%"},{"name":"恢复能力","values":[200,200],"baseValues":[200,200],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"生命","min":8.0,"max":20.0,"unit":"%"},{"name":"防御","min":6.0,"max":18.0,"unit":"%"},{"name":"技能伤害值","min":6.0,"max":18.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":6.0,"max":18.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"按照闪闪发亮！造成伤害的10%，加成额外生命。\n送给你阳光！的伤害提升至每秒伤害的120%。\n向处于攻击减免状态敌人发起攻击时，造成的伤害值提升10%。"}],"skill":{"name":"闪亮礼物！","description":"发射水晶，对敌人造成远程伤害并附带重伤效果。","levels":[3,6],"damage":[205.0,250.0],"cooldown":[9.2,8.3],"ailment":"重伤"}},{"id":9050545,"code":"cwp_eternalflame_myth","label":"开花","stars":6,"sprite":{"sheet":"items","name":"cwp_eternalflame_myth"},"stats":[{"name":"每秒伤害","values":[711,780],"baseValues":[710.6972400000001,780.3734400000002],"grows":true},{"name":"光属性攻击","values":[174,191],"baseValues":[174.19050000000001,191.26800000000003],"grows":true},{"name":"暴击率","values":[2,2],"unit":"%"},{"name":"恢复能力","values":[240,240],"baseValues":[240,240],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"生命","min":8.0,"max":20.0,"unit":"%"},{"name":"防御","min":6.0,"max":18.0,"unit":"%"},{"name":"技能伤害值","min":6.0,"max":18.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":6.0,"max":18.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"按照闪闪发亮！造成伤害的10%，加成额外生命。\n送给你阳光！的伤害提升至每秒伤害的120%。\n向处于攻击减免状态敌人发起攻击时，造成的伤害值提升20%。"}],"skill":{"name":"闪亮礼物！","description":"发射水晶，对敌人造成远程伤害并附带重伤效果。","levels":[3,6],"damage":[270.0,270.0],"cooldown":[9.2,8.3],"ailment":"重伤"}}],"number":1}],"profile":{"Age":null,"Height":[140],"Weight":[1]},"tribes":["？"],"story":"伊露妮是吉尔瓦斯的第一个化身。 \n\n对伊露妮来说，每一天都是探索世界的全新冒险。在本能驱使下，伊露妮那旺盛的好奇心让她无论看到什么都想摸一摸，只要是能碰到的东西，都要紧紧攥在小手里。伊露妮总是顶着一张粉嫩的脸蛋外出，最后满身火山灰地回来，这样的情况多到连吉尔瓦斯都忍不住为她担心。\n\n伊露妮天生对所有生命都抱有好感，即便初次见面，她也会带着热情主动亲近。被伊露妮缠住的人，都要做好迎接问题风暴的准备。当然，因为她掌握的词汇有限，所以通常会重复问些简单的问题，还不停用力点头来回应对方的回答。在回家的路上，伊露妮会小声念叨那些难记的词，用稚嫩又笨拙的发音反复琢磨。\n\n伊露妮浑身充满了活力，哪怕玩了一整天也不肯睡觉。她会一直叽叽喳喳地说到天亮，最后才在吉尔瓦斯的怀里沉沉地睡去。有时她也会独自入睡，每到这种时候，她的枕边总会摊着一本翻开的小日记本。\n\n「你好呀！日记～今天我和蠢脸、笑脸还有吉尔瓦斯一起玩啦！我最喜欢捉迷藏了。但这次蠢脸一看到我就大喊“在这儿呢～！”，吓了我一跳。吉尔瓦斯说我是小傻瓜，告诉我腿也得藏好才行！但被找到也没关系呀，这样我就能再躲一次了！我还要玩！\n\n哦对啦！我给蠢脸舀了一些红色的水，可蠢脸却没喝，还说那是岩浆，岩浆可不是用来喝的，而且味道很差！后来，红色的水“砰！”地一下爆炸了！噗咻咻！！！那么…红色的水到底是岩浆？还是难喝的东西？？？嗯…不知道啦。世界上有好多好多有趣的词呢！我想把它们都学会！\n\n我还想过，要怎样让大家都陪在我身边！和大家在一起的时候，我能学到超级超级多新东西！当我跟着模仿的时候，大家会夸我～超级开心！要是我学了好多好多东西，说不定有一天，我也能像吉尔瓦斯一样，做出超厉害的事呢？明天我也要开心地玩，要是学到了新东西，我会第一个告诉日记哦！」\n\n即便在睡梦中，伊露妮也会笑着喃喃自语。或许是在回味白天的快乐，又或许是在梦里提前邂逅了明天的新奇。那天真烂漫的模样，正是大家都喜爱伊露妮的原因。","storyKey":"profile_eternal_flame_story","sources":{"hero":"heroes.json / OriginId=668","profile":"heroprofile.json / OriginId=668","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"eternal_flame","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["我还要玩这个！嗯？快点来啊！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["哇啊啊。一天这么快就结束啦！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["不要…丢下我一个人…"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_Die"]},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["还是好饿！还想要更多更多！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_GetExp"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["嘿嘿。好像长高了一点。真开心！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_LevelUp"]},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["哇哦~！我太喜欢了！这种时候…应该说谢谢？嗯，谢谢你！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_EquipWeapon"]},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["正在玩娃娃呢！我也能玩过家家吗？"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_EquipCostume"]},{"type":"Evolve","label":"进化","texts":{"zhCN":["我在闪闪发光哦！好像变成了小太阳！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_Evolve"]},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["嘻嘻！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_Attack1"]},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["咻咻咻~"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_Attack2"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["好开心！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_Attack3"]},{"type":"Skill1","label":"技能1","texts":{"zhCN":["砰砰砰~！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_Skill1"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["飞吧，闪闪发光！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_Skill2"]},{"type":"Damaged1","label":"受到攻击1","texts":{"zhCN":["呜哇啊！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_Damaged1"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["坏蛋！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["和你在一起，每一天都很开心！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["吉尔瓦斯不让我跟你玩！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_PlayerChooseDark"]},{"type":"WeakEnemyBattleStart","label":"与弱小敌人战斗","texts":{"zhCN":["哇啊~这是新玩具吗？"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_WeakEnemyBattleStart"]},{"type":"NormalEnemyBattleStart","label":"与普通敌人战斗","texts":{"zhCN":["不可以太快倒下哦！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_NormalEnemyBattleStart"]},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["你好！我是伊露妮……咦？现在不是在打招呼吗？"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_StrongEnemyBattleStart"]},{"type":"BossBattleStart","label":"与首领战斗","texts":{"zhCN":["世界真大！我还是第一次见到你这么酷的人！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_BossBattleStart"]},{"type":"JoinParty","label":"首次加入队伍","texts":{"zhCN":["一个、两个、三个新朋友…嗯…咦…总之超级多！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_JoinParty"]},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["出~发！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_CoopAttack"]},{"type":"CoopHeal","label":"战斗-请求治疗","texts":{"zhCN":["呜哇啊！快帮我吹吹！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_CoopHeal"]},{"type":"CoopRun","label":"战斗-注意","texts":{"zhCN":["呀~捉迷藏开始啦！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_CoopRun"]},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["结束了！呃，心脏还在砰砰狂跳呢！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_CoopWin"]},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["嘿嘿，今天要在日记里夸夸自己！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_CoopMVP"]},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["只要好好听话，你就会表扬我吧？"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_CoopHi"]},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["我要跑第一名！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_CoopHurryUp"]},{"type":"CoopBelieve","label":"战斗-信任","texts":{"zhCN":["一起走吧。我会一直给你温暖的！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_CoopBelieve"]},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["咦，你什么时候来的？快抱抱我！"],"enUS":[],"jaJP":[]},"keys":["Voice_eternal_flame_1_TouchReactionGood1","cv_eternal_flame_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["我来给你唱摇篮曲吧~！一闪一闪亮晶晶~ 满天都是小星星…呼啊啊…"],"enUS":[],"jaJP":[]},"keys":["Voice_eternal_flame_1_TouchReactionGood2","cv_eternal_flame_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["呃啊啊~！我不喜欢刷牙！"],"enUS":[],"jaJP":[]},"keys":["Voice_eternal_flame_1_TouchReactionBad1","cv_eternal_flame_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["抓住这里这样挥动…哇！碎掉了！这是吉尔瓦斯最喜欢的糖果…应该…没关系吧？"],"enUS":[],"jaJP":[]},"keys":["Voice_eternal_flame_1_TouchReactionBad2","cv_eternal_flame_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["嘘，一起看看秘密小纸条吧！"],"enUS":[],"jaJP":[]},"keys":["Voice_eternal_flame_1_NoticeMail","cv_eternal_flame_NoticeMail"]},{"type":"NoticeEvent","label":"活动提示","texts":{"zhCN":["有开心的事情发生？快出去看看吧！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_NoticeEvent"]},{"type":"SummonSpeech1","label":"召唤-台词1","texts":{"zhCN":["哇~这是哪里？有好多新东西呀！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_SummonSpeech1"]},{"type":"SummonSpeech2","label":"召唤-台词2","texts":{"zhCN":["这个闪闪发光的玩具是什么？可以跟后面的朋友们一起玩吗？"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_SummonSpeech2"]},{"type":"SummonSpeech3","label":"召唤-台词3","texts":{"zhCN":["好好奇呀~快告诉我！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_SummonSpeech3"]}]},{"id":"eternal_flame_myth","label":"开花","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["咦？怎么不动了呀？陪我玩嘛！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_myth_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["再见啦！下次见面时，我们做朋友吧！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_myth_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["我只是…打了个盹…眼睛怎么…睁不开啊…"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_myth_Die"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["轻飘~飘~的感觉！以后我也能飞起来吗？"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_myth_LevelUp"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["再玩一会儿嘛！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_myth_Attack3"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["快看我！很厉害吧！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_myth_Skill2"]},{"type":"LeaderSkill","label":"队长技能","texts":{"zhCN":["从现在开始…闪闪发光！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_myth_LeaderSkill"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["不跟你玩了！！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_myth_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["奇怪…明明没有火焰…心里却暖洋洋的！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_myth_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["蠢脸，这样不行，不行！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_myth_PlayerChooseDark"]},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["哇啊~好紧张！心里像在燃烧一样！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_myth_StrongEnemyBattleStart"]},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["我人虽然小，但我的火焰可大着呢！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_myth_CoopAttack"]},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["哇啊啊！来击个掌吧！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_myth_CoopWin"]},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["我是…化身！…嗯？这个呀？吉尔瓦斯告诉我的！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_myth_CoopMVP"]},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["我们会成为火与油一样的关系！也就是好搭档啦！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_myth_CoopHi"]},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["哇~哒哒哒哒哒哒！"],"enUS":[],"jaJP":[]},"keys":["cv_eternal_flame_myth_CoopHurryUp"]},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["咦，你什么时候来的？快抱抱我！"],"enUS":[],"jaJP":[]},"keys":["Voice_eternal_flame_myth_1_TouchReactionGood1","cv_eternal_flame_myth_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["听说永远是超~级、无~限久的意思！我们也要永远在一起！好不好？"],"enUS":[],"jaJP":[]},"keys":["Voice_eternal_flame_myth_1_TouchReactionGood2","cv_eternal_flame_myth_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["呃啊啊~！我不喜欢刷牙！"],"enUS":[],"jaJP":[]},"keys":["Voice_eternal_flame_myth_1_TouchReactionBad1","cv_eternal_flame_myth_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["吉尔瓦斯说，水和火碰到一起就会消失…我…刚才碰了水…那么…我是不是也…呜哇啊啊啊啊啊！！！"],"enUS":[],"jaJP":[]},"keys":["Voice_eternal_flame_myth_1_TouchReactionBad2","cv_eternal_flame_myth_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["嘘，一起看看秘密小纸条吧！"],"enUS":[],"jaJP":[]},"keys":["Voice_eternal_flame_myth_1_NoticeMail"]}]}]}
