0,"unit":"%"},{"name":"生命","min":8.0,"max":20.0,"unit":"%"},{"name":"防御","min":5.0,"max":16.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":3.0,"max":8.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"黑暗扣杀和黑暗球命中目标时，降低30%暗属性抵抗并持续5秒，按照伤害值的10%，加成额外生命。\n黑暗球命中目标时，目标敌人攻击减免10%并持续5秒。"}],"skill":{"name":"猎食者攻击","description":"跃起后，向下劈砍双手剑，对目标敌人造成近程范围伤害并附带击倒效果。","levels":[1,5],"damage":[260.0,260.0],"cooldown":[8.4,8.0],"ailment":"击倒"}}],"number":1}],"profile":{"Age":null,"Height":[173],"Weight":[66]},"tribes":["侵略者"],"story":"贝丝，是侵略者阵营的魔法师，也是侵略者组织首席大祭司。\n \n她时常小题大做，却又足智多谋。贝丝始终坚持“力敌不如智取”，每次制定作战计划时，她就像是在下棋一样，总会先规划整个布局，再预测敌人可能采取的行动与反应，从而制定策略。贝丝总是喜欢在自己的战略中增加戏剧性，尤其注重自己的出场镜头戏剧性。通常来说假扮成普通流民潜入拉赫帝国的坎特伯雷收容所，应该是最有效的。但是，贝丝偏偏选择扮演人见人爱的佩妮，在这期间她欺骗流民，背叛族人，在流民区横行霸道；过了一段时间之后，才露出了自己的真面目。贝丝这么做不仅仅是为了战略，多少也是为了自己的闪亮登场做一个完美铺垫。贝丝向来不达目的誓不罢休，所有人对于她来说只是一枚可用的棋子。为了实现目标，她可以毫不犹豫地抛弃任何人，而这些是为了完成侵略者使命，并按照天神预言履行义务的一部分。\n \n在侵略者阵营中，天神预言早已被认为是绝对“旨意”，是不可否认的崇高信仰。贝丝和其他侵略者一样，一出生就开始受到熏陶，并且长久地学习、祈祷和信奉这些观点，认为所有过程都是为了夺回原本属于自己的世界。贝丝的棋盘式战略完全根据天神预言进行设计，因为真理永远不会失败。她经常为其他人的无知感到悲伤，毕竟可怜的其他族群是根本不会懂得这些。然而守护者的出现让贝丝的坚定信念开始动摇。因为天神预言到了所有事，但却没有预言到有关守护者的一切。此后，守护者成了贝丝计划中的一大变数，不按常理出牌的守护者也常常让贝丝感到头疼。是天神错了吗？还是守护者作为异类破坏了天神的真实性？贝丝陷入了无限的自我怀疑中。\n \n贝丝极其讨厌别人叫自己的真名，所有人必须称她为大祭司。这称呼似乎对贝丝而言更为珍贵。","storyKey":"profile_invader_knight_story","sources":{"hero":"heroes.json / OriginId=368","profile":"heroprofile.json / OriginId=368","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"invader_knight","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["这点事情，微不足道！"],"enUS":["Insignificant!"],"jaJP":["ゴミ共が！"]},"keys":["cv_invader_knight_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["没有比死亡更痛苦的事了。"],"enUS":["There is nothing worse than death."],"jaJP":["死より苦しいものはないだろう？"]},"keys":["cv_invader_knight_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["妈妈…"],"enUS":["Mo, mother…"],"jaJP":["お、お母さん…"]},"keys":["cv_invader_knight_Die"]},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["嗯…我希望能有更多。"],"enUS":["Hmm… It would be good to have more."],"jaJP":["ふむ…これで全部か？まだあるだろう？"]},"keys":["cv_invader_knight_GetExp"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["看起来成长得挺快。"],"enUS":["Notable growth, it seems."],"jaJP":["いい成長だ"]},"keys":["cv_invader_knight_LevelUp"]},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["不错，正合我意。"],"enUS":["Not bad, I like it."],"jaJP":["なかなかいい、気に入った"]},"keys":["cv_invader_knight_EquipWeapon"]},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["呦呼～要想出一些新策略，才配得上这件新衣裳。"],"enUS":["Gotta come up with a new scheme to match this look."],"jaJP":["ほう、この姿に相応しい策略を用意しなければな"]},"keys":["cv_invader_knight_EquipCostume"]},{"type":"Evolve","label":"进化","texts":{"zhCN":["按照我的计划，我理应变得更强。"],"enUS":["According to my plans, it's obvious I get stronger."],"jaJP":["私の計画通りだな、強くなって当然だ"]},"keys":["cv_invader_knight_Evolve"]},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["哈！"],"enUS":["Haaat!"],"jaJP":["はっ！"]},"keys":["cv_invader_knight_Attack1"]},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["嗒啊！"],"enUS":["Taaa!"],"jaJP":["たあっ！"]},"keys":["cv_invader_knight_Attack2"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["咿呀哈！"],"enUS":["Eee Yap!"],"jaJP":["いやあっ！"]},"keys":["cv_invader_knight_Attack3"]},{"type":"Skill1","label":"技能1","texts":{"zhCN":["死吧。"],"enUS":["Exterminate!"],"jaJP":["殺してやろう！"]},"keys":["cv_invader_knight_Skill1"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["你无处可逃。"],"enUS":["There's no place to run."],"jaJP":["逃げ場はないぞ？"]},"keys":["cv_invader_knight_Skill2"]},{"type":"Damaged1","label":"受到攻击1","texts":{"zhCN":["切！"],"enUS":["Hmph!"],"jaJP":["ちっ！"]},"keys":["cv_invader_knight_Damaged1"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["中断！"],"enUS":["Interruption!"],"jaJP":["邪魔だ！"]},"keys":["cv_invader_knight_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["难不成，想让我夸你两句？"],"enUS":["Want my approval or something?"],"jaJP":["まさか、褒めて欲しいのか？"]},"keys":["cv_invader_knight_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["聪明～难怪你这么难搞。"],"enUS":["Clever. Explains why you're so hard to kill."],"jaJP":["貴様らがしぶとく生き延びたのは、なりふり構わなかったからか"]},"keys":["cv_invader_knight_PlayerChooseDark"]},{"type":"WeakEnemyBattleStart","label":"与弱小敌人战斗","texts":{"zhCN":["趁早逃跑吧，一群废物！"],"enUS":["Run, feeble things!"],"jaJP":["ザコどもめ、さっさと散れ！"]},"keys":["cv_invader_knight_WeakEnemyBattleStart"]},{"type":"NormalEnemyBattleStart","label":"与普通敌人战斗","texts":{"zhCN":["无论怎么挣扎，你也逃不出我的手掌心。"],"enUS":["Try all you want, you'll still be within my grasp."],"jaJP":["醜く足掻いたところで、私の手のひらの上だ"]},"keys":["cv_invader_knight_NormalEnemyBattleStart"]},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["强敌？应该早点解决掉的。"],"enUS":["A strong one? I should have killed it sooner."],"jaJP":["面倒だな…私の邪魔になる前に始末しておけばよかったか"]},"keys":["cv_invader_knight_StrongEnemyBattleStart"]},{"type":"BossBattleStart","label":"与首领战斗","texts":{"zhCN":["首领？你会后悔活到了现在。"],"enUS":["A boss? I will make you regret not dying sooner."],"jaJP":["強敵だと？死んだ方がマシだと後悔させてやろう"]},"keys":["cv_invader_knight_BossBattleStart"]},{"type":"JoinParty","label":"首次加入队伍","texts":{"zhCN":["听好了你们这些入侵者，我为收复故土而来。"],"enUS":["I'm here to reclaim my home, invaders."],"jaJP":["私の「家」を取り戻しにきた、侵入者は貴様たちのほうだ"]},"keys":["cv_invader_knight_JoinParty"]},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["消除一切障碍。"],"enUS":["Exterminate everything blocking my path."],"jaJP":["道を塞ぐ者は、全員殺せ"]},"keys":["cv_invader_knight_CoopAttack"]},{"type":"CoopHeal","label":"战斗-请求治疗","texts":{"zhCN":["还不帮我疗伤？！"],"enUS":["Idiots! Heal me!"],"jaJP":["バカどもめ、今すぐ私を治療せよ！"]},"keys":["cv_invader_knight_CoopHeal"]},{"type":"CoopRun","label":"战斗-注意","texts":{"zhCN":["当前不宜交战。"],"enUS":["Time for tactical retreat."],"jaJP":["この場は引く"]},"keys":["cv_invader_knight_CoopRun"]},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["这场胜利，也是我巧妙计划中的一部分。"],"enUS":["This victory is certainly part of my plan."],"jaJP":["この勝利もまた、私の計画の一部にすぎん"]},"keys":["cv_invader_knight_CoopWin"]},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["我听命于天神，有此成就，理所当然。"],"enUS":["As a follower of the savior's message, such performance is obvious."],"jaJP":["私はあのお方の言葉のもとに動いている、この程度の成果は当たり前だ"]},"keys":["cv_invader_knight_CoopMVP"]},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["欢迎成为我的棋子。"],"enUS":["I welcome you as my pawn."],"jaJP":["私の駒として使ってやろう"]},"keys":["cv_invader_knight_CoopHi"]},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["包袱，全部丢掉！"],"enUS":["Abandon anyone falling behind!"],"jaJP":["遅れる者どもは捨てていけ！"]},"keys":["cv_invader_knight_CoopHurryUp"]},{"type":"CoopBelieve","label":"战斗-信任","texts":{"zhCN":["预言不会错，我也不会让它出错。"],"enUS":["The prophecy will never fail. I won't let it fail."],"jaJP":["予言はハズれない、ハズさせない"]},"keys":["cv_invader_knight_CoopBelieve"]},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["执行计划就像是一场戏，而这场戏的主人公就是我。"],"enUS":["Executing a scheme is like a play, and I'm the protagonist."],"jaJP":["計略の遂行は、いわば演劇のようなもの…主人公はもちろんこの私だ"]},"keys":["Voice_invader_knight_1_TouchReactionGood1","cv_invader_knight_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["你因为被我骗而生气？呵呵，没人能识破我的精湛演技！"],"enUS":["Are you mad that I deceived you? I deceive everyone!"],"jaJP":["私に騙されて悔しいか？ははは、貴様以外も皆手の平の上だよ！"]},"keys":["Voice_invader_knight_1_TouchReactionGood2","cv_invader_knight_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["那骑士竟敢违抗天神预言，还毁了我的计划…"],"enUS":["How does that knight defy the prophecy and ruin my plan…"],"jaJP":["あのお方の予言に逆らって私の計画を台無しにするあの騎士は、一体…"]},"keys":["Voice_invader_knight_1_TouchReactionBad1","cv_invader_knight_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["你竟敢叫我的名字？！"],"enUS":["Don't you dare utter my name."],"jaJP":["私の名を気安く呼ぶな"]},"keys":["Voice_invader_knight_1_TouchReactionBad2","cv_invader_knight_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["邮件？会是新的教诲吗？"],"enUS":["Mail? It is our Savior's message."],"jaJP":["メール？あのお方の新しいお言葉か？"]},"keys":["Voice_invader_knight_1_NoticeMail","cv_invader_knight_NoticeMail"]},{"type":"NoticeEvent","label":"活动提示","texts":{"zhCN":["活动…是时候拟定新策略了！"],"enUS":["An event… Time for a new strategy!"],"jaJP":["イベントか… 新たな戦略を練る時が来たな"]},"keys":["cv_invader_knight_NoticeEvent"]},{"type":"SummonSpeech1","label":"召唤-台词1","texts":{"zhCN":["很好，我按照原计划的时间抵达了。"],"enUS":["I've arrived. As I planned."],"jaJP":["到着した、計画通りだな"]},"keys":["cv_invader_knight_SummonSpeech1"]},{"type":"SummonSpeech2","label":"召唤-台词2","texts":{"zhCN":["怎么，你很惊讶？"],"enUS":["Well, are you surprised to see me?"],"jaJP":["どうだ、驚いたか？"]},"keys":["cv_invader_knight_SummonSpeech2"]},{"type":"SummonSpeech3","label":"召唤-台词3","texts":{"zhCN":["记得，要靠近朋友，更要靠近敌人。"],"enUS":["As he says, keep your friends close, and your enemies closer."],"jaJP":["敵を知るならその懐に飛び込むことだ！"]},"keys":["cv_invader_knight_SummonSpeech3"]}]},{"id":"invader_knight_myth","label":"开花","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["肮脏的寄生虫们！"],"enUS":["Vile parasites!"],"jaJP":["薄汚い寄生虫どもが…！"]},"keys":["cv_invader_knight_myth_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["真遗憾..不能杀你两次。"],"enUS":["Shame I can't kill you twice."],"jaJP":["二度殺せないのが、残念だ"]},"keys":["cv_invader_knight_myth_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["终于…能去见… 妈妈了…."],"enUS":["I finally… get to… Mother…."],"jaJP":["やっと会えるね…お母さん…"]},"keys":["cv_invader_knight_myth_Die"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["是我变强了吗…又多了一招可用。"],"enUS":["Looks like I've grown. Another move at my disposal."],"jaJP":["成長したな、これで手札も増えた"]},"keys":["cv_invader_knight_myth_LevelUp"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["徒劳无用！！！"],"enUS":["It's futile!!!"],"jaJP":["思い知れ！"]},"keys":["cv_invader_knight_myth_Attack3"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["就算逃跑，等待你的也只有死路一条。"],"enUS":["You can run, but only death awaits."],"jaJP":["逃げても無駄だ"]},"keys":["cv_invader_knight_myth_Skill2"]},{"type":"LeaderSkill","label":"队长技能","texts":{"zhCN":["毁灭吧！！！"],"enUS":["Perish!!!"],"jaJP":["小細工など無用！消え失せろ！"]},"keys":["cv_invader_knight_myth_LeaderSkill"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["烦死了。"],"enUS":["Annoying."],"jaJP":["うっとうしい"]},"keys":["cv_invader_knight_myth_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["软弱的家伙~难怪你们能像蟑螂一样顽强地活下来。"],"enUS":["Tainted beings playing house, you sicken me."],"jaJP":["汚染種族がどう振る舞おうが、ただのままごとにすぎん"]},"keys":["cv_invader_knight_myth_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["很符合你这卑鄙小人的身份，这就是你能活到现在的秘诀吗？"],"enUS":["A petty person's move. Is that the secret behind your tenacious survival?"],"jaJP":["姑息に生き延びてきた小物らしい選択だ"]},"keys":["cv_invader_knight_myth_PlayerChooseDark"]},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["你说你很强？那你最好祈祷待会儿我会让你死个痛快。"],"enUS":["Strong, you say? You'll beg me to kill you instead soon enough."],"jaJP":["ふん、その実力のほど見せてもらおうか、失望させるなよ"]},"keys":["cv_invader_knight_myth_StrongEnemyBattleStart"]},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["全部歼灭!"],"enUS":["Wipe them all out!"],"jaJP":["撃滅せよ！"]},"keys":["cv_invader_knight_myth_CoopAttack"]},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["胜利的美酒，滋味不错。"],"enUS":["We've won, exactly as planned."],"jaJP":["勝利の美酒というものだな"]},"keys":["cv_invader_knight_myth_CoopWin"]},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["理所当然的结果，那些不追随天神的家伙是无法理解的吧。"],"enUS":["It's the obvious outcome. Those who do not follow the Savior wouldn't understand."],"jaJP":["当然の結果だ、あのお方の偉大さをわからぬ連中には理解できないだろうがな"]},"keys":["cv_invader_knight_myth_CoopMVP"]},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["棋子无需思考，只需服从执棋者的意志。"],"enUS":["Chess pieces have no need to think. They simply oblige the hand that moves them."],"jaJP":["駒に思考など無用だ、指し手の意向に忠実であれば、それで良い"]},"keys":["cv_invader_knight_myth_CoopHi"]},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["别浪费时间，快前进！"],"enUS":["We're wasting time. Move forward!"],"jaJP":["時間を無駄にするな、走れ！"]},"keys":["cv_invader_knight_myth_CoopHurryUp"]},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["执行计划就像是一场戏，而这场戏的主人公就是我。"],"enUS":["Executing a scheme is like a play, and I'm the protagonist."],"jaJP":["計略の遂行は、いわば演劇のようなもの…主人公はもちろんこの私だ"]},"keys":["Voice_invader_knight_myth_1_TouchReactionGood1","cv_invader_knight_myth_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["不必羞愧，被我欺骗是理所当然的事。"],"enUS":["Everyone's deceived by me. Don't be too hard on your foolish self."],"jaJP":["恥じなくていい、私に騙されるのは当然だ"]},"keys":["Voice_invader_knight_myth_1_TouchReactionGood2","cv_invader_knight_myth_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["那骑士竟敢违抗天神预言，还毁了我的计划…"],"enUS":["How does that knight defy the prophecy and ruin my plan…"],"jaJP":["あのお方の予言に逆らって私の計画を台無しにするあの騎士は、一体…"]},"keys":["Voice_invader_knight_myth_1_TouchReactionBad1","cv_invader_knight_myth_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["放肆！竟然拦住我？！"],"enUS":["Don't you dare stop me."],"jaJP":["この私を、けっして呼び止めるな"]},"keys":["Voice_invader_knight_myth_1_TouchReactionBad2","cv_invader_knight_myth_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["邮件？会是新的教诲吗？"],"enUS":["Mail? It is our Savior's message."],"jaJP":["メール？あのお方の新しいお言葉か？"]},"keys":["Voice_invader_knight_myth_1_NoticeMail"]}]},{"id":"invader_knight_dead_cell","label":"细胞人贝丝 [重生细胞联动]","lines":[{