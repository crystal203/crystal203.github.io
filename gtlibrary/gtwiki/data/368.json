{"id":"invader_knight","originId":368,"name":"黑暗魔法师贝丝","englishName":"Dark Magician Beth","title":"黑暗魔法师","shortName":"贝丝","description":"侵略者最高谋略家","introduction":"","element":"暗","role":"战士","weaponsAllowed":["双手剑","饰品"],"portrait":{"sheet":"portraits","name":"invader_knight"},"stages":[{"id":368,"name":"invader_knight_3","label":"3星","stars":3,"asset":{"key":"character:invader_knight","skin":"invader_knight_3"},"sprite":{"sheet":"characters","name":"invader_knight_3"},"stats":{"Hp":826.0322304,"Atk":0.9928272,"Def":33.62324,"Recovery":0,"StatGrowthRate":1.02},"skills":[{"kind":"普通攻击","name":"黑暗扣杀","description":"挥动附有神力的双手剑，对敌人造成近程伤害。优先攻击射手或最远处怪物。"},{"name":"黑暗入侵","description":"凝聚神力，对目标敌人造成400%远程范围伤害，提升40%自己近程伤害并持续8秒。","kind":"连锁技能","trigger":"击倒","connect":"重伤"}],"party":[{"id":10810,"name":"近程伤害","base":12.0,"max":50.0,"unit":"%","level":120,"maxLevel":500,"baseCoefficient":0,"levelCoefficient":0.1,"maxLabel":"满进化 · 满觉醒"}],"skillSets":[{"number":1,"skills":[{"kind":"普通攻击","name":"黑暗扣杀","description":"挥动附有神力的双手剑，对敌人造成近程伤害。优先攻击射手或最远处怪物。"},{"name":"黑暗入侵","description":"凝聚神力，对目标敌人造成400%远程范围伤害，提升40%自己近程伤害并持续8秒。","kind":"连锁技能","trigger":"击倒","connect":"重伤"}],"party":[{"id":10810,"name":"近程伤害","base":12.0,"max":50.0,"unit":"%","level":120,"maxLevel":500,"baseCoefficient":0,"levelCoefficient":0.1,"maxLabel":"满进化 · 满觉醒"}]}],"options":[{"id":10810,"level":120,"name":"队伍近程伤害提升"}]},{"id":369,"name":"invader_knight_4","label":"4星","stars":4,"asset":{"key":"character:invader_knight","skin":"invader_knight_4"},"sprite":{"sheet":"characters","name":"invader_knight_4"},"stats":{"Hp":897.86112,"Atk":1.07916,"Def":36.547,"Recovery":0,"StatGrowthRate":1.02},"skills":[{"kind":"普通攻击","name":"黑暗扣杀","description":"挥动附有神力的双手剑，对敌人造成近程伤害。优先攻击射手或最远处怪物。"},{"name":"黑暗入侵","description":"凝聚神力，对目标敌人造成400%远程范围伤害，提升40%自己近程伤害并持续8秒。","kind":"连锁技能","trigger":"击倒","connect":"重伤"}],"party":[{"id":10810,"name":"近程伤害","base":25.0,"max":50.0,"unit":"%","level":250,"maxLevel":500,"baseCoefficient":0,"leve