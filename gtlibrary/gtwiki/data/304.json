5.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"牵引威力按照每秒伤害的150%造成范围伤害。"}],"skill":{"name":"舰队炮火齐射","description":"请求舰队炮火支援，对周围敌人造成伤害，并附带击倒效果。","levels":[1,5],"damage":[200.0,260.0],"cooldown":[10.0,9.2],"ailment":"击倒"}}],"number":1}],"profile":{"Age":[27],"Height":[163],"Weight":[51]},"tribes":["人类"],"story":"海军舰长玛丽娜，是坎特伯雷邻国阿德拉王国最年轻的海军司令。\n\n曾经指挥过的舰队不幸遭遇侵略者毒手。失去一起航海的船员，失去与自己肝胆相照的部下，让玛丽娜内疚不已。背井离乡，暂别阿德拉王国是为了阻止在世界各地捣乱的侵略者。\n\n曾在王国故乡指挥过号称不败舰队的“日米娜号”。选拔一些能准确熟练击中海面漂浮目标的船员组成了舰炮主力军团，玛丽娜则擅长近距离战。体格娇小，腕力超强。挥动与自己体格一般大小的长剑迎敌，船上所有东西都能成为玛丽娜抛出去的武器。玛丽娜作为海军舰长指挥“日米娜号”时，阿德拉王国的敌人只要见到这支军队就会夹着尾巴逃走，甚至还要学会逃亡掌舵技术。少言寡语且冷酷，偶尔显露的无精打采的模样让人以为她厌烦舰队指挥。其实，玛丽娜只想专注重要的事情，无关痛痒的琐事则抛在脑后，换句话说，玛丽娜是真的讨厌不重要而繁琐的事情。","storyKey":"profile_admiral_story","sources":{"hero":"heroes.json / OriginId=304","profile":"heroprofile.json / OriginId=304","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}