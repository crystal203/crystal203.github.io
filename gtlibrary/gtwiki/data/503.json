"character:maam_magicgunner","skin":null}},{"id":10389,"code":"maam_monk","name":"罗莫斯王国服饰玛姆","type":"时装","sprite":{"sheet":"characters","name":"maam_monk"},"asset":{"key":"character:maam_monk","skin":null}}],"weapons":[{"code":"cwp_maam","name":"魔甲拳","type":"拳套","variants":[{"id":9070464,"code":"cwp_maam_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_maam"},"stats":[{"name":"每秒伤害","values":[716,786],"baseValues":[716.0400000000001,786.2400000000001],"grows":true},{"name":"土属性攻击","values":[172,189],"baseValues":[172.125,189.00000000000003],"grows":true},{"name":"暴击率","values":[4,4],"unit":"%"},{"name":"防御","values":[20,22],"baseValues":[20.4,22.400000000000002],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"防御","min":10.0,"max":22.0,"unit":"%"},{"name":"生命","min":8.0,"max":18.0,"unit":"%"},{"name":"武器技能恢复速度","min":6.0,"max":16.0,"unit":"%"}],"subOptions":[{"name":"技能伤害值","min":8.0,"max":20.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"使用“贝荷伊米”技能时，攻击提升30%持续5秒。"}],"skill":{"name":"猛虎破碎拳","description":"集中斗气于拳头一点，对敌人造成近程伤害并附带重伤效果。","levels":[1,5],"damage":[150.0,250.0],"cooldown":[9.0,8.4],"ailment":"重伤"}}],"number":1}],"profile":{"Age":[16],"Height":null,"Weight":null},"tribes":["人类"],"story":"勇者阿邦的二弟子玛姆，一位拥有强大力量的武斗家。\n\n玛姆的父亲是战士，母亲是僧侣，而玛姆继承了战士与僧侣的全部能力。作为僧侣，玛姆并不会攻击魔法。但在她拜师阿邦，并获得了阿邦发明的魔弹枪之后，这一切才发生了改变。一开始玛姆很犹豫，自己是否有足够的能力去使用如此强大的魔弹枪，但阿邦告诉她，“没有正义的力量是无力的，没有力量的正义同样也是无力的。”从此，玛姆坚信：仅凭爱与善良，无法守护他人。她认真修炼、不断精进，并使用魔弹枪发射了回复、辅助、攻击等咒文。不久后，玛姆的力量已经可以保护整个村子。最终，她得到阿邦的认可顺利毕业，成为了阿邦的弟子。\n\n听到阿邦的死讯时，玛姆十分悲痛。她本想为师报仇，却因为自己有守护涅尔村的责任，而无法离开。在母亲和村民的鼓励下，玛姆决定离开涅尔村，这样她便能继承阿邦的遗志，并替阿邦报仇。后来，玛姆正式成为达伊和波普的伙伴，一起踏上了冒险之路。\n\n在一场战斗中，魔弹枪严重受损无法继续使用。经过深思熟虑，玛姆决定使用新武器来代替。而玛姆发现的新武器正是来源于父亲的力量，她想靠这股力量修炼成为武斗家。后来，玛姆找到了“武术之神”布罗基纳，通过种种极限训练，最终成为了一位真正的武斗家。\n\n玛姆表面上看上去大大咧咧，其实内心细腻又柔软，比任何人都要关心自己的伙伴。就算是敌人，只要知道对方曾有过心灵上的创伤，她仍会释放善意带来一丝温暖。有一次，同样是阿邦门徒的修凯尔为了替父亲报仇，攻击了玛姆和伙伴们。在得知原因后，玛姆不断劝说修凯尔，试图让他重新作为阿邦的弟子，与他们成为伙伴。","storyKey":"profile_maam_story","sources":{"hero":"heroes.json / OriginId=503","profile":"heroprofile.json / OriginId=503","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"maam","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["赢了！"],"enUS":["We won!"],"jaJP":["勝ったわ！"]},"keys":["cv_maam_NormalBattleWin"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/503/5030001"]},"audioName":"5030001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["原谅我，我只能这么做…"],"enUS":["Forgive me, I didn't have a choice…"],"jaJP":["許して、私、こうするしか…"]},"keys":["cv_maam_BossBattleWin"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/503/5030002"]},"audioName":"5030002"},{"type":"Die","label":"阵亡","texts":{"zhCN":["我不能在这里被打倒…"],"enUS":["I can't let myself be defeated here…"],"jaJP":["ここでやられてしまうわけにはいかないのに…"]},"keys":["cv_maam_Die"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/503/5030003"]},"audioName":"5030003"},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["已经有了这种层次成长…不会输吧？"],"enUS":["With this amount of growth… I won't lose right?"],"jaJP":["これほど成長したら…もう負けないよね"]},"keys":["cv_maam_GetExp"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/503/5030004"]},"audioName":"5030004"},{"type":"LevelUp","label":"升级","texts":{"zhCN":["我必须变得更加强大，因为没有力量的正义是无力的。"],"enUS":["I must get stronger. Justice without strength is powerless."],"jaJP":["強くならないと…力なき正義は無力なのだから"]},"keys":["cv_maam_LevelUp"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/503/5030005"]},"audioName":"5030005"},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["那这把是我的吗？"],"enUS":["So, this is mine?"],"jaJP":["じゃ、これが私の？"]},"keys":["cv_maam_EquipWeapon"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/503/5030006"]},"audioName":"5030006"},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["布料轻飘飘的，行动很不方便啊…"],"enUS":["But this thing flaps around and gets in the way…"],"jaJP":["なんかヒラヒラして動きづらいんだけど"]},"keys":["cv_maam_EquipCostume"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/503/5030007"]},"audioName":"5030007"},{"type":"Evolve","label":"进化","texts":{"zhCN":["我不能输！"],"enUS":["I want to catch up with you!"],"jaJP":["みんなの成長に負けたくないもの"]},"keys":["cv_maam_Evolve"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/503/5030008"]},"audioName":"5030008"},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["哈！"],"enUS":["Haat!"],"jaJP":["はっ！"]},"keys":["cv_maam_Attack1"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/503/5030009"]},"audioName":"5030009"},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["哈啊！"],"enUS":["Haaap!"],"jaJP":["はああっ！"]},"keys":["cv_maam_Attack2"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/503/5030010"]},"audioName":"5030010"},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["特啊！"],"enUS":["Taaat!"],"jaJP":["たあっ！"]},"keys":["cv_maam_Attack3"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/503/5030011"]},"audioName":"5030011"},{"type":"Skill1","label":"技能1","texts":{"zhCN":["这是我最后的一击！"],"enUS":["This is my final attack!"],"jaJP":["これが最後の一撃！"]},"keys":["cv_maam_Skill1"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/503/5030012"]},"audioName":"5030012"},{"type":"Skill2","label":"技能2","texts":{"zhCN":["那就让我来告诉你，生命的痛楚！"],"enUS":["It's time you learned the pain of life!"],"jaJP":["教えてあげるわ、命の痛みを！"]},"keys":["cv_maam_Skill2"],"audio":{"zhCN":[],