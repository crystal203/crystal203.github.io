first_bishop_CoopMVP"]},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["请多关照啦！玩儿个痛快吧！"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_CoopHi"]},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["跟不上了吗？"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_CoopHurryUp"]},{"type":"CoopBelieve","label":"战斗-信任","texts":{"zhCN":["交给我吧！等我打败所有敌人再回来。"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_CoopBelieve"]},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["我刚好要给下一个招式取名字！“开天辟地之火”，这个怎么样？"],"enUS":[],"jaJP":[]},"keys":["Voice_first_bishop_1_TouchReactionGood1","cv_first_bishop_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["你问我能随意挥舞跟身体一样大的巨剑的秘诀？哈哈哈，你还没见过我的真本事吧？"],"enUS":[],"jaJP":[]},"keys":["Voice_first_bishop_1_TouchReactionGood2","cv_first_bishop_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["哎呀，刚才那下是失误？没关系！让我也打你一下就扯平了！"],"enUS":[],"jaJP":[]},"keys":["Voice_first_bishop_1_TouchReactionBad1","cv_first_bishop_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["又是职责又是誓约，真是麻烦。真想忘掉一切，痛快地玩一场！"],"enUS":[],"jaJP":[]},"keys":["Voice_first_bishop_1_TouchReactionBad2","cv_first_bishop_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["喂，有信来了！你最好还是在我抢先拆开前，确认一下吧？"],"enUS":[],"jaJP":[]},"keys":["Voice_first_bishop_1_NoticeMail","cv_first_bishop_NoticeMail"]},{"type":"NoticeEvent","label":"活动提示","texts":{"zhCN":["似乎听到了有趣的消息，我的直觉不会错！"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_NoticeEvent"]},{"type":"SummonSpeech1","label":"召唤-台词1","texts":{"zhCN":["我是凯勒，尼德霍格大人最初的化身。"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_SummonSpeech1"]},{"type":"SummonSpeech2","label":"召唤-台词2","texts":{"zhCN":["最喜欢自由！"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_SummonSpeech2"]},{"type":"SummonSpeech3","label":"召唤-台词3","texts":{"zhCN":["讨厌会束缚自由的一切！"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_SummonSpeech3"]}]},{"id":"first_bishop_myth","label":"开花","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["全部破坏之后，还剩下什么？我从没想过呢！"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_myth_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["看来你也觉得有趣得要死！啊哈哈哈！不过我可没死哦。"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_myth_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["啊啊…尼德霍格…大人…"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_myth_Die"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["自由是靠争取来的！为此必须变得更强。"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_myth_LevelUp"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["把你劈成两半！"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_myth_Attack3"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["升腾吧，烈焰！"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_myth_Skill2"]},{"type":"LeaderSkill","label":"队长技能","texts":{"zhCN":["我就是，永不熄灭的烈焰！！"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_myth_LeaderSkill"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["想要打倒我？"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_myth_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["不过，偶尔作出这种循规蹈矩的选择也是你的自由。"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_myth_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["我可没觉得你是个坏人。按照你的信念，随心所欲地活着吧！"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_myth_PlayerChooseDark"]},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["先动起来再说，之后总有办法的！"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_myth_StrongEnemyBattleStart"]},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["在那儿，碾碎他们！"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_myth_CoopAttack"]},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["就这点本事？都不够我热身的。"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_myth_CoopWin"]},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["谢谢。这份荣耀献给尼德霍格大人。"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_myth_CoopMVP"]},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["别紧张！不过是一场游戏罢了。"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_myth_CoopHi"]},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["越晚到，乐趣就会越少！"],"enUS":[],"jaJP":[]},"keys":["cv_first_bishop_myth_CoopHurryUp"]},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["我刚好要给下一个招式取名字！“开天辟地之火”，这个怎么样？"],"enUS":[],"jaJP":[]},"keys":["Voice_first_bishop_myth_1_TouchReactionGood1","cv_first_bishop_myth_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["没有人比我在尼德霍格大人身边侍奉的更久了吧？我连她说的梦话都背下来了！"],"enUS":[],"jaJP":[]},"keys":["Voice_first_bishop_myth_1_TouchReactionGood2","cv_first_bishop_myth_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["哎呀，刚才那下是失误？没关系！让我也打你一下就扯平了！"],"enUS":[],"jaJP":[]},"keys":["Voice_first_bishop_myth_1_TouchReactionBad1","cv_first_bishop_myth_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["自由不可能没有牺牲。沃贝尔的每一个人…都深知这一点。"],"enUS":[],"jaJP":[]},"keys":["Voice_first_bishop_myth_1_TouchReactionBad2","cv_first_bishop_myth_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["喂，有信来了！你最好还是在我抢先拆开前，确认一下吧？"],"enUS":[],"jaJP":[]},"keys":["Voice_first_bishop_myth_1_NoticeMail"]}]}]}
