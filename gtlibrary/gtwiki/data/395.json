":5,"sprite":{"sheet":"items","name":"cwp_necromancer"},"stats":[{"name":"每秒伤害","values":[562,617],"baseValues":[562.224,617.344],"grows":true},{"name":"暗属性攻击","values":[135,148],"baseValues":[135.15,148.4],"grows":true},{"name":"暴击率","values":[4,4],"unit":"%"},{"name":"恢复能力","values":[218,218],"baseValues":[218,218],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"武器技能恢复速度","min":8.0,"max":20.0,"unit":"%"},{"name":"技能伤害值","min":8.0,"max":20.0,"unit":"%"},{"name":"生命","min":6.0,"max":16.0,"unit":"%"}],"subOptions":[{"name":"防御","min":6.0,"max":16.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"诺克希娅攻击命中目标时，以40%概率，按照每秒伤害的40%，造成远程伤害。黑暗灵魂嘲讽敌人时，按照每秒伤害的100%，造成近程伤害。"}],"skill":{"name":"冥界引路人之手","description":"将目标敌人拖入地府，造成近程伤害，并附带击倒效果。","levels":[3,6],"damage":[215.0,290.0],"cooldown":[9.3,9.0],"ailment":"击倒"}}],"number":1}],"profile":{"Age":[17],"Height":[149],"Weight":[40]},"tribes":["人类"],"story":"诺克希娅，召唤灵魂并利用尸体制造怪物的死灵法师。\n \n与生俱来的力量使她能看到灵魂并与之通灵，她也可以随时召唤自己在旅行中利用“碎片”组合成的怪物。诺克希娅将世上所有无生命的东西当成自己的朋友，为了和这些朋友一起玩，她像过家家一样给他们分配了角色。其中，扮演“我的保护神——高大的父亲”角色的那位巨型朋友，总是陪伴在诺克希娅身边。\n \n在诺克希娅小时候，她没能意识到自己拥有特殊“能力”，无法分辨活人和死者的她自然而然地选择与后者成为朋友。当其他小朋友都在玩洋娃娃的时候，诺克希娅就“创造”了自己的人偶。大人们对于她用动物尸体制造怪物的古怪行为感到害怕，他们争吵着要把诺克希娅送走，最后就连诺克希娅的父母也抛弃了她。未满10岁的诺克希娅只好离开家乡，开始四处流浪。慢慢地，墓园和坟墓周围成为最能让她心里感到踏实的场所。\n \n诺克希娅从来不知道如何像普通人一样感受或抒发情感，长期与死灵接触，使得她的面部表情和声音都变得冰冷。几乎所有与诺克希娅有过一面之缘的人都会感到害怕或者憎恶，这也难怪诺克希娅更愿意接近善待自己的死灵，毕竟与活人打交道困难且麻烦。尽管如此，诺克希娅还是非常憧憬活人世界里的璀璨文明和甜美饼干。尤其是小时候在甜点店里看到的巧克力，是诺克希娅梦寐以求的食品。","storyKey":"profile_necromancer_story","sources":{"hero":"heroes.json / OriginId=395","profile":"heroprofile.json / OriginId=395","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*