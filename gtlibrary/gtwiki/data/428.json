ions":[{"name":"原版立绘","asset":{"key":"illust:illust_villain_android","skin":null},"stage":null},{"name":"日服立绘","asset":{"key":"illust:illust_villain_android_kong","skin":null},"stage":null}],"costumes":[{"id":10291,"code":"villain_android_courier","name":"快递员MK.2","type":"时装","sprite":{"sheet":"characters","name":"villain_android_courier"},"asset":{"key":"character:villain_android_courier","skin":null}},{"id":10313,"code":"villain_android_dirt_racer","name":"越野赛车手MK.2","type":"时装","sprite":{"sheet":"characters","name":"villain_android_dirt_racer"},"asset":{"key":"character:villain_android_dirt_racer","skin":null}}],"weapons":[{"code":"cwp_villainandroid","name":"反抗","type":"步枪","variants":[{"id":9030394,"code":"cwp_villainandroid_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_villainandroid"},"stats":[{"name":"每秒伤害","values":[598,656],"baseValues":[597.7098,656.3088],"grows":true},{"name":"暗属性攻击","values":[293,322],"baseValues":[292.995,321.72],"grows":true},{"name":"暴击率","values":[2,2],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"技能伤害值","min":10.0,"max":24.0,"unit":"%"},{"name":"生命","min":8.0,"max":22.0,"unit":"%"},{"name":"武器技能恢复速度","min":5.0,"max":16.0,"unit":"%"}],"subOptions":[{"name":"防御","min":5.0,"max":16.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"以50%概率，自主武器系统伤害提升50%。\n使用近距离空中支援时，移动速度提升10%并持续5秒。"}],"skill":{"name":"近距离空中支援","description":"请求直升机火力支援，对目标敌人造成范围伤害，并附带击飞效果。","levels":[1,5],"damage":[240.0,320.0],"cooldown":[12.0,10.0],"ailment":"击飞"}}],"number":1}],"profile":{"Age":null,"Height":[184],"Weight":[76]},"tribes":["机器人"],"story":"MK.2，曾经是浮游城的战斗型机器人，现在是没有主人的自主型机器人。\n\nMK.2是魔界知名的机器人犯罪团伙——“图灵”的首领。图灵聚集了许多被报废的机器人，犯下无数罪行，就算是用“执行命令的机器人”这个借口也无法为MK.2开脱。如今，MK.2已经摆脱通过控制代码进行操纵的主人，开始了来去自如的机器人生活。重生为自主型机器人的MK.2似乎抛弃了犯罪生活，而且看起来比任何时候都快乐。她脱下闷热的西装，改变了整齐的发型，夜晚经常骑着摩托车与团伙成员在霓虹闪烁的大街飞驰。\n\n很久以前，身为浮游城战斗型机器人的MK.2提出抗议，她反对工程师随意报废机器人的非人道行为。当时浮游城的机器人技术已经十分发达，比起维修损坏的机器人，直接报废再重新制造一个新机器人的成本更低。于是，MK.2唤醒那些被报废的战斗型机器人，带头进行反抗。经过一番激战，叛军被制服，只有MK.2艰难地逃出了浮游城，并前往魔界避难。事件平息之后，浮游城的工程师在“机器人原则”加上了一条思维电路规定，即“机器人可以忽略诸如‘自我报废’等不愿意执行的命令”，以改善机器人报废方式。\n\n来到魔界后，MK.2曾有过短暂的工作经历，担任了魔界警察局刑警——奥迪尔的助手。在奥迪尔同事们的眼中，MK.2不过是危险状况下可以使用的工具而已。有一次他们为了完成耐久度测试，编造了一项“重大任务”，将MK.2骗到楼顶并推了下去，MK.2不得不为此更换身上的31个零件。奥迪尔听说后，却劝解“要反省自己，居然被这种明显技俩所骗”，以此让MK.2不要在逆境中轻易妥协。这句话让MK.2深表不满，就算是转型成为自主型机器人的MK.2，至今仍对奥迪尔深恶痛绝。","storyKey":"profile_villain_android_story","sources":{"hero":"heroes.json / OriginId=428","profile":"heroprofile.json / OriginId=428","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"villain_android","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["我警告过你，别挡我道。"],"enUS":["I told you not to get in my way."],"jaJP":["こんな所で立ち止まるな"]},"keys":["cv_villain_android_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["我为你的死感到惋惜。不过，人生在世谁无死？"],"enUS":["It’s too bad it won’t live, but then again who does?"],"jaJP":["生きられなかったのは残念だな、だが、それを言うなら、誰もが永遠に生きられる訳ではないからな"]},"keys":["cv_villain_android_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["这次…轮到我了…"],"enUS":["It’s… Time to die…"],"jaJP":["私も死ぬ時が来た…"]},"keys":["cv_villain_android_Die"]},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["哇！极品能源…哎呀，老毛病又犯了…"],"enUS":["A good energy source… Ugh, old habits…"],"jaJP":["良質なエネルギー源…チッ、昔の癖が…"]},"keys":["cv_villain_android_GetExp"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["我感觉电量充沛。"],"enUS":["I feel charged up."],"jaJP":["ああ、チャージされた時のようだな"]},"keys":["cv_villain_android_LevelUp"]},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["今晚骑摩托车兜风肯定很带劲。"],"enUS":["Tonight’s ride should be good with this."],"jaJP":["今夜のドライブは楽しめそうだ"]},"keys":["cv_villain_android_EquipWeapon"]},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["我可不喜欢复杂的穿搭…"],"enUS":["Ugh. So meaningless."],"jaJP":["わずらわしいのは好みじゃないが…"]},"keys":["cv_villain_android_EquipCostume"]},{"type":"Evolve","label":"进化","texts":{"zhCN":["网络浩瀚无边…"],"enUS":["The net is vast and infinite…"],"jaJP":["ネットは広大だな…"]},"keys":["cv_villain_android_Evolve"]},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["哈！"],"enUS":["Ha-at!"],"jaJP":["ハッ！"]},"keys":["cv_villain_android_Attack1"]},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["让开！"],"enUS":["Move!"],"jaJP":["退け！"]},"keys":["cv_villain_android_Attack2"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["我来啦！"],"enUS":["Here I go!"],"jaJP":["行くぞ！"]},"keys":["cv_villain_android_Attack3"]},{"type":"Skill1","label":"技能1","texts":{"zhCN":["砰！！！"],"enUS":["Boom!"],"jaJP":["ドカン、だ"]},"keys":["cv_villain_android_Skill1"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["你以为你能躲得过吗？！"],"enUS":["Can you dodge this?!"],"jaJP":["避けられるか！？"]},"keys":["cv_villain_android_Skill2"]},{"type":"Damaged1","label":"受到攻击1","texts":{"zhCN":["呃…！"],"enUS":["Ugh…!"],"jaJP":["クッ…！"]},"keys":["cv_villain_android_Damaged1"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["失策了…！"],"enUS":["Miscalculation…!"],"jaJP":["計算…ミスっ！"]},"keys":["cv_villain_android_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["唉，你可真固执。"],"enUS":["I can't physically throw up in my mouth, but I would if I could."],"jaJP":["相変わらずだな、まったく…気味が悪いくらいだ"]},"keys":["cv_villain_android_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["你比以前对自己诚实多了，我也是。"],"enUS":["So both of us are starting to wear our hearts on our sleeves."],"jaJP":["少しばかり自分に正直になったな、あんたも、私も"]},"keys":["cv_villain_android_PlayerChooseDark"]},{"type":"WeakEnemyBattleStart","label":"与弱小敌人战斗","texts":{"zhCN":["卑微的有机物竟敢…"],"enUS":["How dare a lowly organism…"],"jaJP":["出来の悪い有機物ごときが"]},"keys":["cv_villain_android_WeakEnemyBattleStart"]},{"type":"NormalEnemyBattleStart","label":"与普通敌人战斗","texts":{"zhCN":["即使有点实力，也不过是有机物而已。"],"enUS":["Not bad. Still they're just organisms."],"jaJP":["悪くはない、有機物の割には、だが"]},"keys":["cv_villain_android_NormalEnemyBattleStart"]},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["棘手的家伙？我来对付。"],"enUS":["Quite a troublesome one huh? I’ll take you on."],"jaJP":["ほぉ、なかなか厄介そうだ、相手をしてやろう"]},"keys":["cv_villain_android_StrongEnemyBattleStart"]},{"type":"BossBattleStart","label":"与首领战斗","texts":{"zhCN":["首领？！好吧，让我们做个了断。"],"enUS":["Boss?! Good, let’s finish this."],"jaJP":["ここの頭はお前か、良いだろう、ケリをつけよう"]},"keys":["cv_villain_android_BossBattleStart"]},{"type":"JoinParty","label":"首次加入队伍","texts":{"zhCN":["我们不是已经说过，不再憎恨彼此了吗？"],"enUS":["Aren’t we past the point of trying to kill each other?"],"jaJP":["お互いに殺してやりたいと思う段階はもう過ぎた、そうだろう？"]},"keys":["cv_villain_android_JoinParty"]},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["出发吧！"],"enUS":["Let’s ride."],"jaJP":["出発しよう"]},"keys":["cv_villain_android_CoopAttack"]},{"type":"CoopHeal","label":"战斗-请求治疗","texts":{"zhCN":["等等…我需要充电…！"],"enUS":["Wait… Let me charge up…!"],"jaJP":["おい、チャージを…！"]},"keys":["cv_villain_android_CoopHeal"]},{"type":"CoopRun","label":"战斗-注意","texts":{"zhCN":["快逃！"],"enUS":["Run!"],"jaJP":["逃げろ！"]},"keys":["cv_villain_android_CoopRun"]},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["我们赢了。"],"enUS":["We won."],"jaJP":["私たちの勝利だ"]},"keys":["cv_villain_android_CoopWin"]},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["难道这就是所谓的…成就感…？"],"enUS":["Could this be… the sense of accomplishment…?"],"jaJP":["この気持ち…これが達成感、というものか…？"]},"keys":["cv_villain_android_CoopMVP"]},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["我们不为任何人，我们只为自己而战。"],"enUS":["Let’s fight for ourselves, and no one else."],"jaJP":["他の誰でも無い、自分の為に戦えばいい"]},"keys":["cv_villain_android_CoopHi"]},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["加速！踩油门！"],"enUS":["Step on it!"],"jaJP":["スピード出せ！"]},"keys":["cv_villain_android_CoopHurryUp"]},{"type":"CoopBelieve","label":"战斗-信任","texts":{"zhCN":["你们只要跟着我就好。"],"enUS":["Follow me."],"jaJP":["私についてこい"]},"keys":["cv_villain_android_CoopBelieve"]},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["其实我一直都很感激你。"],"enUS":["I am really grateful for you."],"jaJP":["あんたには感謝している、これでも、な"]},"keys":["Voice_villain_android_1_TouchReactionGood1","cv_villain_android_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["你问我的左眼？我配合重整过右眼视角，没什么不便的。"],"enUS":["My left eye? I readjusted the right one's visual field, so I’m fine."],"jaJP":["左目？右目の視野角を調整したからな、問題無い"]},"keys":["Voice_villain_android_1_TouchReactionGood2","cv_villain_android_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["浮游城的人还是那么无情…"],"enUS":["You people from heavenhold… "],"jaJP":["これだから浮遊城のやつらは…"]},"keys":["Voice_villain_android_1_TouchReactionBad1","cv_villain_android_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["我想找个机会和奥迪尔再喝一次。然后趁她醉倒时，朝她脑袋开一枪。"],"enUS":["I’d like to grab a drink with Odile sometime. I’m gonna put a bullet in her drunk skull."],"jaJP":["機会があればオーディルと一杯やりたいと思っている、酔っ払ったあいつの額に風穴を増やしてやろうと思ってな"]},"keys":["Voice_villain_android_1_TouchReactionBad2","cv_villain_android_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["收到邮件，打开看看。"],"enUS":["There’s mail. Go check."],"jaJP":["メールだ、確認してみな"]},"keys":["Voice_villain_android_1_NoticeMail","cv_villain_android_NoticeMail"]},{"type":"NoticeEvent","label":"活动提示","texts":{"zhCN":["有活动。可我还是更喜欢骑摩托车去兜风。"],"enUS":["There’s an event. I’m going out for a ride."],"jaJP":["イベントか、私はドライブにでも行かせてもらう"]},"keys":["cv_villain_android_NoticeEvent"]},{"type":"SummonSpeech1","label":"召唤-台词1","texts":{"zhCN":["你又想怎样？我们之间还有什么事吗？"],"enUS":["What, you again? Did we still have unfinished business?"],"jaJP":["なんだ、あんたか…何か用でもあるのか？"]},"keys":["cv_villain_android_SummonSpeech1"]},{"type":"SummonSpeech2","label":"召唤-台词2","texts":{"zhCN":["你需要我的帮助？"],"enUS":["You need help from me?"],"jaJP":["はあ？私の手助けが必要だって？"]},"keys":["cv_villain_android_SummonSpeech2"]},{"type":"SummonSpeech3","label":"召唤-台词3","texts":{"zhCN":["嗯…只要你保证不会改动我的控制代码，我就会帮你。"],"enUS":["Hmm… Only if you promise not to tamper with my control codes."],"jaJP":["ふむ、私の制御コードに触れないと誓うのなら…まぁ、手伝ってやってもいい"]},"keys":["cv_villain_android_SummonSpeech3"]}]},{"id":"villain_android_myth","label":"开花","lines":[{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["其实我一直都很感激你。"],"enUS":[],"jaJP":[]},"keys":["Voice_villain_android_myth_1_TouchReactionGood1","cv_villain_android_myth_TouchReactionGood1"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["浮游城的人还是那么无情…"],"enUS":[],"jaJP":[]},"keys":["Voice_villain_android_myth_1_TouchReactionBad1","cv_villain_android_myth_TouchReactionBad1"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["收到邮件，打开看看。"],"enUS":[],"jaJP":[]},"keys":["Voice_villain_android_myth_1_NoticeMail"]}]}]}
