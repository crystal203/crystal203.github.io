ions":[{"name":"原版立绘","asset":{"key":"illust:illust_villain_android","skin":null},"stage":null},{"name":"日服立绘","asset":{"key":"illust:illust_villain_android_kong","skin":null},"stage":null}],"costumes":[{"id":10291,"code":"villain_android_courier","name":"快递员MK.2","type":"时装","sprite":{"sheet":"characters","name":"villain_android_courier"},"asset":{"key":"character:villain_android_courier","skin":null}},{"id":10313,"code":"villain_android_dirt_racer","name":"越野赛车手MK.2","type":"时装","sprite":{"sheet":"characters","name":"villain_android_dirt_racer"},"asset":{"key":"character:villain_android_dirt_racer","skin":null}}],"weapons":[{"code":"cwp_villainandroid","name":"反抗","type":"步枪","variants":[{"id":9030394,"code":"cwp_villainandroid_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_villainandroid"},"stats":[{"name":"每秒伤害","values":[598,656],"baseValues":[597.7098,656.3088],"grows":true},{"name":"暗属性攻击","values":[293,322],"baseValues":[292.995,321.72],"grows":true},{"name":"暴击率","values":[2,2],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"技能伤害值","min":10.0,"max":24.0,"unit":"%"},{"name":"生命","min":8.0,"max":22.0,"unit":"%"},{"name":"武器技能恢复速度","min":5.0,"max":16.0,"unit":"%"}],"subOptions":[{"name":"防御","min":5.0,"max":16.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"以50%概率，自主武器系统伤害提升50%。\n使用近距离空中支援时，移动速度提升10%并持续5秒。"}],"skill":{"name":"近距离空中支援","description":"请求直升机火力支援，对目标敌人造成范围伤害，并附带击飞效果。","levels":[1,5],"damage":[240.0,320.0],"cooldown":[12.0,10.0],"ailment":"击飞"}}],"number":1}],"profile":{"Age":null,"Height":[184],"Weight":[76]},"tribes":["机器人"],"story":"MK.2，曾经是浮游城的战斗型机器人，现在是没有主人的自主型机器人。\n\nMK.2是魔界知名的机器人犯罪团伙——“图灵”的首领。图灵聚集了许多被报废的机器人，犯下无数罪行，就算是用“执行命令的机器人”这个借口也无法为MK.2开脱。如今，MK.2已经摆脱通过控制代码进行操纵的主人，开始了来去自如的机器人生活。重生为自主型机器人的MK.2似乎抛弃了犯罪生活，而且看起来比任何时候都快乐。她脱下闷热的西装，改变了整齐的发型，夜晚经常骑着摩托车与团伙成员在霓虹闪烁的大街飞驰。\n\n很久以前，身为浮游城战斗型机器人的MK.2提出抗议，她反对工程师随意报废机器人的非人道行为。当时浮游城的机器人技术已经十分发达，比起维修损坏的机器人，直接报废再重新制造一个新机器人的成本更低。于是，MK.2唤醒那些被报废的战斗型机器人，带头进行反抗。经过一番激战，叛军被制服，只有MK.2艰难地逃出了浮游城，并前往魔界避难。事件平息之后，浮游城的工程师在“机器人原则”加上了一条思维电路规定，即“机器人可以忽略诸如‘自我报废’等不愿意执行的命令”，以改善机器人报废方式。\n\n来到魔界后，MK.2曾有过短暂的工作经历，担任了魔界警察局刑警——奥迪尔的助手。在奥迪尔同事们的眼中，MK.2不过是危险状况下可以使用的工具而已。有一次他们为了完成耐久度测试，编造了一项“重大任务”，将MK.2骗到楼顶并推了下去，MK.2不得不为此更换身上的31个零件。奥迪尔听说后，却劝解“要反省自己，居然被这种明显技俩所骗”，以此让MK.2不要在逆境中轻易妥协。这句话让MK.2深表不满，就算是转型成为自主型机器人的MK.2，至今仍对奥迪尔深恶痛绝。","storyKey":"profile_villain_android_story","sources":{"hero":"heroes.json / OriginId=428","profile":"heroprofile.json / OriginId=428","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"villain_android","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["我警告过你，别挡我道。"],"enUS":["I told you not to get in my way."],"jaJP":["こんな所で立ち止まるな"]},"keys":["cv_villain_android_NormalBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/428/4280001@-312623353983653197"],"enUS":["cdn/Android/ondemand/voices_en/428/4280001"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/428/4280001@-2614970954342325602"]},"audioName":"4280001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["我为你的死感到惋惜。不过，人生在世谁无死？"],"enUS":["It’s too bad it won’t live, but then again who does?"],"jaJP":["生きられなかったのは残念だな、だが、それを言うなら、誰もが永遠に生きられる訳ではないからな"]},"keys":["cv_villain_android_BossBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/428/4280002@2494857675134282554"],"enUS":["cdn/Android/ondemand/voices_en/428/4280002"],"jaJP":["offline/AssetBundles/Android/ondemand/voi