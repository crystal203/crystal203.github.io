ing!"],"jaJP":["強敵か！？レディーたち、よく見ておくのだ！"]},"keys":["cv_golem_rider_BossBattleStart"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/356/3560021@-2763586030023618393"],"enUS":["cdn/Android/ondemand/voices_en/356/3560021"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/356/3560021@7459155297441028025"]},"audioName":"3560021"},{"type":"JoinParty","label":"首次加入队伍","texts":{"zhCN":["虽然我看上去很年轻，但我确实是一位经验丰富的雕刻师。"],"enUS":["I do look quite young but I'm still an experienced alchemist!"],"jaJP":["確かに俺は少々童顔だが、こう見えてもベテランの錬金術師さ！"]},"keys":["cv_golem_rider_JoinParty"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/356/3560022@6805442337268440117"],"enUS":["cdn/Android/ondemand/voices_en/356/3560022"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/356/3560022@-2330473465524800152"]},"audioName":"3560022"},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["攻击！"],"enUS":["Everyone, move forward!"],"jaJP":["みんな、前へ！"]},"keys":["cv_golem_rider_CoopAttack"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/356/3560023@-9169959585566174579"],"enUS":["cdn/Android/ondemand/voices_en/356/3560023"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/356/3560023@-5393670471785229529"]},"audioName":"3560023"},{"type":"CoopHeal","label":"战斗-请求治疗","texts":{"zhCN":["治，治疗！谁能给我的魔像一些水！"],"enUS":["H-heal! Someone give my golem some water!"],"jaJP":["ヒール、ヒール！誰か、俺のゴーレムに水をかけてくれ！"]},"keys":["cv_golem_rider_CoopHeal"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/356/3560024@-1973895674513819167"],"enUS":["cdn/Android/ondemand/voices_en/356/3560024"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/356/3560024@-2499530864361891656"]},"audioName":"3560024"},{"type":"CoopRun","label":"战斗-注意","texts":{"zhCN":["大家快逃！"],"enUS":["Everybody run!"],"jaJP":["みんな、逃げるんだ！"]},"keys":["cv_golem_rider_CoopRun"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/356/3560025@6405502814420288092"],"en