5"]},"audioName":"6380020"},{"type":"BossBattleStart","label":"与首领战斗","texts":{"zhCN":["咳…这里压根没有复原药草…不如换个地方找找？"],"enUS":["Ahem…I don't think there are any Dispel herbs here… Should we go somewhere else?"],"jaJP":["うーん…ここにディスペルハーブはなさそうだし…場所を変えようか"]},"keys":["cv_whiteday_girgas_BossBattleStart"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/638/6380021@6823953163849749654"],"enUS":[],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/638/6380021@-1553967894859825086"]},"audioName":"6380021"},{"type":"JoinParty","label":"首次加入队伍","texts":{"zhCN":["我没兴趣和人类打交道，除非他们能拿出够格的美食…"],"enUS":["I don't plan on hanging out with humans. It might be different if they offered me something tasty…"],"jaJP":["人間たちとなれ合うつもりはない、\nうまいものをくれるっていうなら話は別だけど…"]},"keys":["cv_whiteday_girgas_JoinParty"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/638/6380022@-2934443784345667393"],"enUS":[],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/638/6380022@-901329197298739083"]},"audioName":"6380022"},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["瞄准那边！"],"enUS":["Aim over there!"],"jaJP":["あっちだ！"]},"keys":["cv_whiteday_girgas_CoopAttack"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/638/6380023@2648190015506585318"],"enUS":[],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/638/6380023@-2169817344986814282"]},"audioName":"6380023"},{"type":"CoopHeal","label":"战斗-请求治疗","texts":{"zhCN":["紧、紧急情况！我受伤了！"],"enUS":["E-Emergency! I've been hurt!!"],"jaJP":["き、緊急！このオレ様がケガしたぞ！！"]},"keys":["cv_whiteday_girgas_CoopHeal"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/638/6380024@-8259007019936250540"],"enUS":[],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/638/6380024@-9212561877515059299"]},"audioName":"6380024"},{"type":"CoopRun","label":"战斗-注意","texts":{"zhCN":["后退！后退！"],"enUS":["Retreat! Retreat!!"],"jaJP":["撤退だ！撤退！！"]},"keys":["cv_whiteday_girgas_CoopRun"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/638/6380025@1041964882923844620"],"enUS":[],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/638/6380025@-2358199107796022273"]},"audioName":"6380025"},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["好好珍惜我赐予你们的胜利～"],"enUS":["Cherish the victory I brought you."],"jaJP":["オレ様がもたらした勝利、ありがたく思えよ！"]},"keys":["cv_whiteday_girgas_CoopWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/638/6380026@5959284120939741907"],"enUS":[],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/638/6380026@-3890140140143064468"]},"audioName":"6380026"},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["哈…！因为太理所当然了，我甚至都感受不到获奖的激动～"],"enUS":["Hah…! It was so obvious that I'm not even impressed."],"jaJP":["はっ…！当たり前すぎて、なんの感動もないぜ"]},"keys":["cv_whiteday_girgas_CoopMVP"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/638/6380027@-926999120065235398"],"enUS":[],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/638/6380027@-5449399874883060763"]},"audioName":"6380027"},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["为我的加入，尽情欢呼吧！"],"enUS":["Yup. Rejoice for I have arrived!"],"jaJP":["喜ぶがいい、お前のような人間がこのオレ様に選んでもらえたんだからな"]},"keys":["cv_whiteday_girgas_CoopHi"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/638/6380028@-3650739767751508115"],"enUS":[],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/638/6380028@-8783492385573148386"]},"audioName":"6380028"},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["傻站着干嘛呢？！"],"enUS":["What are you doing just standing there?!"],"jaJP":["突っ立ってないで早くしろ！"]},"keys":["cv_whiteday_girgas_CoopHurryUp"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/638/6380029@2025731918882467005"],"enUS":[],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/638/6380029@2281646236981347531"]},"audioName":"6380029"},{"type":"CoopBelieve","label":"战斗-信任","texts":{"zhCN":["交给我吧！"],"enUS":["Leave it to me!"],"jaJP":["このオレ様にまかせろ！"]},"keys":["cv_whiteday_girgas_CoopBelieve"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/638/6380030@-8733935781922816170"],"enUS":[],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/638/6380030@-8076675995042885685"]},"audioName":"6380030"},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["爱梅莉丝前几天塞给我一堆巧克力，我也得送吗？"],"enUS":["Ameris gave me a bunch of chocolates the other day. Do I have to do that too?"],"jaJP":["この前、アメリスからチョコをたくさんもらったんだけど、何か返したほうがいいのか？"]},"keys":["Voice_whiteday_girgas_1_TouchReactionGood1","cv_whiteday_girgas_TouchReactionGood1"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/638/6380031@-7979010445003629311"],"enUS":[],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/638/6380031@7025309809135844550"]},"audioName":"6380031"},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["爱梅莉丝脸蛋通红通红的…看起来好像哪里不舒服。"],"enUS":["Ameris' face was really red… I think she might be sick."],"jaJP":["アメリスのやつ、顔が真っ赤だったけど、どこか悪いのか"]},"keys":["Voice_whiteday_girgas_1_TouchReactionGood2","cv_whiteday_girgas_TouchReactionGood2"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/638/6380032@5154459297052783907"],"enUS":[],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/638/6380032@-65450212989036859"]},"audioName":"6380032"},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["送她糖果可以表达心意？糖果…不是用来吃的吗？！"],"enUS":["Express my feelings with candy? Candy is… for eating though?!"],"jaJP":["キャンディで気持ちを伝えろって？キャンディって…食い物じゃないか！？"]},"keys":["Voice_whiteday_girgas_1_TouchReactionBad1","cv_whiteday_girgas_TouchReactionBad1"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/638/6380033@-7830232719628961900"],"enUS":[],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/638/6380033@517071123408635223"]},"audioName":"6380033"},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["有告白的含义…？哎呀，我和爱梅莉丝不是那种关系。"],"enUS":["A confession…? Nah, Ameris and I are just friends."],"jaJP":["告白の返事…？アメリスとオレはそういうのじゃないぞ"]},"keys":["Voice_whiteday_girgas_1_TouchReactionBad2","cv_whiteday_girgas_TouchReactionBad2"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/638/6380034@1465899270755887790"],"enUS":[],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/638/6380034@-7787713406514318157"]},"audioName":"6380034"},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["我有一封信…？该、该不会是爱梅莉丝又要送我奇怪的巧克力吧…？"],"enUS":["A letter…? C-Could Ameris have sent me some weird chocolates again…?"],"jaJP":["手紙…？ま、まさかあいつがまた変なチョコを…？"]},"keys":["Voice_whiteday_girgas_1_NoticeMail","cv_whiteday_girgas_NoticeMail"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/638/6380035@2475294637572880736"],"enUS":[],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/638/6380035@-488388379281626241"]},"audioName":"6380035"},{"type":"NoticeEvent","label":"活动提示","texts":{"zhCN":["你们人类可真会找乐子！加我一个怎么样？"],"enUS":["Humans sure love to play. Let me join!"],"jaJP":["本当、人間たちは遊ぶことが大好きだよな、オレも混ぜてくれよ！"]},"keys":["cv_whiteday_girgas_NoticeEvent"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/638/6380036@7006554799520451802"],"enUS":[],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/638/6380036@-7012239436659768993"]},"audioName":"6380036"},{"type":"SummonSpeech1","label":"召唤-台词1","texts":{"zhCN":["白色情人节？听起来好无聊…"],"enUS":["White Day? That looks boring…"],"jaJP":["ホワイトデー？なんか、つまらなさそうだけど…"]},"keys":["cv_whiteday_girgas_SummonSpeech1"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/638/6380094@-266372036584644978"],"enUS":[],"jaJP":[]},"audioName":"6380094"},{"type":"SummonSpeech2","label":"召唤-台词2","texts":{"zhCN":["不过甜食倒是不错，所以我也准备了一些糖果。"],"enUS":["But hey, I'm all for tasty treats, so I did bring some candy."],"jaJP":["うまいものはオレも好きだから、キャンディを1個だけ用意したぞ"]},"keys":["cv_whiteday_girgas_SummonSpeech2"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/638/6380095@1284423955420776483"],"en