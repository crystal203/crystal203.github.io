tars":5,"sprite":{"sheet":"items","name":"cwp_gourry"},"stats":[{"name":"每秒伤害","values":[771,847],"baseValues":[771.12,846.7200000000001],"grows":true},{"name":"光属性攻击","values":[294,323],"baseValues":[293.76,322.56000000000006],"grows":true},{"name":"暴击率","values":[5,5],"unit":"%"},{"name":"防御","values":[15,17],"baseValues":[15.096000000000002,16.576000000000004],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"击败敌人时，恢复生命","min":6.0,"max":15.0,"unit":"%"},{"name":"防御","min":10.0,"max":22.0,"unit":"%"},{"name":"武器技能恢复速度","min":5.0,"max":15.0,"unit":"%"}],"subOptions":[{"name":"技能伤害值","min":6.0,"max":18.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"高超剑术的伤害值提升25%。\n击败敌人时，按照生命值的10%，加成额外生命。"}],"skill":{"name":"会心一击","description":"使用光之剑在周围引发爆破伤害，并附带击倒效果。","levels":[1,5],"damage":[145.0,225.0],"cooldown":[9.0,8.0],"ailment":"击倒"}}],"number":1}],"profile":{"Age":null,"Height":[182],"Weight":null},"tribes":["人类"],"story":"高里·卡布列夫，击败魔兽沙那法的勇士的后裔，无人能敌的最强剑士。\n\n高里有着让人不禁回头一看的俊秀相貌，但与外表相比，他的智商略显逊色。如果一个内容难度稍高，他就会无法理解其含义，甚至连小孩子都了解的常识也不知道。但是关于莉娜的一切，高里倒是掌握得一清二楚。\n\n高里是一个大胃王，但他不喜欢彩椒，也讨厌咖啡等苦味食物。如果将彩椒切碎，并与其他食材混在一起，他也能用超人般的能力把它们挑出来。\n\n卡布列夫家族世代相传的光之剑——哥伦诺瓦，具有将意志转化为光之刃的能力。它已超越一般的神剑，既可以反弹魔法，也可以吸收魔法。不仅如此，光之剑甚至可以吸收龙破斩、重破斩等强大的魔法，所以莉娜·因巴斯一直对它虎视眈眈。目前，高里仍是这把剑的主人，并且仍在使用中。","storyKey":"profile_gourry_story","sources":{"hero":"heroes.json / OriginId=452","profile":"heroprofile.json / OriginId=452","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}