1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["换作是你，不会轻易放弃这个频道的，对吧。"],"enUS":[],"jaJP":[]},"keys":["Voice_bridge_messenger_myth_1_TouchReactionGood2","cv_bridge_messenger_myth_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["别扫兴了。"],"enUS":[],"jaJP":[]},"keys":["Voice_bridge_messenger_myth_1_TouchReactionBad1","cv_bridge_messenger_myth_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["请避免不必要的接触，存在干扰风险。"],"enUS":[],"jaJP":[]},"keys":["Voice_bridge_messenger_myth_1_TouchReactionBad2","cv_bridge_messenger_myth_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["通信状态良好。已确认收到新邮件。"],"enUS":[],"jaJP":[]},"keys":["Voice_bridge_messenger_myth_1_NoticeMail"]}]}]}
