升"},{"id":320012,"level":null,"name":"恶作剧"}]}],"illustrations":[{"name":"原版立绘","asset":{"key":"illust:illust_redhood","skin":null},"stage":null},{"name":"日服立绘","asset":{"key":"illust:illust_redhood_kong","skin":null},"stage":null},{"name":"晋升立绘","asset":{"key":"illust:illust_redhood_ascent","skin":null},"stage":10012}],"costumes":[{"id":10164,"code":"mechanic_redhood","name":"维修工埃尔韦拉","type":"时装","sprite":{"sheet":"characters","name":"mechanic_redhood"},"asset":{"key":"character:mechanic_redhood","skin":null}},{"id":10165,"code":"baker_redhood","name":"面包师埃尔韦拉","type":"时装","sprite":{"sheet":"characters","name":"baker_redhood"},"asset":{"key":"character:baker_redhood","skin":null}},{"id":10383,"code":"redhood_bath","name":"沐浴埃尔韦拉","type":"时装","sprite":{"sheet":"characters","name":"redhood_bath"},"asset":{"key":"character:redhood_bath","skin":null}}],"weapons":[{"code":"cwp_redhood","name":"捣蛋鬼","type":"步枪","variants":[{"id":9030234,"code":"cwp_redhood_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_redhood"},"stats":[{"name":"每秒伤害","values":[588,645],"baseValues":[587.8260000000001,645.4560000000001],"grows":true},{"name":"火属性攻击","values":[305,335],"baseValues":[305.439,335.384],"grows":true},{"name":"暴击率","values":[2,2],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"生命","min":6.0,"max":18.0,"unit":"%"},{"name":"武器技能恢复速度","min":6.0,"max":18.0,"unit":"%"},{"name":"技能伤害值","min":8.0,"max":20.0,"unit":"%"}],"subOptions":[{"name":"防御","min":5.0,"max":15.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"定制礼物","description":"发射最后一颗苹果炮弹时，造成双倍伤害的特殊炮弹。\n爆破后地面形成火焰地带，按照每秒伤害的125%造成额外远程伤害并持续2.5秒。"}],"skill":{"name":"牛顿苹果","description":"投掷3颗蹦蹦跳跳手榴弹对敌人造成远程范围伤害，并附带击飞效果。","levels":[2,5],"damage":[207.0,225.0],"cooldown":[9.5,9.5],"ailment":"击飞"}}],"number":1}],"profile":{"Age":[21],"Height":[158],"Weight":[47]},"tribes":["半精灵"],"story":"红斗篷埃尔韦拉，想成为黑帮团伙“水库蟒蛇”领导人的最年轻组员。\n\n埃尔韦拉的奶奶从堪称地狱的“狼腹”脱险后，变成战斗家并成立了“水库蟒蛇”。这个犯罪团伙主要以武器走私为生，不仅如此，只要能赚钱，他们无所不作。埃尔韦拉是一名任劳任怨的组员，也是备受瞩目的领导候选人。为了不得罪严厉可怕的奶奶并得到她的认可，埃尔韦拉认真狩猎怪物与悬赏犯人，尽心尽责完成组织下达的任务。身为组员，埃尔韦拉深知失败即意味着被组织除名，况且，被除名组员的下场谁都不得而知。因此，埃尔韦拉每次都会全力以赴迎战。\n\n如今，埃尔韦拉的篮子里装的不再是为身体抱恙的奶奶准备的食物，而是各种炸弹与枪支。如果不确定里面有什么，最好不要去掀开盖子。","storyKey":"profile_redhood_story","sources":{"hero":"heroes.json / OriginId=12","profile":"heroprofile.json / OriginId=12","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"redhood","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["别站在我身后。"],"enUS":["Another win for the Hood!"],"jaJP":["アタイの後ろに立つなよ"]},"keys":["cv_redhood_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["好吧！来呀！"],"enUS":["The Big Red won!"],"jaJP":["オッケー！かかってきやがれっ！"]},"keys":["cv_redhood_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["呃，奶奶…"],"enUS":["Grandma…"],"jaJP":["お祖母様…"]},"keys":["cv_redhood_Die"]},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["是我的！"],"enUS":["In the basket!"],"jaJP":["いっただきぃ！"]},"keys":["cv_redhood_GetExp"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["我的目标是成为第一！"],"enUS":["I will reach the top!"],"jaJP":["アタイはこのままトップを取るっ！"]},"keys":["cv_redhood_LevelUp"]},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["我只相信两样东西，一把巨型枪，还有一把更大的巨型枪。"],"enUS":["I believe in two things. A big gun and a bigger gun."],"jaJP":["アタイが信じてるのはふたつだけ…大きな銃と、もっと大きな銃だ"]},"keys":["cv_redhood_EquipWeapon"]},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["哼…我对这些不感兴趣。"],"enUS":["Ugh, this is stupid."],"jaJP":["ふ、ふん！ こんなの興味ないし？"]},"keys":["cv_redhood_EquipCostume"]},{"type":"Evolve","label":"进化","texts":{"zhCN":["这只是一小步，我会变得更强！"],"enUS":["This is merely a stepping stone. I will rise higher!"],"jaJP":["コイツを踏み台にして、アタイはもっと上に行く！"]},"keys":["cv_redhood_Evolve"]},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["哈！"],"enUS":["Haap!"],"jaJP":["はっ！"]},"keys":["cv_redhood_Attack1"]},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["唉！"],"enUS":["Yaap!"],"jaJP":["えいっ！"]},"keys":["cv_redhood_Attack2"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["死吧！"],"enUS":["Die!"],"jaJP":["死ねえ！"]},"keys":["cv_redhood_Attack3"]},{"type":"Skill1","label":"技能1","texts":{"zhCN":["通通下地狱吧！"],"enUS":["Fire!"],"jaJP":["全弾発射！"]},"keys":["cv_redhood_Skill1"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["向我的小伙伴们打招呼！"],"enUS":["Say hello to my little friend!"],"jaJP":["アタイのカワイコちゃんに挨拶しな！"]},"keys":["cv_redhood_Skill2"]},{"type":"Damaged1","label":"受到攻击1","texts":{"zhCN":["呃！"],"enUS":["Ah!"],"jaJP":["くっ！"]},"keys":["cv_redhood_Damaged1"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["呜哇！"],"enUS":["Urgh!"],"jaJP":["くはっ！"]},"keys":["cv_redhood_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["切，你太懦弱了…"],"enUS":["Ugh. You're so naive…"],"jaJP":["ちっ、これだから弱っちいヤツは…"]},"keys":["cv_redhood_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["真正的强者，会用尽一切办法活到最后。"],"enUS":["The strong will do whatever it can do to survive."],"jaJP":["本当に強いのは、漆黒の意志で生きていくヤツだ"]},"keys":["cv_redhood_PlayerChooseDark"]},{"type":"WeakEnemyBattleStart","label":"与弱小敌人战斗","texts":{"zhCN":["你觉得我很可笑吗？不要小瞧我！"],"enUS":["Are you looking down on me? Huh?"],"jaJP":["アタイを舐めてんの！？"]},"keys":["cv_redhood_WeakEnemyBattleStart"]},{"type":"NormalEnemyBattleStart","label":"与普通敌人战斗","texts":{"zhCN":["就当作是消遣吧。"],"enUS":["This'll be fun."],"jaJP":["ま、暇つぶしに丁度いいか"]},"keys":["cv_redhood_NormalEnemyBattleStart"]},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["想来点刺激的？好呀！"],"enUS":["You wanna play rough? OK!"],"jaJP":["アタイと遊びたいの？オッケー！"]},"keys":["cv_redhood_StrongEnemyBattleStart"]},{"type":"BossBattleStart","label":"与首领战斗","texts":{"zhCN":["想击败我？把所有人都叫过来吧！"],"enUS":["You'll need a freaking army if you wanna take me!"],"jaJP":["アタイを倒したきゃ、軍隊でも連れてきな！"]},"keys":["cv_redhood_BossBattleStart"]},{"type":"JoinParty","label":"首次加入队伍","texts":{"zhCN":["我说的都是真话，说谎时也是真话…"],"enUS":["I always tell the truth. Even when I lie."],"jaJP":["アタイは真実しか言わない、嘘をつくときにもな"]},"keys":["cv_redhood_JoinParty"]},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["开火！"],"enUS":["Fire!"],"jaJP":["ファイヤー！"]},"keys":["cv_redhood_CoopAttack"]},{"type":"CoopHeal","label":"战斗-请求治疗","texts":{"zhCN":["辅助！"],"enUS":["Healer!"],"jaJP":["ヒーラー！"]},"keys":["cv_redhood_CoopHeal"]},{"type":"CoopRun","label":"战斗-注意","texts":{"zhCN":["拜拜！再见！"],"enUS":["Bye bye-!"],"jaJP":["じゃーな！"]},"keys":["cv_redhood_CoopRun"]},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["这是我们的世界！"],"enUS":["The world is ours!"],"jaJP":["世界はアタイたちのもんだ！"]},"keys":["cv_redhood_CoopWin"]},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["是谁主导胜利的？！是我！我要相信谁？！我自己！"],"enUS":["Who brought this victory? Me! Who am I to trust? Me!"],"jaJP":["誰のおかげで勝てた？これから誰を信じるべき？アタイだろ！"]},"keys":["cv_redhood_CoopMVP"]},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["和坏蛋打个招呼！"],"enUS":["Say hello to the bad guy."],"jaJP":["さあ、悪党の登場だ"]},"keys":["cv_redhood_CoopHi"]},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["别磨蹭！"],"enUS":["Hurry up!"],"jaJP":["もたもたすんなよ！"]},"keys":["cv_redhood_CoopHurryUp"]},{"type":"CoopBelieve","label":"战斗-信任","texts":{"zhCN":["你担心的也太多了，这样下去会抑郁的。"],"enUS":["You worry too much, it's bad for your heart."],"jaJP":["てめぇは心配性だな、心臓によくねえぞ？"]},"keys":["cv_redhood_CoopBelieve"]},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["什么呀？"],"enUS":["What?"],"jaJP":["なんだ？"]},"keys":["Voice_redhood_1_TouchReactionGood1","cv_redhood_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["快说。"],"enUS":["Yes. And?"],"jaJP":["言ってみろ"]},"keys":["Voice_redhood_1_TouchReactionGood2","cv_redhood_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["哈？"],"enUS":["Look. I bite."],"jaJP":["ああん…？"]},"keys":["Voice_redhood_1_TouchReactionBad1","cv_redhood_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["你好烦。"],"enUS":["You are so annoying."],"jaJP":["うぜぇよ"]},"keys":["Voice_redhood_1_TouchReactionBad2","cv_redhood_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["有新邮件，快点打开。"],"enUS":["You have mail. Hurry and check it."],"jaJP":["メールが来てる、さっさと見とけ"]},"keys":["Voice_redhood_1_NoticeMail","cv_redhood_NoticeMail"]},{"type":"NoticeEvent","label":"活动提示","texts":{"zhCN":["活动…第一，目标是第一！"],"enUS":["Event, huh? We'll shoot for the top!"],"jaJP":["イベント… トップだ、トップを狙うんだ！"]},"keys":["cv_redhood_NoticeEvent"]}]}]}
