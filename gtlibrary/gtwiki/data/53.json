53","profile":"heroprofile.json / OriginId=53","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"china_hero_girl","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["哼，这点小事，轻轻松松！"],"enUS":["Good. That was so easy!"],"jaJP":["よーし、楽勝、楽勝！"]},"keys":["cv_china_hero_girl_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["嗯哼，应该没让师傅失望吧？"],"enUS":["That didn't go as you expected, did it?"],"jaJP":["皆の期待に答えられたかな？"]},"keys":["cv_china_hero_girl_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["呃…修炼…不够…"],"enUS":["I'll need to… Train more…"],"jaJP":["修行不足…だね…"]},"keys":["cv_china_hero_girl_Die"]},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["…再来一碗！"],"enUS":["More, more please!"],"jaJP":["…もう一杯！"]},"keys":["cv_china_hero_girl_GetExp"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["又进一步！"],"enUS":["I made another step forward!"],"jaJP":["また一歩、前に進んだ！"]},"keys":["cv_china_hero_girl_LevelUp"]},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["喔，这是给我的吗？还是你最好！"],"enUS":["You're giving this to me? You're the best!"],"jaJP":["これを私に？やっぱり師弟は良い子だね！"]},"keys":["cv_china_hero_girl_EquipWeapon"]},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["唉，父亲生前也常常送来这些衣服…"],"enUS":["My father used to buy me nice clothes, too…"],"jaJP":["お父様も生前、よくこういう服を持ってきてくださったな…"]},"keys":["cv_china_hero_girl_EquipCostume"]},{"type":"Evolve","label":"进化","texts":{"zhCN":["这就是仙山拳真正的威力…？！"],"enUS":["Is this the true power of Shen Mountain Fist…?!"],"jaJP":["これが…仙山拳の真の力なの！？"]},"keys":["cv_china_hero_girl_Evolve"]},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["特啊！"],"enUS":["Taat!"],"jaJP":["たあっ！"]},"keys":["cv_china_hero_girl_Attack1"]},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["喝啊！"],"enUS":["Hup!"],"jaJP":["ふっ！"]},"keys":["cv_chi