unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"冰霜碎片","description":"每秒发射自动攻击敌人的制导魔弹，按照每秒伤害的30%造成远程伤害。"}],"skill":{"name":"暴风雪","description":"引起巨大寒冰风暴，对敌人造成远程伤害并附带重伤效果。","levels":[4,7],"damage":[210.0,255.0],"cooldown":[11.4,10.5],"ailment":"重伤"}}],"number":1}],"profile":{"Age":[22],"Height":[158],"Weight":[46]},"tribes":["因纽特人"],"story":"可可，来自裂痕山脉雪山的因纽特族少女。\n\n可可继承了被诅咒的冰雪魔女血脉，能施展冰冻魔法。在发现自己体内潜在的魔女威力显现时，就会变得情绪激动，魔女血脉也会失控后，可可选择了远离人群独自生活，从此与默默无闻陪伴左右的雪橇犬相依为命。\n\n虽然外表沉着冰冷，但可可原有的正义感和对村民的热爱未曾减少过。传闻，雨天在海边漫步能让可可心平气和，因为相比冰冻的河水，她更喜欢澎湃不息的大海。\n","storyKey":"profile_innuit_story","sources":{"hero":"heroes.json / OriginId=37","profile":"heroprofile.json / OriginId=37","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"]},"voiceLines":[{"id":"innuit","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["好，下一个？"],"enUS":["Well, who's next?"],"jaJP":["さ、次は誰？"]},"keys":["cv_innuit_NormalBattleWin"]},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["我还不至于这么弱。"],"enUS":["You'll never break me."],"jaJP":["これぐらいで倒れるほど、私、弱くないから"]},"keys":["cv_innuit_BossBattleWin"]},{"type":"Die","label":"阵亡","texts":{"zhCN":["不能…就这么结束…"],"enUS":["It can't end… Like this…"],"jaJP":["ここで… 終わるわけには…"]},"keys":["cv_innuit_Die"]},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["感受到了力量…"],"enUS":["I feel power…"],"jaJP":["力を感じるわ…"]},"keys":["cv_innuit_GetExp"]},{"type":"LevelUp","label":"升级","texts":{"zhCN":["我现在更了解自己的力量了。"],"enUS":["I think I better understand my power now."],"jaJP":["自分の力のこと、少しわかった気がする…"]},"keys":["cv_innuit_LevelUp"]},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["拿来没用的东西…但还是谢谢你。"],"enUS":["Well, this wasn't necessary… But thanks."],"jaJP":["そんなモノ持ってこられても… でもありがと"]},"keys":["cv_innuit_EquipWeapon"]},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["这…这衣服？我要穿上吗？"],"enUS":["You… You want me to wear this?"],"jaJP":["こ、こんなのを私に着せたいなんて…！"]},"keys":["cv_innuit_EquipCostume"]},{"type":"Evolve","label":"进化","texts":{"zhCN":["我会证明给大家看，魔女的力量也可以守护一切。"],"enUS":["Even a cursed power can protect people. I'll show you."],"jaJP":["魔女の力でもみんなを守れるってことを、見せてあげるわ！"]},"keys":["cv_innuit_Evolve"]},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["哈啊！"],"enUS":["Haah!"],"jaJP":["はっ！"]},"keys":["cv_innuit_Attack1"]},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["喝！"],"enUS":["Hiyaa!"],"jaJP":["ていっ！"]},"keys":["cv_innuit_Attack2"]},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["让开！"],"enUS":["Be gone!"],"jaJP":["どいて"]},"keys":["cv_innuit_Attack3"]},{"type":"Skill1","label":"技能1","texts":{"zhCN":["气温降低吧。"],"enUS":["Even colder!"],"jaJP":["もっと冷たく！"]},"keys":["cv_innuit_Skill1"]},{"type":"Skill2","label":"技能2","texts":{"zhCN":["全部冰冻！"],"enUS":["Freeze!"],"jaJP":["みんな、凍ってしまえ！"]},"keys":["cv_innuit_Skill2"]},{"type":"Damaged1","label":"受到攻击1","texts":{"zhCN":["呃…！"],"enUS":["Ugh!"],"jaJP":["くっ…！"]},"keys":["cv_innuit_Damaged1"]},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["这些小事…"],"enUS":["I'm okay…"],"jaJP":["これぐらい…"]},"keys":["cv_innuit_Damaged2"]},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["这是那个人的选择。"],"enUS":["He would've chosen this."],"jaJP":["あいつなら、同じ選択をした筈…"]},"keys":["cv_innuit_PlayerChooseBright"]},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["这是魔女的选择。"],"enUS":["This… is a witch's way."],"jaJP":["こんなの、魔女のやり方よ…"]},"keys":["cv_innuit_PlayerChooseDark"]},{"type":"WeakEnemyBattleStart","label":"与弱小敌人战斗","texts":{"zhCN":["不值得和他们动手。"],"enUS":["It's not worth fighting them."],"jaJP":["相手する価値もないわ"]},"keys":["cv_innuit_WeakEnemyBattleStart"]},{"type":"NormalEnemyBattleStart","label":"与普通敌人战斗","texts":{"zhCN":["可以做做准备运动了。"],"enUS":["I could warm up a li