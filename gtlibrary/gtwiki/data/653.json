:6,"sprite":{"sheet":"items","name":"cwp_adelanoble_myth"},"stats":[{"name":"每秒伤害","values":[892,979],"baseValues":[891.601992,979.0139520000001],"grows":true},{"name":"水属性攻击","values":[350,384],"baseValues":[349.64784,383.92704000000003],"grows":true},{"name":"暴击率","values":[2,2],"unit":"%"},{"name":"防御","values":[10,11],"baseValues":[9.792,10.752],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"防御","min":8.0,"max":22.0,"unit":"%"},{"name":"生命","min":8.0,"max":22.0,"unit":"%"},{"name":"武器技能恢复速度","min":4.0,"max":10.0,"unit":"%"}],"subOptions":[{"name":"技能伤害值","min":5.0,"max":15.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"防御","min":15.0,"max":15.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"挑衅的持续时间增加2秒，领域范围扩大25%。\n嘲讽敌人时，恢复自身生命6%。\n使用跃空击时，防御力提升25%，持续4秒。\n挑衅领域结束时，按照每秒伤害的50%对敌人造成额外近程伤害。"}],"skill":{"name":"跃空击","description":"跳起攻击敌人，造成近程伤害并附带击飞效果。","levels":[1,5],"damage":[260.0,260.0],"cooldown":[9.1,7.5],"ailment":"击飞"}}],"number":1}],"profile":{"Age":[12],"Height":[146],"Weight":[37]},"tribes":["人类"],"story":"黛西是统治阿德拉要塞的男爵，也是一位拥有怪力的少女。\n\n她的家族世代传承着封印在胸针中的特殊力量。继承家族力量的人不仅能获得超越人类想象的怪力，还要肩负起守护阿德拉的使命。由于每代只有一人能继承家族力量，以前为了成为继承人，甚至会互相争斗，可见继承这份力量的确是一件值得自豪的事情。黛西是独生女，被确定为下一任继承人后，与前辈们不同，她对继承力量充满了恐惧。\n\n在侵略者入侵阿德拉的那天，黛西的父亲当时正担任男爵，他拼尽全力守护了城市。黛西将父亲视为英雄，认为他是世界上最强的人，无论与谁战斗都不会输。但与此同时，这样的父亲也成了她难以逾越的高山。与男爵家族的其他人不同，黛西格外胆小，在剑术课上也总是垫底，她感觉自己不可能像父亲那样，面对这种压力，她开始日渐消沉。从那以后，原本开朗的黛西逐渐失去自信，变得十分在意他人的目光，性格也愈发小心谨慎。\n\n父母察觉到了她的心情，不断鼓励她，说她已经非常强大，但黛西却认为，这只是父母在安慰自己。然而，父母的确是因为看到她不是那种会轻易伤害他人的孩子，才相信她适合成为继承人。他们觉得，女儿是因为不想伤害其他朋友，而甘愿在剑术课上垫底，这种心性足以证明她具备守护城市和王国的资格。当然，黛西后来才知道父母的这种想法。\n\n在继承男爵爵位后，黛西遇到了意想不到的难题，那就是堆积得比她的个头还高的文件。她本就不喜欢学习，再加上年纪尚小，对她来说，那些写满晦涩词语的文件简直比怪兽还要可怕。她曾多次反抗，吵着说如果让她做这种事情，她就要退还爵位。但很显然，她这耍小孩子脾气的请求没能如愿。不过，十分同情黛西遭遇的王女，特意派安娜给她做专门辅导。正因如此有传闻说，男爵家的宅邸里每天都传来哭哭啼啼的声音。","storyKey":"profile_adela_noble_story","sources":{"hero":"heroes.json / OriginId=653","profile":"heroprofile.json / OriginId=653","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"adela_noble","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["我只是轻轻挥了一下…就这么结束了？"],"enUS":["I only gave it a light swing… Is it over already?"],"jaJP":["ちょっと武器を振り回してたら…勝てちゃった"]},"keys":["cv_adela_noble_NormalBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/653/6530001@8644384504711601386"],"enUS":["cdn/Android/ondemand/voices_en/653/6530001"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/653/6530001@4240003300459819563"]},"audioName":"6530001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["我应该没有给家族声誉抹黑吧？"],"enUS":["This should be enough to uphold my family's honor, right?"],"jaJP":["一族の名誉は、守れたかな？"]},"keys":["cv_adela_noble_BossBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/653/6530002@-4348302689051110105"],"enUS":["cdn/Android/ondemand/voices_en/653/6530002"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/653/6530002@-5275767356895479415"]},"audioName":"6530002"},{"type":"Die","label":"阵亡","texts":{"zhCN":["最终…我也…"],"enUS":["In the end… I. too…."],"jaJP":["やっぱり、私…"]},"keys":["cv_adela_noble_Die"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/653/6530003@-8181799245613705675"],"enUS":["cdn/Android/ondemand/voices_en/653/6530003"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/653/6530003@4100883051250930620"]},"audioName":"6530003"},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["我太喜欢了～就不能多给一些吗？"],"enUS":["I love these kinds of things! Can I have more?"],"jaJP":["こういうの大好き…もっと、欲しいかも"]},"key