dolph_druid_queen","skin":null}}],"weapons":[{"code":"cwp_rudolph","name":"终结者","type":"步枪","variants":[{"id":9030364,"code":"cwp_rudolph_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_rudolph"},"stats":[{"name":"每秒伤害","values":[594,653],"baseValues":[594.4050000000001,652.6800000000001],"grows":true},{"name":"土属性攻击","values":[283,311],"baseValues":[283.05,310.8],"grows":true},{"name":"暴击率","values":[5,5],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"生命","min":6.0,"max":18.0,"unit":"%"},{"name":"防御","min":8.0,"max":20.0,"unit":"%"},{"name":"技能伤害值","min":5.0,"max":16.0,"unit":"%"}],"subOptions":[{"name":"开始战斗时，加成额外生命","min":2.0,"max":5.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"抵近射击命中3格以内目标敌人时，按照每秒伤害的10%造成额外伤害。"}],"skill":{"name":"雪橇火力支援","description":"请求火力支援，对目标敌人造成范围伤害，并附带击倒效果。","levels":[1,5],"damage":[165.0,245.0],"cooldown":[10.0,9.0],"ailment":"击倒"}}],"number":1},{"code":"cwp_rudolph2","name":"梦魇","type":"双手剑","variants":[{"id":9020484,"code":"cwp_rudolph2_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_rudolph2"},"stats":[{"name":"每秒伤害","values":[705,774],"baseValues":[705.024,774.1440000000001],"grows":true},{"name":"土属性攻击","values":[261,287],"baseValues":[261.12,286.72],"grows":true},{"name":"暴击率","values":[8,8],"unit":"%"},{"name":"防御","values":[10,11],"baseValues":[9.792,10.752],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"防御","min":7.0,"max":20.0,"unit":"%"},{"name":"武器技能恢复速度","min":7.0,"max":16.0,"unit":"%"},{"name":"击败敌人时，攻击提升（10秒）","min":3.0,"max":10.0,"unit":"%"}],"subOptions":[{"name":"技能伤害值","min":10.0,"max":24.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"佩戴武器时，英雄的职业技能随着武器而变。\n- 暴击率调整为[c][F8E8CB]2倍[-][/c]，暴击伤害倍数减少[c][F8E8CB]-20%[-][/c]；\n- 普通攻击切换为[c][F8E8CB]鹿人打击术[-][/c]；\n- 连锁技能切换为[c][F8E8CB]终极战士[-][/c]；\n- 特殊能力切换为[c][F8E8CB]锋利犄角[-][/c]。"}],"skill":{"name":"圣诞快递","description":"驾驶雪橇突进，对敌人造成近程伤害并附带重伤效果。","levels":[1,5],"damage":[150.0,270.0],"cooldown":[8.5,7.9],"ailment":"重伤"}}],"number":2}],"profile":{"Age":null,"Height":[178],"Weight":[61]},"tribes":["鹿人"],"story":"鲁，圣诞老人小帮手，每逢圣诞节协助圣诞老人将礼物送到世界各地。\n \n鲁是从古至今存在于世的鹿人族成员。小时候，鲁的族人惨遭偷猎者屠杀，只剩下鲁一个人。野外生存能力和良好的身体素质是鲁与生俱来的本领，而长辈们赐予的名字似乎有被封印的特殊力量。平时隐姓埋名，告知对方的都是别名，只有圣诞老人才知道她的真名。\n \n鲁待人冷漠，总是对世间万物冷嘲热讽，处事非常冷静。然而，在帮助圣诞老人解决问题或执行任务时，却像变了一个人似的，性格非常火爆，工作充满激情。但正因为如此，她也会经常“丢了西瓜捡了芝麻”。鲁擅长使用炸药和巨型枪支，凭借操纵的“天赋”，驾驶卡车、飞机等大型交通工具也是得心应手。因为雪橇不能遮风挡雨，所以怕冷的圣诞老人痛下决心买了一架专机用于运输礼物。某日，圣诞老人看到鲁正游刃有余地开着专机，吓得跳了起来。圣诞老人问鲁“什么时候拿到了飞行执照？”，鲁却说：“今天第一次开飞机…”。从此之后，这件事就被大家津津乐道。不过，气急败坏的圣诞老人对着鲁的后背用力打了一巴掌，第二天，她就考取了忒提斯飞行员特级执照。\n \n小时候，鲁是一个身体虚弱的爱哭宝宝。只要受冻，她的鼻子就会变得红红的。邻居家的小孩看到这个样子就会嘲笑她，小小鲁听到后便会哇哇大哭。这时，只要见到甜甜的糖果，马上就会停止哭泣开始微笑。即便长大后遇见圣诞老人，并与其签订“真名契约”以表忠心，她也没改掉爱吃甜食的习惯。","storyKey":"profile_rudolph_story","sources":{"hero":"heroes.json / OriginId=371","profile":"heroprofile.json / OriginId=371","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"rudolph","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["啧，一拳足以解决。"],"enUS":["A piece of cake."],"jaJP":["これで終わり"]},"keys":["cv_rudolph_NormalBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/371/3710001@-2227688638896661431"],"enUS":["cdn/Android/ondeman