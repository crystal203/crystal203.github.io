ngrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"水枪命中目标时，移动速度提升20%并持续3秒。\n最后被水枪击中的敌人，将成为水火箭的优先攻击目标；水火箭命中目标时，按照每秒伤害的60%，造成额外伤害。"}],"skill":{"name":"水炸弹音乐节","description":"设置发射台并弹射水气球，对周围敌人造成伤害，并附带击飞效果。","levels":[1,5],"damage":[145.0,225.0],"cooldown":[8.0,6.0],"ailment":"击飞"}},{"id":9030435,"code":"cwp_summerandroid_myth","label":"开花","stars":6,"sprite":{"sheet":"items","name":"cwp_summerandroid_myth"},"stats":[{"name":"每秒伤害","values":[744,816],"baseValues":[743.5717380000002,816.4709280000002],"grows":true},{"name":"水属性攻击","values":[142,156],"baseValues":[141.63271200000003,155.51827200000002],"grows":true},{"name":"暴击率","values":[5,5],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"技能伤害值","min":8.0,"max":22.0,"unit":"%"},{"name":"生命","min":8.0,"max":20.0,"unit":"%"},{"name":"武器技能恢复速度","min":6.0,"max":18.0,"unit":"%"}],"subOptions":[{"name":"防御","min":6.0,"max":18.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"水枪命中目标时，移动速度提升20%并持续3秒。\n最后被水枪击中的敌人，将成为水火箭的优先攻击目标；水火箭命中目标时，按照每秒伤害的60%，造成额外伤害。"}],"skill":{"name":"水炸弹音乐节","description":"设置发射台并弹射水气球，对周围敌人造成伤害，并附带击飞效果。","levels":[1,5],"damage":[145.0,225.0],"cooldown":[8.0,6.0],"ailment":"击飞"}}],"number":1}],"profile":{"Age":[1],"Height":[145],"Weight":[50]},"tribes":["机器人"],"story":"新型机器人AA72，与现有MK系列不同，该系列是用于消遣、游戏的娱乐型机器人(Amusement Android，简称AA)。\n\n研发时间较早的机器人都有相同的特点——习性懒惰，讨厌工作。为了改善这一缺点，新型机器人AA系列按照“为顾客带来快乐和喜悦”这一目的进行制造，并且配备了盛夏假日的烟花秀的功能。这个系列的机器人在使用特殊功能和执行各自任务时，会感到非常满足，充满了成就感。\n\n直到夏天来临，AA72仍然没有接到任何命令，这让她非常低落，甚至一度失去了生活的热情。其实AA72是暑假专属机器人，还没有到度假旺季，没有任务也是理所当然的事情。因为出厂前没有人和AA72进行工作交接，所以AA72误以为是自己没有用，主人才没有下达指令的。有一天，情绪低落的AA72决定自我报废，她慢慢朝着浮游城外海滩的垃圾桶走去。在那里，她遇到了救生员柚子。与柚子同行时，AA72解开了之前的误会，并开始正确看待自己的价值。这段经历不仅给AA72留下了美好的回忆，还让她拥有了新的名字——斯黛拉。AA72非常喜欢新名字，自那以后，每次自我介绍时她都不忘加上“斯黛拉”这个自订名称。\n\n不过AA72心里好像还有阴影，她总担心自己哪一天会报废，没有命令就会变得忐忑不安。每当遇到这种情况，AA72便会更加接近顾客，积极宣传自己的功能并要求对方使用她。其他机器人不仅无法理解AA72，而且很羡慕她一年只需要放一次烟花就能休息，特别是忙于战斗的MK.99。最近MK.99尝试将自己的涂色改成AA.99，但最终被人揭发了。\n\n为了证明自己的存在很有必要，AA72总是到处找事情做。她的主要任务是帮助柚子守护海滩，或者替罗兰茵跑腿。除此以外，只要是对他人有帮助的事情，尽管对方提出的要求很过分，她也会马上答应。有一次，AA72接受了索菲和玛丽安的请求，要成为她们的实验材料。幸好有浮游城居民及时的举报，再加上罗兰茵的密切监视，才阻止了实验的发生。经历一系列事件之后，疲惫的罗兰茵不想再为琐事操心，她认为MK系列更好，宣布了AA系列即将停产。","storyKey":"profile_summer_android_story","sources":{"hero":"heroes.json / OriginId=470","profile":"heroprofile.json / OriginId=470","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"summer_android","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["任务完成！主人，请迅速下达下一个指令…！"],"enUS":["Mission complete! Your next orders, quickly…!"],"jaJP":["ミッションコンプリート！マスター、早く次のご命令を…！"]},"keys":["cv_summer_android_NormalBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/470/4700001@1150644510187974162"],"enUS":["cdn/Android/ondemand/voices_en/470/4700001"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/470/4700001@-8809363619973908419"]},"audioName":"4700001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["哼，AA72也能轻松打败强敌。"],"enUS":["Hmpf, even powerful enemies like that are no match for AA72."],"jaJP":["えっへん、AA72はこんな強敵にも楽勝なのです！"]},"keys":["cv_summer_android_BossBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/470/4700002@-6066168956535070402"],"enUS":["cdn/Android/ondemand/voices_en/470/4700002"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/470/4700002@1284282280677831481"]},"audioName":"4700002"},{"type":"Die","label":"阵亡","texts":{"zhCN":["我不想死…罗兰茵…"],"enUS":["I don’t wanna go… ma’am, please… Ms.Loraine…"],"jaJP":["ロレインさん…ステラ、まだ死にたくない…です"]},"keys":["cv_summer_android_Die"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/470/4700003@-6235425887108017634"],"enUS":["cdn/Android/ondemand/voices_en/470/4700003"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/470/4700003@-3446446119744440111"]},"audioName":"4700003"},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["哔哔，检测到好能源，可以多来一点。"],"enUS":["Be-Beep. A great energy source. Requesting more."],"jaJP":["ぴぴぴっ！良いエネルギー源です、おかわりを希望したいです"]},"keys":["cv_summer_android_GetExp"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/470/4700004@9090390630448876388"],"enUS":["cdn/Android/ondemand/voices_en/470/4700004"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/470/4700004@-2844584578408140185"]},"audioName":"4700004"},{"type":"LevelUp","label":"升级","texts":{"zhCN":["我为什么…没有长高…"],"enUS":["How come… I didn’t get taller…"],"jaJP":["いつか、おっきくなれるかな…"]},"keys":["cv_summer_android_LevelUp"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/470/4700005@-1663300406082565016"],"enUS":["cdn/Android/ondemand/voices_en/470/4700005"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/470/4700005@391110275317403563"]},"audioName":"4700005"},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["我想给它取个好听的名字。"],"enUS":["I'd like to give it a pretty name too."],"jaJP":["この子、気に入ったのです、名前をつけてあげたいです"]},"keys":["cv_summer_android_EquipWeapon"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/470/4700006@1410718478224591558"],"enUS":["cdn/Android/ondemand/voices_en/470/4700006"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/470/4700006@3437789794930161062"]},"audioName":"4700006"},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["这就是主人的品味吗…？呃，还好啦。"],"enUS":["Master, is this what you like…? It’s not an issue."],"jaJP":["これ、マスターのご趣味ですか？いえ…別にいいですが…"]},"keys":["cv_summer_android_EquipCostume"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/470/4700007@-4589037046202732084"],"enUS":["cdn/Android/ondemand/voices_en/470/4700007"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/470/4700007@-3278768865794818060"]},"audioName":"4700007"},{"type":"Evolve","label":"进化","texts":{"zhCN":["AA72，升级为…更好的机器人。"],"enUS":["AA72… upgraded into a slightly better android."],"jaJP":["AA72、さらに…高性能なアンドロイドにアップグレードしたのです！！"]},"keys":["cv_summer_android_Evolve"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/470/4700008@1732041698260952425"],"enUS":["cdn/Android/ondemand/voices_en/470/4700008"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/470/4700008@-1480293075423780744"]},"audioName":"4700008"},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["目标锁定！"],"enUS":["Target locked on."],"jaJP":["ターゲット、ロックオンです"]},"keys":["cv_summer_android_Attack1"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/470/4700009@2745998280272446331"],"enUS":["cdn/Android/ondemand/voices_en/470/4700009"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/470/4700009@-2265125713501745830"]},"audioName":"4700009"},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["噗咻！噗咻！"],"enUS":["Pshew! Pshew!"],"jaJP":["ぷしゅぷしゅっ"]},"keys":["cv_summer_android_Attack2"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/470/4700010@5410928000238549253"],"enUS":["cdn/Android/ondemand/voices_en/470/4700010"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/470/4700010@-2331927856289311726"]},"audioName":"4700010"},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["噗↓通↑"],"enUS":["Sp-lash"],"jaJP":["ばっしゃーん"]},"keys":["cv_summer_android_Attack3"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/470/4700011@7462872611161241663"],"enUS":["cdn/Android/ondemand/voices_en/470/4700011"],"jaJP":["offline/Ass