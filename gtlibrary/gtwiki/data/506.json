,"jaJP":["ちょっとヘビーな相手かもしれねえが、やるだけやるぜ！"]},"keys":["cv_popp_StrongEnemyBattleStart"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060020"]},"audioName":"5060020"},{"type":"BossBattleStart","label":"与首领战斗","texts":{"zhCN":["你的对手是我！大块头！"],"enUS":["You're up against me! You colossus!"],"jaJP":["てめえの相手はこのおれだ、デカブツ！"]},"keys":["cv_popp_BossBattleStart"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060021"]},"audioName":"5060021"},{"type":"JoinParty","label":"首次加入队伍","texts":{"zhCN":["如果要叫的话，你就称呼我为大魔道士吧！"],"enUS":["If you're going to call me anything, call me the Grand Sorcerer!"],"jaJP":["おれは、ポップ、おれを呼ぶなら賢者じゃなくて、大魔道士とでも呼んでくれっ！！！"]},"keys":["cv_popp_JoinParty"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060022"]},"audioName":"5060022"},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["趁现在！使出全力的一击！"],"enUS":["Now! Get em right in the stomach!"],"jaJP":["今だ！一発ぶちかましてくれ！"]},"keys":["cv_popp_CoopAttack"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060023"]},"audioName":"5060023"},{"type":"CoopHeal","label":"战斗-请求治疗","texts":{"zhCN":["这里也有伤员呢！"],"enUS":["I'm wounded over here!"],"jaJP":["こっちだってケガ人なんだぞ、なんとかしろい！"]},"keys":["cv_popp_CoopHeal"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060024"]},"audioName":"5060024"},{"type":"CoopRun","label":"战斗-注意","texts":{"zhCN":["快趁机逃走吧！"],"enUS":["Try to find a way to get out of there!"],"jaJP":["うまく逃げろよ！"]},"keys":["cv_popp_CoopRun"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060025"]},"audioName":"5060025"},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["赢了！我们赢了！"],"enUS":["We won! We're the winners!"],"jaJP":["勝った！おれたちが勝ったぜ！"]},"keys":["cv_popp_CoopWin"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060026"]},"audioName":"5060026"},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["经过努力，被人们感谢好像也不赖。"],"enUS":["It feels pretty 