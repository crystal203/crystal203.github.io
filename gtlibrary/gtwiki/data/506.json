/ondemand/voices_ja/506/5060032"]},"audioName":"5060032"},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["嘿，你认真点！"],"enUS":["Hey, step up your game!"],"jaJP":["おっ、おい！！よ、よしてくれよっ！！！"]},"keys":["Voice_popp_1_TouchReactionBad1","cv_popp_TouchReactionBad1"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060033"]},"audioName":"5060033"},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["难道我…没有资格自称是阿邦的弟子…"],"enUS":["Am I not qualified to call myself a disciple of Avan…"],"jaJP":["もしかたら、おれには…アバンの使徒を名乗る資格がないんじゃ…"]},"keys":["Voice_popp_1_TouchReactionBad2","cv_popp_TouchReactionBad2"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060034"]},"audioName":"5060034"},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["我有一封信？会是老师寄来的吗？"],"enUS":["A letter? Is it from Master?"],"jaJP":["手紙だって？まさか、し、師匠からじゃないよな？"]},"keys":["Voice_popp_1_NoticeMail","cv_popp_NoticeMail"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060035"]},"audioName":"5060035"},{"type":"NoticeEvent","label":"活动提示","texts":{"zhCN":["庆典？会有很多可爱女生参加吗？嘿嘿嘿…"],"enUS":["An event? Will cute girls be there? Heheh…"],"jaJP":["祭りってのは、着飾った可愛い子ちゃんがいっぱいいるってのはお約束だよな、うへへ…"]},"keys":["cv_popp_NoticeEvent"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060036"]},"audioName":"5060036"},{"type":"SummonSpeech1","label":"召唤-台词1","texts":{"zhCN":["我们终于见面了，我一直在等你。"],"enUS":["Finally we meet. I waited for you."],"jaJP":["やっと会えたな、待ってたんだぜ"]},"keys":["cv_popp_SummonSpeech1"],"audio":{"zhCN":[],"enUS":[],"jaJP":[]},"audioName":"5060094"},{"type":"SummonSpeech2","label":"召唤-台词2","texts":{"zhCN":["只要是为了你，不管多少次舍弃性命我都愿意…"],"enUS":["I'd gladly throw my life away for you any time…"],"jaJP":["おれはお前のためなら何度だって命を捨てられるんだ"]},"keys":["cv_popp_SummonSpeech2"],"audio":{"zhCN":[],"enUS":[],"jaJP":[]},"audioName":"5060095"},{"type":"SummonSpeech3","label":"召唤-台词3","texts":{"zhCN":["我…我…把你…当、当成最亲密的伙伴！"],"enUS":["I… I think you're the best companion ever!"],"jaJP":["…おれは…おれは…おまえを…す、すばらしい仲間だと思ってんだからさ！"]},"keys":["cv_popp_SummonSpeech3"],"audio":{"zhCN":[],"enUS":[],"jaJP":[]},"audioName":"5060096"},{"type":"Special1","label":"特殊剧情1","texts":{"zhCN":["美加恩特！"],"enUS":["Megante!"],"jaJP":["メガンテ！"]},"keys":["cv_popp_Special1"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060501"]},"audioName":"5060501"},{"type":"Special2","label":"特殊剧情2","texts":{"zhCN":["美多洛亚！"],"enUS":["Medroa!"],"jaJP":["メドローア！"]},"keys":["cv_popp_Special2"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060502"]},"audioName":"5060502"},{"type":"Special3","label":"特殊剧情3","texts":{"zhCN":["美拉佐玛！"],"enUS":["Merazoma!!!"],"jaJP":["メラゾーマ！！！"]},"keys":["cv_popp_Special3"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060503"]},"audioName":"5060503"},{"type":"Special4","label":"特殊剧情4","texts":{"zhCN":["《坎公骑冠剑》"],"enUS":["Guardian Tales"],"jaJP":["ガーディアンテイルズ"]},"keys":["cv_popp_Special4"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060504"]},"audioName":"5060504"},{"type":"Special5","label":"特殊剧情5","texts":{"zhCN":["《达伊的大冒险》"],"enUS":["The Adventure of Dai"],"jaJP":["ダイの大冒険"]},"keys":["cv_popp_Special5"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060505"]},"audioName":"5060505"},{"type":"Special6","label":"特殊剧情6","texts":{"zhCN":["《坎公骑冠剑》&《达伊的大冒险》联动活动开始！"],"enUS":["Guardian Tales, The Adventure of Dai collaboration event is now open!"],"jaJP":["ガーディアンテイルズ、ダイの大冒険コラボ開催！"]},"keys":["cv_popp_Special6"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060506"]},"audioName":"5060506"}]}]}
