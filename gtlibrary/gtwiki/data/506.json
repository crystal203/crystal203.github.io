cters","name":"popp_sage"},"asset":{"key":"character:popp_sage","skin":null}}],"weapons":[{"code":"cwp_popp","name":"漆黑法杖","type":"法杖","variants":[{"id":9060614,"code":"cwp_popp_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_popp"},"stats":[{"name":"每秒伤害","values":[588,645],"baseValues":[587.70359988984,645.32159987904],"grows":true},{"name":"火属性攻击","values":[181,199],"baseValues":[181.389999966,199.173333296],"grows":true},{"name":"暴击率","values":[8,8],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"技能伤害值","min":10.0,"max":25.0,"unit":"%"},{"name":"生命","min":8.0,"max":24.0,"unit":"%"},{"name":"武器技能恢复速度","min":5.0,"max":16.0,"unit":"%"}],"subOptions":[{"name":"防御","min":5.0,"max":16.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"连续咒文的伤害值提升20%。\n新增“美加恩特”技能。\n美加恩特 ：消耗当前生命的40%，按照每秒伤害的320%对周围敌人造成远程伤害，技能释放期间承受伤害减免30%持续3秒。仅限生命低于30%的状态使用该技能。"}],"skill":{"name":"五指爆炎弹","description":"施放多个“美拉佐玛”，对周围敌人造成远程伤害并附带击飞效果。","levels":[3,7],"damage":[150.0,250.0],"cooldown":[10.5,8.5],"ailment":"击飞"}}],"number":1}],"profile":{"Age":[15],"Height":null,"Weight":null},"tribes":["人类"],"story":"勇者阿邦的三弟子波普，一位实力超群的魔法师。\n\n波普原本是蓝卡库斯村军火商的儿子，在村里遇到勇者阿邦后，对阿邦产生了强烈的憧憬。于是，波普立刻跟随阿邦离开了蓝卡库斯村，拜师成为阿邦的弟子，在其门下修炼魔法。\n\n与伙伴们的相遇，让波普逐渐变得坚强勇敢。一开始，波普经常逃避艰苦的修炼与战斗，但看到玛姆与达伊勇敢地迎战魔王军，波普也渐渐鼓起了勇气。为了让自己变得更加强大，波普接受了勇者阿邦的战友——“大魔道士马特利夫”的指导，刻苦修行魔法。在马特利夫的指导下，波普一步步成长为真正魔法师，甚至已经掌握了极大消灭咒文“美多洛亚”——以箭矢形态发射出积蓄的魔力，施展此魔法可瞬间将周围的一切夷为平地。\n\n波普暗恋着玛姆。他和达伊一起离开迪尔穆林岛踏上冒险旅程后，在经过一片森林时遇到了玛姆。起初，波普和玛姆见面就会吵个不停，但很快，波普发现了玛姆的善良与正义，并因此深深地喜欢上了她。玛姆为了成为武斗家，决定离开并踏上武术修行之旅。得知此事的波普决定向她告白，可最后未能成功。当知道玛姆喜欢修凯尔后，波普不希望和玛姆的关系受到影响，只好继续隐藏自己的感情。\n\n波普曾经只是一个憧憬勇者的普通人，既懒惰又胆小。然而与达伊一同战胜冒险中的重重困难后，波普已经拥有了不亚于勇者阿邦的勇气。平时，波普总会给人一种做事不够稳重的感觉，但关键时刻，他总能展现出比任何人都认真勇敢的一面。当伙伴们陷入了达伊失忆以及魔王军攻击的双重危机时，波普发动了以所有生命能量为代价的自我牺牲咒文“美加恩特”，成功地守护了伙伴们。波普使用“美加恩特”后陷入了无意识状态，但即便昏迷濒死，他仍然坚持使用咒文试图救出达伊。如此坚强和勇敢，连敌人都不得不敬佩他。","storyKey":"profile_popp_story","sources":{"hero":"heroes.json / OriginId=506","profile":"heroprofile.json / OriginId=506","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"popp","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["一切都在我的计划之中！"],"enUS":["It was all planned out!"],"jaJP":["全部計算ずくなんだよ！"]},"keys":["cv_popp_NormalBattleWin"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060001"]},"audioName":"5060001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["抱着必死的觉悟，还真是有点用的！"],"enUS":["I guess you can do anything if you're desperate!"],"jaJP":["死ぬ気になりゃ、なんとかなるもんだな"]},"keys":["cv_popp_BossBattleWin"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060002"]},"audioName":"5060002"},{"type":"Die","label":"阵亡","texts":{"zhCN":["…我的冒险，好像到此为止了。"],"enUS":["…My adventure ends here."],"jaJP":["…おれの冒険はここまでだ"]},"keys":["cv_popp_Die"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060003"]},"audioName":"5060003"},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["这样做真的能掌握强力的魔法吗？"],"enUS":["Is this really going to let me use powerful magic?"],"jaJP":["こんなんでホントに強い魔法が使えるようになるのかよ？"]},"keys":["cv_popp_GetExp"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060004"]},"audioName":"5060004"},{"type":"LevelUp","label":"升级","texts":{"zhCN":["魔法师的等级大大成长了呢！"],"enUS":["I feel my caliber as a mage really leveled up like crazy!"],"jaJP":["魔法使いとしてのグレードがグ～ンとレベルアップしちゃった感じがするぞ！"]},"keys":["cv_popp_LevelUp"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060005"]},"audioName":"5060005"},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["我看看，是什么样的新武器呢？"],"enUS":["Let's see what sort of weapon this is."],"jaJP":["どれどれ、どんな新兵器なんだい？"]},"keys":["cv_popp_EquipWeapon"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060006"]},"audioName":"5060006"},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["总觉得…这个好土啊…？"],"enUS":["This thing's… kind of ugly…"],"jaJP":["なんか…これはダセぇな"]},"keys":["cv_popp_EquipCostume"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060007"]},"audioName":"5060007"},{"type":"Evolve","label":"进化","texts":{"zhCN":["哈，就这实力？"],"enUS":["Is this it?"],"jaJP":["ま…こんなトコでしょ…！！"]},"keys":["cv_popp_Evolve"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060008"]},"audioName":"5060008"},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["呀！"],"enUS":["Hiyap!"],"jaJP":["やっ！"]},"keys":["cv_popp_Attack1"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060009"]},"audioName":"5060009"},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["哈呀！"],"enUS":["Hyaa!"],"jaJP":["はあっ！"]},"keys":["cv_popp_Attack2"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060010"]},"audioName":"5060010"},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["接招！"],"enUS":["Take this!"],"jaJP":["くらえ！"]},"keys":["cv_popp_Attack3"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060011"]},"audioName":"5060011"},{"type":"Skill1","label":"技能1","texts":{"zhCN":["五指爆炎弹！"],"enUS":["Finger Flare Bombs!"],"jaJP":["フィンガーフレアボムズ"]},"keys":["cv_popp_Skill1"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060012"]},"audioName":"5060012"},{"type":"Skill2","label":"技能2","texts":{"zhCN":["是我赢了！"],"enUS":["It looks like I win!"],"jaJP":["おれの勝ちだ！"]},"keys":["cv_popp_Skill2"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/506/5060013"]},"audioName":"