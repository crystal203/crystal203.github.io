code":"robot_tanker_mecha","name":"欧格玛MK-怀特","type":"时装","sprite":{"sheet":"characters","name":"robot_tanker_mecha"},"asset":{"key":"character:robot_tanker_mecha","skin":"robot_tanker_mecha"}},{"id":10341,"code":"robot_tanker_raiden","name":"欧格玛MK-雷电","type":"时装","sprite":{"sheet":"characters","name":"robot_tanker_raiden"},"asset":{"key":"character:robot_tanker_raiden","skin":"robot_tanker_raiden"}},{"id":10375,"code":"robot_tanker_titan_force","name":"泰坦金刚欧格玛","type":"时装","sprite":null,"asset":null},{"id":19006,"code":"robot_tanker_night_voyager","name":"欧格玛GB-夜航星","type":"时装","sprite":{"sheet":"characters","name":"robot_tanker_night_voyager"},"asset":{"key":"character:robot_tanker_night_voyager","skin":"robot_tanker_night_voyager"}},{"id":19011,"code":"robot_tanker_infinite","name":"INFINITEᆞ欧格玛","type":"时装","sprite":{"sheet":"characters","name":"robot_tanker_infinite"},"asset":{"key":"character:robot_tanker_infinite","skin":"robot_tanker_infinite"}}],"weapons":[{"code":"cwp_robottanker","name":"方阵刹那","type":"单手剑","variants":[{"id":9010454,"code":"cwp_robottanker_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_robottanker"},"stats":[{"name":"每秒伤害","values":[604,663],"baseValues":[604.0950001050601,663.3200001153601],"grows":true},{"name":"暗属性攻击","values":[196,215],"baseValues":[195.500000034,214.66666670400002],"grows":true},{"name":"暴击率","values":[3,3],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"生命","min":5.0,"max":12.0,"unit":"%"},{"name":"防御","min":4.0,"max":8.0,"unit":"%"},{"name":"击败敌人时，恢复生命","min":1.5,"max":3.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":3.0,"max":10.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"防御","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"按照英雄自身防御的一定比例，反弹部分承受伤害。该技能每1秒启动1次。\n(反弹伤害值不会超过武器等级ⅹ1500。)"}],"skill":{"name":"压力气场","description":"在敌人周围持续增加气压，造成范围伤害，并附带击倒效果。","levels":[1,5],"damage":[90.0,170.0],"cooldown":[12.1,8.5],"ailment":"击倒"}}],"number":1},{"code":"cwp_robottanker2","name":"R模式·方阵刹那","type":"步枪","variants":[{"id":9030444,"code":"cwp_robottanker2_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_robottanker2"},"stats":[{"name":"每秒伤害","values":[599,658],"baseValues":[598.9848000000001,657.7088],"grows":true},{"name":"暗属性攻击","values":[141,155],"baseValues":[141.27,155.12],"grows":true},{"name":"暴击率","values":[6,6],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"技能伤害值","min":5.0,"max":16.0,"unit":"%"},{"name":"防御","min":4.0,"max":12.0,"unit":"%"},{"name":"生命","min":4.0,"max":12.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":3.0,"max":10.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"佩戴武器时，英雄的职业技能随武器变更；可以装备盾牌。\n- 装备盾牌时，变为[c][F8E8CB]20%[-][/c]盾牌的基础防御值，输出伤害提升[c][F8E8CB]20%[-][/c]；\n- 队伍能力切换为[c][F8E8CB]技能伤害值提升[-][/c]；\n- 普通攻击切换为[c][F8E8CB]机甲射击术[-][/c]；\n- 连锁技能切换为[c][F8E8CB]艾登驾驶员突击[-][/c]；\n- 特殊能力切换为[c][F8E8CB]超感触发器[-][/c]。"}],"skill":{"name":"集束导弹","description":"向敌人发射可以投放导弹的吊舱，造成伤害并附带击飞效果。","levels":[1,5],"damage":[90.0,270.0],"cooldown":[10.2,8.2],"ailment":"击飞"}}],"number":2}],"profile":{"Age":null,"Height":[210],"Weight":[527]},"tribes":["机器人"],"story":"欧格玛，巨型机甲武器。\n\n身高18米，体重51吨，由地精发明家博士改造侵略者盔甲而成的机器人，所用材料，除侵略者和博士以外，无人知晓。佩戴巨剑，对近程战斗有利，头部最多可装备6枚导弹。抖动躯体，在指定范围内形成振动磁场，对范围内的敌人持续施加压力。\n\n地精青年艾登是欧格玛驾驶员。侵略者袭击旅馆时，热血青年艾登为了守护笑面神，自告奋勇参加敢死队。受到侵略者空袭，艾登全身上下满是伤痕。幸而，地精发明家博士利用在侵略者盔甲上面发现的技术救活了筋骨尽断、奄奄一息的艾登。博士用机械配件代替了一些无法重生的器官，复活的艾登俨然是半机器人地精。正因为如此，艾登才能成为唯一与欧格玛“通灵”的驾驶员。艾登的身体能与欧格玛融合，操控欧格玛更加得心应手。\n\n变成欧格玛的半人半机器驾驶员之前，艾登除了满腔正义感，什么都没有。住在旅馆的那段期间，以旅馆英雄自诩，是一个冲动莽撞的青年。侵略者战斗结束之后，重获新生的艾登才真正了解到履行身为“笑面神守护勇士”的使命才是自己该做的。目前，艾登假装自己是人类的伙伴，在笑面神罗兰茵周围徘徊，忠实地执行笑面神守护任务，以免她受到侵略者和其他邪恶势力袭击。","storyKey":"profile_robot_tanker_story","sources":{"hero":"heroes.json / OriginId=353","profile":"heroprofile.json / OriginId=353","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"robot_tanker","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["战斗结束！"],"enUS":["The END!"],"jaJP":["戦闘終了っ！"]},"keys":["cv_robot_tanker_NormalBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/353/3530001@6965512733171705785"],"enUS":["cdn/Android/ondemand/voices_en/353/3530001"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/353/3530001@6728558908622351316"]},"audioName":"3530001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["太好了！我离笑面神更近了！"],"enUS":["Awesome! I'm now one step closer to Lord Smiley Face!"],"jaJP":["よぉしっ、これでにこにこ様に一歩近づいたな！"]},"keys":["cv_robot_tanker_BossBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/353/3530002@3390720262670125820"],"enUS":["cdn/Android/ondemand/voices_en/353/3530002"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/353/3530002@5400281250867434630"]},"audioName":"3530002"},{"type":"Die","label":"阵亡","texts":{"zhCN":["笑面神…我来了…"],"enUS":["Lord Smiley Face… Here I…"],"jaJP":["にこにこ様…俺はここで…"]},"keys":["cv_robot_tanker_Die"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/353/3530003@-2242645765265778303"],"enUS":["cdn/Android/ondemand/voices_en/353/3530003"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/353/3530003@9105727771861358104"]},"audioName":"3530003"},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["感觉实力在增强。"],"enUS":["I