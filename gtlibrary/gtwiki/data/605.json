unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"阿德拉式武术最后一次攻击增强。\n命中目标时，在敌人身上附着炸弹，炸弹在3秒后爆炸并按照每秒伤害的100%造成伤害；该技能每5秒启动1次。\n按照每秒伤害的150%，对生命低于50%的敌人造成伤害。"}],"skill":{"name":"枪伞射击","description":"使用枪伞对敌人扫射，造成远程伤害并附带重伤效果。","levels":[1,5],"damage":[160.0,220.0],"cooldown":[10.2,8.6],"ailment":"重伤"}}],"number":1}],"profile":{"Age":[27],"Height":[170],"Weight":[60]},"tribes":["人类"],"story":"安娜是阿德拉王国的情报要员，隶属于国王直属的特工组织「NEST」。\n\n安娜出身于军人世家，为了继承因事故去世的父母的遗志，安娜也加入了军队。凭借多次在任务中的出色表现，安娜被选拔进入情报部门。在作为情报要员继续她的军旅生涯时，安娜偶然发现她父母并非死于一场事故，而是在一次机密任务中丧命的。为了寻找真相安娜试图调查此事，但最终却受到了情报部门的停职处分。同时，安娜也因为王国故意掩盖父母的死因而陷入绝望。\n\n正当安娜感到迷茫时，成为新国王的王女找到了她。王女告诉了安娜，她的父母被贵族势力强行卷入了一场不正当且极具危险的任务，并因此丧命。王女向安娜保证，她会消除贵族的压迫，并提出让安娜加入「NEST」成为王国直属的秘密特工。此后，安娜的代号被定为了“鱼鹰”，寓意她像大海上的鱼鹰猎杀水中的鱼一样，迅速消灭隐藏在暗处的王国的威胁。\n\n从此，安娜成为了王女的最锋利的刀刃，清除一切可能引发王国混乱的威胁。据说，安娜的任务从未失败过，每次任务都干净利落，不留下一丝痕迹。部分阿德拉王国的贵族甚至怀疑，传说中的「NEST」是否真的存在。\n\n尽管长期的军旅生涯和秘密特工的工作让她变得沉默寡言，但在伪装和潜入任务中，她能够完美地扮演任何角色。在伯莱坞执行特殊潜入任务时，她就装扮成了电影演员尤金的性格外向的经纪人，就连尤金这么活泼开朗的人，也无法适应她的节奏，经常躲开她。","storyKey":"profile_secret_agent_story","sources":{"hero":"heroes.json / OriginId=605","profile":"heroprofile.json / OriginId=605","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"secret_agent","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["继续移动。"],"enUS":["Moving out."],"jaJP":["先を急ぎます"]},"keys":["cv_secret_agent_NormalBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050001@8842352787520542061"],"enUS":["cdn/Android/ondemand/voices_en/605/6050001"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050001@4047251730439316717"]},"audioName":"6050001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["作战结束，即刻动身返回王国。"],"enUS":["Mission accomplished. Returning to the kingdom."],"jaJP":["任務完了、王国へ帰還します"]},"keys":["cv_secret_agent_BossBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050002@2472684726292484494"],"enUS":["cdn/Android/ondemand/voices_en/605/6050002"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050002@1753156781156558596"]},"audioName":"6050002"},{"type":"Die","label":"阵亡","texts":{"zhCN":["即使只有这些情报…我也必须汇报给上级…"],"enUS":["This information… has to be reported…"],"jaJP":["この情報だけでも…報告しなけれ…ば…"]},"keys":["cv_secret_agent_Die"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050003@-9185480479965893936"],"enUS":["cdn/Android/ondemand/voices_en/605/6050003"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050003@-1194498192287768541"]},"audioName":"6050003"},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["这是…攸关王国安全的重要情报。"],"enUS":["This is… crucial intelligence for the kingdom's security."],"jaJP":["これは…王国の安全保障のために重要な情報ですね"]},"keys":["cv_secret_agent_GetExp"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050004@6086614645373884129"],"enUS":["cdn/Android/ondemand/voices_en/605/6050004"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050004@-4434528742792729750"]},"audioName":"6050004"},{"type":"LevelUp","label":"升级","texts":{"zhCN":["执行下一阶段作战计划。"],"enUS":["Now, I'll move on to the next mission."],"jaJP":["さて、次の任務に移りましょう"]},"keys":["cv_secret_agent_LevelUp"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050005@-8259997872252105626"],"enUS":["cdn/Android/ondemand/voices_en/605/6050005"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050005@-3767172347234767162"]},"audioName":"6050005"},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["装备并不重要，无论用什么，我都能成功完成作战计划。"],"enUS":["Any equipment will do. I'll ensure the mission succeeds."],"jaJP":["どのような装備であっても構いません、任務は必ず成功させますので"]},"keys":["cv_secret_agent_EquipWeapon"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050006@7246570757153620866"],"enUS":["cdn/Android/ondemand/voices_en/605/6050006"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050006@-5286209475913960038"]},"audioName":"6050006"},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["这次行动的潜入作战服…有些特别呢。"],"enUS":["The outfit for this mission… is quite unconventional."],"jaJP":["この服装は…潜入用でしょうか"]},"keys":["cv_secret_agent_EquipCostume"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050007@8312029033614512418"],"enUS":["cdn/Android/ondemand/voices_en/605/6050007"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050007@-3893329434052275578"]},"audioName":"6050007"},{"type":"Evolve","label":"进化","texts":{"zhCN":["世界上有我不知道的情报，但是没有我找不到的情报。"],"enUS":["There may be information I don't know, but there's no information I can't find."],"jaJP":["私に知らない情報はあっても、手に入れられない情報はありません"]},"keys":["cv_secret_agent_Evolve"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050008@2828140468521812112"],"enUS":["cdn/Android/ondemand/voices_en/605/6050008"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050008@-4202486808585474678"]},"audioName":"6050008"},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["哈！"],"enUS":["Hut!"],"jaJP":["ふっ！"]},"keys":["cv_secret_agent_Attack1"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050009@6619979019046903675"],"enUS":["cdn/Android/ondemand/voices_en/605/6050009"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050009@-3533921958254214316"]},"audioName":"6050009"},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["喝！"],"enUS":["Hu-ut!"],"jaJP":["はっ！"]},"keys":["cv_secret_agent_Attack2"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050010@4655376857749065600"],"enUS":["cdn/Android/ondemand/voices_en/605/6050010"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050010@2630941313569209251"]},"audioName":"6050010"},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["肃静…！"],"enUS":["Quiet…!"],"jaJP":["お静かに"]},"keys":["cv_secret_agent_Attack3"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050011@-7922189062723608617"],"enUS":["cdn/Android/ondemand/voices_en/605/6050011"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050011@6560601438265240652"]},"audioName":"6050011"},{"type":"Skill1","label":"技能1","texts":{"zhCN":["嘘，别出声。"],"enUS":["Shh, don’t make a sound."],"jaJP":["息の根、止めさせていただきます"]},"keys":["cv_secret_agent_Skill1"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050012@7999261380625679271"],"enUS":["cdn/Android/ondemand/voices_en/605/6050012"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050012@-7141275364121005305"]},"audioName":"6050012"},{"type":"Skill2","label":"技能2","texts":{"zhCN":["我并没有恶意。"],"enUS":["It's nothing personal."],"jaJP":["これもすべて王女様のため"]},"keys":["cv_secret_agent_Skill2"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050013@2329382372731994123"],"enUS":["cdn/Android/ondemand/voices_en/605/6050013"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050013@-4634907091274542124"]},"audioName":"6050013"},{"type":"Damaged1","label":"受到攻击1","texts":{"zhCN":["呃！"],"enUS":["Ugh!"],"jaJP":["うっ！"]},"keys":["cv_secret_agent_Damaged1"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050014@-1418060233430316692"],"enUS":["cdn/Android/ondemand/voices_en/605/6050014"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050014@3119338584512659065"]},"audioName":"6050014"},{"type":"Damaged2","label":"受到攻击2","texts":{"zhCN":["咳呃…！"],"enUS":["Agh…!"],"jaJP":["ううっ…！"]},"keys":["cv_secret_agent_Damaged2"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050015@4706743091746327114"],"enUS":["cdn/Android/ondemand/voices_en/605/6050015"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050015@-6523855188509928491"]},"audioName":"6050015"},{"type":"PlayerChooseBright","label":"人物友善值选项","texts":{"zhCN":["虽然你的选择，我无法向上级汇报…但我会记住你今天的决定。"],"enUS":["I can't report your decision, but… I will remember it."],"jaJP":["あなたの選択は世間に知られることはありませんが…私の記憶には残ります"]},"keys":["cv_secret_agent_PlayerChooseBright"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050016@-2626724034974872147"],"enUS":["cdn/Android/ondemand/voices_en/605/6050016"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050016@861174843556406511"]},"audioName":"6050016"},{"type":"PlayerChooseDark","label":"人物邪恶值选项","texts":{"zhCN":["此刻我们是并肩作战的伙伴，但说不定，将来我们是针锋相对的敌人。"],"enUS":["We may be allies now, but I have a feeling we'll meet on opposite sides in the future."],"jaJP":["あなたとはいつかは相対する時が来る、そんな気がしますね"]},"keys":["cv_secret_agent_PlayerChooseDark"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050017@6714292070905869614"],"enUS":["cdn/Android/ondemand/voices_en/605/6050017"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050017@4777137378123725277"]},"audioName":"6050017"},{"type":"WeakEnemyBattleStart","label":"与弱小敌人战斗","texts":{"zhCN":["我会悄无声息地抹杀目标。"],"enUS":["I'll handle this quietly."],"jaJP":["静かに処理しましょう"]},"keys":["cv_secret_agent_WeakEnemyBattleStart"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050018@9173403877433277798"],"enUS":["cdn/Android/ondemand/voices_en/605/6050018"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050018@5995004128292241517"]},"audioName":"6050018"},{"type":"NormalEnemyBattleStart","label":"与普通敌人战斗","texts":{"zhCN":["抹杀目标后，再继续前行。"],"enUS":["I'll eliminate it and proceed."],"jaJP":["早急に対処し、計画を進めます"]},"keys":["cv_secret_agent_NormalEnemyBattleStart"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050019@-7722698930836755031"],"enUS":["cdn/Android/ondemand/voices_en/605/6050019"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050019@9099112267857216444"]},"audioName":"6050019"},{"type":"StrongEnemyBattleStart","label":"与强大敌人战斗","texts":{"zhCN":["为了以后着想，现在必须把这家伙制服。"],"enUS":["I should subdue this for the sake of the future."],"jaJP":["後の脅威となる前に、芽を摘んでおかねばなりませんね"]},"keys":["cv_secret_agent_StrongEnemyBattleStart"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050020@2544511475495482964"],"enUS":["cdn/Android/ondemand/voices_en/605/6050020"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050020@2708820185062657909"]},"audioName":"6050020"},{"type":"BossBattleStart","label":"与首领战斗","texts":{"zhCN":["鱼鹰，前来报到！发现目标，准备清除！"],"enUS":["Osprey reporting. Target will be eliminated."],"jaJP":["エージェントオスプレイ、ターゲットを排除します"]},"keys":["cv_secret_agent_BossBattleStart"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050021@-5464549429581995762"],"enUS":["cdn/Android/ondemand/voices_en/605/6050021"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050021@1409750339451095424"]},"audioName":"6050021"},{"type":"JoinParty","label":"首次加入队伍","texts":{"zhCN":["只要能达成目的，任何一件事我都会去做，哪怕是潜入、暗杀，或者是爆破…"],"enUS":["I'll do whatever is necessary to achieve the objective. Infiltration, assassination, demolition…"],"jaJP":["目的のためなら何でもします、潜入でも、暗殺でも、爆破でも…"]},"keys":["cv_secret_agent_JoinParty"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050022@-8559407019818070142"],"enUS":["cdn/Android/ondemand/voices_en/605/6050022"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050022@-3770738011367889582"]},"audioName":"6050022"},{"type":"CoopAttack","label":"战斗-攻击","texts":{"zhCN":["锁定目标，开始攻击！"],"enUS":["Initiate target attack!"],"jaJP":["ターゲット確認、作戦開始"]},"keys":["cv_secret_agent_CoopAttack"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050023@-776546835914105880"],"enUS":["cdn/Android/ondemand/voices_en/605/6050023"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050023@245341353386710638"]},"audioName":"6050023"},{"type":"CoopHeal","label":"战斗-请求治疗","texts":{"zhCN":["我需要帮助，快帮我疗伤。"],"enUS":["I need assistance. Please provide medical support."],"jaJP":["助けが必要です、治療をお願いします"]},"keys":["cv_secret_agent_CoopHeal"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050024@-1341649059482834193"],"enUS":["cdn/Android/ondemand/voices_en/605/6050024"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050024@5856886322776133119"]},"audioName":"6050024"},{"type":"CoopRun","label":"战斗-注意","texts":{"zhCN":["敌人众多，先暂时撤退。"],"enUS":["Too many enemies. I'm retreating for now."],"jaJP":["予備計画へ移行、一度退きます"]},"keys":["cv_secret_agent_CoopRun"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050025@-6102371014942048545"],"enUS":["cdn/Android/ondemand/voices_en/605/6050025"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050025@-4631015904230281278"]},"audioName":"6050025"},{"type":"CoopWin","label":"战斗-胜利","texts":{"zhCN":["任务完成，前往下一个地点继续执行作战计划。"],"enUS":["Mission complete. Moving on to the next operation."],"jaJP":["任務完了、次のターゲットの元へ移動します"]},"keys":["cv_secret_agent_CoopWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050026@-7344259759139970107"],"enUS":["cdn/Android/ondemand/voices_en/605/6050026"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050026@847453632893809453"]},"audioName":"6050026"},{"type":"CoopMVP","label":"战斗-最佳队员","texts":{"zhCN":["为了避免暴露身分，我决定把这份荣誉让给别人。"],"enUS":["Due to the risk of exposure, I'll pass it on to someone else."],"jaJP":["素性を知られるわけにはいきませんので、他の方に譲ります"]},"keys":["cv_secret_agent_CoopMVP"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050027@2467949651022245446"],"enUS":["cdn/Android/ondemand/voices_en/605/6050027"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050027@6417183914389042295"]},"audioName":"6050027"},{"type":"CoopHi","label":"战斗-问候","texts":{"zhCN":["出于安全考量，自我介绍就免了吧。"],"enUS":["For security reasons, I'll skip the introductions."],"jaJP":["自己紹介は控えさせていただきます"]},"keys":["cv_secret_agent_CoopHi"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050028@-2270345449334403925"],"enUS":["cdn/Android/ondemand/voices_en/605/6050028"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050028@8261805741086263695"]},"audioName":"6050028"},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["这边走，我们得快点移动。"],"enUS":["This way. Let's move quickly."],"jaJP":["こちらです、急ぎましょう"]},"keys":["cv_secret_agent_CoopHurryUp"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050029@-4019884311377122076"],"enUS":["cdn/Android/ondemand/voices_en/605/6050029"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050029@2257626850238288556"]},"audioName":"6050029"},{"type":"CoopBelieve","label":"战斗-信任","texts":{"zhCN":["按原定计划行动，请大家相信我。"],"enUS":["Trust me. There's no change in the plan."],"jaJP":["私を信じてください、計画に変更はありません"]},"keys":["cv_secret_agent_CoopBelieve"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050030@2089027485772016944"],"enUS":["cdn/Android/ondemand/voices_en/605/6050030"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050030@-5798319200866306086"]},"audioName":"6050030"},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["作战时，务必听我的指挥。"],"enUS":["We're in the middle of a mission. Follow my instructions."],"jaJP":["任務遂行中です、指示通りにお願いします"]},"keys":["Voice_secret_agent_1_TouchReactionGood1","cv_secret_agent_TouchReactionGood1"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050031@-5683409731593237849"],"enUS":["cdn/Android/ondemand/voices_en/605/6050031"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050031@6831552042750233700"]},"audioName":"6050031"},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["有什么好方法可以轻而易举地获得情报？\n很简单，只要准备好一根结实的绳子和一个隔音效果好的房间，几个小时就能搞定。"],"enUS":["An easy way to extract information? Just give me a few hours with a sturdy rope and a soundproof room."],"jaJP":["情報を引き出す簡単な方法ですか？丈夫な紐と防音室、それと、数時間あれば十分です"]},"keys":["Voice_secret_agent_1_TouchReactionGood2","cv_secret_agent_TouchReactionGood2"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050032@-8323220489858575062"],"enUS":["cdn/Android/ondemand/voices_en/605/6050032"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050032@-2126647416594081346"]},"audioName":"6050032"},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["我现在从事什么行业？\n如果你没有1级机密访问权限，恕我无可奉告。"],"enUS":["What do I do for a living? If you don’t have Level 1 clearance, I can’t tell you."],"jaJP":["私の仕事ですか？1級機密情報取り扱い資格をお持ちでないなら、お答えできません"]},"keys":["Voice_secret_agent_1_TouchReactionBad1","cv_secret_agent_TouchReactionBad1"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050033@737569899360837160"],"enUS":["cdn/Android/ondemand/voices_en/605/6050033"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050033@-3883061168567441183"]},"audioName":"6050033"},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["请别妨碍我，难道你没听过“举止造就人品”这句话？"],"enUS":["Please don't interfere. Haven't you heard that manners maketh man?"],"jaJP":["邪魔をしないでください、礼節が人を作るという言葉を知らないのですか？"]},"keys":["Voice_secret_agent_1_TouchReactionBad2","cv_secret_agent_TouchReactionBad2"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050034@48771165379846786"],"enUS":["cdn/Android/ondemand/voices_en/605/6050034"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050034@3871691165236153266"]},"audioName":"6050034"},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["收到一封新任务邮件。请注意，这封邮件将在五秒钟后自动销毁。"],"enUS":["Looks like the mission mail is here. Careful, the message will self-destruct in 5 seconds."],"jaJP":["任務のメールが来ましたね、5秒後に爆発するので注意してください"]},"keys":["Voice_secret_agent_1_NoticeMail","cv_secret_agent_NoticeMail"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050035@-6490218756582872671"],"enUS":["cdn/Android/ondemand/voices_en/605/6050035"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050035@-7861217154645235977"]},"audioName":"6050035"},{"type":"NoticeEvent","label":"活动提示","texts":{"zhCN":["有一场特别的活动在这里举行！目标…正在靠近活动区。"],"enUS":["There's a special event taking place here! …Target is moving to the event."],"jaJP":["こちらでは特別イベントが行われています…ターゲット移動開始、イベントへ向かう模様"]},"keys":["cv_secret_agent_NoticeEvent"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050036@1520824777045377983"],"enUS":["cdn/Android/ondemand/voices_en/605/6050036"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/605/6050036@-8506193611450772128"]},"audioName":"6050036"},{"type":"SummonSpeech1","label":"召唤-台词1","texts":{"zhCN":["我叫安娜，很荣幸和你一起参与本次作战。"],"enUS":["I'm Anna and I'll be joining you for this mission."],"jaJP":["今回の任務に参加するアンナと申します"]},"keys":["cv_secret_agent_SummonSpeech1"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050094@-5521244790738362507"],"enUS":[],"jaJP":[]},"audioName":"6050094"},{"type":"SummonSpeech2","label":"召唤-台词2","texts":{"zhCN":["先别动，目标刚刚从你身后经过。"],"enUS":["Hold still for a moment. The target just passed behind you."],"jaJP":["しばらくそのままお待ちください、先ほどターゲットが後ろを通り過ぎました"]},"keys":["cv_secret_agent_SummonSpeech2"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050095@-7433193895823916659"],"enUS":[],"jaJP":[]},"audioName":"6050095"},{"type":"SummonSpeech3","label":"召唤-台词3","texts":{"zhCN":["我们将在7秒后执行潜入作战任务。"],"enUS":["I'll move in and execute the operation in 7 seconds."],"jaJP":["作戦開始、7秒後に突入します"]},"keys":["cv_secret_agent_SummonSpeech3"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/605/6050096@-6625442665350175015"],"enUS":[],"jaJP":[]},"audioName":"6050096"}]}]}
