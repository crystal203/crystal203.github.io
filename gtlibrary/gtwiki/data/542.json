s!"],"jaJP":["変化の術で何とかします、信じてください！"]},"keys":["cv_dokkaebi_CoopBelieve"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/542/5420030@220021762535398208"],"enUS":["cdn/Android/ondemand/voices_en/542/5420030"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/542/5420030@9000261280755592340"]},"audioName":"5420030"},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["你听说过神奇而美丽的妖怪村吗？"],"enUS":["Have you heard of the Dokkaebi Village? Full of mysteries, Full of magic!"],"jaJP":["幻想的なとある鬼の村について、ご存知ですか？"]},"keys":["Voice_dokkaebi_1_TouchReactionGood1","cv_dokkaebi_TouchReactionGood1"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/542/5420031@-4726254141567394252"],"enUS":["cdn/Android/ondemand/voices_en/542/5420031"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/542/5420031@165996939393349974"]},"audioName":"5420031"},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["和我一起玩捉迷藏叭！"],"enUS":["Do you want to play hide-and-seek with me?"],"jaJP":["私とかくれんぼしましょう！"]},"keys":["Voice_dokkaebi_1_TouchReactionGood2","cv_dokkaebi_TouchReactionGood2"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/542/5420032@-4314639998353837970"],"enUS":["cdn/Android/ondemand/voices_en/542/5420032"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/542/5420032@-5041860487566803335"]},"audioName":"5420032"},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["一个人的捉迷藏太孤独了，很可怕。"],"enUS":["Hiding alone is scary."],"jaJP":["ひとりでかくれんぼなんて、もう嫌です"]},"keys":["Voice_dokkaebi_1_TouchReactionBad1","cv_dokkaebi_TouchReactionBad1"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/542/5420033@9013821437726405180"],"enUS":["cdn/Android/ondemand/voices_en/542/5420033"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/542/5420033@6687588450902233722"]},"audioName":"5420033"},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["胸口插着一把宝剑的妖怪？我没见过！"],"enUS":["A dokk