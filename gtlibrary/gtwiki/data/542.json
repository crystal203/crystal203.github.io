{"id":"dokkaebi","originId":542,"name":"小妖怪银河","englishName":"Baby Dokkaebi Eunha","title":"小妖怪","shortName":"银河","description":"精通变身术的妖怪","introduction":"","element":"虚","role":"射手","weaponsAllowed":["篮子","饰品"],"portrait":{"sheet":"portraits","name":"dokkaebi"},"stages":[{"id":542,"name":"dokkaebi_3","label":"3星","stars":3,"asset":{"key":"character:dokkaebi","skin":"dokkaebi_3"},"sprite":{"sheet":"characters","name":"dokkaebi_3"},"stats":{"Hp":932.39424,"Atk":1.2797568,"Def":34.736256,"Recovery":10.58,"StatGrowthRate":1.02},"skills":[{"kind":"普通攻击","name":"妖怪恶作剧","description":"凉风萧瑟：吸取附近敌人，对其造成远程伤害；攻击每命中6次，我方全部人员恢复生命。\n号令面具：投掷回旋面具，对敌人造成远程伤害。为被命中的目标刻上妖怪纹章，攻击减免10%并持续6秒。"},{"name":"变身术","description":"变成物体，按照每秒伤害的500%对敌人造成近程伤害。","kind":"连锁技能","trigger":"击倒","connect":"击飞"}],"party":[{"id":10820,"name":"远程伤害","base":12.0,"max":50.0,"unit":"%","level":120,"maxLevel":500,"baseCoefficient":0,"levelCoefficient":0.1,"maxLabel":"满进化 · 满觉醒"}],"skillSets":[{"number":1,"skills":[{"kind":"普通攻击","name":"妖怪恶作剧","description":"凉风萧瑟：吸取附近敌人，对其造成远程伤害；攻击每命中6次，我方全部人员恢复生命。\n号令面具：投掷回旋面具，对敌人造成远程伤害。为被命中的目标刻上妖怪纹章，攻击减免10%并持续6秒。"},{"name":"变身术","description":"变成物体，按照每秒伤害的500%对敌人造成近程伤害。","kind":"连锁技能","trigger":"击倒","connect":"击飞"}],"party":[{"id":10820,"name":"远程伤害","base":12.0,"max":50.0,"unit":"%","level":120,"maxLevel":500,"baseCoefficient":0,"levelCoefficient":0.1,"maxLabel":"满进化 · 满觉醒"}]}],"options":[{"id":10820,"level":120,"name":"队伍远程伤害提升"}]},{"id":543,"name":"dokkaebi_4","label":"4星","stars":4,"asset":{"key":"character:dokkaebi","skin":"dokkaebi_4"},"sprite":{"sheet":"characters","name":"dokkaebi_4"},"stats":{"Hp":1013.472,"Atk":1.39104,"Def":37.7568,"Recovery":11.5,"StatGrowthRate":1.02},"skills":[{"kind":"普通攻击","name":"妖怪恶作剧","description":"凉风萧瑟：吸取附近敌人，对其造成远程伤害；攻击每命中6次，我方全部人员恢复生命。\n号令面具：投掷回旋面具，对敌人造成远程伤害。为被命中的目标刻上妖怪纹章，攻击减免10%并持续6秒。"},{"name":"变身术","description":"变成物体，按照每秒伤害的500%对敌人造成近程伤害。","kind":"连锁技能","trigger":"击倒","connect":"击飞"}],"party":[{"id":10820,"name":"远程伤害","base":25.0,"ma