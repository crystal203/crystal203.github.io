ame":"每秒伤害","values":[634,696],"baseValues":[633.9299998878001,696.0799998768002],"grows":true},{"name":"虚属性攻击","values":[165,181],"baseValues":[164.65714282800002,180.79999996800004],"grows":true},{"name":"暴击率","values":[10,10],"unit":"%"},{"name":"防御","values":[27,29],"baseValues":[26.52,29.120000000000005],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"伤害减免","min":35,"max":80,"unit":""},{"name":"防御","min":8.0,"max":20.0,"unit":"%"},{"name":"生命","min":12.0,"max":26.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":3.0,"max":12.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"神龙咆哮","description":"命中目标时，以30%概率引起爆破，按照每秒伤害的30%造成额外伤害。"}],"skill":{"name":"恶龙爪","description":"凶残神龙大力挥舞前爪，对敌人造成伤害，并附带重伤效果。","levels":[2,5],"damage":[122.0,140.0],"cooldown":[7.0,7.0],"ailment":"重伤"}}],"number":1}],"profile":{"Age":[21],"Height":[149],"Weight":[40]},"tribes":["人类"],"story":"岚芳，总部设在消逝之都的秘密组织龙爪派的首领。\n\n岚芳的想法1：志存高远，令人生畏的龙爪派一定能称霸中原武林，征服全世界。身上这套臃肿的神龙人偶服可不是普通的标志性服饰。神龙人偶服既能威吓他人，受到攻击时又能起到缓冲作用，是一件了不起的盔甲，也是恐怖的武器。\n\n岚芳的想法2：想要征服世界，任何手段都可以使用。筹划糖果计划(用糖果引起高血糖，扩散糖尿病毒)、美食计划(分配食物，秘密组织人气飙升)等残酷作战，都是为了达到独霸天下的目的。","storyKey":"profile_doll_girl_story","sources":{"hero":"heroes.json / OriginId=102","profile":"heroprofile.json / OriginId=102","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}