"id":10810,"level":250,"name":"队伍近程伤害提升"},{"id":320404,"level":null,"name":"摧毁"}]}],"illustrations":[{"name":"原版立绘","asset":{"key":"illust:illust_demon_ceo","skin":null},"stage":null},{"name":"日服立绘","asset":{"key":"illust:illust_demon_ceo_kong","skin":null},"stage":null},{"name":"红心皇后莉莉丝","asset":{"key":"illust:illust_demon_ceo_heart_queen","skin":null},"stage":null}],"costumes":[{"id":10268,"code":"demon_ceo_ballet","name":"芭蕾舞者莉莉丝","type":"时装","sprite":{"sheet":"characters","name":"demon_ceo_ballet"},"asset":{"key":"character:demon_ceo_ballet","skin":null}},{"id":10288,"code":"demon_ceo_dragon_king","name":"龙王莉莉丝","type":"时装","sprite":{"sheet":"characters","name":"demon_ceo_dragon_king"},"asset":{"key":"character:demon_ceo_dragon_king","skin":null}},{"id":10301,"code":"demon_ceo_disguised","name":"乔装莉莉丝","type":"时装","sprite":{"sheet":"characters","name":"demon_ceo_disguised"},"asset":{"key":"character:demon_ceo_disguised","skin":null}},{"id":10371,"code":"demon_ceo_princess","name":"魔界公主莉莉丝","type":"时装","sprite":{"sheet":"characters","name":"demon_ceo_princess"},"asset":{"key":"character:demon_ceo_princess","skin":null}},{"id":10631,"code":"demon_ceo_rulestudent","name":"私立高中风纪委员莉莉丝","type":"时装","sprite":{"sheet":"characters","name":"demon_ceo_rulestudent"},"asset":{"key":"character:demon_ceo_rulestudent","skin":null}},{"id":179003,"code":"demon_ceo_heart_queen","name":"红心皇后莉莉丝","type":"超级时装","sprite":{"sheet":"characters","name":"demon_ceo_heart_queen"},"asset":{"key":"character:demon_ceo_heart_queen","skin":null}}],"weapons":[{"code":"cwp_demonceo","name":"女王的优雅","type":"爪","variants":[{"id":9100334,"code":"cwp_demonceo_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_demonceo"},"stats":[{"name":"每秒伤害","values":[733,805],"baseValues":[733.1250001172999,805.0000001287999],"grows":true},{"name":"暗属性攻击","values":[182,200],"baseValues":[182.142857172,200.000000032],"grows":true},{"name":"暴击率","values":[15,15],"unit":"%"},{"name":"防御","values":[22,24],"baseValues":[21.6,24.192000000000004],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"生命","min":10.0,"max":25.0,"unit":"%"},{"name":"武器技能恢复速度","min":3.0,"max":12.0,"unit":"%"},{"name":"防御","min":4.0,"max":10.0,"unit":"%"}],"subOptions":[{"name":"技能伤害值","min":5.0,"max":16.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"攻击","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"启动承受伤害减免20%的保护效果。\n黑暗利刺恢复时间减免至5秒，防御减免效果提升至20%。"}],"skill":{"name":"幻影斩","description":"伸出蕴含魔王之力的手，对敌人造成近程伤害并附带重伤效果。","levels":[1,5],"damage":[230.0,290.0],"cooldown":[11.2,10.2],"ailment":"重伤"}}],"number":1}],"profile":{"Age":[1510],"Height":[166],"Weight":[51]},"tribes":["魔族"],"story":"莉莉丝，魔界的最高统治者。\n\n身为魔界统治者，莉莉丝拥有超凡的智慧和卓越的领导能力。大约500年前，她和凯登和埃里娜等勇士们一起阻止了“灭亡之火”。莉莉丝不像其他人那样有勇无谋，冷静沉着的性格使她成为了凯登最坚实的后盾。结束冒险之后，莉莉丝展现出果断且现实的领袖风范，她将处于混乱的魔界重新整合，最终坐上了魔王的位置。\n\n老骑士埃里娜一直陪伴在莉莉丝左右，随时辅佐她。她们的缘分要追溯到1500多年前，那时候莉莉丝还是个小女孩，而埃里娜已经成为了优秀的勇士。她们既像朋友又像亲人，照顾了彼此上千年。莉莉丝当然会担心埃里娜，因为埃里娜的寿命远远超出了人类的平均寿命。但埃里娜总是拿莉莉丝的话当耳旁风，一转身就不见了。传闻莉莉丝的办公桌上很整洁，没有一件东西。这都是因为她生气时，总是会将手边的东西砸向埃里娜。尽管如此，每当埃里娜离家出走处于危险之中，莉莉丝都会及时出现并帮她解决问题。当然，莉莉丝也不会忘了絮絮叨叨，还会大发脾气。\n\n莉莉丝以自我管理闻名，她常年坚持运动，保持严格的食谱。风靡魔界的“成功人士清晨好习惯”也是莉莉丝基于自己的习惯创作的，内容包括早起、晨练、冥想、冲冷水澡等。莉莉丝对曲奇品质非常挑剔，由于戒了甜点，偶尔她想吃零食的时候，只会选择去吃最好的。人人都觉得莉莉丝是一个完美无瑕的人，却不知她每天都在和懒惰的自己“战斗”。每隔几十年，当她实在忍不住想要偷懒时，就会拿低血压当借口不去晨练。","storyKey":"profile_demon_ceo_story","sources":{"hero":"heroes.json / OriginId=404","profile":"heroprofile.json / OriginId=404","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"demon_ceo","label":"普通","lines":[{"type"