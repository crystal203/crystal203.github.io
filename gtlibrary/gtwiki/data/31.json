t":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"实验成功","description":"投掷烧杯时，最后一个烧杯的爆破范围及伤害提升60%。\n使用生物催化剂时，在5秒内恢复15%的生命。"}],"skill":{"name":"第七套组合","description":"混合魔界毒物制造的特殊炮弹，对敌人造成伤害，并附带重伤效果。","levels":[3,6],"damage":[320.0,320.0],"cooldown":[8.0,8.0],"ailment":"重伤"}}],"number":1}],"profile":{"Age":[244],"Height":[161],"Weight":[47]},"tribes":["魔族"],"story":"吉蒙里，恶魔族魔法研究员，她的所有行为都围绕着魔法研究，堪称研究狂。\n\n拥有常人无法揣测的精神世界，经常陷入自己的世界，很少能与他人相处融洽。与人交谈时，要么斜眼想事情，要么自言自语，情绪激动时，又想一下子说太多话，根本无法与其沟通。\n\n对吉蒙里来说，世上所有东西都只是潜在的实验对象。进入研究室的实验对象，会以什么模样走出实验室，甚至能不能走出实验室，都不得而知。","storyKey":"profile_mad_scientist_story","sources":{"hero":"heroes.json / OriginId=31","profile":"heroprofile.json / OriginId=31","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"mad_scientist","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["果然，魔法最棒…！"],"enUS":["Magic is the best!"],"jaJP":["んんん～ やっぱ魔法って最っ高…！"]},"keys":["cv_mad_scientist_NormalBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/31/310001@-1844781861596057653"],"enUS":["cdn/Android/ondemand/voices_en/31/310001"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/31/310001@2859120748784349159"]},"audioName":"310001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["嘻嘻…不错的实验对象。"],"enUS":["Ahaha! It was a great experiment!"],"jaJP":["ふひっ… なかなかの実験体だったね～"]},"keys":["cv_mad_scientist_BossBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/31/310002@6862855700672193875"],"enUS":["cdn/Android/ondemand/voices_en/31/310002"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/31/310002@-2663842180991107583"]},"audioName":"310002"},{"type":"Die","label":"阵亡","texts":{"zhCN":