opHi"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/500/5000028"]},"audioName":"5000028"},{"type":"CoopHurryUp","label":"战斗-急迫","texts":{"zhCN":["动作快点！"],"enUS":["Hurry up!"],"jaJP":["早く行こうよ！"]},"keys":["cv_dai_CoopHurryUp"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/500/5000029"]},"audioName":"5000029"},{"type":"CoopBelieve","label":"战斗-信任","texts":{"zhCN":["这里交给我吧！"],"enUS":["Leave it to me!"],"jaJP":["ここはおれに任せろ！"]},"keys":["cv_dai_CoopBelieve"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/500/5000030"]},"audioName":"5000030"},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["请看着我吧，老师…"],"enUS":["Watch me, Master…"],"jaJP":["見ていてくれ、アバン先生"]},"keys":["Voice_dai_1_TouchReactionGood1","cv_dai_TouchReactionGood1"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/500/5000031"]},"audioName":"5000031"},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["我喜欢养育我长大的、这片大地上的所有生物！"],"enUS":["I love all the creatures of the Surface World who made me who I am!"],"jaJP":["おれを育ててくれた、この地上の生き物、すべてが好きだっ！！"]},"keys":["Voice_dai_1_TouchReactionGood2","cv_dai_TouchReactionGood2"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/500/5000032"]},"audioName":"5000032"},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["别叫我迪诺，我的名字是达伊。"],"enUS":["Don't call me Dino. My name is Dai."],"jaJP":["ディーノなんて呼ぶな！おれの名はダイだ"]},"keys":["Voice_dai_1_TouchReactionBad1","cv_dai_TouchReactionBad1"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/500/5000033"]},"audioName":"5000033"},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["如果靠骄傲能获胜，就不用费功夫了…"],"enUS":["If I could win with just pride, I would…"],"jaJP":["誇りで勝てたら苦労はしないよ！"]},"keys":["Voice_dai_1_TouchReactionBad2","cv_dai_TouchReactionBad2"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/500/5000034"]},"audioName":"5000034"},{"type":"NoticeMai