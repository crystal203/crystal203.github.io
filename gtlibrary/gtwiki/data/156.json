s":[3,3],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"技能伤害值","min":6.0,"max":20.0,"unit":"%"},{"name":"武器技能恢复速度","min":6.0,"max":20.0,"unit":"%"},{"name":"生命","min":6.0,"max":15.0,"unit":"%"}],"subOptions":[{"name":"防御","min":6.0,"max":15.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"过热","description":"持续使用神龙吐息，灼热难耐，伤害值提升60%。"}],"skill":{"name":"火焰风暴","description":"激发炎龙的力量燃烧周围敌人，造成伤害并附带重伤效果。","levels":[4,7],"damage":[140.0,200.0],"cooldown":[10.5,9.0],"ailment":"重伤"}}],"number":1}],"profile":{"Age":[75],"Height":[152],"Weight":[45]},"tribes":["神龙"],"story":"吉尔瓦斯，无可救药的淘气包小炎龙。\n\n出生地不详，离家出走是因为不想被妈妈教训，还想恣意使用魔法。‘我是神龙，无所不能’，但踏上冒险之旅之后，首次施展变身人类的魔法失败，变成半人半龙的模样。\n\n从内心鄙视比神龙寿命短、能力欠缺的人类。但他也是尚未成年的幼龙，不懂人情世故的呆萌神龙，身在异乡，不尽人意。世间万物，对吉尔瓦斯而言都是无比新鲜，无比惊奇的。虽然极力保持镇静，旁人却能一眼看穿吉尔瓦斯内心澎湃不已。","storyKey":"profile_dragon_boy_story","sources":{"hero":"heroes.json / OriginId=156","profile":"heroprofile.json / OriginId=156","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId"}}