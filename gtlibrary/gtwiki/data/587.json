"sheet":"characters","name":"blue_dragon_officelook"},"asset":{"key":"character:blue_dragon_officelook","skin":null}},{"id":10522,"code":"blue_dragon_wonderer","name":"中原流浪侠客沄","type":"时装","sprite":{"sheet":"characters","name":"blue_dragon_wonderer"},"asset":{"key":"character:blue_dragon_wonderer","skin":null}},{"id":10563,"code":"blue_dragon_jellyfish","name":"沧海水母沄","type":"时装","sprite":{"sheet":"characters","name":"blue_dragon_jellyfish"},"asset":{"key":"character:blue_dragon_jellyfish","skin":null}},{"id":10594,"code":"blue_dragon_queen","name":"王后沄 [重生细胞联动]","type":"时装","sprite":{"sheet":"characters","name":"blue_dragon_queen"},"asset":{"key":"character:blue_dragon_queen","skin":null}}],"weapons":[{"code":"cwp_bluedragon","name":"龙泉剑","type":"单手剑","variants":[{"id":9010654,"code":"cwp_bluedragon_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_bluedragon"},"stats":[{"name":"每秒伤害","values":[594,652],"baseValues":[593.5889998949399,651.78399988464],"grows":true},{"name":"水属性攻击","values":[192,211],"baseValues":[192.09999996599998,210.933333296],"grows":true},{"name":"暴击率","values":[3,3],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"防御","min":4.0,"max":14.0,"unit":"%"},{"name":"生命","min":3.0,"max":12.0,"unit":"%"},{"name":"武器技能恢复速度","min":2.0,"max":8.0,"unit":"%"}],"subOptions":[{"name":"技能伤害值","min":4.0,"max":16.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"技能伤害值","unit":"%","values":[9.0,18.0,27.0,36.0,45.0]}],"effects":[{"name":"专属效果","description":"当激流命中目标8次时，引起爆破，按照每秒伤害的40%造成额外远程伤害。\n命中目标时，我方水属性队员的暴击伤害倍数提升10%并持续5秒，该效果最多叠加5次；此外，当叠加次数达到上限时，我方水属性队员的远程伤害值提升25%并持续4秒。"}],"skill":{"name":"沧浪万顷","description":"制造波涛，对敌人造成远程伤害并附带击飞效果。","levels":[1,5],"damage":[140.0,200.0],"cooldown":[10.0,9.2],"ailment":"击飞"}}],"number":1}],"profile":{"Age":null,"Height":[165],"Weight":[45]},"tribes":["神龙"],"story":"沧海龙族沄，是负责看守魔龙血的守卫者。\n\n在沄小时候，母亲经常给她讲述一个古老的传说。很久以前，勇士与三位古龙携手击败了魔龙王。由于魔龙的血液中不仅蕴含着知识和力量，还有着难以消除的蛊惑人心的魔力，因此古龙们决定将魔龙血封印在海底深处，并由沧海龙族严加看守。通过这段故事，年幼的沄第一次意识到，看守魔龙血是沧海龙族生来就要背负的使命。然而，沄还没来得及做好接受使命的准备，作为前任守卫者的母亲突然失踪了。\n\n长大后，沄自愿成为了魔龙血的守卫者，不仅是为了履行身为沧海龙族的使命，也是为了寻找母亲不辞而别的原因。沄的守卫者前辈对此并不知情，她无法理解为什么沄要自讨苦吃，主动承担起这份非常危险的任务。由于守卫者的职责是看守魔龙血，这就意味着他们是与魔龙血最近，接触时间最长的人。因此令人感到讽刺的是，那些被魔龙血迷惑、堕落，最终试图占有魔龙力量的人，大多都是曾经的守卫者。在成为守卫者后，沄始终恪尽职守坚定自己的信念，可每当想起消失的母亲，她的心里总会不禁泛起一丝涟漪。\n\n沄是一个理想主义者，她希望自己可以保护所有人，同时也不愿意有人牺牲。实际上，沄非常清楚看守魔龙血的必要性，但这并不妨碍她对守卫者的牺牲感到不满。沄在龙族使命与个人牺牲的矛盾中不断地寻找着答案。\n\n沄的品行高尚，处处以礼待人，看起来好像对人有些冷漠，刻意和他人保持距离，但实际上她是一个性格随和的人。沄不仅和其他海洋种族保持着良好的关系，还在他们中间享有很高的声望。尤其是和人鱼汐雅，两人关系非常亲密，每当遇到困难时，沄最先想到求助的人就是汐雅。","storyKey":"profile_blue_dragon_story","sources":{"hero":"heroes.json / OriginId=587","profile":"heroprofile.json / OriginId=587","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"blue_dragon","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["大海是不会被雨淋湿的。"],"enUS":["The sea does not get wet by rain."],"jaJP":["海流は雨程度ではとめられない"]},"keys":["cv_blue_dragon_NormalBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/587/5870001@5774107652836004084"],"enUS":["cdn/Android/ondemand/voices_en/587/5870001"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/587/5870001@1971167397729367400"]},"audioName":"5870001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["无论这条路的尽头是怎样一番风景，我都要在那里找到一份答案。"],"enUS":["I must find it. Whatever answer awaits me at the end."],"jaJP":["見つけねばなりません、それがどんな答えであろうと"]},"keys":["cv_blue_dragon_BossBattleWin"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/587/5870002@1128330728228052476"],"enUS":["cdn/Android/ondemand/voices_en/587/5870002"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/587/5870002@-4537921905911527104"]},"audioName":"5870002"},{"type":"Die","label":"阵亡","texts":{"zhCN":["我有义务去守护…"],"enUS":["I still must protect…"],"jaJP":["私には護るべきものが…"]},"keys":["cv_blue_dragon_Die"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/587/5870003@8190371658457703354"],"enUS":["cdn/Android/ondemand/voices_en/587/5870003"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/587/5870003@-4621903227226491750"]},"audioName":"5870003"},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["清爽的海风迎面吹来，让我心情瞬间舒畅。"],"enUS":["A nice sea breeze is blowing in."],"jaJP":["心地よい潮風が吹いていますね"]},"keys":["cv_blue_dragon_GetExp"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/587/5870004@4877291676127495708"],"enUS":["cdn/Android/ondemand/voices_en/587/5870004"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/587/5870004@770983473500581941"]},"audioName":"5870004"},{"type":"LevelUp","label":"升级","texts":{"zhCN":["为了守护一切，我会永不止步！"],"enUS":["I'll stop at nothing to protect everything."],"jaJP":["すべてを護るために、とどまるつもりはありません"]},"keys":["cv_blue_dragon_LevelUp"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/587/5870005@4926578332417434494"],"enUS":["cdn/Android/ondemand/voices_en/587/5870005"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/587/5870005@5004006464413136401"]},"audioName":"5870005"},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["这么贵重的东西你也舍得送给我…真不知道该如何报答你这份情谊。"],"enUS":["This looks pretty valuable. How might I repay you?"],"jaJP":["貴重な品のようですね、なんとお礼を申し上げたらよいのでしょうか"]},"keys":["cv_blue_dragon_EquipWeapon"],"audio":{"zhCN":["offline/AssetBundles/Android/ondemand/voices_cn/587/5870006@2215459974359010061"],"enUS":["cdn/Android/ondemand/voices_en/587/5870006"],"jaJP":["offline/AssetBundles/Android/ondemand/voices_ja/587/5870006@7115344476355839382"]},"audioName":"5870006"},{"type":"EquipCostum