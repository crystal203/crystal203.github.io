_CoopHurryUp"]},{"type":"TouchReactionGood1","label":"触碰反应-积极1","texts":{"zhCN":["摸摸小柴琳，难道不开心吗？"],"enUS":[],"jaJP":[]},"keys":["Voice_magical_girl_myth_1_TouchReactionGood1","cv_magical_girl_myth_TouchReactionGood1"]},{"type":"TouchReactionGood2","label":"触碰反应-积极2","texts":{"zhCN":["嗯？变身咒语…？其实不用说也可以，这都是我自己想的…因、因为…很帅嘛！"],"enUS":[],"jaJP":[]},"keys":["Voice_magical_girl_myth_1_TouchReactionGood2","cv_magical_girl_myth_TouchReactionGood2"]},{"type":"TouchReactionBad1","label":"触碰反应-消极1","texts":{"zhCN":["呀！我、我花了一小时才编好的头发，别碰…！"],"enUS":[],"jaJP":[]},"keys":["Voice_magical_girl_myth_1_TouchReactionBad1","cv_magical_girl_myth_TouchReactionBad1"]},{"type":"TouchReactionBad2","label":"触碰反应-消极2","texts":{"zhCN":["那个，小柴琳…我听说其他城市有非常帅气的魔法少女，是真的吗？诶？不，我才没有想和她交朋友呢…"],"enUS":[],"jaJP":[]},"keys":["Voice_magical_girl_myth_1_TouchReactionBad2","cv_magical_girl_myth_TouchReactionBad2"]},{"type":"NoticeMail","label":"邮件提示","texts":{"zhCN":["啊，是呼叫！有新敌人出现了吗？"],"enUS":[],"jaJP":[]},"keys":["Voice_magical_girl_myth_1_NoticeMail"]}]}]}
