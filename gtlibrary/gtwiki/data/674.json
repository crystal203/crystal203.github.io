{"id":"magical_girl","originId":674,"name":"神秘紫罗兰遥","englishName":"","title":"神秘紫罗兰","shortName":"遥","description":"魔法少女初中生","introduction":"","element":"光","role":"战士","weaponsAllowed":["法杖","饰品"],"portrait":{"sheet":"portraits","name":"magical_girl"},"stages":[{"id":674,"name":"magical_girl_3","label":"3星","stars":3,"asset":{"key":"character:magical_girl","skin":"magical_girl_3"},"sprite":{"sheet":"characters","name":"magical_girl_3"},"stats":{"Hp":981.824,"Atk":1.22728,"Def":37.2416,"Recovery":0,"StatGrowthRate":1.02},"skills":[{"kind":"普通攻击","name":"奇迹梦幻舞步","description":"闪耀舞步：挥动法杖，对敌人造成近程伤害。\n月光印记：通过月光对目标造成近程伤害。被命中的目标身上会刻上小柴琳纹章，使其受到的光属性伤害增加20%并持续6秒。"},{"name":"星光能量光束","description":"发射魔法光线，按照每秒伤害的400%对路径上的敌人造成远程伤害，我方全部人员暴击率提升10%并持续10秒。","kind":"连锁技能","trigger":"击倒","connect":"重伤"}],"party":[{"id":10810,"name":"近程伤害","base":12.0,"max":50.0,"unit":"%","level":120,"maxLevel":500,"baseCoefficient":0,"levelCoefficient":0.1,"maxLabel":"满进化 · 满觉醒"}],"skillSets":[{"number":1,"skills":[{"kind":"普通攻击","name":"奇迹梦幻舞步","description":"闪耀舞步：挥动法杖，对敌人造成近程伤害。\n月光印记：通过月光对目标造成近程伤害。被命中的目标身上会刻上小柴琳纹章，使其受到的光属性伤害增加20%并持续6秒。"},{"name":"星光能量光束","description":"发射魔法光线，按照每秒伤害的400%对路径上的敌人造成远程伤害，我方全部人员暴击率提升10%并持续10秒。","kind":"连锁技能","trigger":"击倒","connect":"重伤"}],"party":[{"id":10810,"name":"近程伤害","base":12.0,"max":50.0,"unit":"%","level":120,"maxLevel":500,"baseCoefficient":0,"levelCoefficient":0.1,"maxLabel":"满进化 · 满觉醒"}]}],"options":[{"id":10810,"level":120,"name":"队伍近程伤害提升"}]},{"id":675,"name":"magical_girl_4","label":"4星","stars":4,"asset":{"key":"character:magical_girl","skin":"magical_girl_4"},"sprite":{"sheet":"characters","name":"magical_girl_4"},"stats":{"Hp":1067.2,"Atk":1.334,"Def":40.48,"Recovery":0,"StatGrowthRate":1.02},"skills":[{"kind":"普通攻击","name":"奇迹梦幻舞步","description":"闪耀舞步：挥动法杖，对敌人造成近程伤害。\n月光印记：通过月光对目标造成近程伤害。被命中的目标身上会刻上小柴琳纹章，使其受到的光属性伤害增加20%并持续6秒。"},{"name":"星光能量光束","description":"发射魔法光线，按照每秒伤害的400%对路径上的敌人造成远程伤害，我方全部人员暴击率提升10%并持续10秒。","kind":"连锁技能","trigger":"击倒","connec