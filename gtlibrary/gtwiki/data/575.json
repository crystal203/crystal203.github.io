5,204.4],"grows":true},{"name":"暴击率","values":[5,5],"unit":"%"},{"name":"恢复能力","values":[220,220],"baseValues":[220,220],"grows":true}],"growthRate":1.02,"mainOptions":[{"name":"恢复能力","min":8.0,"max":22.0,"unit":"%"},{"name":"技能伤害值","min":8.0,"max":20.0,"unit":"%"},{"name":"生命","min":8.0,"max":18.0,"unit":"%"}],"subOptions":[{"name":"防御","min":6.0,"max":16.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"恢复能力","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"魔力花瓣命中目标时，我方全部人员防御提升30%并持续5秒；该技能每5秒启动1次。\n被魔力花瓣命中的敌人身上会刻上魔花纹章并持续3秒；若魔力花瓣的下一次攻击没有命中刻有魔花纹章的敌人，该敌人身上的纹章将爆炸，使其受到魔力花瓣的伤害。"}],"skill":{"name":"对魔属性结界","description":"展开对魔属性结界，对敌人造成远程伤害并附带重伤效果。","levels":[3,7],"damage":[212.0,280.0],"cooldown":[8.5,7.5],"ailment":"重伤"}}],"number":1}],"profile":{"Age":null,"Height":null,"Weight":null},"tribes":["妖鬼"],"story":"大鬼族公主朱菜，是鸠拉·特恩佩斯特联邦国的干部之一。\n\n为了找到戴面具的魔人并向其报仇，朱菜和在猪头族袭击中幸免于难的其他族人一起在鸠拉大森林中漂泊。一次偶然的机会，朱菜等人与利姆鲁·特恩佩斯特相遇，误认为对方就是他们寻找的仇人而与其大打出手，但很快，朱菜就发现利姆鲁并不是他们要找的那个魔人，于是立刻出面调停了这场冲突。在朱菜的极力劝解下，双方总算停止了交手，而利姆鲁听对方讲述事情的来龙去脉后，便向朱菜及其他幸存者发出邀请，希望他们成为自己的伙伴。\n\n大鬼族们欣然接受了利姆鲁的提议，利姆鲁则为原本没有名字的大鬼族公主赐名“朱菜”，作为成为伙伴的证据。后来，利姆鲁通过“魔王进化”仪式进化为魔王，其麾下魂之系谱中的所有魔物都得到了祝福，朱菜也因此进化成为妖鬼。\n\n朱菜尽心尽力辅佐利姆鲁，与此同时，她也为鸠拉·特恩佩斯特联邦国的文化发展做出了重大贡献。她不仅重点培养了料理及服饰文化领域中的人才，身为大鬼族公主，还展露了善于沟通及外交业务的能力。\n\n朱菜深深地喜欢着自己的主君利姆鲁。她对利姆鲁可谓是“一心一意”，基于对利姆鲁的绝对信任，虽然身为魔物，朱菜却能施展依靠信仰的“神圣魔法”。依靠神圣魔法，她轻松地击败了克雷曼的手下“亚达鲁曼”。","storyKey":"profile_slime_shuna_story","sources":{"hero":"heroes.json / OriginId=575","profile":"heroprofile.json / OriginId=575","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"slime_shuna","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["身为利姆鲁大人的侍奉者，这点程度不算什么…"],"enUS":["To serve Great Rimuru, this is the least I can do…."],"jaJP":["リムル様にお仕えする者なら、これぐらい"]},"keys":["cv_slime_shuna_NormalBattleWin"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/575/5750001"]},"audioName":"5750001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["我来这里可不是游山玩水的。"],"enUS":["We did not come here on some pleasant little excursion."],"jaJP":["物見遊山をしにここに来たのではありません"]},"keys":["cv_slime_shuna_BossBattleWin"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/575/5750002"]},"audioName":"5750002"},{"type":"Die","label":"阵亡","texts":{"zhCN":["利…利姆鲁大人…"],"enUS":["G… Great Rimuru…."],"jaJP":["リ…リムル様…"]},"keys":["cv_slime_shuna_Die"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/575/5750003"]},"audioName":"5750003"},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["哎呀，这个真的能让我变强吗？"],"enUS":["Will this really make me stronger?"],"jaJP":["まあ、これで強くなれるのでしょうか"]},"keys":["cv_slime_shuna_GetExp"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/575/5750004"]},"audioName":"5750004"},{"type":"LevelUp","label":"升级","texts":{"zhCN":["希望能对利姆鲁大人有所帮助…"],"enUS":["I hope I can be of help to Great Rimuru…."],"jaJP":["もっとリムル様のお役に立てますように...."]},"keys":["cv_slime_shuna_LevelUp"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/575/5750005"]},"audioName":"5750005"},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["这种东西，形式也是很重要的。"],"enUS":["Regarding things like this, appearances matter too."],"jaJP":["こういうのは形も大切なんです"]},"keys":["cv_slime_shuna_EquipWeapon"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/575/5750006"]},"audioName":"5750006"},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["这件衣服里蕴含着魔素吗？"],"enUS":["Are there magicules in this garment?"],"jaJP":["こちらの衣装には魔素は含まれているのですか？"]},"keys