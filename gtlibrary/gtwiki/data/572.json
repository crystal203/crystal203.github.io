r:slime_rimuru_demonking","skin":null}},{"id":10460,"code":"slime_rimuru_shiz","name":"静服饰·利姆鲁","type":"时装","sprite":{"sheet":"characters","name":"slime_rimuru_shiz"},"asset":{"key":"character:slime_rimuru_shiz","skin":null}}],"weapons":[{"code":"cwp_slimerimuru","name":"利姆鲁之剑","type":"单手剑","variants":[{"id":9010644,"code":"cwp_slimerimuru_epic","label":"普通","stars":5,"sprite":{"sheet":"items","name":"cwp_slimerimuru"},"stats":[{"name":"每秒伤害","values":[610,670],"baseValues":[610.4700000000001,670.3200000000002],"grows":true},{"name":"水属性攻击","values":[194,213],"baseValues":[193.8,212.8],"grows":true},{"name":"暴击率","values":[5,5],"unit":"%"}],"growthRate":1.02,"mainOptions":[{"name":"生命","min":5.0,"max":14.0,"unit":"%"},{"name":"防御","min":4.0,"max":12.0,"unit":"%"},{"name":"技能伤害值","min":5.0,"max":10.0,"unit":"%"}],"subOptions":[{"name":"武器技能恢复速度","min":4.0,"max":12.0,"unit":"%"}],"subCount":[0,1],"limitBreak":[{"name":"攻击","min":10.0,"max":10.0,"unit":"%"}],"engrave":[{"name":"攻击","min":15.0,"max":15.0,"unit":"%"},{"name":"生命","min":15.0,"max":15.0,"unit":"%"}],"engraveRandom":[{"name":"生命","unit":"%","values":[3.0,6.0,9.0,12.0,15.0]}],"effects":[{"name":"专属效果","description":"命中目标时，有50%概率按照每秒伤害的40%造成额外近程伤害，使敌人水属性抵抗减免30%并持续3秒。\n使用暴食者时，我方人员攻击提升30%并持续5秒。"}],"skill":{"name":"暴食者","description":"吸取敌人的力量，对其造成近程伤害并附带击飞效果。","levels":[1,5],"damage":[190.0,250.0],"cooldown":[9.8,8.0],"ailment":"击飞"}}],"number":1}],"profile":{"Age":null,"Height":null,"Weight":null},"tribes":["龙魔粘性星神体"],"story":"利姆鲁·特恩佩斯特，位列八星魔王之一，是鸠拉·特恩佩斯特联邦国的国王。\n\n利姆鲁原本是一位在东京生活的普通上班族，因一场意外被人持刀刺死后转生到了异世界。虽然已经转生成为史莱姆，但利姆鲁却仍保留着前世的记忆。在独有技能“大贤者”的帮助下，利姆鲁也逐渐适应了异世界的生活。\n\n利姆鲁之所以能变成人形，多亏了同乡的井泽静江--“静”小姐。静被魔王莱昂召唤到异世界后，在利姆鲁的村庄失控暴走变成了炎之精灵“伊芙利特”。虽然利姆鲁通过吞噬伊芙利特救下了静，但由于失去了凭依的精灵，她的生命力极速下降，濒临死亡。临死前，静小姐拜托利姆鲁吞噬自己，从此，利姆鲁获得了变为人形的能力。\n\n在鸠拉大森林与哥布林及牙狼族一起生活的利姆鲁，解决森林中出现的各种问题后成为了这片森林的盟主，并与森林里的其他魔物携手发展村庄。矮人国国王看到利姆鲁为村庄所付出的努力，便认可利姆鲁的村庄具备成为国家的资格，并决定与其缔结盟约。于是，名为“鸠拉·特恩佩斯特联邦国”的国家就此诞生。\n\n不料，鸠拉·特恩佩斯特联邦国的迅猛发展激起了人类的戒备心，最终导致许多伙伴遭遇人类的袭击而死。为了复活自己的伙伴们，利姆鲁决定成为魔王。在收集足够的灵魂后，利姆鲁成功进化为魔王，独有技能“大贤者”也随之进化为究极能力“智慧之王”。成功复活死去的同伴们后，利姆鲁还以新魔王的身份受邀参加了“魔王盛宴”。在宴会上，利姆鲁除掉了整个事件的罪魁祸首——克雷曼，并登上了八星魔王之位。\n\n利姆鲁热爱美食，是个十足的吃货。自从可以化为人形，能够品味出食物的味道后，利姆鲁便将前世体验过的庆典及饮食文化融入到异世界中，促进了国家娱乐和文化的发展。然而，即使紫苑已经获得了独有技能“料理人”，利姆鲁仍然对她做的料理避之不及。","storyKey":"profile_slime_rimuru_story","sources":{"hero":"heroes.json / OriginId=572","profile":"heroprofile.json / OriginId=572","strings":"strings-zhCN.json","items":"items.json / TargetCharacterIds, ExclusiveCharacterId","voiceLines":["strings-zhCN.json / Voice_*, cv_*","strings-enUS.json / Voice_*, cv_*","strings-jaJP.json / Voice_*, cv_*"],"voiceAudio":"gtaudio/data/offline-package.json; CharacterVoiceType; heroes.json VoiceId"},"voiceLines":[{"id":"slime_rimuru","label":"普通","lines":[{"type":"NormalBattleWin","label":"胜利-普通战斗","texts":{"zhCN":["嗯，差不多就这样了。"],"enUS":["Well, I think this is enough."],"jaJP":["まあ、こんなところだな"]},"keys":["cv_slime_rimuru_NormalBattleWin"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/572/5720001"]},"audioName":"5720001"},{"type":"BossBattleWin","label":"胜利-首领战斗","texts":{"zhCN":["既然我已经自称魔王了，我不会输的。"],"enUS":["I took the title of Demon Lord, so I can't lose."],"jaJP":["俺も魔王を名乗ったわけだし、負けるわけにはいかない"]},"keys":["cv_slime_rimuru_BossBattleWin"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/572/5720002"]},"audioName":"5720002"},{"type":"Die","label":"阵亡","texts":{"zhCN":["眼前一片漆黑…"],"enUS":["Everything is getting dark….\nEntering…. sleep mode…."],"jaJP":["うっ！…目の前が暗く…"]},"keys":["cv_slime_rimuru_Die"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/572/5720003"]},"audioName":"5720003"},{"type":"GetExp","label":"获得经验结晶","texts":{"zhCN":["等等，如果用捕食者捕食分析的话…"],"enUS":["Shall I feast?"],"jaJP":["待てよ？これ、捕食者で捕食して解析したら…"]},"keys":["cv_slime_rimuru_GetExp"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/572/5720004"]},"audioName":"5720004"},{"type":"LevelUp","label":"升级","texts":{"zhCN":["好极了，看来又获得了新力量！"],"enUS":["All right, feasting complete!"],"jaJP":["よし、これでまた新しい力を得たようだな"]},"keys":["cv_slime_rimuru_LevelUp"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/572/5720005"]},"audioName":"5720005"},{"type":"EquipWeapon","label":"佩戴装备","texts":{"zhCN":["连我一个外行都能看出来，这是好东西。"],"enUS":["It's magnificent. Even an untrained eye like mine can tell this is good."],"jaJP":["素人の俺にだって、いいものだってわかる"]},"keys":["cv_slime_rimuru_EquipWeapon"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/572/5720006"]},"audioName":"5720006"},{"type":"EquipCostume","label":"穿戴时装","texts":{"zhCN":["像今天这种日子，还是穿得庄重大气一点比较好吧？"],"enUS":["I think something more somber and respectful would be more appropriate."],"jaJP":["今日はもっときちんとかしこまった衣装の方がいいんじゃないかなぁ"]},"keys":["cv_slime_rimuru_EquipCostume"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/572/5720007"]},"audioName":"5720007"},{"type":"Evolve","label":"进化","texts":{"zhCN":["我的进化成功了吗？"],"enUS":["Was my evolution successful?"],"jaJP":["俺の進化は成功したのか…？"]},"keys":["cv_slime_rimuru_Evolve"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/572/5720008"]},"audioName":"5720008"},{"type":"Attack1","label":"攻击1","texts":{"zhCN":["喝啊！"],"enUS":["Cha-at."],"jaJP":["ほっ！"]},"keys":["cv_slime_rimuru_Attack1"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/572/5720009"]},"audioName":"5720009"},{"type":"Attack2","label":"攻击2","texts":{"zhCN":["哼！"],"enUS":["Hm!"],"jaJP":["ふん！"]},"keys":["cv_slime_rimuru_Attack2"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/572/5720010"]},"audioName":"5720010"},{"type":"Attack3","label":"攻击3","texts":{"zhCN":["诶！"],"enUS":["Hiyap!"],"jaJP":["えいっ！"]},"keys":["cv_slime_rimuru_Attack3"],"audio":{"zhCN":[],"enUS":[],"jaJP":["cdn/Android/ondemand/voices_ja/572/5720011"]},"audioName":"5720011"},{"type":"Skill1","label":"技能1","texts":{"zhCN":["瞧好了！"],"enUS":["Take this!"],"jaJP":["くらえ！"]},"keys":["cv_slime_rimuru_Skill1"],"audio":{"zhCN":[],